		Kind = "Medal",
		Focus = "Precision",
		Medal = 3,
		Count = 4,
	},
	-- Grappling
	{
		Id = "gr1",
		Category = "Grappling",
		Tier = 1,
		Name = "Hooked",
		Text = "Grapple 15 times.",
		Kind = "Count",
