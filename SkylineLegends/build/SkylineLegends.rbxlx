	},
	{
		Id = "milo",
		Name = "Milo",
		Role = "Pigeon Keeper",
		District = "Tinroof",
		Spot = "tin_milo",
		Personality = "Ten years old, fearless, convinced his pigeons are the fastest couriers in Meridian.",
		Look = {
			Skin = SKIN[4],
			Shirt = rgb(255, 214, 90),
			Pants = rgb(90, 160, 210),
			Hair = rgb(30, 20, 15),
			Hat = "Cap",
		},
		Greeting = { "Did you see Comet? She's the grey one!", "Bet my pigeons beat you to the water tower." },
