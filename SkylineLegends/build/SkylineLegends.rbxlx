		},
		Idle = { "Step through the gate when you're ready. One fall ends the dream." },
		Service = "Endless",
	},

	-- Tinroof Terraces --------------------------------------------------------------
	{
		Id = "petra",
		Name = "Gran Petra",
		Role = "Rooftop Gardener",
		District = "Tinroof",
