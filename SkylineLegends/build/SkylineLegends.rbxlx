          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- The heads-up display. Everything a runner needs mid-move, readable at a
-- glance and never by colour alone:
--   stamina, with a preview of what your next move would cost and a clear
--   TIRED / EXHAUSTED state; air-action pips (double jump, dash charges with
--   cooldown, grapple target); level, XP and currencies; pinned objectives
--   with a waypoint arrow; the run panel (timer, splits, checkpoints, tokens,
--   next medal); the flow meter and chain; contextual input hints; the lesson
--   card and mode panels (race, relay, Spire, Dreamline, timed jobs).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FlowConfig = require(ReplicatedStorage.Shared.Config.Flow)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Leveling = require(ReplicatedStorage.Shared.Logic.Leveling)
local Medals = require(ReplicatedStorage.Shared.Logic.Medals)
local Progression = require(ReplicatedStorage.Shared.Config.Progression)
local Quests = require(ReplicatedStorage.Shared.Config.Quests)

local Bus = require(script.Parent.Parent.Core.Bus)
local Input = require(script.Parent.Parent.Core.Input)
local Settings = require(script.Parent.Parent.Core.Settings)
local State = require(script.Parent.Parent.Core.State)
local Controller = require(script.Parent.Parent.Movement.Controller)
local Stamina = require(script.Parent.Parent.Movement.Stamina)
local CourseClient = require(script.Parent.Parent.Gameplay.CourseClient)
local Flow = require(script.Parent.Parent.Gameplay.Flow)
local QuestClient = require(script.Parent.Parent.Gameplay.QuestClient)
local LessonsClient = require(script.Parent.Parent.Gameplay.Lessons)
local Kit = require(script.Parent.Kit)
local Root = require(script.Parent.Root)

local C = Kit.Colors
local Hud = {}

local ui: { [string]: any } = {}
local splitFlashUntil = 0
local deniedUntil = 0
local timerEnds: number? = nil
local raceProgress: { [number]: number } = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Builders -----------------------------------------------------------------------------------------

local function buildStamina(parent: Instance)
	local holder = Kit.new("Frame", {
		Name = "Stamina",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -28),
		Size = UDim2.fromOffset(360, 74),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	-- Air actions row.
	local pips = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		Parent = holder,
	})
	Kit.List(pips, true, 10, Enum.HorizontalAlignment.Center)
	local function pip(name: string, glyph: string, order: number): TextLabel
		local label = Kit.Label(pips, glyph, 15, {
			Name = name,
			Size = UDim2.fromOffset(78, 28),
			BackgroundTransparency = 0.25,
			BackgroundColor3 = C.Panel,
			TextXAlignment = Enum.TextXAlignment.Center,
			Font = Kit.Fonts.Bold,
			LayoutOrder = order,
		})
		Kit.Corner(label, 7)
		return label
	end
	ui.DoublePip = pip("Double", "◆ 2×JUMP", 1)
	ui.DashPip = pip("Dash", "▮ DASH", 2)
	ui.DashPip.Size = UDim2.fromOffset(92, 28)
	ui.DashCooldown = Kit.new("Frame", {
		BackgroundColor3 = C.Signal,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		ZIndex = 0,
		Parent = ui.DashPip,
	})
	Kit.Corner(ui.DashCooldown, 7)
	ui.GrapplePip = pip("Grapple", "⌁ HOOK", 3)

	-- Bar.
	local bar = Kit.Bar(holder, C.Signal, {
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 0, 14),
	})
	ui.StaminaBar = bar
	ui.StaminaCost = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = bar.Frame,
	})
	ui.StaminaText = Kit.Label(holder, "", 13, {
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
		Font = Kit.Fonts.Bold,
	})
	ui.StaminaHolder = holder
end

local function buildProfile(parent: Instance)
	local panel = Kit.Panel(parent, {
		Name = "Profile",
		Position = UDim2.fromOffset(16, 56),
		Size = UDim2.fromOffset(250, 66),
		BackgroundTransparency = 0.25,
	})
	Kit.Padding(panel, 8, 12)
	ui.LevelText = Kit.Label(panel, "Lv 1", 16, { Size = UDim2.new(1, 0, 0, 20), Font = Kit.Fonts.Bold })
	ui.RankText = Kit.Label(
		panel,
		"",
		13,
		{ Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 16), TextColor3 = C.Muted }
	)
	ui.XPBar = Kit.Bar(panel, C.Accent, { Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 6) })
	ui.Currency = Kit.Label(panel, "", 13, {
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, 0, 0, 20),
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = Kit.Fonts.Bold,
		TextColor3 = C.Accent,
	})
	ui.Profile = panel
end

local function buildFlow(parent: Instance)
	local panel = Kit.new("Frame", {
		Name = "Flow",
		Position = UDim2.fromOffset(16, 132),
		Size = UDim2.fromOffset(250, 70),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	ui.FlowTier = Kit.Label(panel, "", 15, { Size = UDim2.new(1, 0, 0, 20), Font = Kit.Fonts.Black })
	ui.FlowBar =
		Kit.Bar(panel, rgb(120, 255, 200), { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 6) })
	ui.FlowChain = Kit.Label(panel, "", 13, {
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 34),
		TextColor3 = C.Muted,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	ui.Flow = panel
end

local function buildObjectives(parent: Instance)
	local panel = Kit.new("Frame", {
		Name = "Objectives",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 56),
		Size = UDim2.fromOffset(300, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = parent,
	})
	Kit.List(panel, false, 6)
	ui.Objectives = panel
	-- Waypoint marker (follows the pinned objective on screen, or points to it from the edge).
	local marker = Kit.Label(parent, "◆", 22, {
		Name = "Waypoint",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(120, 44),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Accent,
		TextStrokeTransparency = 0.3,
		Font = Kit.Fonts.Black,
		Visible = false,
	})
	ui.Waypoint = marker
end

local function buildRun(parent: Instance)
	local panel = Kit.Panel(parent, {
		Name = "Run",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 52),
		Size = UDim2.fromOffset(340, 112),
		BackgroundTransparency = 0.3,
		Visible = false,
	})
	Kit.Padding(panel, 8, 14)
	ui.RunName = Kit.Label(panel, "", 14, {
		Size = UDim2.new(1, 0, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
		Font = Kit.Fonts.Bold,
	})
	ui.RunTimer = Kit.Label(panel, "0:00.00", 34, {
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Kit.Fonts.Mono,
	})
	ui.RunSplit = Kit.Label(panel, "", 16, {
		Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, 0, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Kit.Fonts.Bold,
	})
	ui.RunInfo = Kit.Label(panel, "", 13, {
		Position = UDim2.fromOffset(0, 78),
		Size = UDim2.new(1, 0, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
	})
	ui.Run = panel
end

local function buildHint(parent: Instance)
	ui.Hint = Kit.Label(parent, "", 14, {
		Name = "Hint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -108),
		Size = UDim2.fromOffset(520, 22),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Text,
		TextStrokeTransparency = 0.5,
		Font = Kit.Fonts.Bold,
	})
end

local function buildLesson(parent: Instance)
	local panel = Kit.Panel(parent, {
		Name = "Lesson",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.55, 0),
		Size = UDim2.fromOffset(300, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
	})
	Kit.Padding(panel, 12)
	Kit.List(panel, false, 6)
	ui.Lesson = panel
end

local function buildMode(parent: Instance)
	local panel = Kit.Panel(parent, {
		Name = "Mode",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.55, 0),
		Size = UDim2.fromOffset(260, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
	})
	Kit.Padding(panel, 12)
	Kit.List(panel, false, 4)
	ui.Mode = panel
	ui.Timer = Kit.Label(parent, "", 20, {
		Name = "QuestTimer",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 170),
		Size = UDim2.fromOffset(300, 26),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Kit.Fonts.Black,
		TextStrokeTransparency = 0.4,
		Visible = false,
	})
	ui.Carry = Kit.Label(parent, "", 15, {
		Name = "Carry",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -134),
		Size = UDim2.fromOffset(360, 20),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Accent,
		Font = Kit.Fonts.Bold,
		TextStrokeTransparency = 0.5,
		Visible = false,
	})
end

-- Updates --------------------------------------------------------------------------------------------

-- The move whose cost is most relevant right now, and its cost.
local function relevantCost(): (string?, number)
	local info = Controller.Info
	local state = info.State
	local costs = Controller.Stats.Costs or {}
	if state == "Air" then
		if info.DoubleJumpReady and Controller.Has("DoubleJump") then
			return "Double jump", costs.DoubleJump or 0
		elseif Controller.Has("Dash") and info.DashCharges > 0 then
			return "Dash", costs.Dash or 0
		end
	elseif state == "WallRun" then
		return "Wall run /s", costs.WallRun or 0
	elseif state == "Ledge" then
		return "Hang /s", costs.Hang or 0
	elseif state == "Climb" then
		return "Climb /s", costs.Climb or 0
	elseif state == "Ground" and info.Sprinting then
		return "Sprint /s", costs.Sprint or 0
	elseif Controller.Has("Dash") then
		return "Dash", costs.Dash or 0
	end
	return nil, 0
end

local function updateStamina()
	local value, max = Stamina.Value, math.max(Stamina.Max, 1)
	local fraction = value / max
	ui.StaminaBar.Set(fraction)
	local exhausted = Stamina.Exhausted
	local denied = os.clock() < deniedUntil
	local color = if exhausted or denied then C.Bad elseif fraction < 0.3 then C.Warn else C.Signal
	ui.StaminaBar.Color(color)
	local name, cost = relevantCost()
	local costFraction = math.clamp(cost / max, 0, fraction)
	ui.StaminaCost.Size = UDim2.fromScale(costFraction, 1)
	ui.StaminaCost.Position = UDim2.fromScale(fraction - costFraction, 0)
	ui.StaminaCost.Visible = name ~= nil and cost > 0
	local status = if exhausted
		then "EXHAUSTED — rest on the ground"
		elseif denied then "NOT ENOUGH STAMINA"
		elseif fraction < 0.3 then "TIRED"
		else ""
	local costText = if name and cost > 0 then ("%s −%d"):format(name, math.floor(cost + 0.5)) else ""
	ui.StaminaText.Text = if status ~= "" then status else costText
	ui.StaminaText.TextColor3 = if status ~= "" then color else C.Muted
	-- Hide when full and idle on the ground (clean screen), unless in a run.
	local idle = fraction >= 0.999
		and Controller.Info.State == "Ground"
		and Controller.Info.Speed < 1
		and not CourseClient.Run
	ui.StaminaHolder.Visible = not idle or os.clock() < deniedUntil
end

local function updatePips()
	local info = Controller.Info
	local doubleOn = Controller.Has("DoubleJump")
	ui.DoublePip.Visible = doubleOn
	if doubleOn then
		local ready = info.DoubleJumpReady
		ui.DoublePip.Text = if ready then "◆ 2×JUMP" else "◇ used"
		ui.DoublePip.TextColor3 = if ready then C.Text else C.Faint
	end
	local dashOn = Controller.Has("Dash")
	ui.DashPip.Visible = dashOn
	if dashOn then
		local charges = info.DashCharges
		local maxCharges = Controller.Stats.DashCharges or 1
		local marks = string.rep("▮", charges) .. string.rep("▯", math.max(maxCharges - charges, 0))
		ui.DashPip.Text = marks .. " DASH"
		ui.DashPip.TextColor3 = if charges > 0 and info.DashReady >= 1 then C.Text else C.Faint
		ui.DashCooldown.Size = UDim2.fromScale(if info.DashReady < 1 then info.DashReady else 0, 1)
	end
	local grappleOn = Controller.Has("Grapple")
	ui.GrapplePip.Visible = grappleOn
	if grappleOn then
		local target = info.GrappleTarget
		ui.GrapplePip.Text = if target then "⌁ HOOK ✓" else "⌁ HOOK"
		ui.GrapplePip.TextColor3 = if target then C.Signal else C.Faint
	end
end

local function updateProfile()
	local profile = State.Profile
	if not profile then
		return
	end
	local level, into, needed = Leveling.FromXP(profile.XP or 0)
	local rank = Progression.RankFor(level)
	ui.LevelText.Text = ("Lv %d"):format(level)
	ui.RankText.Text = if level >= 100
		then rank.Name .. " · MAX"
		else ("%s · %s / %s XP"):format(rank.Name, Format.Number(into), Format.Number(needed))
	ui.RankText.TextColor3 = rank.Color
	ui.XPBar.Set(if needed > 0 then into / needed else 1)
	ui.Currency.Text = ("¢ %s   ✪ %d"):format(Format.Number(profile.Credits or 0), profile.Prestige or 0)
end

local function objectiveCard(title: string, text: string, color: Color3, order: number)
	local card = Kit.Panel(ui.Objectives, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0.3,
		LayoutOrder = order,
	})
	Kit.Padding(card, 8, 10)
	Kit.List(card, false, 2)
	Kit.Label(card, title, 13, { TextColor3 = color, Font = Kit.Fonts.Bold, Size = UDim2.new(1, 0, 0, 16) })
	Kit.Paragraph(card, text, 14, C.Text)
end

local function updateObjectives()
	Kit.Clear(ui.Objectives)
	local profile = State.Profile
	if not profile then
		return
	end
	local order = 0
	for _, questId in profile.Quests.Pinned or {} do
		local quest = Quests.ById[questId]
		local state = profile.Quests.Active[questId]
		if quest and state then
			local step = quest.Steps[state.Step]
			if step then
				order += 1
				local progress = ""
				local done = 0
				for _ in state.Progress or {} do
					done += 1
				end
				local total = if step.Points
					then #step.Points
					elseif type(step.To) == "table" then #step.To
					else step.Count
				if total and total > 1 then
					progress = ("  (%d/%d)"):format(
						if state.Progress and state.Progress.Count then state.Progress.Count else done,
						total
					)
				end
				local tag = if quest.Type == "Main" then "STORY" elseif quest.Type == "Expert" then "EXPERT" else "SIDE"
				objectiveCard(
					tag .. " · " .. quest.Name,
					step.Text .. progress,
					if quest.Type == "Main" then C.Accent else C.Signal,
					order
				)
			end
		end
	end
	local contract = profile.Contracts and profile.Contracts.Active
	if contract then
		order += 1
		objectiveCard("CONTRACT · " .. tostring(contract.Name), tostring(contract.Text), C.Good, order)
	end
end

local function updateWaypoint()
	local marker = ui.Waypoint
	local target = QuestClient.PinnedTarget()
	local camera = workspace.CurrentCamera
	local root = Controller.Info.Root
	if not target or not camera or not root or CourseClient.Run then
		marker.Visible = false
		return
	end
	local distance = (target.Position - root.Position).Magnitude
	if distance < 10 then
		marker.Visible = false
		return
	end
	local point, onScreen = camera:WorldToViewportPoint(target.Position)
	local viewport = camera.ViewportSize
	marker.Visible = true
	local text = ("%dm"):format(math.floor(distance * 0.28 + 0.5))
	if onScreen and point.Z > 0 then
		marker.Position = UDim2.fromOffset(point.X, point.Y - 20)
		marker.Text = "◆\n" .. text
	else
		-- Point from the screen edge.
		local center = viewport / 2
		local direction = Vector2.new(point.X, point.Y) - center
		if point.Z < 0 then
			direction = -direction
		end
		if direction.Magnitude < 1 then
			direction = Vector2.new(0, -1)
		end
		local unit = direction.Unit
		local edge = center
			+ unit
				* math.min(center.X - 60, center.Y - 60)
				/ math.max(math.abs(unit.X), math.abs(unit.Y), 1e-3)
				* math.max(math.abs(unit.X), math.abs(unit.Y))
		marker.Position = UDim2.fromOffset(edge.X, edge.Y)
		local arrow = if math.abs(unit.X) > math.abs(unit.Y)
			then (if unit.X > 0 then "▶" else "◀")
			else (if unit.Y > 0 then "▼" else "▲")
		marker.Text = arrow .. "\n" .. text
	end
	marker.TextColor3 = if Settings.Get("HighContrast") then Color3.new(1, 1, 1) else C.Accent
end

local function updateRun()
	local run = CourseClient.Run
	ui.Run.Visible = run ~= nil
	if not run then
		return
	end
	local elapsed = CourseClient.Elapsed()
	if elapsed < 0 then
		ui.RunTimer.Text = ("%.1f"):format(-elapsed)
	else
		ui.RunTimer.Text = Format.Time(elapsed)
	end
	local tag = if run.Mode == "Ranked"
		then "RANKED"
		elseif run.Mode == "Practice" then "PRACTICE"
		else string.upper(run.Mode)
	ui.RunName.Text = ("%s · %s"):format(run.Name, tag)
	if os.clock() > splitFlashUntil then
		ui.RunSplit.Text = ""
	end
	local tokens = 0
	for _ in run.Tokens do
		tokens += 1
	end
	local info = ("CP %d/%d   ★ %d/%d"):format(run.Checkpoint, run.CheckpointCount, tokens, run.TokenTotal)
	if run.Mode ~= "Practice" and #run.Medals > 0 and run.Context == nil then
		local medal, limit = Medals.Next(math.max(elapsed, 0), run.Medals)
		if medal and limit then
			local current = Medals.For(math.max(elapsed, 0), run.Medals)
			local target = if current > 0 then current else medal
			local targetLimit = run.Medals[target]
			info ..= ("   %s %s"):format(Kit.MedalText(target), Format.Time(targetLimit))
		end
	end
	if run.Mode == "Race" then
		local ahead = 0
		for _, index in raceProgress do
			if index > run.Checkpoint then
				ahead += 1
			end
		end
		info ..= ("   Place ~%d"):format(ahead + 1)
	end
	if run.Mark then
		info ..= "   ⚑ mark set"
	end
	ui.RunInfo.Text = info
end

local function updateFlow()
	local tier = Flow.Tier
	local show = CourseClient.Run ~= nil or Settings.Get("ShowFlow") ~= false
	ui.Flow.Visible = show and (Flow.Meter > 1 or CourseClient.Run ~= nil)
	local info = FlowConfig.Tiers[tier]
	ui.FlowTier.Text = if info then ("%s  ×%.2g"):format(string.upper(info.Name), info.Multiplier) else "FLOW"
	ui.FlowTier.TextColor3 = if tier >= 4 then rgb(255, 150, 230) elseif tier >= 2 then rgb(120, 255, 200) else C.Muted
	ui.FlowBar.Set(Flow.Meter / FlowConfig.MeterMax)
	local chain = table.concat(Flow.Chain, " › ")
	if CourseClient.Run then
		chain = ("Score %d  ·  %s"):format(Flow.RunScore(), chain)
	end
	ui.FlowChain.Text = chain
end

local ACTION_HINTS: { [string]: (any) -> string? } = {
	Ledge = function()
		local text = ("[%s] Climb up   [%s] Drop   [%s] Shimmy"):format(
			Input.Glyph("Jump"),
			Input.Glyph("Crouch"),
			Input.Glyph("Move")
		)
		if Controller.Has("LedgeLeap") then
			text ..= ("   Hold up + [%s] Leap"):format(Input.Glyph("Jump"))
		end
		return text
	end,
	WallRun = function()
		return ("[%s] Wall jump   [%s] Let go"):format(Input.Glyph("Jump"), Input.Glyph("Crouch"))
	end,
	Climb = function()
		return ("[%s] Climb   [%s] Hop up   [%s] Let go"):format(
			Input.Glyph("Move"),
			Input.Glyph("Jump"),
			Input.Glyph("Crouch")
		)
	end,
	Zipline = function()
		return ("[%s] Jump off   [%s] Drop"):format(Input.Glyph("Jump"), Input.Glyph("Crouch"))
	end,
	Swing = function()
		return ("Pump with [%s]   Release [%s] at the top of the arc"):format(Input.Glyph("Move"), Input.Glyph("Jump"))
	end,
	Balance = function()
		return ("Steer with [%s] to stay centred"):format(Input.Glyph("Move"))
	end,
	Slide = function()
		return ("[%s] Slide jump keeps your speed"):format(Input.Glyph("Jump"))
	end,
}

local function updateHint()
	if Settings.Get("ShowInputHints") == false then
		ui.Hint.Text = ""
		return
	end
	local info = Controller.Info
	local fn = ACTION_HINTS[info.State]
	local text = if fn then fn(info) else nil
	if not text and info.State == "Air" then
		if info.GrappleTarget and Controller.Has("Grapple") then
			text = ("[%s] Grapple"):format(Input.Glyph("Grapple"))
		elseif info.Velocity.Y < -70 and Controller.Has("Roll") then
			text = ("Press [%s] just before landing to roll"):format(Input.Glyph("Crouch"))
		end
	end
	ui.Hint.Text = text or ""
end

local function renderLesson(lesson: any, step: number, progress: number)
	local panel = ui.Lesson
	Kit.Clear(panel)
	if not lesson then
		panel.Visible = false
		return
	end
	panel.Visible = true
	Kit.Label(
		panel,
		"TRAINING · " .. string.upper(lesson.Name),
		15,
		{ Font = Kit.Fonts.Black, TextColor3 = C.Accent, Size = UDim2.new(1, 0, 0, 20) }
	)
	local lock = LessonsClient.LockReason(lesson)
	if lock then
		Kit.Paragraph(panel, "🔒 " .. lock, 14, C.Warn)
		return
	end
	Kit.Paragraph(panel, ("Input: [%s]"):format(Input.Glyph(lesson.Input)), 14, C.Signal)
	for index, entry in lesson.Steps do
		local mark = if index < step then "✓" elseif index == step then "▶" else "·"
		local count = ""
		if index == step and entry.Count and entry.Count > 1 then
			count = (" (%d/%d)"):format(progress, entry.Count)
		end
		Kit.Paragraph(
			panel,
			("%s %s%s"):format(mark, entry.Text, count),
			14,
			if index < step then C.Good elseif index == step then C.Text else C.Faint
		)
	end
	if step > #lesson.Steps then
		Kit.Paragraph(panel, "✓ Lesson complete! Try the next station.", 14, C.Good)
	end
end

local function renderMode(kind: string?, data: any)
	local panel = ui.Mode
	Kit.Clear(panel)
	if kind == "Endless" and data then
		panel.Visible = true
		Kit.Label(panel, "THE DREAMLINE", 15, { Font = Kit.Fonts.Black, TextColor3 = rgb(255, 160, 240) })
		Kit.Label(panel, ("Gates cleared: %d"):format(data.Cleared or 0), 15)
		Kit.Label(panel, ("Lives: %s"):format(string.rep("♥ ", data.Lives or 0)), 15, { TextColor3 = C.Bad })
		Kit.Label(panel, ("Difficulty %.1f"):format(data.Difficulty or 1), 13, { TextColor3 = C.Muted })
		local best = State.Profile and State.Profile.Endless and State.Profile.Endless.Best or 0
		Kit.Label(panel, ("Record: %d"):format(best), 13, { TextColor3 = C.Muted })
	elseif kind == "Race" and data and data.State == "Running" then
		panel.Visible = true
		Kit.Label(
			panel,
			"RACE · " .. tostring(data.CourseName),
			15,
			{ Font = Kit.Fonts.Black, TextColor3 = rgb(255, 120, 220) }
		)
		for _, member in data.Members or {} do
			local finished = nil
			for _, result in data.Results or {} do
				if result.UserId == member.UserId then
					finished = result
				end
			end
			local text = if finished
				then ("%d. %s  %s"):format(finished.Place, member.Name, Format.Time(finished.Seconds))
				else ("—  %s  CP %d"):format(member.Name, raceProgress[member.UserId] or 0)
			Kit.Label(panel, text, 14)
		end
	elseif kind == "Relay" and data and data.State == "Running" then
		panel.Visible = true
		Kit.Label(
			panel,
			"RELAY · " .. tostring(data.CourseName),
			15,
			{ Font = Kit.Fonts.Black, TextColor3 = rgb(255, 120, 220) }
		)
		for _, leg in data.Legs or {} do
			local mark = if leg.Index < data.Leg then "✓" elseif leg.Index == data.Leg then "▶" else "·"
			Kit.Label(
				panel,
				("%s Leg %d: %s%s"):format(
					mark,
					leg.Index,
					leg.Name,
					if leg.Time then "  " .. Format.Time(leg.Time) else ""
				),
				14
			)
		end
	else
		panel.Visible = false
	end
end

function Hud.Start()
	local gui = Root.Get("Hud")
	buildStamina(gui)
	buildProfile(gui)
	buildFlow(gui)
	buildObjectives(gui)
	buildRun(gui)
	buildHint(gui)
	buildLesson(gui)
	buildMode(gui)

	State.On("XP", updateProfile)
	State.On("Credits", updateProfile)
	State.On("Prestige", updateProfile)
	Bus.Objective:Connect(updateObjectives)
	State.On("Quests", updateObjectives)
	updateObjectives()
	Stamina.Denied:Connect(function()
		deniedUntil = os.clock() + 0.7
	end)
	Bus.Split:Connect(function(index: number, seconds: number, delta: number?)
		if Settings.Get("ShowSplits") == false then
			return
		end
		splitFlashUntil = os.clock() + 2.5
		if delta then
			ui.RunSplit.Text = ("CP %d  %s  (%s)"):format(index, Format.Time(seconds), Format.Delta(delta))
			ui.RunSplit.TextColor3 = if delta <= 0 then C.Good else C.Bad
		else
			ui.RunSplit.Text = ("CP %d  %s"):format(index, Format.Time(seconds))
			ui.RunSplit.TextColor3 = C.Text
		end
	end)
	Bus.Lesson:Connect(renderLesson)
	local currentMode: string? = nil
	local currentData: any = nil
	Bus.Mode:Connect(function(kind: string, data: any)
		if kind == "RaceProgress" then
			raceProgress[data.UserId] = data.Index
		elseif kind == "Endless" or kind == "Race" or kind == "Relay" then
			currentMode, currentData = kind, data
			if kind == "Race" and data and data.State ~= "Running" then
				table.clear(raceProgress)
			end
		elseif kind == "EndlessEnded" then
			currentMode, currentData = nil, nil
		end
		renderMode(currentMode, currentData)
	end)
	Bus.Timer:Connect(function(seconds: number?)
		timerEnds = if seconds then os.clock() + seconds else nil
	end)
	Bus.Carry:Connect(function(carrying: boolean, fragile: boolean)
		ui.Carry.Visible = carrying
		ui.Carry.Text = if fragile
			then "📦 Carrying a FRAGILE package: no stumbles or falls"
			else "📦 Carrying a package"
	end)
	Bus.PageChanged:Connect(function(page)
		gui.Enabled = page == nil
	end)

	local lastSlow = 0
	RunService.RenderStepped:Connect(function()
		updateStamina()
		updatePips()
		updateRun()
		updateFlow()
		updateWaypoint()
		if timerEnds then
			local left = timerEnds - os.clock()
			ui.Timer.Visible = true
			ui.Timer.Text = ("⏱ %s"):format(Format.Time(math.max(left, 0)))
			ui.Timer.TextColor3 = if left < 10 then C.Bad else C.Text
			if left < -2 then
				timerEnds = nil
			end
		else
			ui.Timer.Visible = false
		end
		if os.clock() - lastSlow > 0.2 then
			lastSlow = os.clock()
			updateHint()
		end
	end)
	updateProfile()
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="121">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[-- The interface toolkit: theme colours, text that follows the Text Size
-- setting, and small components (panels, buttons, bars, toggles, sliders,
-- choices, scrolling lists) shared by the HUD and every menu page.
--
-- Everything is built in code, so the place needs no uploaded images, and
-- every state that colour shows (locked, ready, warning...) is also shown
-- with text or a symbol.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Settings = require(script.Parent.Parent.Core.Settings)

local Kit = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

Kit.Colors = {
	Background = rgb(12, 14, 20),
	Panel = rgb(20, 24, 33),
	PanelLight = rgb(32, 37, 50),
	Line = rgb(70, 78, 98),
	Text = rgb(240, 242, 248),
	Muted = rgb(160, 168, 186),
	Faint = rgb(110, 118, 136),
	Accent = rgb(255, 196, 92),
	Signal = rgb(80, 200, 255),
	Good = rgb(110, 230, 140),
	Bad = rgb(255, 110, 100),
	Warn = rgb(255, 176, 60),
	Prestige = rgb(255, 120, 110),
	Medal = {
		rgb(205, 127, 70),
		rgb(200, 210, 220),
		rgb(255, 200, 60),
		rgb(150, 235, 255),
	},
}
Kit.Fonts = {
	Body = Enum.Font.Gotham,
	Medium = Enum.Font.GothamMedium,
	Bold = Enum.Font.GothamBold,
	Black = Enum.Font.GothamBlack,
	Mono = Enum.Font.RobotoMono,
}

-- Text scaling -------------------------------------------------------------------------------------

local scaled: { [Instance]: number } = setmetatable({}, { __mode = "k" }) :: any

local function textScale(): number
	return Settings.Get("TextScale") or 1
end

function Kit.TextSize(object: TextLabel | TextButton | TextBox, size: number)
	scaled[object] = size
	local target: any = object
	target.TextSize = math.floor(size * textScale() + 0.5)
end

Settings.Changed:Connect(function(id)
	if id == "TextScale" then
		for object, size in scaled do
			if object.Parent then
				(object :: any).TextSize = math.floor(size * textScale() + 0.5)
			end
		end
	end
end)

-- Construction ----------------------------------------------------------------------------------------

function Kit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	for key, value in (props or {}) :: { [string]: any } do
		if key == "Parent" then
			parent = value
		else
			(instance :: any)[key] = value
		end
	end
	for _, child in (children or {}) :: { Instance } do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Kit.Corner(parent: Instance, radius: number?): UICorner
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, radius or 10), Parent = parent })
end

function Kit.Stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	return Kit.new("UIStroke", {
		Color = color or Kit.Colors.Line,
		Thickness = thickness or 1,
		Transparency = transparency or 0.4,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Kit.Padding(parent: Instance, all: number, horizontal: number?): UIPadding
	local h = horizontal or all
	return Kit.new("UIPadding", {
		PaddingTop = UDim.new(0, all),
		PaddingBottom = UDim.new(0, all),
		PaddingLeft = UDim.new(0, h),
		PaddingRight = UDim.new(0, h),
		Parent = parent,
	})
end

function Kit.List(
	parent: Instance,
	horizontal: boolean?,
	spacing: number?,
	align: Enum.HorizontalAlignment?
): UIListLayout
	return Kit.new("UIListLayout", {
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		Padding = UDim.new(0, spacing or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = if horizontal then Enum.VerticalAlignment.Center else Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

function Kit.Panel(parent: Instance?, props: { [string]: any }?): Frame
	local frame = Kit.new("Frame", {
		BackgroundColor3 = Kit.Colors.Panel,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
	})
	for key, value in (props or {}) :: { [string]: any } do
		(frame :: any)[key] = value
	end
	Kit.Corner(frame, 12)
	Kit.Stroke(frame, Kit.Colors.Line, 1, 0.55)
	if parent then
		frame.Parent = parent
	end
	return frame
end

function Kit.Label(parent: Instance?, text: string, size: number?, props: { [string]: any }?): TextLabel
	local label = Kit.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = Kit.Colors.Text,
		Font = Kit.Fonts.Medium,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true,
		RichText = true,
		Size = UDim2.new(1, 0, 0, math.floor((size or 16) * 1.5)),
		AutomaticSize = Enum.AutomaticSize.None,
	})
	for key, value in (props or {}) :: { [string]: any } do
		(label :: any)[key] = value
	end
	Kit.TextSize(label, size or 16)
	if parent then
		label.Parent = parent
	end
	return label
end

-- A paragraph that grows to fit its text.
function Kit.Paragraph(parent: Instance?, text: string, size: number?, color: Color3?): TextLabel
	return Kit.Label(parent, text, size or 15, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextColor3 = color or Kit.Colors.Muted,
		Font = Kit.Fonts.Body,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
end

local clickSound: Sound? = nil
local function click()
	local sound = clickSound
	if not sound then
		local s = Instance.new("Sound")
		s.SoundId = "rbxasset://sounds/electronicpingshort.wav"
		s.Volume = 0.15
		s.PlaybackSpeed = 2.2
		s.Parent = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui") or workspace
		clickSound = s
		sound = s
	end
	if sound then
		sound.TimePosition = 0
		sound:Play()
	end
end

export type ButtonStyle = "Primary" | "Secondary" | "Ghost" | "Danger"

function Kit.Button(
	parent: Instance?,
	text: string,
	onClick: (() -> ())?,
	style: ButtonStyle?,
	props: { [string]: any }?
): TextButton
	local kind = style or "Secondary"
	local base = if kind == "Primary"
		then Kit.Colors.Accent
		elseif kind == "Danger" then Kit.Colors.Bad
		elseif kind == "Ghost" then Kit.Colors.Panel
		else Kit.Colors.PanelLight
	local textColor = if kind == "Primary" then rgb(30, 22, 10) else Kit.Colors.Text
	local button = Kit.new("TextButton", {
		BackgroundColor3 = base,
		BackgroundTransparency = if kind == "Ghost" then 0.6 else 0,
		AutoButtonColor = false,
		Text = text,
		TextColor3 = textColor,
		Font = Kit.Fonts.Bold,
		Size = UDim2.new(0, 160, 0, 40),
		BorderSizePixel = 0,
		Selectable = true,
	})
	for key, value in (props or {}) :: { [string]: any } do
		(button :: any)[key] = value
	end
	Kit.TextSize(button, 16)
	Kit.Corner(button, 8)
	local stroke = Kit.Stroke(button, Kit.Colors.Text, 1.5, 1)
	local function hover(on: boolean)
		TweenService:Create(
			button,
			TweenInfo.new(0.12),
			{ BackgroundColor3 = if on then base:Lerp(Color3.new(1, 1, 1), 0.15) else base }
		):Play()
		stroke.Transparency = if on then 0.2 else 1
	end
	button.MouseEnter:Connect(function()
		hover(true)
	end)
	button.MouseLeave:Connect(function()
		hover(false)
	end)
	button.SelectionGained:Connect(function()
		hover(true)
	end)
	button.SelectionLost:Connect(function()
		hover(false)
	end)
	if onClick then
		button.Activated:Connect(function()
			click()
			onClick()
		end)
	end
	if parent then
		button.Parent = parent
	end
	return button
end

export type Bar = { Frame: Frame, Fill: Frame, Set: (number) -> (), Color: (Color3) -> () }

function Kit.Bar(parent: Instance?, color: Color3?, props: { [string]: any }?): Bar
	local frame = Kit.new("Frame", {
		BackgroundColor3 = rgb(40, 44, 56),
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 8),
		ClipsDescendants = true,
	})
	for key, value in (props or {}) :: { [string]: any } do
		(frame :: any)[key] = value
	end
	Kit.Corner(frame, 4)
	local fill = Kit.new("Frame", {
		BackgroundColor3 = color or Kit.Colors.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = frame,
	})
	Kit.Corner(fill, 4)
	if parent then
		frame.Parent = parent
	end
	return {
		Frame = frame,
		Fill = fill,
		Set = function(value: number)
			fill.Size = UDim2.fromScale(math.clamp(value, 0, 1), 1)
		end,
		Color = function(c: Color3)
			fill.BackgroundColor3 = c
		end,
	}
end

function Kit.Scroll(parent: Instance?, props: { [string]: any }?): ScrollingFrame
	local scroll = Kit.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Kit.Colors.Line,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Selectable = false,
	})
	for key, value in (props or {}) :: { [string]: any } do
		(scroll :: any)[key] = value
	end
	if parent then
		scroll.Parent = parent
	end
	return scroll
end

-- Remove everything except layout helpers.
function Kit.Clear(container: Instance)
	for _, child in container:GetChildren() do
		if
			not child:IsA("UIListLayout")
			and not child:IsA("UIGridLayout")
			and not child:IsA("UIPadding")
			and not child:IsA("UICorner")
			and not child:IsA("UIStroke")
		then
			child:Destroy()
		end
	end
end

-- A row: a horizontal strip of fixed height.
function Kit.Row(parent: Instance?, height: number?, spacing: number?): Frame
	local row = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height or 40),
	})
	Kit.List(row, true, spacing or 8)
	if parent then
		row.Parent = parent
	end
	return row
end

-- A card: a padded panel that grows with its content.
function Kit.Card(parent: Instance?, props: { [string]: any }?): Frame
	local card = Kit.Panel(nil, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Kit.Colors.PanelLight,
		BackgroundTransparency = 0.25,
	})
	for key, value in (props or {}) :: { [string]: any } do
		(card :: any)[key] = value
	end
	Kit.Padding(card, 12)
	Kit.List(card, false, 6)
	if parent then
		card.Parent = parent
	end
	return card
end

-- Controls ----------------------------------------------------------------------------------------------

function Kit.Toggle(parent: Instance?, value: boolean, onChange: (boolean) -> ()): TextButton
	local state = value
	local button = Kit.Button(nil, "", nil, "Secondary", { Size = UDim2.fromOffset(90, 34) })
	local function render()
		button.Text = if state then "ON" else "OFF"
		button.BackgroundColor3 = if state
			then Kit.Colors.Good:Lerp(Kit.Colors.PanelLight, 0.35)
			else Kit.Colors.PanelLight
	end
	button.Activated:Connect(function()
		state = not state
		render()
		onChange(state)
	end)
	render()
	if parent then
		button.Parent = parent
	end
	return button
end

function Kit.Choice(parent: Instance?, choices: { string }, value: string, onChange: (string) -> ()): TextButton
	local index = table.find(choices, value) or 1
	local button = Kit.Button(nil, "", nil, "Secondary", { Size = UDim2.fromOffset(150, 34) })
	local function render()
		button.Text = "‹  " .. choices[index] .. "  ›"
	end
	button.Activated:Connect(function()
		index = index % #choices + 1
		render()
		onChange(choices[index])
	end)
	button.MouseButton2Click:Connect(function()
		index = (index - 2) % #choices + 1
		render()
		onChange(choices[index])
	end)
	render()
	if parent then
		button.Parent = parent
	end
	return button
end

-- A slider with - and + buttons (works with mouse, touch and gamepad).
function Kit.Slider(
	parent: Instance?,
	min: number,
	max: number,
	step: number,
	value: number,
	onChange: (number) -> (),
	format: ((number) -> string)?
): Frame
	local current = value
	local frame = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(260, 34) })
	Kit.List(frame, true, 6)
	local minus = Kit.Button(frame, "−", nil, "Secondary", { Size = UDim2.fromOffset(34, 34), LayoutOrder = 1 })
	local track = Kit.new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = rgb(40, 44, 56),
		Size = UDim2.fromOffset(130, 10),
		LayoutOrder = 2,
		Parent = frame,
	})
	Kit.Corner(track, 5)
	local fill = Kit.new("Frame", { BackgroundColor3 = Kit.Colors.Signal, BorderSizePixel = 0, Parent = track })
	Kit.Corner(fill, 5)
	local plus = Kit.Button(frame, "+", nil, "Secondary", { Size = UDim2.fromOffset(34, 34), LayoutOrder = 3 })
	local label = Kit.Label(
		frame,
		"",
		14,
		{ Size = UDim2.fromOffset(46, 34), LayoutOrder = 4, TextXAlignment = Enum.TextXAlignment.Right }
	)
	local function render()
		local alpha = (current - min) / math.max(max - min, 1e-6)
		fill.Size = UDim2.fromScale(alpha, 1)
		label.Text = if format then format(current) else tostring(math.floor(current * 100 + 0.5) / 100)
	end
	local function set(v: number)
		v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
		if math.abs(v - current) > 1e-6 then
			current = v
			render()
			onChange(current)
		end
	end
	minus.Activated:Connect(function()
		set(current - step)
	end)
	plus.Activated:Connect(function()
		set(current + step)
	end)
	track.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			local alpha = (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
			set(min + (max - min) * math.clamp(alpha, 0, 1))
		end
	end)
	render()
	if parent then
		frame.Parent = parent
	end
	return frame
end

-- Formatting helpers -----------------------------------------------------------------------------------

function Kit.MedalText(medal: number): string
	local names = { "Bronze", "Silver", "Gold", "Platinum" }
	local glyphs = { "●", "◆", "★", "✦" }
	if medal <= 0 then
		return "No medal"
	end
	return glyphs[medal] .. " " .. names[medal]
end

function Kit.Rewards(rewards: { [string]: any }?): string
	if not rewards then
		return ""
	end
	local parts = {}
	if rewards.XP and rewards.XP > 0 then
		table.insert(parts, ("+%d XP"):format(rewards.XP))
	end
	if rewards.Credits and rewards.Credits > 0 then
		table.insert(parts, ("+%d ¢"):format(rewards.Credits))
	end
	if rewards.Prestige and rewards.Prestige > 0 then
		table.insert(parts, ("+%d ✪"):format(rewards.Prestige))
	end
	if rewards.Items and #rewards.Items > 0 then
		table.insert(parts, ("+%d item%s"):format(#rewards.Items, if #rewards.Items == 1 then "" else "s"))
	end
	return table.concat(parts, "   ")
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="122">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[-- The full-screen menu: a navigation rail and one page at a time. Pages are
-- modules in UI/Pages; each builds its content into a container and is
-- rebuilt when the profile data it shows changes.

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Bus = require(script.Parent.Parent.Core.Bus)
local Input = require(script.Parent.Parent.Core.Input)
local State = require(script.Parent.Parent.Core.State)
local Controller = require(script.Parent.Parent.Movement.Controller)
local CameraController = require(script.Parent.Parent.Camera.CameraController)
local Sfx = require(script.Parent.Parent.Audio.Sfx)
local Kit = require(script.Parent.Kit)
local Root = require(script.Parent.Root)

local C = Kit.Colors
local Menu = {}

export type Page = {
	Id: string,
	Title: string,
	Icon: string,
	Order: number,
	Hidden: boolean?,
	Sections: { string }?, -- profile sections that trigger a rebuild
	Build: (container: Frame, args: any) -> (),
}

local pages: { [string]: Page } = {}
local ordered: { Page } = {}
local current: string? = nil
local currentArgs: any = nil
local lastPage = "Map"

local gui: ScreenGui
local shade: Frame
local rail: ScrollingFrame
local content: Frame
local title: TextLabel
local navButtons: { [string]: TextButton } = {}
local rebuildQueued = false

local function build()
	local page = current and pages[current]
	if not page then
		return
	end
	Kit.Clear(content)
	title.Text = page.Icon .. "  " .. page.Title
	for id, button in navButtons do
		button.BackgroundColor3 = if id == current then C.Accent:Lerp(C.PanelLight, 0.55) else C.PanelLight
	end
	local ok, err = pcall(page.Build, content, currentArgs)
	if not ok then
		Kit.Paragraph(content, "Something went wrong drawing this page: " .. tostring(err), 14, C.Bad)
		warn("[Menu] " .. page.Id .. ": " .. tostring(err))
	end
end

function Menu.Open(id: string, args: any?)
	local page = pages[id]
	if not page then
		return
	end
	local wasOpen = current ~= nil
	current = id
	currentArgs = args
	if not page.Hidden then
		lastPage = id
	end
	shade.Visible = true
	CameraController.MenuOpen = true
	Controller.SetLock("Menu", true)
	build()
	if not wasOpen then
		Sfx.Stinger("Open")
	end
	Bus.PageChanged:Fire(id)
	if Input.Device == "Gamepad" then
		task.defer(function()
			GuiService.SelectedObject = navButtons[id]
		end)
	end
end

function Menu.Close()
	if not current then
		return
	end
	current = nil
	shade.Visible = false
	Kit.Clear(content)
	CameraController.MenuOpen = false
	Controller.SetLock("Menu", false)
	GuiService.SelectedObject = nil
	Sfx.Stinger("Close")
	Bus.PageChanged:Fire(nil)
end

function Menu.Refresh()
	if current and not rebuildQueued then
		rebuildQueued = true
		task.defer(function()
			rebuildQueued = false
			build()
		end)
	end
end

function Menu.Current(): string?
	return current
end

function Menu.Register(page: Page)
	pages[page.Id] = page
	if not page.Hidden then
		table.insert(ordered, page)
		table.sort(ordered, function(a, b)
			return a.Order < b.Order
		end)
	end
end

function Menu.Start()
	gui = Root.Get("Menu")
	shade = Kit.new("Frame", {
		Name = "Menu",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.12,
		Visible = false,
		Parent = gui,
	})
	-- Register every page module.
	for _, module in script.Parent.Pages:GetChildren() do
		if module:IsA("ModuleScript") then
			local ok, page = pcall(require, module)
			if ok and type(page) == "table" and page.Id then
				Menu.Register(page :: any)
			elseif ok and type(page) == "table" and type(page.Pages) == "table" then
				-- A module can define several related pages.
				for _, entry in page.Pages do
					Menu.Register(entry)
				end
			else
				warn("[Menu] Couldn't load page " .. module.Name .. ": " .. tostring(page))
			end
		end
	end

	local inset = GuiService:GetGuiInset().Y
	rail = Kit.Scroll(shade, {
		Position = UDim2.fromOffset(16, inset + 16),
		Size = UDim2.new(0, 190, 1, -(inset + 32)),
	})
	Kit.List(rail, false, 6)
	for index, page in ordered do
		local button = Kit.Button(
			rail,
			page.Icon .. "  " .. page.Title,
			function()
				Menu.Open(page.Id, nil)
			end,
			"Secondary",
			{ Size = UDim2.new(1, -10, 0, 40), LayoutOrder = index, TextXAlignment = Enum.TextXAlignment.Left }
		)
		Kit.Padding(button, 0, 12)
		navButtons[page.Id] = button
	end
	local panel = Kit.Panel(shade, {
		Position = UDim2.fromOffset(222, inset + 16),
		Size = UDim2.new(1, -238, 1, -(inset + 32)),
		BackgroundTransparency = 0.1,
	})
	Kit.Padding(panel, 18)
	title = Kit.Label(panel, "", 26, { Font = Kit.Fonts.Black, Size = UDim2.new(1, -50, 0, 34), TextColor3 = C.Accent })
	Kit.Button(
		panel,
		"✕",
		Menu.Close,
		"Ghost",
		{ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(38, 38) }
	)
	content = Kit.new("Frame", {
		Name = "Content",
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 1, -46),
		BackgroundTransparency = 1,
		Parent = panel,
	})

	-- Narrow screens: the rail becomes a top strip.
	local function adapt()
		local camera = workspace.CurrentCamera
		local width = if camera then camera.ViewportSize.X else 1200
		if width < 760 then
			rail.Size = UDim2.new(1, -32, 0, 48)
			rail.ScrollingDirection = Enum.ScrollingDirection.X
			rail.AutomaticCanvasSize = Enum.AutomaticSize.X
			local layout = rail:FindFirstChildOfClass("UIListLayout")
			if layout then
				layout.FillDirection = Enum.FillDirection.Horizontal
			end
			for _, button in navButtons do
				button.Size = UDim2.fromOffset(150, 40)
			end
			panel.Position = UDim2.fromOffset(16, inset + 72)
			panel.Size = UDim2.new(1, -32, 1, -(inset + 88))
		end
	end
	adapt()

	Bus.OpenPage:Connect(function(id: string, args: any)
		Menu.Open(id, args)
	end)
	Bus.ClosePages:Connect(Menu.Close)
	Input.Pressed:Connect(function(action: string)
		if action == "Menu" then
			if current then
				Menu.Close()
			else
				Menu.Open(lastPage, nil)
			end
		elseif action == "Map" then
			if current == "Map" then
				Menu.Close()
			else
				Menu.Open("Map", nil)
			end
		elseif action == "Journal" then
			if current == "Journal" then
				Menu.Close()
			else
				Menu.Open("Journal", nil)
			end
		end
	end)
	UserInputService.InputBegan:Connect(function(input)
		if current and input.KeyCode == Enum.KeyCode.ButtonB then
			Menu.Close()
		end
	end)
	-- Lobby changes redraw the race board while it's open.
	Bus.Mode:Connect(function(kind: string)
		if current == "Races" and (kind == "Race" or kind == "Relay") then
			Menu.Refresh()
		end
	end)
	State.Changed:Connect(function(section: string)
		local page = current and pages[current]
		if page and page.Sections and table.find(page.Sections, section) then
			Menu.Refresh()
		end
	end)
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">Overlay</string>
              <string name="Source"><![CDATA[-- Everything that appears over the game: notification toasts, banners, the
-- start countdown, level-up and unlock cards, the course preview, the results
-- screen, NPC dialogue, confirmations, and the panels that close out Spire
-- floors, relays, races and Dreamline runs.

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Abilities = require(ReplicatedStorage.Shared.Config.Abilities)
local Courses = require(ReplicatedStorage.Shared.Config.Courses)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Medals = require(ReplicatedStorage.Shared.Logic.Medals)
local MoveStats = require(ReplicatedStorage.Shared.Logic.MoveStats)
local Net = require(ReplicatedStorage.Shared.Net)
local NPCs = require(ReplicatedStorage.Shared.Config.NPCs)
local Schedule = require(ReplicatedStorage.Shared.Logic.Schedule)

local Bus = require(script.Parent.Parent.Core.Bus)
local Input = require(script.Parent.Parent.Core.Input)
local State = require(script.Parent.Parent.Core.State)
local Controller = require(script.Parent.Parent.Movement.Controller)
local CameraController = require(script.Parent.Parent.Camera.CameraController)
local Sfx = require(script.Parent.Parent.Audio.Sfx)
local CourseClient = require(script.Parent.Parent.Gameplay.CourseClient)
local Modes = require(script.Parent.Parent.Gameplay.Modes)
local QuestClient = require(script.Parent.Parent.Gameplay.QuestClient)
local Kit = require(script.Parent.Kit)
local Root = require(script.Parent.Root)

local C = Kit.Colors
local Overlay = {}

local gui: ScreenGui
local toastStack: Frame
local banner: TextLabel
local bannerSub: TextLabel
local countdownLabel: TextLabel
local modal: Frame? = nil

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Modals ---------------------------------------------------------------------------------------------

function Overlay.CloseModal()
	if modal then
		modal:Destroy()
		modal = nil
	end
	CameraController.MenuOpen = false
	Controller.SetLock("Modal", false)
	GuiService.SelectedObject = nil
end

-- A centred modal card; returns its content frame.
local function openModal(width: number, title: string, subtitle: string?, color: Color3?): Frame
	Overlay.CloseModal()
	local shade = Kit.new("Frame", {
		Name = "Modal",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Parent = gui,
	})
	modal = shade
	local card = Kit.Panel(shade, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, width, 0.86, 0),
		BackgroundTransparency = 0.04,
	})
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = Vector2.new(width, 720)
	constraint.Parent = card
	Kit.Padding(card, 18)
	local header = Kit.Label(
		card,
		title,
		24,
		{ Font = Kit.Fonts.Black, TextColor3 = color or C.Accent, Size = UDim2.new(1, -40, 0, 30) }
	)
	header.TextTruncate = Enum.TextTruncate.AtEnd
	if subtitle then
		Kit.Label(
			card,
			subtitle,
			14,
			{ Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.Muted }
		)
	end
	local close = Kit.Button(
		card,
		"✕",
		Overlay.CloseModal,
		"Ghost",
		{ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(36, 36) }
	)
	close.Name = "Close"
	local body = Kit.Scroll(card, { Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 1, -58) })
	Kit.List(body, false, 10)
	Kit.Padding(body, 2, 4)
	CameraController.MenuOpen = true
	Controller.SetLock("Modal", true)
	if Input.Device == "Gamepad" then
		task.defer(function()
			GuiService.SelectedObject = close
		end)
	end
	return body
end

-- Toasts and banners -----------------------------------------------------------------------------------

local ICONS = {
	Reward = "✚",
	Quest = "✔",
	Objective = "◆",
	Achievement = "🏆",
	Mastery = "▲",
	Discovery = "◎",
	LevelUp = "★",
	Unlock = "✦",
	Warning = "!",
	Lesson = "✔",
	Toast = "•",
	Item = "▣",
}

local function toast(payload: any)
	local color = payload.Color
		or (
			if payload.Kind == "Warning"
				then C.Bad
				elseif payload.Kind == "Quest" then C.Accent
				elseif payload.Kind == "Achievement" then rgb(210, 180, 255)
				else C.Signal
		)
	local card = Kit.Panel(toastStack, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0.15,
		LayoutOrder = -math.floor(os.clock() * 100),
	})
	Kit.Padding(card, 10, 12)
	Kit.List(card, false, 2)
	Kit.Label(card, ("%s  %s"):format(ICONS[payload.Kind] or "•", tostring(payload.Title or "")), 15, {
		Font = Kit.Fonts.Bold,
		TextColor3 = color,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	if payload.Text and payload.Text ~= "" then
		Kit.Paragraph(card, tostring(payload.Text), 13, C.Muted)
	end
	local rewards = Kit.Rewards(payload)
	if rewards ~= "" then
		Kit.Label(card, rewards, 13, { TextColor3 = C.Accent, Font = Kit.Fonts.Bold, Size = UDim2.new(1, 0, 0, 18) })
	end
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
		stroke.Transparency = 0.2
	end
	task.delay(if payload.Kind == "Warning" then 3.5 else 5, function()
		if card.Parent then
			TweenService:Create(card, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			task.wait(0.3)
			card:Destroy()
		end
	end)
	-- Keep the stack short.
	local cards = {}
	for _, child in toastStack:GetChildren() do
		if child:IsA("Frame") then
			table.insert(cards, child)
		end
	end
	if #cards > 5 then
		table.sort(cards, function(a, b)
			return a.LayoutOrder > b.LayoutOrder
		end)
		cards[1]:Destroy()
	end
end

local bannerToken = 0
function Overlay.Banner(title: string, subtitle: string?, color: Color3?)
	bannerToken += 1
	local token = bannerToken
	banner.Text = title
	banner.TextColor3 = color or C.Text
	bannerSub.Text = subtitle or ""
	banner.TextTransparency = 0
	bannerSub.TextTransparency = 0
	banner.Visible = true
	bannerSub.Visible = true
	task.delay(2.8, function()
		if token == bannerToken then
			TweenService:Create(banner, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			TweenService:Create(bannerSub, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		end
	end)
end

local function onNotify(payload: any)
	if type(payload) ~= "table" then
		return
	end
	local kind = payload.Kind
	if kind == "District" then
		Overlay.Banner(string.upper(tostring(payload.Title)), payload.Text, C.Accent)
		Sfx.Stinger("Discover")
		return
	elseif kind == "LevelUp" or kind == "Rank" or kind == "Ability" then
		Overlay.Banner(tostring(payload.Title), payload.Text, C.Accent)
		Sfx.Stinger("LevelUp")
	end
	local sound = payload.Sound
	if sound == "Quest" then
		Sfx.Stinger("Quest")
	elseif sound == "Achievement" or sound == "Mastery" or sound == "Unlock" then
		Sfx.Stinger("Unlock")
	elseif sound == "Discovery" then
		Sfx.Stinger("Discover")
	elseif sound == "Medal" then
		Sfx.Stinger("Medal")
	elseif kind == "Warning" then
		Sfx.Stinger("Error")
	end
	toast(payload)
end

-- Countdown ----------------------------------------------------------------------------------------------

local countdownAt: number? = nil
local lastShown = ""

local function updateCountdown()
	local at = countdownAt
	if not at then
		countdownLabel.Visible = false
		return
	end
	local left = at - Schedule.Now()
	local text
	if left > 0 then
		text = tostring(math.ceil(left))
	elseif left > -0.8 then
		text = "GO!"
	else
		countdownAt = nil
		countdownLabel.Visible = false
		return
	end
	countdownLabel.Visible = true
	if text ~= lastShown then
		lastShown = text
		countdownLabel.Text = text
		countdownLabel.TextColor3 = if text == "GO!" then C.Good else C.Text
		countdownLabel.TextSize = 120
		TweenService:Create(countdownLabel, TweenInfo.new(0.25, Enum.EasingStyle.Back), { TextSize = 96 }):Play()
		Sfx.Stinger(if text == "GO!" then "Go" else "Countdown")
	end
end

-- Course preview -------------------------------------------------------------------------------------------

local function medalRow(parent: Instance, medals: { number }, record: any?)
	local row = Kit.Row(parent, 34, 8)
	for index, seconds in medals do
		local earned = record and (record.Medal or 0) >= index
		local chip = Kit.Label(row, ("%s %s"):format(Kit.MedalText(index), Format.Time(seconds)), 14, {
			Size = UDim2.fromOffset(132, 30),
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundTransparency = if earned then 0.2 else 0.75,
			BackgroundColor3 = C.Medal[index],
			TextColor3 = if earned then rgb(20, 20, 24) else C.Medal[index],
			Font = Kit.Fonts.Bold,
			LayoutOrder = index,
		})
		Kit.Corner(chip, 6)
	end
end

local function abilityNames(list: { string }): string
	local names = {}
	for _, id in list do
		local ability = Abilities.ById[id]
		table.insert(names, if ability then ability.Name else id)
	end
	return table.concat(names, ", ")
end

function Overlay.CoursePreview(courseId: string)
	local config = CourseClient.Config(courseId)
	if not config then
		return
	end
	local course = Courses.ById[courseId]
	local name = config:GetAttribute("Name") or courseId
	local difficulty = config:GetAttribute("Difficulty") or 1
	local kind = config:GetAttribute("Kind") or "Course"
	local body = openModal(
		560,
		name,
		("%s · %s · %s"):format(
			tostring(config:GetAttribute("District")),
			if kind == "Room" then "Challenge Room" elseif kind == "Relay" then "Relay" else "Course",
			Courses.DifficultyNames[difficulty] or ("Difficulty " .. difficulty)
		)
	)
	if course then
		Kit.Paragraph(body, course.Blurb, 15, C.Text)
		Kit.Paragraph(body, "Focus: " .. table.concat(course.Focus, " · "), 13, C.Muted)
	end
	local medals = CourseClient.Medals(config)
	local record = State.Profile and State.Profile.Courses and State.Profile.Courses[courseId]
	medalRow(body, medals, record)
	if record and (record.Completions or 0) > 0 then
		local tokens = 0
		for _ in record.Tokens or {} do
			tokens += 1
		end
		local distinctions = {}
		for _, def in Courses.Distinctions do
			table.insert(
				distinctions,
				(if record.Distinctions and record.Distinctions[def.Id] then "✓ " else "· ") .. def.Name
			)
		end
		Kit.Paragraph(
			body,
			("Best %s · Ranked %s · %d runs · ★ %d/%d tokens"):format(
				Format.Time(record.Best),
				Format.Time(record.RankedBest),
				record.Completions or 0,
				tokens,
				config:GetAttribute("Tokens") or 0
			),
			14,
			C.Text
		)
		Kit.Paragraph(body, table.concat(distinctions, "   "), 13, C.Muted)
	else
		Kit.Paragraph(body, "Not finished yet. Accessible route first, then hunt for the faster lines.", 14, C.Muted)
	end

	local status = Kit.Paragraph(body, "Loading records…", 13, C.Faint)
	local boards = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = body,
	})
	Kit.List(boards, false, 4)

	-- Mode selection.
	local modes = { "Casual", "Practice", "Ranked" }
	local mode = "Casual"
	local assists: { [string]: boolean } = {}
	local modeRow = Kit.Row(body, 40, 8)
	local modeText = Kit.Paragraph(body, "", 13, C.Muted)
	local assistBox = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = body,
	})
	Kit.List(assistBox, false, 4)
	for _, assist in MoveStats.Assists do
		local row = Kit.Row(assistBox, 36, 8)
		Kit.Toggle(row, false, function(on)
			assists[assist.Id] = on or nil
		end)
		Kit.Label(
			row,
			("%s: %s"):format(assist.Name, assist.Text),
			13,
			{ Size = UDim2.new(1, -100, 1, 0), TextColor3 = C.Muted }
		)
	end
	local modeButtons: { [string]: TextButton } = {}
	local function selectMode(m: string)
		mode = m
		for key, button in modeButtons do
			button.BackgroundColor3 = if key == m then C.Signal:Lerp(C.PanelLight, 0.4) else C.PanelLight
			button.Text = (if key == m then "● " else "") .. key
		end
		modeText.Text = if m == "Casual"
			then "Your own movement and upgrades. Medals, rewards and personal bests."
			elseif m == "Practice" then ("Assists allowed, [%s] sets a practice checkpoint. No medals."):format(
				Input.Glyph("Mark")
			)
			else "Standard attributes and the course's full kit for everyone. Leaderboards and ghosts."
		assistBox.Visible = m == "Practice"
	end
	for _, m in modes do
		modeButtons[m] = Kit.Button(modeRow, m, function()
			selectMode(m)
		end, "Secondary", { Size = UDim2.fromOffset(140, 36) })
	end
	selectMode("Casual")

	local actions = Kit.Row(body, 48, 10)
	local message = Kit.Paragraph(body, "", 14, C.Bad)
	local startButton = Kit.Button(actions, "▶  Start run", function()
		message.Text = "Starting…"
		message.TextColor3 = C.Muted
		task.spawn(function()
			local ok, reason = CourseClient.Begin(courseId, mode, assists)
			if ok then
				Overlay.CloseModal()
			else
				message.Text = reason or "Couldn't start"
				message.TextColor3 = C.Bad
				Sfx.Stinger("Error")
			end
		end)
	end, "Primary", { Size = UDim2.fromOffset(170, 44) })
	if kind == "Course" then
		Kit.Button(actions, "Open a race", function()
			task.spawn(function()
				local ok, info = Modes.CreateRace(courseId)
				if ok then
					Overlay.CloseModal()
					Bus.OpenPage:Fire("Races", nil)
				else
					message.Text = tostring(info)
				end
			end)
		end, "Secondary", { Size = UDim2.fromOffset(150, 44) })
	elseif kind == "Relay" then
		startButton.Visible = false
		Kit.Button(actions, "Form a relay team", function()
			task.spawn(function()
				local ok, info = Modes.CreateRelay(courseId)
				if ok then
					Overlay.CloseModal()
					Bus.OpenPage:Fire("Races", nil)
				else
					message.Text = tostring(info)
				end
			end)
		end, "Primary", { Size = UDim2.fromOffset(200, 44) })
	end
	if Input.Device == "Gamepad" then
		GuiService.SelectedObject = startButton
	end

	task.spawn(function()
		local ok, preview = pcall(Net.Invoke, "Course.Preview", courseId)
		if not ok or type(preview) ~= "table" or not body.Parent then
			status.Text = "Records unavailable right now."
			return
		end
		status.Text = if preview.Online == false then "Records are kept for this session only (offline mode)." else ""
		if preview.Locked then
			message.Text = "🔒 " .. preview.Locked
			startButton.Visible = false
		end
		if preview.MissingFast and #preview.MissingFast > 0 then
			Kit.Paragraph(
				boards,
				"Fast route needs: " .. abilityNames(preview.MissingFast) .. " (Ranked lends the full kit)",
				13,
				C.Warn
			)
		end
		if preview.MissingExpert and #preview.MissingExpert > 0 then
			Kit.Paragraph(boards, "Expert route needs: " .. abilityNames(preview.MissingExpert), 13, C.Warn)
		end
		local function board(title: string, entries: any)
			if type(entries) ~= "table" or #entries == 0 then
				return
			end
			Kit.Label(boards, title, 14, { Font = Kit.Fonts.Bold, TextColor3 = C.Signal })
			for _, entry in entries do
				Kit.Label(boards, ("%d.  %s   %s"):format(entry.Rank, entry.Name, Format.Time(entry.Seconds)), 14)
			end
		end
		board("Fastest ranked runs", preview.Top)
		board("Friends", preview.Friends)
	end)
end

-- Results -------------------------------------------------------------------------------------------------

function Overlay.Results(result: any, run: any)
	local medal = result.Medal or 0
	local title = if result.Partial then "Leg complete" elseif medal > 0 then Kit.MedalText(medal) else "Finished"
	local color = if medal > 0 then C.Medal[medal] else C.Text
	local body = openModal(
		560,
		title,
		("%s · %s"):format(tostring(result.Name or result.CourseId), tostring(result.Mode)),
		color
	)
	Kit.Label(
		body,
		Format.Time(result.Seconds),
		48,
		{ Font = Kit.Fonts.Mono, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 60) }
	)
	if result.PreviousBest then
		local delta = result.Seconds - result.PreviousBest
		Kit.Label(body, (if result.NewBest then "NEW PERSONAL BEST  " else "Best ") .. Format.Delta(delta), 16, {
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = if delta < 0 then C.Good else C.Muted,
			Font = Kit.Fonts.Bold,
		})
	elseif result.FirstCompletion then
		Kit.Label(
			body,
			"FIRST COMPLETION",
			16,
			{ TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.Accent, Font = Kit.Fonts.Black }
		)
	end
	if result.Medals and not result.Partial and result.Mode ~= "Practice" then
		medalRow(body, result.Medals, { Medal = medal })
		local nextMedal, limit = Medals.Next(result.Seconds, result.Medals)
		if nextMedal and limit then
			Kit.Paragraph(
				body,
				("Next: %s at %s — %s faster."):format(
					Kit.MedalText(nextMedal),
					Format.Time(limit),
					Format.Time(result.Seconds - limit)
				),
				14,
				C.Text
			)
		end
	end
	-- Distinctions.
	if not result.Partial and result.Mode ~= "Practice" then
		local list = {}
		for _, def in Courses.Distinctions do
			local earned = result.Distinctions and result.Distinctions[def.Id]
			local fresh = table.find(result.NewDistinctions or {}, def.Id) ~= nil
			table.insert(
				list,
				("%s %s%s"):format(if earned then "✓" else "✗", def.Name, if fresh then " (new!)" else "")
			)
		end
		Kit.Paragraph(body, table.concat(list, "    "), 14, C.Text)
		Kit.Paragraph(
			body,
			("Tokens ★ %d/%d · Falls %d · Retries %d · Flow %d / %d"):format(
				result.Tokens or 0,
				result.TokenTotal or 0,
				result.Falls or 0,
				result.Retries or 0,
				result.Flow or 0,
				result.FlowTarget or 0
			),
			13,
			C.Muted
		)
	end
	-- Splits.
	if result.Splits and #result.Splits > 0 then
		local parts = {}
		for index, split in result.Splits do
			table.insert(parts, ("CP%d %s"):format(index, Format.Time(split)))
		end
		Kit.Paragraph(body, table.concat(parts, "   "), 13, C.Muted)
	end
	-- Rewards.
	for _, line in result.Lines or {} do
		Kit.Label(body, ("%s   %s"):format(line.Label, Kit.Rewards(line)), 14, { TextColor3 = C.Accent })
	end
	if result.Verified == false then
		Kit.Paragraph(body, "This run had connection hiccups, so it wasn't submitted to the leaderboard.", 13, C.Warn)
	end
	local actions = Kit.Row(body, 48, 10)
	local courseId = result.CourseId
	local mode = result.Mode
	if run and run.Context == nil and mode ~= "Tower" then
		local retry = Kit.Button(actions, "↻ Run again", function()
			Overlay.CloseModal()
			task.spawn(CourseClient.Begin, courseId, mode, CourseClient.Assists)
		end, "Primary", { Size = UDim2.fromOffset(150, 44) })
		if Input.Device == "Gamepad" then
			GuiService.SelectedObject = retry
		end
		if mode ~= "Ranked" then
			Kit.Button(actions, "Try ranked", function()
				Overlay.CloseModal()
				task.spawn(CourseClient.Begin, courseId, "Ranked")
			end, "Secondary", { Size = UDim2.fromOffset(130, 44) })
		end
	end
	Kit.Button(actions, "Continue", Overlay.CloseModal, "Secondary", { Size = UDim2.fromOffset(130, 44) })
end

-- Dialogue ---------------------------------------------------------------------------------------------------

function Overlay.Dialogue(npcId: string, response: any)
	local npc = NPCs.ById[npcId]
	local body = openModal(560, if npc then npc.Name else npcId, if npc then npc.Role else nil)
	local lines = response.Lines or {}
	local index = 1
	local text = Kit.Paragraph(body, "", 17, C.Text)
	local continue = Kit.Button(body, "Next ›", nil, "Secondary", { Size = UDim2.fromOffset(120, 38) })
	local after = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = body,
	})
	Kit.List(after, false, 10)

	local function showAfter()
		continue.Visible = false
		after.Visible = true
		for _, done in response.Completed or {} do
			Kit.Paragraph(after, ("✔ %s complete   %s"):format(done.Name, Kit.Rewards(done.Rewards)), 15, C.Good)
		end
		for _, offer in response.Offers or {} do
			local card = Kit.Card(after)
			local tag = if offer.Type == "Main"
				then "STORY"
				elseif offer.Type == "Expert" then "EXPERT TRIAL"
				else "SIDE QUEST"
			Kit.Label(
				card,
				tag .. " · " .. offer.Name,
				16,
				{ Font = Kit.Fonts.Bold, TextColor3 = if offer.Type == "Main" then C.Accent else C.Signal }
			)
			for _, line in offer.Intro or {} do
				Kit.Paragraph(card, "“" .. line .. "”", 14, C.Text)
			end
			Kit.Label(card, "What it takes", 13, { Font = Kit.Fonts.Bold, TextColor3 = C.Muted })
			for i, step in offer.Steps or {} do
				Kit.Paragraph(card, ("%d. %s"):format(i, step), 13, C.Muted)
			end
			Kit.Label(card, "Rewards: " .. Kit.Rewards(offer.Rewards), 13, { TextColor3 = C.Accent })
			local row = Kit.Row(card, 40, 8)
			local note = Kit.Paragraph(card, "", 13, C.Bad)
			Kit.Button(row, "Accept", function()
				task.spawn(function()
					local ok, reason = QuestClient.Accept(offer.Id)
					if ok then
						card:Destroy()
						Sfx.Stinger("Quest")
					else
						note.Text = reason or "Can't accept that right now"
					end
				end)
			end, "Primary", { Size = UDim2.fromOffset(120, 36) })
			Kit.Button(row, "Not now", function()
				card:Destroy()
			end, "Ghost", { Size = UDim2.fromOffset(110, 36) })
		end
		local service = response.Service
		if service then
			local pages = {
				Shop = "Shop",
				Races = "Races",
				Crew = "Crew",
				Tower = "Tower",
				Achievements = "Achievements",
				Mastery = "Mastery",
			}
			if service == "Endless" then
				Kit.Button(after, "Enter the Dreamline", function()
					Overlay.CloseModal()
					Modes.StartEndless()
				end, "Primary", { Size = UDim2.fromOffset(220, 40) })
			elseif pages[service] then
				Kit.Button(after, "Open " .. service, function()
					Overlay.CloseModal()
					Bus.OpenPage:Fire(pages[service], nil)
				end, "Primary", { Size = UDim2.fromOffset(180, 40) })
			end
		end
		Kit.Button(after, "Goodbye", Overlay.CloseModal, "Secondary", { Size = UDim2.fromOffset(140, 38) })
	end
	local function show()
		if index <= #lines then
			text.Text = "“" .. lines[index] .. "”"
		end
		if index >= #lines then
			showAfter()
		end
	end
	continue.Activated:Connect(function()
		index += 1
		show()
	end)
	show()
	-- Face the speaker.
	local folder = workspace:FindFirstChild("SkylineNPCs")
	local model = folder and folder:FindFirstChild(npcId)
	local root = Controller.Info.Root
	if model and model:IsA("Model") and root then
		local head = model:FindFirstChild("Head") :: BasePart?
		local target = if head then head.Position else model:GetPivot().Position
		-- Over the runner's shoulder, looking at the speaker.
		local offset = (root.Position - target) * Vector3.new(1, 0, 1)
		local away = if offset.Magnitude > 0.1 then offset.Unit else Vector3.zAxis
		local from = target + away * 9 + Vector3.new(0, 1.5, 0)
		CameraController.SetOverride(function()
			return CFrame.lookAt(from, target), 50
		end)
		local connection
		connection = RunService.Heartbeat:Connect(function()
			if modal == nil or not body.Parent then
				connection:Disconnect()
				CameraController.SetOverride(nil)
			end
		end)
	end
end

-- Confirmations and mode panels -------------------------------------------------------------------------

function Overlay.Confirm(title: string, text: string, options: { { Text: string, Callback: (() -> ())? } })
	local body = openModal(460, title)
	Kit.Paragraph(body, text, 15, C.Text)
	local row = Kit.Row(body, 46, 10)
	for index, option in options do
		Kit.Button(row, option.Text, function()
			Overlay.CloseModal()
			if option.Callback then
				option.Callback()
			end
		end, if index == 1 then "Primary" else "Secondary", { Size = UDim2.fromOffset(140, 42) })
	end
end

local function towerCleared(data: any)
	local body = openModal(
		480,
		("Floor %d cleared"):format(data.Floor),
		("Highest floor: %d / 25"):format(data.Highest or data.Floor),
		C.Signal
	)
	Kit.Label(
		body,
		Format.Time(data.Seconds),
		40,
		{ Font = Kit.Fonts.Mono, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 50) }
	)
	if data.PreviousBest then
		Kit.Label(
			body,
			"Best " .. Format.Time(data.Best) .. "  (" .. Format.Delta(data.Seconds - data.PreviousBest) .. ")",
			15,
			{ TextXAlignment = Enum.TextXAlignment.Center }
		)
	end
	Kit.Label(body, Kit.Rewards(data), 15, { TextColor3 = C.Accent, TextXAlignment = Enum.TextXAlignment.Center })
	local row = Kit.Row(body, 48, 10)
	if data.Next then
		Kit.Button(row, ("Floor %d ›"):format(data.Next), function()
			Overlay.CloseModal()
			task.spawn(Modes.TowerFloor, data.Next)
		end, "Primary", { Size = UDim2.fromOffset(140, 44) })
	elseif data.Roof then
		Kit.Button(row, "To the roof ›", function()
			Overlay.CloseModal()
			task.spawn(Modes.TowerFloor, 26)
		end, "Primary", { Size = UDim2.fromOffset(160, 44) })
	end
	Kit.Button(row, "Retry floor", function()
		Overlay.CloseModal()
		task.spawn(Modes.TowerFloor, data.Floor)
	end, "Secondary", { Size = UDim2.fromOffset(130, 44) })
	Kit.Button(row, "Leave", function()
		Overlay.CloseModal()
		Modes.LeaveTower()
	end, "Ghost", { Size = UDim2.fromOffset(100, 44) })
end

local function relayResults(data: any)
	local medal = data.Medal or 0
	local body = openModal(
		500,
		if medal > 0 then "Relay · " .. Kit.MedalText(medal) else "Relay complete",
		("Team of %d"):format(data.TeamSize or 1),
		if medal > 0 then C.Medal[medal] else C.Text
	)
	Kit.Label(
		body,
		Format.Time(data.Total),
		40,
		{ Font = Kit.Fonts.Mono, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 50) }
	)
	for _, leg in data.Legs or {} do
		Kit.Label(body, ("Leg %d · %s · %s"):format(leg.Index, leg.Name, Format.Time(leg.Time)), 15)
	end
	Kit.Label(body, Kit.Rewards(data), 15, { TextColor3 = C.Accent })
	Kit.Button(body, "Continue", Overlay.CloseModal, "Primary", { Size = UDim2.fromOffset(140, 42) })
end

local function endlessEnded(data: any)
	if type(data) ~= "table" then
		return
	end
	local body = openModal(
		460,
		if data.Record then "New Dreamline record!" else "Run over",
		tostring(data.Reason),
		rgb(255, 160, 240)
	)
	Kit.Label(
		body,
		("%d gates"):format(data.Cleared or 0),
		40,
		{ Font = Kit.Fonts.Black, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 50) }
	)
	Kit.Label(
		body,
		("Record %d · %s"):format(data.Best or 0, Format.Duration(data.Seconds or 0)),
		15,
		{ TextXAlignment = Enum.TextXAlignment.Center }
	)
	Kit.Label(body, Kit.Rewards(data), 15, { TextColor3 = C.Accent, TextXAlignment = Enum.TextXAlignment.Center })
	local row = Kit.Row(body, 48, 10)
	Kit.Button(row, "Run again", function()
		Overlay.CloseModal()
		Modes.StartEndless()
	end, "Primary", { Size = UDim2.fromOffset(140, 44) })
	Kit.Button(row, "Done", Overlay.CloseModal, "Secondary", { Size = UDim2.fromOffset(120, 44) })
end

function Overlay.IsOpen(): boolean
	return modal ~= nil
end

function Overlay.Start()
	gui = Root.Get("Overlay")
	toastStack = Kit.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -150),
		Size = UDim2.fromOffset(320, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local layout = Kit.List(toastStack, false, 6)
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	banner = Kit.Label(gui, "", 34, {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.2, 0),
		Size = UDim2.new(0.8, 0, 0, 44),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Kit.Fonts.Black,
		TextStrokeTransparency = 0.5,
		Visible = false,
	})
	bannerSub = Kit.Label(gui, "", 17, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.2, 46),
		Size = UDim2.new(0.8, 0, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
		TextStrokeTransparency = 0.6,
		Visible = false,
	})
	countdownLabel = Kit.Label(gui, "", 96, {
		Name = "Countdown",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(400, 140),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Kit.Fonts.Black,
		TextStrokeTransparency = 0.3,
		Visible = false,
	})

	Net.Listen("Notify", onNotify)
	Bus.Notify:Connect(onNotify)
	Bus.Banner:Connect(function(title, subtitle, color)
		Overlay.Banner(title, subtitle, color)
	end)
	Bus.Countdown:Connect(function(at: number)
		countdownAt = at
		lastShown = ""
	end)
	Bus.CoursePreview:Connect(Overlay.CoursePreview)
	Bus.CourseResults:Connect(Overlay.Results)
	Bus.Dialogue:Connect(Overlay.Dialogue)
	Bus.Confirm:Connect(Overlay.Confirm)
	Bus.Mode:Connect(function(kind: string, data: any)
		if kind == "TowerCleared" then
			towerCleared(data)
		elseif kind == "RelayResults" then
			relayResults(data)
		elseif kind == "EndlessEnded" then
			endlessEnded(data)
		elseif kind == "RaceReward" and type(data) == "table" then
			Overlay.Banner(
				("Place %d of %d"):format(data.Place, data.Field),
				Kit.Rewards(data),
				if data.Place == 1 then C.Accent else C.Text
			)
		elseif kind == "RelayHandoff" and type(data) == "table" then
			Overlay.Banner(("Leg %d!"):format(data.Leg), "The baton is passed", rgb(255, 120, 220))
		end
	end)
	Net.Listen("Social.Invite", function(data)
		if type(data) ~= "table" then
			return
		end
		Overlay.Confirm(
			"Invite",
			("%s invites you to %s."):format(
				tostring(data.Name),
				if data.Kind == "Race"
					then "a race"
					elseif data.Kind == "Relay" then "their relay team"
					else "run together"
			),
			{
				{
					Text = "Accept",
					Callback = function()
						task.spawn(function()
							local ok, success, info = pcall(Net.Invoke, "Social.Respond", data.From, true)
							if ok and success and type(info) == "table" and typeof(info.Teleport) == "CFrame" then
								Controller.Teleport(info.Teleport)
							elseif ok and not success then
								Overlay.Banner("Couldn't join", tostring(info))
							end
						end)
					end,
				},
				{
					Text = "Decline",
					Callback = function()
						task.spawn(pcall, Net.Invoke, "Social.Respond", data.From, false)
					end,
				},
			}
		)
	end)
	Net.Listen("Crew.Invite", function(data)
		if type(data) ~= "table" then
			return
		end
		Overlay.Confirm(
			"Crew invite",
			("%s invites you to join [%s] %s."):format(tostring(data.From), tostring(data.Tag), tostring(data.Name)),
			{
				{
					Text = "Join",
					Callback = function()
						task.spawn(function()
							local ok, success, info = pcall(Net.Invoke, "Crew.Respond", data.CrewId, true)
							if ok and not success then
								Overlay.Banner("Couldn't join", tostring(info))
							end
						end)
					end,
				},
				{
					Text = "No thanks",
					Callback = function()
						task.spawn(pcall, Net.Invoke, "Crew.Respond", data.CrewId, false)
					end,
				},
			}
		)
	end)
	RunService.RenderStepped:Connect(updateCountdown)
end

return Overlay
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="124">
            <Properties>
              <string name="Name">Pages</string>
            </Properties>
            <Item class="ModuleScript" referent="125">
              <Properties>
                <string name="Name">Journal</string>
                <string name="Source"><![CDATA[-- The quest journal: the story by chapter, side quests and expert trials,
-- daily objectives and weekly expeditions, your contract, and the lost
-- letters you've found. Every quest shows where it starts, what it asks and
-- what it pays before you take it on; active ones can be pinned to the HUD.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Util.Format)
local Lore = require(ReplicatedStorage.Shared.Config.Lore)
local Net = require(ReplicatedStorage.Shared.Net)
local NPCs = require(ReplicatedStorage.Shared.Config.NPCs)
local Quests = require(ReplicatedStorage.Shared.Config.Quests)

local State = require(script.Parent.Parent.Parent.Core.State)
local QuestClient = require(script.Parent.Parent.Parent.Gameplay.QuestClient)
local Kit = require(script.Parent.Parent.Kit)

local C = Kit.Colors
local tab = "Story"

local function questCard(parent: Instance, quest: Quests.Quest, profile: any)
	local active = profile.Quests.Active[quest.Id]
	local done = profile.Quests.Completed[quest.Id]
	local available = QuestClient.IsAvailable(quest)
	local card = Kit.Card(parent)
	local mark = if done then "✓" elseif active then "▶" elseif available then "!" else "🔒"
	local color = if done then C.Good elseif active then C.Accent elseif available then C.Signal else C.Faint
	Kit.Label(card, ("%s  %s"):format(mark, quest.Name), 17, { Font = Kit.Fonts.Bold, TextColor3 = color })
	Kit.Paragraph(card, quest.Summary, 14, C.Text)
	if active then
		for index, step in quest.Steps do
			local stepMark = if index < active.Step then "✓" elseif index == active.Step then "▶" else "·"
			Kit.Paragraph(
				card,
				("%s %s"):format(stepMark, step.Text),
				13,
				if index == active.Step then C.Text else C.Muted
			)
		end
		local row = Kit.Row(card, 38, 8)
		local pinned = table.find(profile.Quests.Pinned or {}, quest.Id) ~= nil
		Kit.Button(row, if pinned then "📌 Pinned" else "Pin", function()
			QuestClient.Pin(quest.Id, not pinned)
		end, if pinned then "Primary" else "Secondary", { Size = UDim2.fromOffset(120, 34) })
		if quest.Type ~= "Main" then
			Kit.Button(row, "Abandon", function()
				QuestClient.Abandon(quest.Id)
			end, "Ghost", { Size = UDim2.fromOffset(110, 34) })
		end
	elseif not done then
		local giver = NPCs.ById[quest.Giver]
		Kit.Paragraph(
			card,
			"Start: " .. quest.Start .. (if giver then (" (" .. giver.Name .. ")") else ""),
			13,
			C.Muted
		)
		local steps = {}
		for _, step in quest.Steps do
			table.insert(steps, step.Text)
		end
		Kit.Paragraph(card, "Asks: " .. table.concat(steps, " → "), 13, C.Muted)
		if quest.Type == "Expert" and available then
			local note = Kit.Paragraph(card, "", 13, C.Bad)
			Kit.Button(card, "Take on this trial", function()
				task.spawn(function()
					local ok, reason = QuestClient.Accept(quest.Id)
					if not ok then
						note.Text = reason or "Not available"
					end
				end)
			end, "Primary", { Size = UDim2.fromOffset(190, 34) })
		end
	end
	Kit.Label(card, "Rewards: " .. Kit.Rewards(quest.Rewards), 13, { TextColor3 = C.Accent })
end

local function story(parent: Instance, profile: any)
	local chapters: { [number]: { Quests.Quest } } = {}
	for _, quest in Quests.List do
		if quest.Type == "Main" and quest.Chapter then
			chapters[quest.Chapter] = chapters[quest.Chapter] or {}
			table.insert(chapters[quest.Chapter], quest)
		end
	end
	for chapter = 0, 7 do
		local list = chapters[chapter]
		if list then
			local total, done = #list, 0
			local anyVisible = false
			for _, quest in list do
				if profile.Quests.Completed[quest.Id] then
					done += 1
				end
				if
					profile.Quests.Completed[quest.Id]
					or profile.Quests.Active[quest.Id]
					or QuestClient.IsAvailable(quest)
				then
					anyVisible = true
				end
			end
			Kit.Label(
				parent,
				("%s  ·  %d/%d"):format(Quests.ChapterNames[chapter] or ("Chapter " .. chapter), done, total),
				18,
				{
					Font = Kit.Fonts.Black,
					TextColor3 = if done == total then C.Good elseif anyVisible then C.Accent else C.Faint,
				}
			)
			if anyVisible then
				for _, quest in list do
					if
						profile.Quests.Completed[quest.Id]
						or profile.Quests.Active[quest.Id]
						or QuestClient.IsAvailable(quest)
					then
						questCard(parent, quest, profile)
					end
				end
			else
				Kit.Paragraph(parent, "Continue the story to open this chapter.", 13, C.Faint)
			end
		end
	end
end

local function sideQuests(parent: Instance, profile: any)
	for _, kind in { "Side", "Expert" } do
		Kit.Label(
			parent,
			if kind == "Side" then "Side quests" else "Expert trials",
			18,
			{ Font = Kit.Fonts.Black, TextColor3 = C.Accent }
		)
		local shown = 0
		for _, quest in Quests.List do
			if
				quest.Type == kind
				and (
					profile.Quests.Completed[quest.Id]
					or profile.Quests.Active[quest.Id]
					or QuestClient.IsAvailable(quest)
				)
			then
				questCard(parent, quest, profile)
				shown += 1
			end
		end
		if shown == 0 then
			Kit.Paragraph(
				parent,
				if kind == "Side"
					then "Talk to the people of each district to find side work."
					else "Expert trials open once you've finished a district's chapter.",
				13,
				C.Faint
			)
		end
	end
end

local function rolling(parent: Instance)
	local status = Kit.Paragraph(parent, "Checking the board…", 13, C.Faint)
	task.spawn(function()
		local ok, data = pcall(Net.Invoke, "Quest.Claim")
		if not ok or type(data) ~= "table" or not parent.Parent then
			status.Text = "Objectives unavailable right now."
			return
		end
		status.Text = ""
		local function section(title: string, block: any, list: { any }, resetIn: number)
			Kit.Label(
				parent,
				("%s  ·  resets in %s"):format(title, Format.Duration(resetIn)),
				18,
				{ Font = Kit.Fonts.Black, TextColor3 = C.Accent }
			)
			for _, id in block.Picks or {} do
				local template = nil
				for _, entry in list do
					if entry.Id == id then
						template = entry
					end
				end
				if template then
					local card = Kit.Card(parent)
					local done = block.Done and block.Done[id]
					local progress = block.Progress and block.Progress[id] or 0
					Kit.Label(
						card,
						(if done then "✓ " else "") .. template.Text,
						15,
						{ Font = Kit.Fonts.Bold, TextColor3 = if done then C.Good else C.Text }
					)
					local bar = Kit.Bar(card, if done then C.Good else C.Signal)
					bar.Set(if done then 1 else progress / (template.Count or 1))
					Kit.Label(card, ("%d / %d"):format(progress, template.Count or 1), 12, { TextColor3 = C.Muted })
				end
			end
		end
		section("Daily objectives", data.Daily, Quests.Daily, data.NextDay or 0)
		Kit.Paragraph(parent, "Finish all three dailies for a bonus: " .. Kit.Rewards(Quests.DailyBonus), 13, C.Muted)
		section("Weekly expeditions", data.Weekly, Quests.Weekly, data.NextWeek or 0)
		Kit.Paragraph(parent, "Each expedition pays " .. Kit.Rewards(Quests.WeeklyReward), 13, C.Muted)
	end)
end

local function contracts(parent: Instance, profile: any)
	local contract = profile.Contracts and profile.Contracts.Active
	if contract then
		local card = Kit.Card(parent)
		Kit.Label(card, "Active: " .. tostring(contract.Name), 17, { Font = Kit.Fonts.Bold, TextColor3 = C.Good })
		Kit.Paragraph(card, tostring(contract.Text), 14, C.Text)
		Kit.Label(card, "Pays " .. Kit.Rewards(contract.Reward), 13, { TextColor3 = C.Accent })
		Kit.Button(card, "Abandon contract", function()
			task.spawn(pcall, Net.Invoke, "Contract.Take", nil)
		end, "Ghost", { Size = UDim2.fromOffset(180, 34) })
	else
		Kit.Paragraph(
			parent,
			"No contract. Every district plaza has a job board with quick work for runners.",
			14,
			C.Muted
		)
	end
	Kit.Paragraph(
		parent,
		("Contracts completed: %d"):format(profile.Contracts and profile.Contracts.Completed or 0),
		13,
		C.Muted
	)
end

local function letters(parent: Instance, profile: any)
	local found = 0
	for district, list in Lore.Letters do
		Kit.Label(parent, district, 17, { Font = Kit.Fonts.Black, TextColor3 = C.Accent })
		for index, letter in list do
			local id = ("letter_%s_%d"):format(string.lower(district), index)
			if profile.Discoveries and profile.Discoveries[id] then
				found += 1
				local card = Kit.Card(parent)
				Kit.Label(card, tostring(letter.Title or ("Letter " .. index)), 15, { Font = Kit.Fonts.Bold })
				Kit.Paragraph(card, tostring(letter.Text or ""), 14, C.Text)
			else
				Kit.Paragraph(parent, "· An unread letter is still out there.", 13, C.Faint)
			end
		end
	end
	if found == 0 then
		Kit.Paragraph(
			parent,
			"Lost letters are tucked away on rooftops in every district. Each tells part of what happened to the city.",
			14,
			C.Muted
		)
	end
end

return {
	Id = "Journal",
	Title = "Journal",
	Icon = "✎",
	Order = 2,
	Sections = { "Quests", "Contracts", "Discoveries" },
	Build = function(container: Frame)
		local profile = State.Profile
		if not profile then
			return
		end
		local tabs = Kit.Row(container, 40, 8)
		local body = Kit.Scroll(container, { Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, 0, 1, -52) })
		Kit.List(body, false, 10)
		Kit.Padding(body, 4)
		local function render()
			Kit.Clear(body)
			if tab == "Story" then
				story(body, profile)
			elseif tab == "Side" then
				sideQuests(body, profile)
			elseif tab == "Objectives" then
				rolling(body)
			elseif tab == "Contracts" then
				contracts(body, profile)
			else
				letters(body, profile)
			end
		end
		for _, name in { "Story", "Side", "Objectives", "Contracts", "Letters" } do
			Kit.Button(
				tabs,
				name,
				function()
					tab = name
					for _, child in tabs:GetChildren() do
						if child:IsA("TextButton") then
							child.BackgroundColor3 = if child.Text == tab
								then C.Accent:Lerp(C.PanelLight, 0.5)
								else C.PanelLight
						end
					end
					render()
				end,
				"Secondary",
				{
					Size = UDim2.fromOffset(120, 36),
					BackgroundColor3 = if name == tab then C.Accent:Lerp(C.PanelLight, 0.5) else C.PanelLight,
				}
			)
		end
		render()
	end,
}
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="126">
              <Properties>
                <string name="Name">Locker</string>
                <string name="Source"><![CDATA[-- The locker (everything you own, equip and the emote wheel) and the shop
-- (what's for sale here, in credits or prestige tokens). Cosmetics never
-- change how you move.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Cosmetics = require(ReplicatedStorage.Shared.Config.Cosmetics)
local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Net = require(ReplicatedStorage.Shared.Net)

local State = require(script.Parent.Parent.Parent.Core.State)
local Sfx = require(script.Parent.Parent.Parent.Audio.Sfx)
local Kit = require(script.Parent.Parent.Kit)

local C = Kit.Colors

local Locker = {}

local category = "Outfit"

local function isEquipped(profile: any, item: Cosmetics.Item): boolean
	if item.Category == "Emote" then
		return table.find(profile.Equipped.Emotes or {}, item.Id) ~= nil
	end
	return profile.Equipped[item.Category] == item.Id
end

local function itemCard(parent: Instance, item: Cosmetics.Item, profile: any, shop: boolean, message: TextLabel)
	local owned = profile.Inventory[item.Id] == true
	local card = Kit.Panel(parent, { BackgroundColor3 = C.PanelLight })
	Kit.Padding(card, 10)
	Kit.List(card, false, 4)
	local rarity = Cosmetics.Rarities[item.Rarity] or C.Text
	Kit.Label(card, item.Name, 15, { Font = Kit.Fonts.Bold, TextColor3 = rarity })
	Kit.Label(card, ("%s · %s"):format(item.Rarity, item.Style or ""), 12, { TextColor3 = C.Muted })
	-- Colour swatches.
	if item.Colors and #item.Colors > 0 then
		local swatches = Kit.Row(card, 16, 4)
		for _, color in item.Colors do
			local swatch =
				Kit.new("Frame", { Size = UDim2.fromOffset(16, 16), BackgroundColor3 = color, Parent = swatches })
			Kit.Corner(swatch, 4)
		end
	end
	Kit.Paragraph(card, item.Description, 12, C.Muted)
	if owned then
		local equipped = isEquipped(profile, item)
		Kit.Button(card, if equipped then "✓ Equipped" else "Equip", function()
			task.spawn(function()
				local ok, success, reason = pcall(Net.Invoke, "Shop.Equip", item.Category, item.Id)
				if not (ok and success) then
					message.Text = tostring(reason or "Couldn't equip")
				end
			end)
		end, if equipped then "Primary" else "Secondary", { Size = UDim2.new(1, 0, 0, 32) })
	elseif shop and (item.Source == "Shop" or item.Source == "Prestige") then
		local price = if item.Source == "Prestige"
			then ("✪ %d"):format(item.PrestigePrice or 0)
			else ("¢ %s"):format(Format.Number(item.Price or 0))
		Kit.Button(card, "Buy  " .. price, function()
			task.spawn(function()
				local ok, success, reason = pcall(Net.Invoke, "Shop.Buy", item.Id)
				if ok and success then
					Sfx.Stinger("Unlock")
					message.Text = "Bought " .. item.Name .. "!"
					message.TextColor3 = C.Good
				else
					Sfx.Stinger("Error")
					message.Text = tostring(reason or "Couldn't buy that")
					message.TextColor3 = C.Bad
				end
			end)
		end, "Primary", { Size = UDim2.new(1, 0, 0, 32) })
	else
		local how = if item.Source == "Reward"
			then (item.Unlock or "Earned in play")
			elseif item.District then (
				"Sold in " .. (Districts.ById[item.District] and Districts.ById[item.District].Name or item.District)
			)
			else "Sold at the Outfitters"
		Kit.Paragraph(card, "🔒 " .. how, 12, C.Faint)
	end
end

local function render(container: Frame, shop: boolean, district: string?)
	local profile = State.Profile
	if not profile then
		return
	end
	local header = Kit.Row(container, 40, 8)
	Kit.Label(
		header,
		("¢ %s    ✪ %d"):format(Format.Number(profile.Credits or 0), profile.Prestige or 0),
		18,
		{ Font = Kit.Fonts.Black, Size = UDim2.fromOffset(240, 40), TextColor3 = C.Accent }
	)
	local message = Kit.Label(
		header,
		if shop and district
			then ("Stall stock: %s specials plus Guild staples"):format(
				Districts.ById[district] and Districts.ById[district].Short or district
			)
			else "",
		13,
		{ Size = UDim2.new(1, -250, 1, 0), TextColor3 = C.Muted }
	)
	local tabs = Kit.Scroll(container, {
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 44),
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
	})
	Kit.List(tabs, true, 6)
	for _, name in Cosmetics.Categories do
		Kit.Button(
			tabs,
			Cosmetics.CategoryNames[name] or name,
			function()
				category = name
				Kit.Clear(container)
				render(container, shop, district)
			end,
			"Secondary",
			{
				Size = UDim2.fromOffset(140, 36),
				BackgroundColor3 = if name == category then C.Accent:Lerp(C.PanelLight, 0.5) else C.PanelLight,
			}
		)
	end
	local grid = Kit.Scroll(container, { Position = UDim2.fromOffset(0, 98), Size = UDim2.new(1, 0, 1, -98) })
	Kit.new("UIGridLayout", {
		CellSize = UDim2.new(0.25, -9, 0, 190),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	local items = Cosmetics.OfCategory(category)
	table.sort(items, function(a, b)
		local ownedA, ownedB = profile.Inventory[a.Id] == true, profile.Inventory[b.Id] == true
		if ownedA ~= ownedB then
			return ownedA
		end
		return (a.Price or (a.PrestigePrice or 0) * 1000) < (b.Price or (b.PrestigePrice or 0) * 1000)
	end)
	local shown = 0
	for _, item in items do
		local forSale = item.Source == "Shop" or item.Source == "Prestige"
		local here = not district or item.District == nil or item.District == district
		if (shop and forSale and here) or not shop then
			itemCard(grid, item, profile, shop, message)
			shown += 1
		end
	end
	if shown == 0 then
		Kit.Paragraph(grid, "Nothing here yet.", 14, C.Faint)
	end
	if category == "Emote" and not shop then
		message.Text = ("Emote wheel: %d / %d equipped. Press [Emote] to use them."):format(
			#(profile.Equipped.Emotes or {}),
			Cosmetics.MultiEquip.Emote
		)
	end
end

Locker.Pages = {
	{
		Id = "Locker",
		Title = "Locker",
		Icon = "▣",
		Order = 5,
		Sections = { "Inventory", "Equipped", "Credits", "Prestige" },
		Build = function(container: Frame)
			render(container, false, nil)
		end,
	},
	{
		Id = "Shop",
		Title = "Shop",
		Icon = "¢",
		Order = 6,
		Sections = { "Inventory", "Equipped", "Credits", "Prestige" },
		Build = function(container: Frame, args: any)
			render(
				container,
				true,
				if type(args) == "table" and type(args.District) == "string" then args.District else nil
			)
		end,
	},
}

return Locker
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="127">
              <Properties>
                <string name="Name">Map</string>
                <string name="Source"><![CDATA[-- The map of Meridian: every district on its ring around the Guildhall, what
-- you've found and finished in each, where you are, where your pinned
-- objective is, and fast travel between plazas you've unlocked.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Access = require(ReplicatedStorage.Shared.Logic.Access)
local Courses = require(ReplicatedStorage.Shared.Config.Courses)
local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Net = require(ReplicatedStorage.Shared.Net)

local Bus = require(script.Parent.Parent.Parent.Core.Bus)
local State = require(script.Parent.Parent.Parent.Core.State)
local Controller = require(script.Parent.Parent.Parent.Movement.Controller)
local CourseClient = require(script.Parent.Parent.Parent.Gameplay.CourseClient)
local Explore = require(script.Parent.Parent.Parent.Gameplay.Explore)
local QuestClient = require(script.Parent.Parent.Parent.Gameplay.QuestClient)
local Kit = require(script.Parent.Parent.Kit)

local C = Kit.Colors

local selected = "Hub"

local function medalSummary(districtId: string): (number, number, number)
	local profile = State.Profile
	local total, finished, gold = 0, 0, 0
	for _, course in Courses.Of(districtId) do
		total += 1
		local record = profile and profile.Courses and profile.Courses[course.Id]
		if record and (record.Completions or 0) > 0 then
			finished += 1
			if (record.Medal or 0) >= 3 then
				gold += 1
			end
		end
	end
	return total, finished, gold
end

local function travel(districtId: string, note: TextLabel)
	note.Text = "Travelling…"
	note.TextColor3 = C.Muted
	task.spawn(function()
		local ok, allowed, destination = pcall(Net.Invoke, "Travel.Go", districtId)
		if ok and allowed and typeof(destination) == "CFrame" then
			Bus.ClosePages:Fire()
			Controller.Teleport(destination)
		else
			note.Text = if ok and type(destination) == "string" then destination else "Can't travel right now"
			note.TextColor3 = C.Bad
		end
	end)
end

local function details(parent: Frame, districtId: string)
	Kit.Clear(parent)
	local district = Districts.ById[districtId]
	local profile = State.Profile
	if not district or not profile then
		return
	end
	local ok, reason = Access.District(State.Level(), profile.Quests.Completed, districtId)
	local visited = profile.Districts and profile.Districts.Visited and profile.Districts.Visited[districtId]
	Kit.Label(parent, district.Name, 22, { Font = Kit.Fonts.Black, TextColor3 = C.Accent })
	Kit.Paragraph(parent, district.Tagline, 15, C.Text)
	Kit.Paragraph(parent, district.Lore, 14, C.Muted)
	for _, trait in district.Traits do
		Kit.Paragraph(parent, "• " .. trait, 13, C.Muted)
	end
	local total, finished, gold = medalSummary(districtId)
	local foundAll, totalAll = Explore.Count(nil, districtId)
	Kit.Paragraph(
		parent,
		("Courses %d/%d finished · %d at gold or better\nDiscoveries %d/%d"):format(
			finished,
			total,
			gold,
			foundAll,
			totalAll
		),
		14,
		C.Text
	)
	local status = if not ok
		then "🔒 " .. tostring(reason)
		elseif visited then "✓ Visited"
		else "Unvisited — go and see it"
	Kit.Paragraph(parent, status, 14, if ok then C.Good else C.Warn)
	local note = Kit.Paragraph(parent, "", 13, C.Muted)
	if ok then
		local button = Kit.Button(parent, "Travel to the plaza", function()
			travel(districtId, note)
		end, "Primary", { Size = UDim2.fromOffset(200, 40) })
		if CourseClient.Run then
			button.Visible = false
			note.Text = "Finish or leave your run to travel."
		end
	end
end

return {
	Id = "Map",
	Title = "Map",
	Icon = "◎",
	Order = 1,
	Sections = { "Districts", "Quests", "Discoveries", "Courses" },
	Build = function(container: Frame, args: any)
		if type(args) == "table" and type(args.District) == "string" then
			selected = args.District
		end
		local canvas = Kit.new("Frame", {
			Size = UDim2.new(0.62, -10, 1, 0),
			BackgroundColor3 = Color3.fromRGB(16, 20, 30),
			BackgroundTransparency = 0.1,
			ClipsDescendants = true,
			Parent = container,
		})
		Kit.Corner(canvas, 12)
		local side = Kit.Scroll(container, { Position = UDim2.new(0.62, 10, 0, 0), Size = UDim2.new(0.38, -10, 1, 0) })
		Kit.List(side, false, 8)
		Kit.Padding(side, 4)

		-- Project world XZ onto the canvas.
		local extent = 1900
		local function project(position: Vector3): UDim2
			return UDim2.fromScale(0.5 + position.X / (extent * 2.2), 0.5 + position.Z / (extent * 2.2))
		end
		local hub = Districts.ById.Hub
		local profile = State.Profile
		for _, district in Districts.Ordered() do
			local ok = profile ~= nil and Access.District(State.Level(), profile.Quests.Completed, district.Id)
			local visited = profile
				and profile.Districts
				and profile.Districts.Visited
				and profile.Districts.Visited[district.Id]
			-- Spoke from the hub.
			if district.Id ~= "Hub" then
				local a, b = project(hub.Origin), project(district.Origin)
				local mid = UDim2.fromScale((a.X.Scale + b.X.Scale) / 2, (a.Y.Scale + b.Y.Scale) / 2)
				local dx = (b.X.Scale - a.X.Scale)
				local dy = (b.Y.Scale - a.Y.Scale)
				local line = Kit.new("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = mid,
					BackgroundColor3 = if ok then C.Signal else C.Line,
					BackgroundTransparency = 0.5,
					BorderSizePixel = 0,
					Parent = canvas,
				})
				-- Size and rotate once the canvas has a size.
				local function place()
					local size = canvas.AbsoluteSize
					local length = math.sqrt((dx * size.X) ^ 2 + (dy * size.Y) ^ 2)
					line.Size = UDim2.fromOffset(length, 3)
					line.Rotation = math.deg(math.atan2(dy * size.Y, dx * size.X))
				end
				place()
				canvas:GetPropertyChangedSignal("AbsoluteSize"):Connect(place)
			end
			local node = Kit.Button(
				canvas,
				"",
				function()
					selected = district.Id
					details(side, selected)
				end,
				if selected == district.Id then "Primary" else "Secondary",
				{
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = project(district.Origin),
					Size = UDim2.fromOffset(150, 52),
					ZIndex = 3,
				}
			)
			node.Text = ("%s\n%s"):format(
				district.Short,
				if not ok then "🔒 locked" elseif visited then "✓ visited" else "new"
			)
			Kit.TextSize(node, 14)
		end
		-- You.
		local root = Controller.Info.Root
		if root then
			Kit.Label(canvas, "▲ YOU", 14, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = project(root.Position),
				Size = UDim2.fromOffset(70, 20),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextColor3 = C.Good,
				Font = Kit.Fonts.Black,
				ZIndex = 4,
			})
		end
		local target = QuestClient.PinnedTarget()
		if target then
			Kit.Label(canvas, "◆ " .. string.sub(target.Label, 1, 28), 13, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = project(target.Position),
				Size = UDim2.fromOffset(220, 20),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextColor3 = C.Accent,
				Font = Kit.Fonts.Bold,
				ZIndex = 4,
			})
		end
		Kit.Label(canvas, "Spire beside the Guildhall · Dreamline portal in the Commons", 12, {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -20, 0, 18),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = C.Faint,
		})
		details(side, selected)
	end,
}
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="128">
              <Properties>
                <string name="Name">Mastery</string>
                <string name="Source"><![CDATA[-- Movement mastery: eight technique categories, five tiers each. A tier needs
-- both points from real use and its proficiency challenge, so this page shows
-- exactly what's left for the next one.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Util.Format)
local Mastery = require(ReplicatedStorage.Shared.Config.Mastery)

local State = require(script.Parent.Parent.Parent.Core.State)
local Kit = require(script.Parent.Parent.Kit)

local C = Kit.Colors

return {
	Id = "Mastery",
	Title = "Mastery",
	Icon = "▲",
	Order = 4,
	Sections = { "Mastery" },
	Build = function(container: Frame)
		local profile = State.Profile
		if not profile then
			return
		end
		local data = profile.Mastery or {}
		local points = data.Points or {}
		local completed = data.Challenges or {}
		local scroll = Kit.Scroll(container)
		Kit.new("UIGridLayout", {
			CellSize = UDim2.new(0.5, -8, 0, 190),
			CellPadding = UDim2.fromOffset(12, 12),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = scroll,
		})

		for index, category in Mastery.Categories do
			local have = points[category.Id] or 0
			local tier = Mastery.TierOf(category.Id, have, completed)
			local card = Kit.Panel(scroll, { BackgroundColor3 = C.PanelLight, LayoutOrder = index })
			Kit.Padding(card, 12)
			Kit.List(card, false, 4)
			Kit.Label(
				card,
				("%s  %s"):format(category.Icon, category.Name),
				17,
				{ Font = Kit.Fonts.Black, TextColor3 = category.Color }
			)
			Kit.Label(
				card,
				if tier > 0 then ("Tier %d · %s"):format(tier, Mastery.TierNames[tier]) else "Unranked",
				14,
				{ Font = Kit.Fonts.Bold }
			)
			Kit.Paragraph(card, category.Blurb, 12, C.Muted)
			if tier >= 5 then
				Kit.Paragraph(card, "✓ Grandmaster. Nothing left to prove here.", 13, C.Good)
			else
				local nextTier = tier + 1
				local needed = Mastery.TierPoints[nextTier]
				local bar = Kit.Bar(card, category.Color)
				bar.Set(have / needed)
				Kit.Label(
					card,
					("%s / %s points to %s"):format(
						Format.Number(have),
						Format.Number(needed),
						Mastery.TierNames[nextTier]
					),
					12,
					{ TextColor3 = C.Muted }
				)
				local challenge = Mastery.ChallengeFor[category.Id] and Mastery.ChallengeFor[category.Id][nextTier]
				if challenge then
					local done = completed[challenge.Id]
					Kit.Paragraph(
						card,
						("%s Challenge: %s — %s"):format(
							if done then "✓" else "◇",
							challenge.Name,
							challenge.Text
						),
						13,
						if done then C.Good else C.Text
					)
				end
				local reward = Mastery.TierRewards[nextTier]
				if reward then
					Kit.Label(card, "Tier reward: " .. Kit.Rewards(reward), 12, { TextColor3 = C.Accent })
				end
			end
		end
	end,
}
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="129">
              <Properties>
                <string name="Name">Places</string>
                <string name="Source"><![CDATA[-- Pages opened from the world rather than the menu rail: the lift gates
-- (travel), the Spire lift (pick a floor) and district job boards (contracts).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Access = require(ReplicatedStorage.Shared.Logic.Access)
local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Net = require(ReplicatedStorage.Shared.Net)

local Bus = require(script.Parent.Parent.Parent.Core.Bus)
local State = require(script.Parent.Parent.Parent.Core.State)
local Controller = require(script.Parent.Parent.Parent.Movement.Controller)
local Modes = require(script.Parent.Parent.Parent.Gameplay.Modes)
local Kit = require(script.Parent.Parent.Kit)

local C = Kit.Colors

-- Travel -----------------------------------------------------------------------------------------------

local function buildTravel(container: Frame, args: any)
	local profile = State.Profile
	if not profile then
		return
	end
	local scroll = Kit.Scroll(container)
	Kit.List(scroll, false, 8)
	Kit.Padding(scroll, 4)
	Kit.Paragraph(
		scroll,
		"The lift gates connect every plaza you've opened. New districts open with your level and the story.",
		14,
		C.Muted
	)
	local message = Kit.Paragraph(scroll, "", 13, C.Bad)
	local preferred = if type(args) == "table" then args.Destination else nil
	for _, district in Districts.Ordered() do
		local ok, reason = Access.District(State.Level(), profile.Quests.Completed, district.Id)
		local row = Kit.Panel(scroll, {
			Size = UDim2.new(1, -8, 0, 64),
			BackgroundColor3 = if district.Id == preferred then C.Accent:Lerp(C.PanelLight, 0.7) else C.PanelLight,
		})
		Kit.Padding(row, 8, 12)
		Kit.Label(
			row,
			district.Name,
			16,
			{ Font = Kit.Fonts.Bold, Size = UDim2.new(1, -170, 0, 22), TextColor3 = if ok then C.Text else C.Faint }
		)
		Kit.Label(row, if ok then district.Tagline else ("🔒 " .. tostring(reason)), 13, {
			Position = UDim2.fromOffset(0, 24),
			Size = UDim2.new(1, -170, 0, 20),
			TextColor3 = if ok then C.Muted else C.Warn,
		})
		if ok then
			Kit.Button(
				row,
				"Travel",
				function()
					message.Text = "Travelling…"
					task.spawn(function()
						local okInvoke, allowed, destination = pcall(Net.Invoke, "Travel.Go", district.Id)
						if okInvoke and allowed and typeof(destination) == "CFrame" then
							Bus.ClosePages:Fire()
							Controller.Teleport(destination)
						else
							message.Text = if okInvoke and type(destination) == "string"
								then destination
								else "Can't travel right now"
						end
					end)
				end,
				"Primary",
				{
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, 0, 0.5, 0),
					Size = UDim2.fromOffset(140, 38),
				}
			)
		end
	end
end

-- The Spire ---------------------------------------------------------------------------------------------

local function buildTower(container: Frame)
	local profile = State.Profile
	if not profile then
		return
	end
	local tower = profile.Tower or {}
	local highest = tower.Highest or 0
	Kit.Paragraph(
		container,
		("25 floors, each a short route that asks for more of your kit. Highest cleared: %d. Every fifth floor is a milestone."):format(
			highest
		),
		14,
		C.Muted
	)
	local message = Kit.Label(container, "", 13, { Position = UDim2.fromOffset(0, 40), TextColor3 = C.Bad })
	local grid = Kit.Scroll(container, { Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 1, -70) })
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(150, 64),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	for floor = 1, 25 do
		local cleared = floor <= highest
		local open = floor <= highest + 1
		local best = tower.Best and tower.Best[tostring(floor)]
		local text = ("Floor %d\n%s"):format(
			floor,
			if cleared then "✓ " .. Format.Time(best) elseif open then "▶ next" else "🔒"
		)
		local button = Kit.Button(
			grid,
			text,
			function()
				if not open then
					return
				end
				message.Text = "Riding up…"
				task.spawn(function()
					local ok, reason = Modes.EnterTower(floor)
					if ok then
						Bus.ClosePages:Fire()
					else
						message.Text = reason or "The lift won't move"
					end
				end)
			end,
			if open and not cleared then "Primary" else "Secondary",
			{
				LayoutOrder = floor,
				BackgroundColor3 = if floor % 5 == 0 and cleared
					then C.Accent:Lerp(C.PanelLight, 0.6)
					elseif open and not cleared then C.Accent
					elseif cleared then C.PanelLight
					else C.Panel,
			}
		)
		Kit.TextSize(button, 14)
	end
end

-- Job board ----------------------------------------------------------------------------------------------

local function buildJobs(container: Frame, args: any)
	local district = if type(args) == "table" and type(args.District) == "string" then args.District else "Hub"
	local scroll = Kit.Scroll(container)
	Kit.List(scroll, false, 10)
	Kit.Padding(scroll, 4)
	Kit.Paragraph(
		scroll,
		("Job board · %s. Contracts are quick, repeatable work: deliveries against the clock, relay checks and route certifications."):format(
			Districts.ById[district] and Districts.ById[district].Name or district
		),
		14,
		C.Muted
	)
	local status = Kit.Paragraph(scroll, "Reading the board…", 13, C.Faint)
	task.spawn(function()
		local ok, data = pcall(Net.Invoke, "Contract.Take", district)
		if not scroll.Parent then
			return
		end
		if not ok or type(data) ~= "table" then
			status.Text = "The board is empty right now."
			return
		end
		status.Text = ("New offers in %s"):format(Format.Duration(math.max(data.Refresh or 0, 0)))
		if data.Active then
			local card = Kit.Card(scroll)
			Kit.Label(
				card,
				"Your contract: " .. tostring(data.Active.Name),
				16,
				{ Font = Kit.Fonts.Bold, TextColor3 = C.Good }
			)
			Kit.Paragraph(card, tostring(data.Active.Text), 14, C.Text)
			Kit.Button(card, "Abandon", function()
				task.spawn(pcall, Net.Invoke, "Contract.Take", nil)
				Bus.ClosePages:Fire()
			end, "Ghost", { Size = UDim2.fromOffset(120, 34) })
		end
		for index, offer in data.Offers or {} do
			local card = Kit.Card(scroll)
			Kit.Label(card, tostring(offer.Name), 16, { Font = Kit.Fonts.Bold, TextColor3 = C.Accent })
			Kit.Paragraph(card, tostring(offer.Text), 14, C.Text)
			Kit.Label(card, "Pays " .. Kit.Rewards(offer.Reward), 13, { TextColor3 = C.Accent })
			local note = Kit.Paragraph(card, "", 13, C.Bad)
			Kit.Button(card, "Take the job", function()
				task.spawn(function()
					local okTake, result = pcall(Net.Invoke, "Contract.Take", district, index)
					if okTake and type(result) == "table" and result.Active then
						Bus.ClosePages:Fire()
					else
						note.Text = if okTake
								and type(result) == "table"
								and result.Error
							then result.Error
							else "Couldn't take that job"
					end
				end)
			end, "Primary", { Size = UDim2.fromOffset(160, 36) })
		end
	end)
end

return {
	Pages = {
		{
			Id = "Travel",
			Title = "Lift Gates",
			Icon = "⇄",
			Order = 50,
			Hidden = true,
			Sections = { "Quests", "XP" },
			Build = buildTravel,
		},
		{
			Id = "Tower",
			Title = "The Spire",
			Icon = "▥",
			Order = 51,
			Hidden = true,
			Sections = { "Tower" },
			Build = buildTower,
		},
		{
			Id = "Jobs",
			Title = "Job Board",
			Icon = "✉",
			Order = 52,
			Hidden = true,
			Sections = { "Contracts" },
			Build = buildJobs,
		},
	},
}
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="130">
              <Properties>
                <string name="Name">Progress</string>
                <string name="Source"><![CDATA[-- Progress pages: the achievement journal, every course by district with
-- your medals and records, and the leaderboards (global top runs and your
-- friends' times, standardized ranked runs only).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Achievements = require(ReplicatedStorage.Shared.Config.Achievements)
local Courses = require(ReplicatedStorage.Shared.Config.Courses)
local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Net = require(ReplicatedStorage.Shared.Net)
local Stats = require(ReplicatedStorage.Shared.Logic.Stats)

local Bus = require(script.Parent.Parent.Parent.Core.Bus)
local State = require(script.Parent.Parent.Parent.Core.State)
local CourseClient = require(script.Parent.Parent.Parent.Gameplay.CourseClient)
local Explore = require(script.Parent.Parent.Parent.Gameplay.Explore)
local Kit = require(script.Parent.Parent.Kit)

local C = Kit.Colors

local achievementCategory = "Exploration"
local courseDistrict = "Hub"
local recordCourse: string? = nil
local recordScope = "Top"

local function tabRow(
	container: Instance,
	items: { { Id: string, Text: string } },
	selected: string,
	onPick: (string) -> ()
): ScrollingFrame
	local tabs = Kit.Scroll(container, {
		Size = UDim2.new(1, 0, 0, 44),
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
	})
	Kit.List(tabs, true, 6)
	for _, item in items do
		Kit.Button(
			tabs,
			item.Text,
			function()
				onPick(item.Id)
			end,
			"Secondary",
			{
				Size = UDim2.fromOffset(150, 36),
				BackgroundColor3 = if item.Id == selected then C.Accent:Lerp(C.PanelLight, 0.5) else C.PanelLight,
			}
		)
	end
	return tabs
end

local function districtTabs(): { { Id: string, Text: string } }
	local items = {}
	for _, district in Districts.Ordered() do
		table.insert(items, { Id = district.Id, Text = district.Short })
	end
	return items
end

-- Achievements -----------------------------------------------------------------------------------------

local function buildAchievements(container: Frame)
	local profile = State.Profile
	if not profile then
		return
	end
	local items = {}
	for _, category in Achievements.Categories do
		table.insert(items, { Id = category.Id, Text = category.Icon .. " " .. category.Name })
	end
	tabRow(container, items, achievementCategory, function(id)
		achievementCategory = id
		Kit.Clear(container)
		buildAchievements(container)
	end)
	local earned, total = 0, 0
	for _, achievement in Achievements.List do
		total += 1
		if profile.Achievements[achievement.Id] then
			earned += 1
		end
	end
	Kit.Label(
		container,
		("%d of %d achievements earned"):format(earned, total),
		14,
		{ Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.Muted }
	)
	local list = Kit.Scroll(container, { Position = UDim2.fromOffset(0, 76), Size = UDim2.new(1, 0, 1, -76) })
	Kit.new("UIGridLayout", {
		CellSize = UDim2.new(0.5, -8, 0, 112),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})
	-- Cache totals for "every cache in a district" style entries.
	local cacheTotals = {}
	for _, district in Districts.Ordered() do
		local _, cacheCount = Explore.Count("Cache", district.Id)
		cacheTotals[district.Id] = cacheCount
	end
	local context = { CacheTotals = cacheTotals }
	for index, achievement in Achievements.List do
		if achievement.Category == achievementCategory then
			local got = profile.Achievements[achievement.Id]
			local card =
				Kit.Panel(list, { BackgroundColor3 = C.PanelLight, LayoutOrder = (if got then 0 else 1000) + index })
			Kit.Padding(card, 10)
			Kit.List(card, false, 3)
			local hidden = achievement.Hidden and not got
			Kit.Label(
				card,
				(if got then "🏆 " else "◇ ") .. (if hidden then "???" else achievement.Name),
				15,
				{ Font = Kit.Fonts.Bold, TextColor3 = if got then C.Accent else C.Text }
			)
			Kit.Paragraph(
				card,
				if hidden then "A hidden achievement. Keep exploring." else achievement.Text,
				12,
				C.Muted
			)
			if not got and not hidden then
				local value = Stats.Get(profile, achievement.Stat, context)
				local bar = Kit.Bar(card, C.Signal)
				bar.Set(value / achievement.Target)
				Kit.Label(
					card,
					("%s / %s"):format(
						Format.Number(math.min(value, achievement.Target)),
						Format.Number(achievement.Target)
					),
					11,
					{ TextColor3 = C.Faint }
				)
			elseif got then
				Kit.Label(card, "Earned " .. os.date("%d %b %Y", got), 11, { TextColor3 = C.Faint })
			end
			Kit.Label(
				card,
				Kit.Rewards({
					XP = achievement.XP,
					Credits = achievement.Credits,
					Prestige = achievement.Prestige,
					Items = if achievement.Item then { achievement.Item } else nil,
				}),
				11,
				{ TextColor3 = C.Accent }
			)
		end
	end
end

-- Courses ----------------------------------------------------------------------------------------------

local function buildCourses(container: Frame, args: any)
	local profile = State.Profile
	if not profile then
		return
	end
	if type(args) == "table" and type(args.District) == "string" and Districts.ById[args.District] then
		courseDistrict = args.District
	end
	tabRow(container, districtTabs(), courseDistrict, function(id)
		courseDistrict = id
		Kit.Clear(container)
		buildCourses(container, nil)
	end)
	local list = Kit.Scroll(container, { Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, 0, 1, -52) })
	Kit.List(list, false, 8)
	local district = Districts.ById[courseDistrict]
	Kit.Paragraph(list, district.Tagline, 14, C.Muted)
	for _, course in Courses.Of(courseDistrict) do
		local config = CourseClient.Config(course.Id)
		local record = profile.Courses[course.Id]
		local row = Kit.Panel(list, { Size = UDim2.new(1, -8, 0, 64), BackgroundColor3 = C.PanelLight })
		Kit.Padding(row, 8, 12)
		local medal = record and record.Medal or 0
		local kind = if course.Kind == "Room" then "Room" elseif course.Kind == "Relay" then "Relay" else "Course"
		Kit.Label(
			row,
			("%s  %s"):format(if medal > 0 then ({ "●", "◆", "★", "✦" })[medal] else "○", course.Name),
			16,
			{
				Font = Kit.Fonts.Bold,
				Size = UDim2.new(0.5, 0, 0, 22),
				TextColor3 = if medal > 0 then C.Medal[medal] else C.Text,
			}
		)
		local tokens = 0
		for _ in (record and record.Tokens or {}) :: { [any]: any } do
			tokens += 1
		end
		Kit.Label(
			row,
			("%s · %s · best %s · ★ %d/%d"):format(
				kind,
				Courses.DifficultyNames[course.Difficulty] or "",
				Format.Time(record and record.Best),
				tokens,
				if config then config:GetAttribute("Tokens") or 0 else 0
			),
			13,
			{ Position = UDim2.fromOffset(0, 24), Size = UDim2.new(0.6, 0, 0, 20), TextColor3 = C.Muted }
		)
		Kit.Button(
			row,
			"Preview",
			function()
				Bus.ClosePages:Fire()
				Bus.CoursePreview:Fire(course.Id)
			end,
			"Secondary",
			{ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(110, 36) }
		)
		Kit.Button(
			row,
			"Records",
			function()
				recordCourse = course.Id
				Bus.OpenPage:Fire("Records", nil)
			end,
			"Ghost",
			{
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -120, 0.5, 0),
				Size = UDim2.fromOffset(100, 36),
			}
		)
	end
end

-- Records ----------------------------------------------------------------------------------------------

local function buildRecords(container: Frame)
	local profile = State.Profile
	if not profile then
		return
	end
	local districtCourses = Courses.Of(courseDistrict, "Course")
	if not recordCourse or not Courses.ById[recordCourse] then
		recordCourse = if districtCourses[1] then districtCourses[1].Id else nil
	end
	tabRow(container, districtTabs(), courseDistrict, function(id)
		courseDistrict = id
		recordCourse = nil
		Kit.Clear(container)
		buildRecords(container)
	end)
	local controls = Kit.Row(container, 40, 8)
	controls.Position = UDim2.fromOffset(0, 50)
	local names = {}
	local ids = {}
	for _, course in Courses.Of(courseDistrict) do
		table.insert(names, course.Name)
		table.insert(ids, course.Id)
	end
	local list = Kit.Scroll(container, { Position = UDim2.fromOffset(0, 98), Size = UDim2.new(1, 0, 1, -98) })
	Kit.List(list, false, 6)
	local function load()
		Kit.Clear(list)
		local courseId = recordCourse
		if not courseId then
			Kit.Paragraph(list, "No courses here.", 14, C.Faint)
			return
		end
		local record = profile.Courses[courseId]
		Kit.Paragraph(
			list,
			("Your best %s · ranked %s · medal %s"):format(
				Format.Time(record and record.Best),
				Format.Time(record and record.RankedBest),
				Kit.MedalText(record and record.Medal or 0)
			),
			14,
			C.Text
		)
		local loading = Kit.Paragraph(list, "Loading…", 13, C.Faint)
		task.spawn(function()
			local ok, entries = pcall(Net.Invoke, "Course.Leaderboard", courseId, recordScope)
			if not list.Parent then
				return
			end
			loading.Text = ""
			if not ok or type(entries) ~= "table" or #entries == 0 then
				loading.Text = if recordScope == "Friends"
					then "No ranked times from friends yet."
					else "No ranked times yet. Be the first."
				return
			end
			for _, entry in entries do
				local mine = entry.Name == game:GetService("Players").LocalPlayer.DisplayName
				Kit.Label(list, ("%3d.   %-24s   %s"):format(entry.Rank, entry.Name, Format.Time(entry.Seconds)), 15, {
					Font = Kit.Fonts.Mono,
					TextColor3 = if mine
						then C.Accent
						elseif entry.Rank <= 3 then C.Medal[({ 3, 2, 1 })[entry.Rank]]
						else C.Text,
				})
			end
		end)
	end
	if #names > 0 then
		local currentName = names[table.find(ids, recordCourse) or 1]
		Kit.Choice(controls, names, currentName, function(name)
			recordCourse = ids[table.find(names, name) or 1]
			load()
		end).Size =
			UDim2.fromOffset(280, 36)
	end
	Kit.Choice(controls, { "Top", "Friends" }, recordScope, function(scope)
		recordScope = scope
		load()
	end)
	-- Personal mode records.
	Kit.Label(
		controls,
		("Spire floor %d · Dreamline %d gates"):format(
			profile.Tower and profile.Tower.Highest or 0,
			profile.Endless and profile.Endless.Best or 0
		),
		13,
		{
			Size = UDim2.fromOffset(300, 36),
			TextColor3 = C.Muted,
		}
	)
	load()
end

return {
	Pages = {
		{
			Id = "Achievements",
			Title = "Achievements",
			Icon = "🏆",
			Order = 7,
			Sections = { "Achievements", "Stats" },
			Build = buildAchievements,
		},
		{
			Id = "Courses",
			Title = "Courses",
			Icon = "⚑",
			Order = 8,
			Sections = { "Courses" },
			Build = buildCourses,
		},
		{
			Id = "Records",
			Title = "Records",
			Icon = "⏱",
			Order = 9,
			Sections = { "Courses" },
			Build = buildRecords,
		},
	},
}
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="131">
              <Properties>
                <string name="Name">Settings</string>
                <string name="Source"><![CDATA[-- Settings: controls (sprint/crouch modes, sensitivity per device, invert,
-- camera assist), full key and button remapping, camera and motion comfort
-- (reduced motion turns every effect off at once), interface and
-- accessibility (text and HUD size, high-contrast markers, hints), graphics
-- and audio. Everything saves to your profile.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local SettingsConfig = require(ReplicatedStorage.Shared.Config.Settings)

local Input = require(script.Parent.Parent.Parent.Core.Input)
local Settings = require(script.Parent.Parent.Parent.Core.Settings)
local Kit = require(script.Parent.Parent.Kit)

local C = Kit.Colors
local section = "Controls"
local capturing: { Action: string, Device: string, Button: TextButton }? = nil

local function settingRow(parent: Instance, def: SettingsConfig.SettingDef)
	local row = Kit.Panel(parent, {
		Size = UDim2.new(1, -8, 0, if def.Hint then 64 else 48),
		BackgroundColor3 = C.PanelLight,
		BackgroundTransparency = 0.35,
	})
	Kit.Padding(row, 6, 12)
	Kit.Label(row, def.Name, 15, { Font = Kit.Fonts.Bold, Size = UDim2.new(0.5, 0, 0, 22) })
	if def.Hint then
		Kit.Label(row, def.Hint, 12, {
			Position = UDim2.fromOffset(0, 24),
			Size = UDim2.new(0.55, 0, 0, 28),
			TextColor3 = C.Muted,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
	end
	local control: GuiObject
	local value = Settings.Get(def.Id)
	if def.Kind == "Toggle" then
		control = Kit.Toggle(row, value == true, function(on)
			Settings.Set(def.Id, on)
		end)
	elseif def.Kind == "Slider" then
		control = Kit.Slider(
			row,
			def.Min or 0,
			def.Max or 1,
			def.Step or 0.05,
			if type(value) == "number" then value else def.Default,
			function(v)
				Settings.Set(def.Id, v)
			end,
			function(v)
				if def.Max and def.Max > 10 then
					return tostring(math.floor(v + 0.5))
				end
				return ("%d%%"):format(math.floor(v * 100 + 0.5))
			end
		)
	else
		control = Kit.Choice(row, def.Choices or {}, tostring(value), function(choice)
			Settings.Set(def.Id, choice)
		end)
	end
	control.AnchorPoint = Vector2.new(1, 0.5)
	control.Position = UDim2.new(1, 0, 0.5, 0)
end

local function keyLabel(list: { string }): string
	if #list == 0 then
		return "—"
	end
	return table.concat(list, " / ")
end

local function bindingRows(parent: Instance)
	Kit.Label(parent, "Key bindings", 18, { Font = Kit.Fonts.Black, TextColor3 = C.Accent })
	Kit.Paragraph(
		parent,
		"Click a binding, then press the key or button you want. A key can only do one thing, so it moves from any other action.",
		13,
		C.Muted
	)
	local bindings = Input.Bindings()
	for _, action in SettingsConfig.Actions do
		local entry = bindings[action.Id] or { Keyboard = {}, Gamepad = {} }
		local row = Kit.Panel(
			parent,
			{ Size = UDim2.new(1, -8, 0, 46), BackgroundColor3 = C.PanelLight, BackgroundTransparency = 0.35 }
		)
		Kit.Padding(row, 5, 12)
		Kit.Label(row, action.Name, 14, { Size = UDim2.new(0.45, 0, 1, 0) })
		for index, device in { "Keyboard", "Gamepad" } do
			local button = Kit.Button(row, keyLabel(entry[device] or {}), nil, "Secondary", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -(2 - index) * 170, 0.5, 0),
				Size = UDim2.fromOffset(160, 34),
			})
			button.Activated:Connect(function()
				capturing = { Action = action.Id, Device = device, Button = button }
				button.Text = if device == "Keyboard" then "Press a key…" else "Press a button…"
			end)
		end
	end
	Kit.Button(parent, "Reset all bindings", function()
		Input.ResetBindings()
	end, "Ghost", { Size = UDim2.fromOffset(200, 38) })
end

UserInputService.InputBegan:Connect(function(input)
	local capture = capturing
	if not capture then
		return
	end
	local name: string? = nil
	if capture.Device == "Keyboard" then
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Escape then
			name = input.KeyCode.Name
		elseif
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.MouseButton2
		then
			name = input.UserInputType.Name
		end
	elseif
		input.UserInputType == Enum.UserInputType.Gamepad1
		and (string.find(input.KeyCode.Name, "Button") or string.find(input.KeyCode.Name, "DPad"))
	then
		name = input.KeyCode.Name
	end
	if name then
		capturing = nil
		Input.Rebind(capture.Action, capture.Device, name)
		capture.Button.Text = name
	end
end)

return {
	Id = "Settings",
	Title = "Settings",
	Icon = "⚙",
	Order = 13,
	Build = function(container: Frame)
		capturing = nil
		local tabs = Kit.Row(container, 40, 8)
		local body = Kit.Scroll(container, { Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, 0, 1, -52) })
		Kit.List(body, false, 8)
		Kit.Padding(body, 4)
		local function render()
			Kit.Clear(body)
			for _, def in SettingsConfig.Definitions do
				if def.Section == section then
					settingRow(body, def)
				end
			end
			if section == "Controls" then
				bindingRows(body)
			end
		end
		for _, name in SettingsConfig.Sections do
			Kit.Button(
				tabs,
				name,
				function()
					section = name
					for _, child in tabs:GetChildren() do
						if child:IsA("TextButton") then
							child.BackgroundColor3 = if child.Text == section
								then C.Accent:Lerp(C.PanelLight, 0.5)
								else C.PanelLight
						end
					end
					render()
				end,
				"Secondary",
				{
					Size = UDim2.fromOffset(130, 36),
					BackgroundColor3 = if name == section then C.Accent:Lerp(C.PanelLight, 0.5) else C.PanelLight,
				}
			)
		end
		render()
	end,
}
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="132">
              <Properties>
                <string name="Name">Skills</string>
                <string name="Source"><![CDATA[-- The skill tree: Endurance, Agility, Aerial Control and Exploration. Each
-- node shows its rank, cost and what it needs; upgrades shape how you move in
-- casual play, while ranked runs and races use standard attributes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Abilities = require(ReplicatedStorage.Shared.Config.Abilities)
local Leveling = require(ReplicatedStorage.Shared.Logic.Leveling)
local Net = require(ReplicatedStorage.Shared.Net)
local SkillTree = require(ReplicatedStorage.Shared.Config.SkillTree)

local State = require(script.Parent.Parent.Parent.Core.State)
local Sfx = require(script.Parent.Parent.Parent.Audio.Sfx)
local Kit = require(script.Parent.Parent.Kit)

local C = Kit.Colors

local function freePoints(profile: any): number
	return Leveling.SkillPoints(State.Level()) - SkillTree.SpentPoints(profile.Skills or {})
end

return {
	Id = "Skills",
	Title = "Skill Tree",
	Icon = "✦",
	Order = 3,
	Sections = { "Skills", "XP", "Credits" },
	Build = function(container: Frame)
		local profile = State.Profile
		if not profile then
			return
		end
		local ranks = profile.Skills or {}
		local free = freePoints(profile)
		local header = Kit.Row(container, 40, 12)
		Kit.Label(header, ("Skill points: %d"):format(free), 18, {
			Font = Kit.Fonts.Black,
			Size = UDim2.fromOffset(220, 40),
			TextColor3 = if free > 0 then C.Accent else C.Muted,
		})
		local message = Kit.Label(
			header,
			"Upgrades apply in casual play; ranked runs and races use standard attributes.",
			13,
			{ Size = UDim2.new(1, -470, 1, 0), TextColor3 = C.Muted }
		)
		Kit.Button(header, ("Respec (%d ¢)"):format(SkillTree.RespecCost), function()
			task.spawn(function()
				local ok, success, reason = pcall(Net.Invoke, "Skill.Respec")
				message.Text = if ok and success then "Points refunded." else tostring(reason or "Can't respec")
			end)
		end, "Ghost", { Size = UDim2.fromOffset(170, 36) })

		local detail = Kit.Panel(container, {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 86),
			BackgroundColor3 = C.PanelLight,
		})
		Kit.Padding(detail, 10, 14)
		local detailTitle =
			Kit.Label(detail, "Select a skill", 16, { Font = Kit.Fonts.Bold, Size = UDim2.new(1, 0, 0, 22) })
		local detailText = Kit.Label(detail, "Abilities unlock with your level; skills refine how they feel.", 14, {
			Position = UDim2.fromOffset(0, 24),
			Size = UDim2.new(1, 0, 0, 40),
			TextColor3 = C.Muted,
			TextYAlignment = Enum.TextYAlignment.Top,
		})

		local columns = Kit.new("Frame", {
			Position = UDim2.fromOffset(0, 50),
			Size = UDim2.new(1, 0, 1, -146),
			BackgroundTransparency = 1,
			Parent = container,
		})
		local grid = Kit.List(columns, true, 10)
		grid.VerticalAlignment = Enum.VerticalAlignment.Top
		for _, branch in SkillTree.Branches do
			local column = Kit.Scroll(columns, { Size = UDim2.new(0.25, -8, 1, 0) })
			Kit.List(column, false, 8)
			Kit.Label(column, branch.Name, 17, { Font = Kit.Fonts.Black, TextColor3 = branch.Color })
			Kit.Paragraph(column, branch.Blurb, 12, C.Muted)
			local nodes = {}
			for _, node in SkillTree.Nodes do
				if node.Branch == branch.Id then
					table.insert(nodes, node)
				end
			end
			table.sort(nodes, function(a, b)
				if a.Tier ~= b.Tier then
					return a.Tier < b.Tier
				end
				return a.Column < b.Column
			end)
			for _, node in nodes do
				local rank = ranks[node.Id] or 0
				local can, reason = SkillTree.CanUnlock(ranks, free, node.Id)
				local maxed = rank >= node.MaxRank
				local mark = if maxed then "✓" elseif can then "+" elseif rank > 0 then "◐" else "🔒"
				local button = Kit.Button(
					column,
					("%s %s  %d/%d"):format(mark, node.Name, rank, node.MaxRank),
					nil,
					if can then "Primary" else "Secondary",
					{
						Size = UDim2.new(1, -8, 0, 44),
						TextXAlignment = Enum.TextXAlignment.Left,
						BackgroundColor3 = if maxed
							then branch.Color:Lerp(C.PanelLight, 0.6)
							elseif can then C.Accent
							else C.PanelLight,
					}
				)
				Kit.Padding(button, 0, 10)
				if node.Capstone then
					local stroke = button:FindFirstChildOfClass("UIStroke")
					if stroke then
						stroke.Color = branch.Color
						stroke.Transparency = 0
					end
				end
				local function describe()
					detailTitle.Text = ("%s  ·  rank %d/%d  ·  %d point%s"):format(
						node.Name,
						rank,
						node.MaxRank,
						node.Cost,
						if node.Cost == 1 then "" else "s"
					)
					local status = if maxed
						then "Maxed."
						elseif can then "Click to learn the next rank."
						else (reason or "Locked")
					detailText.Text = node.Description .. "  " .. status
				end
				button.MouseEnter:Connect(describe)
				button.SelectionGained:Connect(describe)
				button.Activated:Connect(function()
					describe()
					if not can then
						Sfx.Stinger("Error")
						return
					end
					task.spawn(function()
						local ok, success, why = pcall(Net.Invoke, "Skill.Unlock", node.Id)
						if ok and success then
							Sfx.Stinger("Unlock")
						else
							detailText.Text = tostring(why or "Couldn't learn that")
						end
					end)
				end)
			end
		end
		-- Upcoming ability unlocks, so players always know what's next.
		local level = State.Level()
		local upcoming = nil
		for _, ability in Abilities.List do
			if ability.Level > level and (not upcoming or ability.Level < upcoming.Level) then
				upcoming = ability
			end
		end
		if upcoming then
			detailText.Text ..= ("\nNext ability: %s at level %d."):format(upcoming.Name, upcoming.Level)
		end
	end,
}
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="133">
              <Properties>
                <string name="Name">Social</string>
                <string name="Source"><![CDATA[-- Social pages: the race board (open races and relay teams, your lobby,
-- readying up and inviting people), your crew (members, weekly crew goal,
-- invites) and everyone in this server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Courses = require(ReplicatedStorage.Shared.Config.Courses)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Net = require(ReplicatedStorage.Shared.Net)

local State = require(script.Parent.Parent.Parent.Core.State)
local Modes = require(script.Parent.Parent.Parent.Gameplay.Modes)
local Kit = require(script.Parent.Parent.Kit)

local C = Kit.Colors
local player = Players.LocalPlayer

local function invitePicker(parent: Instance, kind: string)
	local box = Kit.Card(parent)
	Kit.Label(box, "Invite someone", 15, { Font = Kit.Fonts.Bold })
	local status = Kit.Paragraph(box, "Loading players…", 13, C.Faint)
	task.spawn(function()
		local ok, list = pcall(Net.Invoke, "Social.Players")
		if not ok or type(list) ~= "table" or not box.Parent then
			status.Text = "Couldn't list players."
			return
		end
		status.Text = ""
		local any = false
		for _, entry in list do
			if not entry.You then
				any = true
				local row = Kit.Row(box, 36, 8)
				Kit.Label(
					row,
					("%s%s  Lv %d"):format(if entry.Friend then "★ " else "", entry.Name, entry.Level or 1),
					14,
					{ Size = UDim2.new(1, -130, 1, 0) }
				)
				Kit.Button(row, "Invite", function()
					Net.Send("Social.Invite", entry.UserId, kind)
				end, "Secondary", { Size = UDim2.fromOffset(110, 32) })
			end
		end
		if not any then
			status.Text = "Nobody else is in this server yet. Invite friends from the Roblox menu!"
		end
	end)
end

-- Races --------------------------------------------------------------------------------------------------

local function lobbyCard(parent: Instance, data: any, isRelay: boolean)
	local card = Kit.Card(parent)
	Kit.Label(
		card,
		("%s · %s"):format(if isRelay then "RELAY TEAM" else "YOUR RACE", tostring(data.CourseName)),
		17,
		{ Font = Kit.Fonts.Black, TextColor3 = Color3.fromRGB(255, 120, 220) }
	)
	Kit.Paragraph(
		card,
		("%d / %d runners · %s"):format(
			#(data.Members or {}),
			data.Max or 8,
			if data.State == "Running" then "running now" else "in the lobby"
		),
		13,
		C.Muted
	)
	local mine = false
	for _, member in data.Members or {} do
		if member.UserId == player.UserId then
			mine = member.Ready
		end
		Kit.Label(
			card,
			("%s %s%s"):format(
				if member.Ready then "✓" else "…",
				member.Name,
				if member.Host then " (host)" else ""
			),
			14,
			{ TextColor3 = if member.Ready then C.Good else C.Text }
		)
	end
	if not isRelay and data.Results and #data.Results > 0 then
		Kit.Label(card, "Last race", 14, { Font = Kit.Fonts.Bold, TextColor3 = C.Accent })
		for _, result in data.Results do
			Kit.Label(card, ("%d. %s  %s"):format(result.Place, result.Name, Format.Time(result.Seconds)), 14)
		end
	end
	if data.State ~= "Running" then
		local row = Kit.Row(card, 42, 8)
		Kit.Button(row, if mine then "Not ready" else "Ready!", function()
			Net.Send(if isRelay then "Relay.Ready" else "Race.Ready", not mine)
		end, if mine then "Secondary" else "Primary", { Size = UDim2.fromOffset(140, 38) })
		Kit.Button(row, "Leave", function()
			Net.Send(if isRelay then "Relay.Leave" else "Race.Leave")
		end, "Ghost", { Size = UDim2.fromOffset(100, 38) })
		Kit.Paragraph(
			card,
			"Everyone readies up and the countdown starts. Races use standard attributes and the course's full kit.",
			12,
			C.Faint
		)
		invitePicker(card, if isRelay then "Relay" else "Race")
	end
end

local function buildRaces(container: Frame)
	local scroll = Kit.Scroll(container)
	Kit.List(scroll, false, 10)
	Kit.Padding(scroll, 4)
	if Modes.Race then
		lobbyCard(scroll, Modes.Race, false)
	end
	if Modes.Relay then
		lobbyCard(scroll, Modes.Relay, true)
	end
	Kit.Label(scroll, "Open in this server", 18, { Font = Kit.Fonts.Black, TextColor3 = C.Accent })
	local openList = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = scroll,
	})
	Kit.List(openList, false, 6)
	local status = Kit.Paragraph(openList, "Checking the board…", 13, C.Faint)
	local message = Kit.Paragraph(scroll, "", 13, C.Bad)
	task.spawn(function()
		local data = Modes.RaceList()
		if not openList.Parent then
			return
		end
		status.Text = ""
		local count = 0
		for _, entry in (if type(data) == "table" then data.Races or {} else {}) :: { any } do
			if entry.State == "Lobby" and not (Modes.Race and Modes.Race.Id == entry.Id) then
				count += 1
				local row = Kit.Row(openList, 40, 8)
				Kit.Label(
					row,
					("Race · %s · %d/%d"):format(entry.CourseName, #entry.Members, entry.Max),
					14,
					{ Size = UDim2.new(1, -130, 1, 0) }
				)
				Kit.Button(row, "Join", function()
					task.spawn(function()
						local ok, info = Modes.JoinRace(entry.Id)
						if not ok then
							message.Text = tostring(info)
						end
					end)
				end, "Primary", { Size = UDim2.fromOffset(110, 34) })
			end
		end
		for _, entry in (if type(data) == "table" then data.Relays or {} else {}) :: { any } do
			if entry.State == "Lobby" and not (Modes.Relay and Modes.Relay.Id == entry.Id) then
				count += 1
				local row = Kit.Row(openList, 40, 8)
				Kit.Label(
					row,
					("Relay · %s · %d/%d"):format(entry.CourseName, #entry.Members, entry.Max),
					14,
					{ Size = UDim2.new(1, -130, 1, 0) }
				)
				Kit.Button(row, "Join team", function()
					task.spawn(function()
						local ok, info = Modes.JoinRelay(entry.Id)
						if not ok then
							message.Text = tostring(info)
						end
					end)
				end, "Primary", { Size = UDim2.fromOffset(110, 34) })
			end
		end
		if count == 0 then
			status.Text = "No open races. Start one below!"
		end
	end)
	-- Start something.
	Kit.Label(scroll, "Start a race", 18, { Font = Kit.Fonts.Black, TextColor3 = C.Accent })
	local profile = State.Profile
	local any = false
	for _, course in Courses.List do
		local record = profile and profile.Courses and profile.Courses[course.Id]
		if
			(course.Kind == "Course" or course.Kind == "Relay") and record and (record.Completions or 0) > 0
			or course.District == "Hub" and course.Kind ~= "Room"
		then
			any = true
			local row = Kit.Row(scroll, 40, 8)
			Kit.Label(row, ("%s · %s"):format(course.Name, course.District), 14, { Size = UDim2.new(1, -170, 1, 0) })
			Kit.Button(row, if course.Kind == "Relay" then "Form relay" else "Open race", function()
				task.spawn(function()
					local ok, info
					if course.Kind == "Relay" then
						ok, info = Modes.CreateRelay(course.Id)
					else
						ok, info = Modes.CreateRace(course.Id)
					end
					if not ok then
						message.Text = tostring(info)
					end
				end)
			end, "Secondary", { Size = UDim2.fromOffset(150, 34) })
		end
	end
	if not any then
		Kit.Paragraph(scroll, "Finish a course to open races on it.", 13, C.Faint)
	end
end

-- Crew -----------------------------------------------------------------------------------------------------

local function buildCrew(container: Frame)
	local scroll = Kit.Scroll(container)
	Kit.List(scroll, false, 10)
	Kit.Padding(scroll, 4)
	local status = Kit.Paragraph(scroll, "Loading crew…", 13, C.Faint)
	task.spawn(function()
		local ok, crew = pcall(Net.Invoke, "Crew.Get")
		if not scroll.Parent then
			return
		end
		status.Text = ""
		if ok and type(crew) == "table" then
			Kit.Label(
				scroll,
				("[%s] %s"):format(crew.Tag, crew.Name),
				24,
				{ Font = Kit.Fonts.Black, TextColor3 = C.Good }
			)
			local goal = Kit.Card(scroll)
			Kit.Label(
				goal,
				("Weekly crew goal · resets in %s"):format(Format.Duration(crew.ResetIn or 0)),
				15,
				{ Font = Kit.Fonts.Bold }
			)
			local top = crew.Tiers[#crew.Tiers]
			local bar = Kit.Bar(goal, C.Good)
			bar.Set((crew.Points or 0) / top)
			local tiers = {}
			for index, needed in crew.Tiers do
				table.insert(
					tiers,
					("%s %d pts: %s"):format(
						if (crew.Points or 0) >= needed then "✓" else "·",
						needed,
						Kit.Rewards(crew.Rewards[index])
					)
				)
			end
			Kit.Paragraph(
				goal,
				("%d points this week (%d all time)\n%s"):format(
					crew.Points or 0,
					crew.Total or 0,
					table.concat(tiers, "\n")
				),
				13,
				C.Muted
			)
			Kit.Paragraph(goal, "Every course, race, relay and Spire floor a member finishes adds points.", 12, C.Faint)
			Kit.Label(scroll, "Members", 17, { Font = Kit.Fonts.Black, TextColor3 = C.Accent })
			for _, member in crew.Members do
				local row = Kit.Row(scroll, 36, 8)
				Kit.Label(
					row,
					("%s %s%s"):format(
						if member.Online then "●" else "○",
						member.Name,
						if member.Owner then " (leader)" else ""
					),
					14,
					{ Size = UDim2.new(1, -120, 1, 0), TextColor3 = if member.Online then C.Good else C.Muted }
				)
				if crew.IsOwner and not member.Owner then
					Kit.Button(row, "Remove", function()
						Net.Send("Crew.Kick", member.UserId)
					end, "Ghost", { Size = UDim2.fromOffset(100, 32) })
				end
			end
			-- Invite people in this server.
			local invite = Kit.Card(scroll)
			Kit.Label(invite, "Invite runners in this server", 15, { Font = Kit.Fonts.Bold })
			task.spawn(function()
				local okPlayers, list = pcall(Net.Invoke, "Social.Players")
				if okPlayers and type(list) == "table" then
					for _, entry in list do
						if not entry.You and not entry.Crew then
							local row = Kit.Row(invite, 36, 8)
							Kit.Label(
								row,
								("%s  Lv %d"):format(entry.Name, entry.Level or 1),
								14,
								{ Size = UDim2.new(1, -120, 1, 0) }
							)
							Kit.Button(row, "Invite", function()
								Net.Send("Crew.Invite", entry.UserId)
							end, "Secondary", { Size = UDim2.fromOffset(100, 32) })
						end
					end
				end
			end)
			Kit.Button(scroll, "Leave crew", function()
				Net.Send("Crew.Leave")
			end, "Danger", { Size = UDim2.fromOffset(160, 38) })
			return
		end
		-- No crew: create one.
		Kit.Paragraph(
			scroll,
			"Crews are small groups of runners who share a tag on their nametags and a weekly crew goal. Create one, or accept an invite from someone in your server.",
			14,
			C.Text
		)
		local form = Kit.Card(scroll)
		Kit.Label(form, "Found a crew", 16, { Font = Kit.Fonts.Bold })
		local function field(placeholder: string, max: number): TextBox
			local box = Kit.new("TextBox", {
				PlaceholderText = placeholder,
				Text = "",
				ClearTextOnFocus = false,
				BackgroundColor3 = C.Panel,
				TextColor3 = C.Text,
				PlaceholderColor3 = C.Faint,
				Font = Kit.Fonts.Medium,
				Size = UDim2.new(1, 0, 0, 38),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = form,
			})
			Kit.TextSize(box, 15)
			Kit.Corner(box, 8)
			Kit.Padding(box, 0, 10)
			box:GetPropertyChangedSignal("Text"):Connect(function()
				if #box.Text > max then
					box.Text = string.sub(box.Text, 1, max)
				end
			end)
			return box
		end
		local nameBox = field("Crew name (3-24 characters)", 24)
		local tagBox = field("Tag (2-4 letters)", 4)
		local note = Kit.Paragraph(form, "", 13, C.Bad)
		Kit.Button(form, "Create crew", function()
			note.Text = "Creating…"
			task.spawn(function()
				local okCreate, success, info = pcall(Net.Invoke, "Crew.Create", nameBox.Text, tagBox.Text)
				if okCreate and success then
					note.Text = ""
				else
					note.Text = tostring(info or "Couldn't create the crew")
				end
			end)
		end, "Primary", { Size = UDim2.fromOffset(160, 38) })
	end)
end

-- Players --------------------------------------------------------------------------------------------------

local function buildPlayers(container: Frame)
	local scroll = Kit.Scroll(container)
	Kit.List(scroll, false, 8)
	Kit.Padding(scroll, 4)
	local status = Kit.Paragraph(scroll, "Loading…", 13, C.Faint)
	task.spawn(function()
		local ok, list = pcall(Net.Invoke, "Social.Players")
		if not scroll.Parent then
			return
		end
		status.Text = ""
		if not ok or type(list) ~= "table" then
			status.Text = "Couldn't list players."
			return
		end
		table.sort(list, function(a, b)
			if a.Friend ~= b.Friend then
				return a.Friend
			end
			return (a.Level or 0) > (b.Level or 0)
		end)
		for _, entry in list do
			local card = Kit.Panel(scroll, { Size = UDim2.new(1, -8, 0, 70), BackgroundColor3 = C.PanelLight })
			Kit.Padding(card, 8, 12)
			local tag = if entry.Crew then ("[%s] "):format(entry.Crew) else ""
			Kit.Label(
				card,
				("%s%s%s  ·  Lv %d %s"):format(
					if entry.Friend then "★ " else "",
					tag,
					entry.Name,
					entry.Level or 1,
					entry.Rank or ""
				),
				16,
				{
					Font = Kit.Fonts.Bold,
					Size = UDim2.new(1, -250, 0, 24),
					TextColor3 = if entry.You then C.Accent else C.Text,
				}
			)
			Kit.Label(
				card,
				("%s%s · %s"):format(
					if entry.Title then ("“" .. entry.Title .. "” · ") else "",
					entry.District or "",
					entry.Activity or ""
				),
				13,
				{
					Position = UDim2.fromOffset(0, 26),
					Size = UDim2.new(1, -250, 0, 20),
					TextColor3 = C.Muted,
				}
			)
			if not entry.You then
				local actions = Kit.Row(card, 36, 6)
				actions.AnchorPoint = Vector2.new(1, 0.5)
				actions.Position = UDim2.new(1, 0, 0.5, 0)
				actions.Size = UDim2.fromOffset(240, 36)
				Kit.Button(actions, "Run together", function()
					Net.Send("Social.Invite", entry.UserId, "Join")
				end, "Secondary", { Size = UDim2.fromOffset(130, 32) })
				if Modes.Race then
					Kit.Button(actions, "Race", function()
						Net.Send("Social.Invite", entry.UserId, "Race")
					end, "Secondary", { Size = UDim2.fromOffset(90, 32) })
				end
			end
		end
	end)
end

return {
	Pages = {
		{
			Id = "Races",
			Title = "Races & Relays",
			Icon = "⚐",
			Order = 10,
			Sections = { "Courses" },
			Build = buildRaces,
		},
		{ Id = "Crew", Title = "Crew", Icon = "∞", Order = 11, Sections = { "Crew" }, Build = buildCrew },
		{ Id = "Players", Title = "Players", Icon = "☺", Order = 12, Build = buildPlayers },
	},
}
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="134">
            <Properties>
              <string name="Name">Root</string>
              <string name="Source"><![CDATA[-- The screen layers every interface module draws into.

local Players = game:GetService("Players")

local Settings = require(script.Parent.Parent.Core.Settings)

local Root = {}

Root.Hud = nil :: ScreenGui?
Root.Menu = nil :: ScreenGui?
Root.Overlay = nil :: ScreenGui?
Root.Touch = nil :: ScreenGui?

local function gui(name: string, order: number, inset: boolean): ScreenGui
	local screen = Instance.new("ScreenGui")
	screen.Name = name
	screen.DisplayOrder = order
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = inset
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return screen
end

function Root.Get(name: string): ScreenGui
	local screen = (Root :: any)[name]
	assert(screen, "UI layer " .. name .. " not started")
	return screen
end

function Root.Start()
	Root.Touch = gui("SkylineTouch", 4, true)
	Root.Hud = gui("SkylineHud", 5, true)
	Root.Menu = gui("SkylineMenu", 10, true)
	Root.Overlay = gui("SkylineOverlay", 20, true)
	-- HUD size follows its setting.
	local scale = Instance.new("UIScale")
	scale.Scale = Settings.Get("HudScale") or 1
	scale.Parent = Root.Hud
	Settings.Changed:Connect(function(id, value)
		if id == "HudScale" and type(value) == "number" then
			scale.Scale = value
		end
	end)
end

return Root
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="135">
            <Properties>
              <string name="Name">Touch</string>
              <string name="Source"><![CDATA[-- On-screen controls for touch devices: a large jump button under the right
-- thumb with crouch/slide, dash, grapple, sprint and retry around it, plus a
-- menu button. Button size follows the Touch Button Size setting; abilities
-- you haven't unlocked yet stay hidden so the screen stays clear.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Bus = require(script.Parent.Parent.Core.Bus)
local Input = require(script.Parent.Parent.Core.Input)
local Settings = require(script.Parent.Parent.Core.Settings)
local Controller = require(script.Parent.Parent.Movement.Controller)
local Kit = require(script.Parent.Kit)
local Root = require(script.Parent.Root)

local C = Kit.Colors
local Touch = {}

type Spec = { Action: string, Label: string, Size: number, X: number, Y: number, Ability: string?, Toggle: boolean? }

-- Offsets from the bottom-right corner (before scaling).
local SPECS: { Spec } = {
	{ Action = "Jump", Label = "JUMP", Size = 96, X = -70, Y = -90 },
	{ Action = "Crouch", Label = "SLIDE", Size = 66, X = -176, Y = -52, Ability = "Slide" },
	{ Action = "Dash", Label = "DASH", Size = 62, X = -160, Y = -152, Ability = "Dash" },
	{ Action = "Grapple", Label = "HOOK", Size = 62, X = -80, Y = -198, Ability = "Grapple" },
	{ Action = "Sprint", Label = "RUN", Size = 54, X = -246, Y = -120, Toggle = true },
	{ Action = "Retry", Label = "↻", Size = 46, X = -40, Y = -262 },
}

local buttons: { [string]: { Button: TextButton, Spec: Spec } } = {}
local frame: Frame
local sprintOn = false

local function hideDefaultJump()
	local gui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local touchGui = gui and gui:FindFirstChild("TouchGui")
	local controls = touchGui and touchGui:FindFirstChild("TouchControlFrame")
	local jump = controls and controls:FindFirstChild("JumpButton")
	if jump and jump:IsA("GuiObject") then
		jump.Visible = false
	end
end

local function layout()
	local scale = Settings.Get("TouchButtonScale") or 1
	for _, entry in buttons do
		local spec = entry.Spec
		local size = spec.Size * scale
		entry.Button.Size = UDim2.fromOffset(size, size)
		entry.Button.Position = UDim2.new(1, spec.X * scale - size / 2, 1, spec.Y * scale - size / 2)
	end
end

local function make(spec: Spec)
	local button = Kit.new("TextButton", {
		Name = spec.Action,
		Text = spec.Label,
		AutoButtonColor = false,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.35,
		TextColor3 = C.Text,
		Font = Kit.Fonts.Black,
		Active = true,
		Parent = frame,
	})
	Kit.TextSize(button, if spec.Size > 80 then 18 else 14)
	Kit.Corner(button, 999)
	local stroke = Kit.Stroke(button, C.Text, 2, 0.5)
	local active: InputObject? = nil
	local function set(down: boolean)
		button.BackgroundTransparency = if down then 0.05 else 0.35
		stroke.Transparency = if down then 0 else 0.5
	end
	button.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch or active then
			return
		end
		active = input
		if spec.Toggle then
			sprintOn = not sprintOn
			Input.Touch(spec.Action, sprintOn)
			set(sprintOn)
		else
			Input.Touch(spec.Action, true)
			set(true)
		end
	end)
	button.InputEnded:Connect(function(input)
		if input ~= active then
			return
		end
		active = nil
		if not spec.Toggle then
			Input.Touch(spec.Action, false)
			set(false)
		end
	end)
	buttons[spec.Action] = { Button = button, Spec = spec }
end

local function refresh()
	local touch = Input.Device == "Touch"
	frame.Visible = touch and Controller.Enabled
	if not touch then
		return
	end
	hideDefaultJump()
	for _, entry in buttons do
		local ability = entry.Spec.Ability
		entry.Button.Visible = ability == nil or Controller.Has(ability)
	end
	-- The grapple button lights up when there's something to hook.
	local hook = buttons.Grapple
	if hook then
		hook.Button.TextColor3 = if Controller.Info.GrappleTarget then C.Signal else C.Muted
	end
	local dash = buttons.Dash
	if dash then
		dash.Button.TextColor3 = if Controller.Info.DashCharges > 0 then C.Text else C.Faint
	end
end

function Touch.Start()
	local gui = Root.Get("Touch")
	frame =
		Kit.new("Frame", { Name = "Controls", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	for _, spec in SPECS do
		make(spec)
	end
	local menu = Kit.Button(frame, "☰", function()
		Bus.OpenPage:Fire("Map", nil)
	end, "Ghost", { Size = UDim2.fromOffset(48, 48), Position = UDim2.new(1, -64, 0, GuiService:GetGuiInset().Y + 8) })
	menu.Name = "Menu"
	layout()
	Settings.Changed:Connect(function(id)
		if id == "TouchButtonScale" then
			layout()
		end
	end)
	Input.DeviceChanged:Connect(refresh)
	local last = 0
	RunService.Heartbeat:Connect(function()
		if os.clock() - last > 0.2 then
			last = os.clock()
			refresh()
		end
	end)
	refresh()
end

return Touch
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="136">
          <Properties>
            <string name="Name">World</string>
          </Properties>
          <Item class="ModuleScript" referent="137">
            <Properties>
              <string name="Name">Atmosphere</string>
              <string name="Source"><![CDATA[-- Per-district lighting, time of day and weather.
--
-- Each district has its own look (Config/Districts.Lighting): warm morning
-- rooftops, an amber industrial dusk, a misty garden, a neon city at night, a
-- bright cold summit and a golden sky citadel. Crossing between districts
-- blends everything over a few seconds. Time of day moves through each
-- district's range on a shared clock, and weather comes and goes in windows
-- every player sees at the same time.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Rotation = require(ReplicatedStorage.Shared.Logic.Rotation)
local Schedule = require(ReplicatedStorage.Shared.Logic.Schedule)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local Settings = require(script.Parent.Parent.Core.Settings)
local Controller = require(script.Parent.Parent.Movement.Controller)

local Atmosphere = {}

Atmosphere.District = "Hub"
Atmosphere.Changed = Signal.new() -- (districtId, previous)
Atmosphere.WeatherChanged = Signal.new() -- (kind or nil)

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- The Dreamline floats outside every district.
local DREAM: Districts.Lighting = {
	Clock = { 0.5, 2.5 },
	CycleMinutes = 30,
	Brightness = 1.6,
	Ambient = rgb(120, 90, 150),
	OutdoorAmbient = rgb(150, 110, 190),
	ShiftTop = rgb(255, 170, 240),
	ShiftBottom = rgb(90, 110, 255),
	Exposure = 0.25,
	Atmosphere = {
		Density = 0.38,
		Offset = 0.3,
		Color = rgb(190, 150, 255),
		Decay = rgb(255, 150, 220),
		Glare = 0.6,
		Haze = 2.2,
	},
	Bloom = { Intensity = 0.9, Size = 30, Threshold = 1.2 },
	Grade = { Brightness = 0.04, Contrast = 0.12, Saturation = 0.25, Tint = rgb(255, 235, 255) },
	SunRays = 0.12,
	Clouds = { Cover = 0.7, Density = 0.5, Color = rgb(255, 200, 250) },
	Night = rgb(60, 40, 90),
}

local atmosphere: Atmosphere
local bloom: BloomEffect
local grade: ColorCorrectionEffect
local rays: SunRaysEffect
local clouds: Clouds?

local target: Districts.Lighting = DREAM
local blend = 1
local weatherKind: string? = nil

-- Weather emitters on a part that follows the camera.
local weatherPart = Instance.new("Part")
weatherPart.Name = "SkylineWeather"
weatherPart.Anchored = true
weatherPart.CanCollide = false
weatherPart.CanQuery = false
weatherPart.CanTouch = false
weatherPart.Transparency = 1
weatherPart.Size = Vector3.new(140, 1, 140)
local emitters: { [string]: ParticleEmitter } = {}
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function makeEmitter(kind: string): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = kind
	e.Shape = Enum.ParticleEmitterShape.Box
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	e.EmissionDirection = Enum.NormalId.Bottom
	e.Enabled = false
	e.LightInfluence = 0.6
	if kind == "Drizzle" then
		e.Texture = SPARKLE
		e.Color = ColorSequence.new(rgb(200, 215, 235))
		e.Transparency = NumberSequence.new(0.45)
		e.Size = NumberSequence.new(0.12)
		e.Squash = NumberSequence.new(-2.6)
		e.Orientation = Enum.ParticleOrientation.VelocityParallel
		e.Speed = NumberRange.new(90, 110)
		e.Lifetime = NumberRange.new(0.6, 0.9)
		e.Rate = 900
	elseif kind == "Snow" then
		e.Texture = SPARKLE
		e.Color = ColorSequence.new(rgb(255, 255, 255))
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0.15) })
		e.Speed = NumberRange.new(6, 12)
		e.Lifetime = NumberRange.new(5, 7)
		e.Acceleration = Vector3.new(4, 0, 2)
		e.SpreadAngle = Vector2.new(20, 20)
		e.Rate = 320
	elseif kind == "Embers" then
		e.Texture = SPARKLE
		e.EmissionDirection = Enum.NormalId.Top
		e.Color = ColorSequence.new(rgb(255, 170, 60), rgb(255, 80, 30))
		e.LightEmission = 1
		e.LightInfluence = 0
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.22), NumberSequenceKeypoint.new(1, 0) })
		e.Speed = NumberRange.new(4, 10)
		e.Lifetime = NumberRange.new(3, 5)
		e.Acceleration = Vector3.new(2, 3, 0)
		e.SpreadAngle = Vector2.new(40, 40)
		e.Rate = 70
	elseif kind == "Leaves" then
		e.Texture = SMOKE
		e.Color = ColorSequence.new(rgb(120, 170, 70), rgb(220, 150, 60))
		e.Size = NumberSequence.new(0.35)
		e.Squash = NumberSequence.new(0.6)
		e.Speed = NumberRange.new(3, 6)
		e.Lifetime = NumberRange.new(6, 8)
		e.RotSpeed = NumberRange.new(-200, 200)
		e.Rotation = NumberRange.new(0, 360)
		e.Acceleration = Vector3.new(3, -2, 1)
		e.Rate = 40
	else -- Motes
		e.Texture = SPARKLE
		e.Color = ColorSequence.new(rgb(255, 240, 200))
		e.LightEmission = 0.8
		e.LightInfluence = 0
		e.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.3),
			NumberSequenceKeypoint.new(1, 1),
		})
		e.Size = NumberSequence.new(0.18)
		e.Speed = NumberRange.new(0.4, 1.4)
		e.Lifetime = NumberRange.new(4, 7)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Rate = 60
	end
	e:SetAttribute("BaseRate", e.Rate)
	e.Parent = weatherPart
	return e
end

-- Is a district's weather active right now? Same answer for every player.
local function weatherFor(id: string): string?
	local district = Districts.ById[id]
	local weather = if district then district.Weather else { Kind = "Motes", Chance = 1 }
	local window = math.floor(Schedule.Now() / 240)
	local roll = (Rotation.Hash("weather", id, window) % 1000) / 1000
	if roll < weather.Chance then
		return weather.Kind
	end
	return nil
end

local function lightingFor(id: string): Districts.Lighting
	if id == "Dreamline" then
		return DREAM
	end
	local district = Districts.ById[id] or Districts.ById.Hub
	return district.Lighting
end

local function districtAt(position: Vector3): string?
	if (position - Districts.Dreamline).Magnitude < 2600 then
		return "Dreamline"
	end
	local district = Districts.At(position)
	return if district then district.Id else nil
end

-- Blend helpers.
local function lerpNumber(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function apply(dt: number)
	local l = target
	local t = 1 - math.exp(-dt * 0.9)
	if blend < 1 then
		blend = math.min(blend + dt * 0.35, 1)
	else
		t = 1 - math.exp(-dt * 3)
	end
	Lighting.Brightness = lerpNumber(Lighting.Brightness, l.Brightness, t)
	Lighting.Ambient = Lighting.Ambient:Lerp(l.Ambient, t)
	Lighting.OutdoorAmbient = Lighting.OutdoorAmbient:Lerp(l.OutdoorAmbient, t)
	Lighting.ColorShift_Top = Lighting.ColorShift_Top:Lerp(l.ShiftTop, t)
	Lighting.ColorShift_Bottom = Lighting.ColorShift_Bottom:Lerp(l.ShiftBottom, t)
	Lighting.ExposureCompensation = lerpNumber(Lighting.ExposureCompensation, l.Exposure, t)
	local a = l.Atmosphere
	atmosphere.Density = lerpNumber(atmosphere.Density, a.Density, t)
	atmosphere.Offset = lerpNumber(atmosphere.Offset, a.Offset, t)
	atmosphere.Color = atmosphere.Color:Lerp(a.Color, t)
	atmosphere.Decay = atmosphere.Decay:Lerp(a.Decay, t)
	atmosphere.Glare = lerpNumber(atmosphere.Glare, a.Glare, t)
	atmosphere.Haze =
		lerpNumber(atmosphere.Haze, a.Haze + (if weatherKind == "Drizzle" or weatherKind == "Snow" then 0.8 else 0), t)
	bloom.Intensity = lerpNumber(bloom.Intensity, l.Bloom.Intensity, t)
	bloom.Size = lerpNumber(bloom.Size, l.Bloom.Size, t)
	bloom.Threshold = lerpNumber(bloom.Threshold, l.Bloom.Threshold, t)
	grade.Brightness = lerpNumber(grade.Brightness, l.Grade.Brightness, t)
	grade.Contrast = lerpNumber(grade.Contrast, l.Grade.Contrast, t)
	grade.Saturation = lerpNumber(grade.Saturation, l.Grade.Saturation, t)
	grade.TintColor = grade.TintColor:Lerp(l.Grade.Tint, t)
	rays.Intensity = lerpNumber(rays.Intensity, l.SunRays, t)
	local c = clouds
	if c then
		c.Cover = lerpNumber(c.Cover, l.Clouds.Cover + (if weatherKind == "Drizzle" then 0.25 else 0), t)
		c.Density = lerpNumber(c.Density, l.Clouds.Density, t)
		c.Color = c.Color:Lerp(l.Clouds.Color, t)
	end

	-- Time of day moves through the district's range on a shared clock.
	local clock = l.Clock
	local target_: number
	if Settings.Get("DayCycle") then
		local phase = Schedule.PingPong(Schedule.Now(), l.CycleMinutes * 60, 0)
		target_ = lerpNumber(clock[1], clock[2], phase)
	else
		target_ = (clock[1] + clock[2]) / 2
	end
	local current = Lighting.ClockTime
	local delta = (target_ - current + 12) % 24 - 12
	Lighting.ClockTime = (current + delta * t) % 24
	Lighting.GlobalShadows = Settings.Get("Shadows") ~= false and Settings.Quality() ~= "Low"
end

local function setDistrict(id: string)
	if id == Atmosphere.District then
		return
	end
	local previous = Atmosphere.District
	Atmosphere.District = id
	target = lightingFor(id)
	blend = 0
	Atmosphere.Changed:Fire(id, previous)
end

local function updateWeather()
	local kind = if Settings.Get("Weather") then weatherFor(Atmosphere.District) else nil
	if kind ~= weatherKind then
		weatherKind = kind
		Atmosphere.WeatherChanged:Fire(kind)
	end
	local scale = if Settings.Quality() == "Low" then 0.35 elseif Settings.Quality() == "Medium" then 0.65 else 1
	for name, emitter in emitters do
		local on = name == kind
		emitter.Enabled = on
		local base = emitter:GetAttribute("BaseRate")
		if type(base) == "number" then
			emitter.Rate = base * scale
		end
	end
end

function Atmosphere.Weather(): string?
	return weatherKind
end

function Atmosphere.Start()
	local existing = Lighting:FindFirstChildOfClass("Atmosphere")
	atmosphere = existing or Instance.new("Atmosphere")
	atmosphere.Parent = Lighting
	bloom = Instance.new("BloomEffect")
	bloom.Name = "SkylineBloom"
	bloom.Parent = Lighting
	grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "SkylineGrade"
	grade.Parent = Lighting
	rays = Instance.new("SunRaysEffect")
	rays.Name = "SkylineRays"
	rays.Spread = 0.8
	rays.Parent = Lighting
	local ok, made = pcall(function()
		local c = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
		c.Parent = workspace.Terrain
		return c
	end)
	if ok then
		clouds = made
	end
	for _, kind in { "Drizzle", "Snow", "Embers", "Leaves", "Motes" } do
		emitters[kind] = makeEmitter(kind)
	end

	target = lightingFor("Hub")
	Atmosphere.District = "Hub"
	blend = 1
	local lastCheck = 0
	local lastWeather = 0
	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		local root = Controller.Info.Root
		local camera = workspace.CurrentCamera
		local position = if root then root.Position elseif camera then camera.CFrame.Position else nil
		if position and now - lastCheck > 0.5 then
			lastCheck = now
			local id = districtAt(position)
			if id then
				setDistrict(id)
			end
		end
		if now - lastWeather > 2 then
			lastWeather = now
			updateWeather()
		end
		apply(dt)
		if camera then
			local offset = if weatherKind == "Embers"
				then Vector3.new(0, -30, 0)
				elseif weatherKind == "Motes" then Vector3.zero
				else Vector3.new(0, 34, 0)
			weatherPart.Size = if weatherKind == "Motes" then Vector3.new(90, 40, 90) else Vector3.new(140, 1, 140)
			weatherPart.CFrame = CFrame.new(camera.CFrame.Position + offset)
			weatherPart.Parent = camera
		end
	end)
	Controller.Teleported:Connect(function(cframe: CFrame)
		local id = districtAt(cframe.Position)
		if id then
			setDistrict(id)
		end
	end)
	Players.LocalPlayer.CharacterAdded:Connect(function(character)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and root:IsA("BasePart") then
			local id = districtAt(root.Position)
			if id then
				setDistrict(id)
				blend = 1
			end
		end
	end)
end

return Atmosphere
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="138">
            <Properties>
              <string name="Name">Detail</string>
              <string name="Source"><![CDATA[-- Level of detail for a city of tens of thousands of parts.
--
-- Every district is built as Core (everything you can touch), Decor (windows,
-- railings, plants, lights) and Far (large silhouettes that are always shown).
-- Decor is only kept for districts near the camera, and on Low quality the
-- Core of distant districts is dropped too; their Far silhouettes still give
-- the skyline its shape. Changes happen locally on this client only.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Districts = require(ReplicatedStorage.Shared.Config.Districts)

local Settings = require(script.Parent.Parent.Core.Settings)
local Controller = require(script.Parent.Parent.Movement.Controller)

local Detail = {}

type Entry = {
	Root: Instance,
	Center: Vector3,
	Core: Instance?,
	Decor: Instance?,
	CoreShown: boolean,
	DecorShown: boolean,
}

local entries: { Entry } = {}
local stash = Instance.new("Folder")
stash.Name = "SkylineHiddenDetail"

local function centerFor(root: Instance): Vector3
	local id = root:GetAttribute("District") or root.Name
	if id == "Dreamline" then
		return Districts.Dreamline
	elseif id == "Spire" then
		return Districts.ById.Hub.Origin + Districts.SpireOffset
	end
	local district = Districts.ById[id]
	if district then
		return district.Origin
	end
	if root:IsA("Model") then
		return root:GetPivot().Position
	end
	return Vector3.zero
end

local function scan(world: Instance)
	table.clear(entries)
	for _, root in world:GetChildren() do
		local core = root:FindFirstChild("Core")
		local decor = root:FindFirstChild("Decor")
		if core or decor then
			table.insert(entries, {
				Root = root,
				Center = centerFor(root),
				Core = core,
				Decor = decor,
				CoreShown = true,
				DecorShown = true,
			})
		end
	end
end

-- Distances (flat, studs) within which detail is kept, by quality.
local RANGES = {
	High = { Decor = 1300, Core = math.huge },
	Medium = { Decor = 950, Core = math.huge },
	Low = { Decor = 650, Core = 1500 },
}

function Detail.Update(position: Vector3)
	local range = RANGES[Settings.Quality()] or RANGES.High
	for _, entry in entries do
		local offset = entry.Center - position
		local distance = Vector3.new(offset.X, offset.Y * 0.5, offset.Z).Magnitude
		local wantDecor = distance < range.Decor
		local wantCore = distance < range.Core
		if entry.Decor and wantDecor ~= entry.DecorShown then
			entry.DecorShown = wantDecor
			entry.Decor.Parent = if wantDecor then entry.Root else stash
		end
		if entry.Core and wantCore ~= entry.CoreShown then
			entry.CoreShown = wantCore
			entry.Core.Parent = if wantCore then entry.Root else stash
		end
	end
end

function Detail.Start()
	local world = workspace:WaitForChild("SkylineWorld", 60)
	if not world then
		return
	end
	-- Give replication a moment to deliver the district folders.
	task.wait(1)
	scan(world)
	world.ChildAdded:Connect(function()
		task.defer(scan, world)
	end)
	local last = 0
	local function update()
		local root = Controller.Info.Root
		local camera = workspace.CurrentCamera
		local position = if root then root.Position elseif camera then camera.CFrame.Position else nil
		if position then
			Detail.Update(position)
		end
	end
	RunService.Heartbeat:Connect(function()
		if os.clock() - last > 0.75 then
			last = os.clock()
			update()
		end
	end)
	-- Teleports must arrive in a fully built district.
	Controller.Teleported:Connect(function(cframe: CFrame)
		Detail.Update(cframe.Position)
	end)
	Settings.Changed:Connect(function(id)
		if id == "Quality" then
			update()
		end
	end)
end

return Detail
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="139">
            <Properties>
              <string name="Name">Hazards</string>
              <string name="Source"><![CDATA[-- Hazards, falls and instant recovery.
--
-- Touching a live hazard (lasers, sweepers' red cousins, rising water) or
-- falling out of the world sends you back. In a course that's your last
-- checkpoint (handled by whoever registered a handler, e.g. the course or
-- lesson client); while exploring it's the most recent safe ground you stood
-- on, so a missed jump costs a second, never a long walk back.
--
-- The hurtbox follows posture: sliding really does pass under a high laser.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local MathUtil = require(ReplicatedStorage.Shared.Util.MathUtil)
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Tags = require(ReplicatedStorage.Shared.Tags)

local Controller = require(script.Parent.Parent.Movement.Controller)
local Mechanisms = require(script.Parent.Mechanisms)

local player = Players.LocalPlayer

local Hazards = {}

-- (reason, destination) after every respawn.
Hazards.Respawned = Signal.new()
-- (reason) just before a respawn, for sounds and effects.
Hazards.Hit = Signal.new()
-- Extra kill height set by courses/lessons (below it counts as a fall).
Hazards.KillY = nil :: number?

-- Handlers get first say over where a respawn goes. Return a CFrame to use it,
-- or nil to pass. The most recently pushed handler is asked first.
type Handler = (reason: string) -> CFrame?
local handlers: { { Id: string, Fn: Handler } } = {}

local SAFE_INTERVAL = 0.25
local SAFE_SPACING = 3
local SAFE_KEEP = 12

local safeSpots: { { Position: Vector3, Look: Vector3, Time: number } } = {}
local lastSafeCheck = 0
local busyUntil = 0
local hazardCache: { BasePart } = {}
local hazardCacheTime = 0
local worldFloor = -math.huge

-- Fade -------------------------------------------------------------------------------------------

local fadeGui = Instance.new("ScreenGui")
fadeGui.Name = "SkylineFade"
fadeGui.DisplayOrder = 50
fadeGui.IgnoreGuiInset = true
fadeGui.ResetOnSpawn = false
local fade = Instance.new("Frame")
fade.Size = UDim2.fromScale(1, 1)
fade.BackgroundColor3 = Color3.fromRGB(8, 10, 16)
fade.BackgroundTransparency = 1
fade.BorderSizePixel = 0
fade.Parent = fadeGui

local function fadeTo(transparency: number, seconds: number)
	TweenService:Create(fade, TweenInfo.new(seconds, Enum.EasingStyle.Quad), { BackgroundTransparency = transparency })
		:Play()
end

-- Safe ground ------------------------------------------------------------------------------------

local UNSAFE_TAGS =
	{ Tags.Mover, Tags.Timed, Tags.Collapse, Tags.Hazard, Tags.BouncePad, Tags.Conveyor, Tags.Balance, Tags.SwitchGate }

local function isSafeFloor(part: BasePart): boolean
	if not part.Anchored or not part.CanCollide then
		return false
	end
	for _, tag in UNSAFE_TAGS do
		if CollectionService:HasTag(part, tag) then
			return false
		end
	end
	-- Ledge-thin surfaces make poor respawn spots.
	local size = part.Size
	return math.min(size.X, size.Z) >= 3 or (part:IsA("Part") and part.Shape == Enum.PartType.Cylinder)
end

local function recordSafeSpot()
	local info = Controller.Info
	local root = info.Root
	local floor = info.Floor
	if not root or not floor or not info.Grounded then
		return
	end
	if info.State ~= "Ground" and info.State ~= "Crouch" then
		return
	end
	if not isSafeFloor(floor) then
		return
	end
	local position = root.Position
	local last = safeSpots[#safeSpots]
	if last and (last.Position - position).Magnitude < SAFE_SPACING then
		last.Time = os.clock()
		return
	end
	table.insert(
		safeSpots,
		{ Position = position, Look = MathUtil.FlatUnit(root.CFrame.LookVector), Time = os.clock() }
	)
	if #safeSpots > SAFE_KEEP then
		table.remove(safeSpots, 1)
	end
end

-- The latest safe spot that isn't the edge you just fell from.
local function bestSafeSpot(): CFrame?
	local now = os.clock()
	for i = #safeSpots, 1, -1 do
		local spot = safeSpots[i]
		-- Spots from the last instant before a fall are often right on the lip.
		if now - spot.Time > 0.4 or i == 1 then
			return CFrame.lookAt(
				spot.Position + Vector3.new(0, 0.5, 0),
				spot.Position + Vector3.new(0, 0.5, 0) + spot.Look
			)
		end
	end
	return nil
end

-- Respawning --------------------------------------------------------------------------------------

function Hazards.PushHandler(id: string, fn: Handler)
	Hazards.PopHandler(id)
	table.insert(handlers, { Id = id, Fn = fn })
end

function Hazards.PopHandler(id: string)
	for i = #handlers, 1, -1 do
		if handlers[i].Id == id then
			table.remove(handlers, i)
		end
	end
end

function Hazards.ClearSafeSpots()
	table.clear(safeSpots)
end

-- Send the runner back. `reason`: "Fall" | "Hazard" | "Water" | "Retry".
function Hazards.Respawn(reason: string)
	local now = os.clock()
	if now < busyUntil then
		return
	end
	local root = Controller.Info.Root
	local humanoid = Controller.Info.Humanoid
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	busyUntil = now + 0.5
	Hazards.Hit:Fire(reason)

	local destination: CFrame? = nil
	local handled = false
	for i = #handlers, 1, -1 do
		local result = handlers[i].Fn(reason)
		if result then
			destination = result
			handled = true
			break
		end
	end
	if not destination then
		destination = bestSafeSpot()
	end
	if not destination then
		-- Nothing safe recorded: the district's arrival point via the server.
		Net.Send("Move.Fall", reason, nil)
		local ok, allowed, target = pcall(Net.Invoke, "Travel.Spawn")
		if ok and allowed and typeof(target) == "CFrame" then
			destination = target
		end
	elseif not handled then
		Net.Send("Move.Fall", reason, destination.Position)
	end
	if not destination then
		busyUntil = 0
		return
	end

	local quick = reason == "Retry"
	fade.BackgroundTransparency = if quick then 0.4 else 0.15
	Controller.Teleport(destination)
	fadeTo(1, if quick then 0.18 else 0.3)
	Hazards.Respawned:Fire(reason, destination)
end

-- Hazard contact -----------------------------------------------------------------------------------

local function refreshHazards(position: Vector3)
	hazardCacheTime = os.clock()
	table.clear(hazardCache)
	for _, instance in CollectionService:GetTagged(Tags.Hazard) do
		if instance:IsA("BasePart") and instance.Parent then
			local reach = instance.Size.Magnitude / 2 + 120
			if (instance.Position - position).Magnitude < reach then
				table.insert(hazardCache, instance)
			end
		end
	end
	-- Lowest kill volume: anything far below it is out of the world.
	local lowest = math.huge
	for _, instance in CollectionService:GetTagged(Tags.KillZone) do
		if instance:IsA("BasePart") then
			lowest = math.min(lowest, instance.Position.Y - instance.Size.Y / 2)
		end
	end
	worldFloor = if lowest < math.huge then lowest - 40 else -1500
end

-- Points along the body that count for hits, by posture.
local function hurtPoints(root: BasePart): { Vector3 }
	local feet = root.Position - Vector3.new(0, 3, 0)
	local low = Controller.Info.Posture == "Low"
	local top = if low then 2.2 else 4.8
	local points = {}
	local y = 0.4
	while y <= top do
		table.insert(points, feet + Vector3.new(0, y, 0))
		y += 0.8
	end
	return points
end

local function checkHazards()
	local info = Controller.Info
	local root = info.Root
	if not root or os.clock() < busyUntil then
		return
	end
	if os.clock() - hazardCacheTime > 1 then
		refreshHazards(root.Position)
	end
	local points: { Vector3 }? = nil
	for _, part in hazardCache do
		if not part.Parent or not Mechanisms.IsLive(part) then
			continue
		end
		if (part.Position - root.Position).Magnitude > part.Size.Magnitude / 2 + 8 then
			continue
		end
		points = points or hurtPoints(root)
		local isWater = CollectionService:HasTag(part, Tags.Water)
		for _, point in points :: { Vector3 } do
			if MathUtil.InBox(part.CFrame, part.Size, point, if isWater then 0 else 0.25) then
				Hazards.Respawn(if isWater then "Water" else "Hazard")
				return
			end
		end
	end
end

function Hazards.Start()
	fadeGui.Parent = player:WaitForChild("PlayerGui")
	Controller.KillCheck = function(position: Vector3): boolean
		local killY = Hazards.KillY
		return position.Y < worldFloor or (killY ~= nil and position.Y < killY)
	end
	Controller.Fell:Connect(function(reason: string)
		Hazards.Respawn(reason)
	end)
	Controller.Teleported:Connect(function()
		-- A teleport that wasn't a respawn (travel, course start): old spots are stale.
		if os.clock() >= busyUntil then
			Hazards.ClearSafeSpots()
		end
	end)
	player.CharacterAdded:Connect(function()
		Hazards.ClearSafeSpots()
	end)
	RunService.Heartbeat:Connect(function()
		checkHazards()
		if os.clock() - lastSafeCheck >= SAFE_INTERVAL then
			lastSafeCheck = os.clock()
			recordSafeSpot()
		end
	end)
end

return Hazards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="140">
            <Properties>
              <string name="Name">Icons</string>
              <string name="Source"><![CDATA[-- Surface icons: small shape markers on interactive surfaces (climbable walls,
-- beams, anchors, ropes, hazards, mechanisms) so nothing in a route relies on
-- colour alone. "Nearby" shows them within a short range, "Always" from much
-- further, and High Contrast makes them bolder.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Tags = require(ReplicatedStorage.Shared.Tags)

local Settings = require(script.Parent.Parent.Core.Settings)

local Icons = {}

local function apply(gui: Instance)
	if not gui:IsA("BillboardGui") then
		return
	end
	local mode = Settings.Get("SurfaceIcons") or "Nearby"
	local high = Settings.Get("HighContrast") == true
	gui.Enabled = mode ~= "Off"
	gui.MaxDistance = if mode == "Always" then 160 else 60
	local label = gui:FindFirstChildOfClass("TextLabel")
	if label then
		label.BackgroundTransparency = if high then 0 else 0.25
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Thickness = if high then 3.5 else 2
		end
	end
end

local function applyAll()
	for _, gui in CollectionService:GetTagged(Tags.SurfaceIcon) do
		apply(gui)
	end
end

function Icons.Start()
	applyAll()
	CollectionService:GetInstanceAddedSignal(Tags.SurfaceIcon):Connect(apply)
	Settings.Changed:Connect(function(id)
		if id == "SurfaceIcons" or id == "HighContrast" then
			applyAll()
		end
	end)
end

return Icons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="141">
            <Properties>
              <string name="Name">Mechanisms</string>
              <string name="Source"><![CDATA[-- Animates every mechanism in the world on this client.
--
-- Moving platforms, swinging cargo, spinners, timed doors, retracting bridges,
-- blinking holograms, lasers, collapsing planks, pressure-plate gates and
-- rising water are all pure functions of shared server time (Logic/Schedule),
-- so every player sees the same door open at the same instant without the
-- server streaming a single CFrame. Parts are moved before physics each step
-- and the local runner is carried by whatever it stands on.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local MathUtil = require(ReplicatedStorage.Shared.Util.MathUtil)
local Net = require(ReplicatedStorage.Shared.Net)
local Schedule = require(ReplicatedStorage.Shared.Logic.Schedule)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Tags = require(ReplicatedStorage.Shared.Tags)

local Settings = require(script.Parent.Parent.Core.Settings)
local Controller = require(script.Parent.Parent.Movement.Controller)

local Mechanisms = {}

-- (switchId, secondsRemaining) whenever a gate the runner opened changes.
Mechanisms.SwitchChanged = Signal.new()
-- (part) when a collapsing plank starts to give way under the runner.
Mechanisms.Cracking = Signal.new()

type Entry = {
	Part: BasePart,
	Tag: string,
	Kind: string,
	Home: Vector3,
	Origin: CFrame,
	Last: CFrame,
	Base: { Transparency: number, Color: Color3, CanCollide: boolean },
	Emitters: { { Emitter: ParticleEmitter, Rate: number } }?,
	-- Collapse
	TriggeredAt: number?,
	FallAt: number?,
	-- Switch gates
	Open: number?,
	-- Water
	RiseStart: number?,
	Top: number?,
	-- Lasers: last visual mode, so sizes only change when it does
	Mode: string?,
}

local entries: { [BasePart]: Entry } = {}
local list: { Entry } = {}
local dirty = false
local live: { [BasePart]: boolean } = {}

local switchUntil: { [string]: number } = {} -- server time each gate stays open until
local lastPress: { [string]: number } = {}
local course: { Id: string?, Checkpoint: number, Restarted: number } = { Id = nil, Checkpoint = 0, Restarted = 0 }

local frame = 0
local WARN_COLOR = Color3.fromRGB(255, 176, 40)
local STOP_COLOR = Color3.fromRGB(235, 60, 60)
local GO_COLOR = Color3.fromRGB(80, 255, 120)

local function attr(part: Instance, name: string, default: any): any
	local value = part:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

local function vector(part: Instance, name: string): Vector3
	local value = part:GetAttribute(name)
	return if typeof(value) == "Vector3" then value else Vector3.zero
end

-- Registration ----------------------------------------------------------------------------------

local function register(instance: Instance, tag: string)
	if not instance:IsA("BasePart") then
		return
	end
	local part = instance
	if entries[part] then
		return
	end
	local origin = part:GetAttribute("Origin")
	local originCF = if typeof(origin) == "CFrame" then origin else part.CFrame
	local kind = attr(part, "Kind", tag)
	local home = originCF.Position
	local center = part:GetAttribute("Center")
	local pivot = part:GetAttribute("Pivot")
	if typeof(center) == "Vector3" then
		home = center
	elseif typeof(pivot) == "Vector3" then
		home = pivot
	end
	local entry: Entry = {
		Part = part,
		Tag = tag,
		Kind = kind,
		Home = home,
		Origin = originCF,
		Last = part.CFrame,
		Base = { Transparency = part.Transparency, Color = part.Color, CanCollide = part.CanCollide },
	}
	if tag == Tags.WindZone or tag == Tags.LaunchVent then
		local emitters = {}
		for _, descendant in part:GetDescendants() do
			if descendant:IsA("ParticleEmitter") then
				table.insert(emitters, { Emitter = descendant, Rate = descendant.Rate })
			end
		end
		entry.Emitters = emitters
	end
	if tag == Tags.SwitchGate then
		entry.Open = 0
	end
	entries[part] = entry
	dirty = true
end

local function unregister(instance: Instance)
	if instance:IsA("BasePart") and entries[instance] then
		entries[instance] = nil
		live[instance] = nil
		dirty = true
	end
end

local MANAGED =
	{ Tags.Mover, Tags.Timed, Tags.Collapse, Tags.Switch, Tags.SwitchGate, Tags.Water, Tags.WindZone, Tags.LaunchVent }

-- Behaviour ---------------------------------------------------------------------------------------

-- 0..1 openness of a timed part with a short ease at each change.
local function timedOpenness(t: number, part: BasePart): (number, boolean, boolean)
	local period = attr(part, "Period", 4)
	local onFraction = attr(part, "OnFraction", 0.5)
	local phase = attr(part, "Phase", 0)
	local warn = attr(part, "Warn", 0.6)
	local on, warning = Schedule.Cycle(t, period, onFraction, phase, warn)
	local into = Schedule.Fraction(t, period, phase) * period
	local onTime = period * onFraction
	local ease = 0.35
	local a
	if into < onTime then
		a = math.clamp(into / ease, 0, 1)
	else
		a = 1 - math.clamp((into - onTime) / ease, 0, 1)
	end
	return MathUtil.Smooth(a), on, warning
end

local function blinkOn(t: number, hz: number): boolean
	return (t * hz) % 1 < 0.5
end

local function stepMover(entry: Entry, t: number): CFrame?
	local part = entry.Part
	local kind = entry.Kind
	if kind == "Shuttle" or kind == "Linear" then
		local a = Schedule.Shuttle(t, attr(part, "Period", 6), attr(part, "Phase", 0), attr(part, "Hold", 0.3))
		return entry.Origin + vector(part, "Offset") * a
	elseif kind == "Orbit" then
		local angle = Schedule.Fraction(t, attr(part, "Period", 9), attr(part, "Phase", 0)) * math.pi * 2
		local radius = attr(part, "Radius", 10)
		local center = vector(part, "Center")
		return CFrame.new(center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius))
			* entry.Origin.Rotation
	elseif kind == "Pendulum" or kind == "PendulumRod" then
		local angle =
			Schedule.Pendulum(t, attr(part, "Period", 4), attr(part, "Amplitude", 0.4), attr(part, "Phase", 0))
		local pivot = vector(part, "Pivot")
		local axis = vector(part, "Axis")
		if axis.Magnitude < 0.5 then
			axis = Vector3.xAxis
		end
		local swing = CFrame.new(pivot) * CFrame.fromAxisAngle(axis.Unit, angle) * CFrame.new(-pivot)
		if kind == "PendulumRod" then
			return swing * entry.Origin
		end
		-- Cargo hangs level from parallel chains, so it's always safe to land on.
		return CFrame.new((swing * entry.Origin).Position) * entry.Origin.Rotation
	elseif kind == "Spin" then
		return entry.Origin * CFrame.Angles(0, math.rad(attr(part, "Speed", 30)) * t % (math.pi * 2), 0)
	end
	return nil
end

local function stepTimed(entry: Entry, t: number): CFrame?
	local part = entry.Part
	local kind = entry.Kind
	if kind == "Door" then
		local a = timedOpenness(t, part)
		return entry.Origin + vector(part, "Offset") * a
	elseif kind == "Retract" then
		local a, on, warning = timedOpenness(t, part)
		local cf = entry.Origin + vector(part, "Offset") * (1 - a)
		if on and warning and not Settings.Get("ReducedMotion") then
			-- A shudder before it pulls away.
			cf *= CFrame.new(math.sin(t * 60) * 0.06, 0, 0)
		end
		return cf
	elseif kind == "Blink" then
		local _, on, warning = timedOpenness(t, part)
		local base = entry.Base.Transparency
		if on then
			part.CanCollide = true
			part.Transparency = if warning and blinkOn(t, 7) then math.max(base, 0.55) else base
		else
			part.CanCollide = false
			part.Transparency = if warning and blinkOn(t, 5) then 0.6 else 0.88
		end
		live[part] = on
	elseif kind == "Laser" then
		local _, on, warning = timedOpenness(t, part)
		local mode = if on then "On" else "Off"
		if mode ~= entry.Mode then
			entry.Mode = mode
			local thickness = if on then 0.3 else 0.08
			part.Size = Vector3.new(part.Size.X, thickness, thickness)
		end
		if on then
			part.Transparency = entry.Base.Transparency
		elseif warning then
			-- About to fire: a thin flickering sighting line.
			part.Transparency = if blinkOn(t, 9) then 0.35 else 0.85
		else
			part.Transparency = 0.94
		end
		live[part] = on
	elseif kind == "LaserSweep" then
		local a = Schedule.PingPong(t, attr(part, "Period", 3), attr(part, "Phase", 0))
		live[part] = true
		return entry.Origin + vector(part, "Offset") * a
	elseif kind == "Lamp" then
		local _, on, warning = timedOpenness(t, part)
		-- Steady = safe, blinking = about to change, dim = closed. Readable without colour.
		if attr(part, "Traffic", false) then
			if warning then
				part.Color = WARN_COLOR
				part.Transparency = if blinkOn(t, 4) then 0 else 0.7
			elseif on then
				part.Color = GO_COLOR
				part.Transparency = 0
			else
				part.Color = STOP_COLOR
				part.Transparency = 0.45
			end
		else
			if warning and on then
				part.Color = WARN_COLOR
				part.Transparency = if blinkOn(t, 5) then 0 else 0.8
			elseif on then
				part.Color = WARN_COLOR
				part.Transparency = 0.5
			else
				part.Color = STOP_COLOR
				part.Transparency = 0.2
			end
		end
	end
	return nil
end

local function stepCollapse(entry: Entry, t: number, floor: BasePart?): CFrame?
	local part = entry.Part
	local clock = os.clock()
	if not entry.TriggeredAt then
		if floor == part then
			entry.TriggeredAt = clock
			entry.FallAt = clock + attr(part, "Delay", 0.45)
			Mechanisms.Cracking:Fire(part)
		end
		return nil
	end
	local fallAt = entry.FallAt or clock
	if clock < fallAt then
		-- Shake while it gives way.
		if Settings.Get("ReducedMotion") then
			return nil
		end
		local strength = 0.08 + 0.12 * (1 - (fallAt - clock) / attr(part, "Delay", 0.45))
		return entry.Origin
			* CFrame.new(math.sin(t * 71) * strength, 0, math.cos(t * 53) * strength)
			* CFrame.Angles(0, 0, math.sin(t * 40) * strength * 0.2)
	end
	local fallen = clock - fallAt
	if fallen < 0.01 + attr(part, "Respawn", 3.5) then
		part.CanCollide = false
		local drop = 0.5 * 90 * math.min(fallen, 1.4) ^ 2
		part.Transparency = math.clamp(entry.Base.Transparency + fallen * 0.8, 0, 1)
		return entry.Origin * CFrame.new(0, -drop, 0) * CFrame.Angles(fallen * 0.6, 0, fallen * 0.3)
	end
	-- Rebuilt.
	entry.TriggeredAt, entry.FallAt = nil, nil
	part.CanCollide = entry.Base.CanCollide
	part.Transparency = entry.Base.Transparency
	return entry.Origin
end

local function pressSwitch(entry: Entry, t: number)
	local part = entry.Part
	local id = attr(part, "SwitchId", "")
	local duration = attr(part, "Duration", 5)
	local wasOpen = (switchUntil[id] or 0) > t
	switchUntil[id] = math.max(switchUntil[id] or 0, t + duration)
	if not wasOpen then
		Mechanisms.SwitchChanged:Fire(id, duration)
	end
	-- Tell the server (co-op partners see the gate open too), at most once a second.
	if os.clock() - (lastPress[id] or 0) > 1 then
		lastPress[id] = os.clock()
		Net.Send("Switch.Press", id)
	end
end

local function stepSwitch(entry: Entry, t: number, root: BasePart?, floor: BasePart?)
	local part = entry.Part
	local id = attr(part, "SwitchId", "")
	if
		root
		and (
			floor == part
			or MathUtil.InBox(part.CFrame * CFrame.new(0, 2.5, 0), part.Size + Vector3.new(0.5, 5, 0.5), root.Position)
		)
	then
		pressSwitch(entry, t)
	end
	local remaining = (switchUntil[id] or 0) - t
	if remaining > 0 then
		part.Color = if remaining < 1.5 and blinkOn(t, 4) then WARN_COLOR else GO_COLOR
	else
		part.Color = entry.Base.Color
	end
end

local function stepGate(entry: Entry, t: number, dt: number): CFrame?
	local part = entry.Part
	local id = attr(part, "SwitchId", "")
	local open = (switchUntil[id] or 0) > t
	local current = entry.Open or 0
	local target = if open then 1 else 0
	current = MathUtil.Approach(current, target, dt * 3)
	entry.Open = current
	part.CanCollide = current < 0.7 and entry.Base.CanCollide
	part.Transparency = entry.Base.Transparency + (1 - entry.Base.Transparency) * current * 0.6
	return entry.Origin + vector(part, "Offset") * MathUtil.Smooth(current)
end

local function stepWater(entry: Entry, t: number): CFrame?
	local part = entry.Part
	local baseY = attr(part, "BaseY", entry.Origin.Y)
	local active = course.Id == attr(part, "CourseId", "") and course.Checkpoint >= attr(part, "StartCP", 1)
	if not active then
		entry.RiseStart = nil
		live[part] = false
		entry.Top = baseY
		return entry.Origin
	end
	if not entry.RiseStart or entry.RiseStart < course.Restarted then
		entry.RiseStart = math.max(t, course.Restarted)
	end
	local riseStart = entry.RiseStart :: number
	-- A short grace before the water starts to climb.
	local rise = math.max(t - riseStart - 1.5, 0) * attr(part, "Rate", 1.8)
	local top = math.min(baseY + rise, attr(part, "MaxY", baseY + 60))
	entry.Top = top
	live[part] = top > baseY + 0.5
	return entry.Origin + Vector3.new(0, top - baseY, 0)
end

local function stepCycleFx(entry: Entry, t: number)
	local emitters = entry.Emitters
	if not emitters or #emitters == 0 then
		return
	end
	local part = entry.Part
	local on, warning = Schedule.Cycle(
		t,
		attr(part, "Period", 4),
		attr(part, "OnFraction", 0.4),
		attr(part, "Phase", 0),
		attr(part, "Warn", 0.8)
	)
	local scale = if on then 1 elseif warning then 0.25 else 0.04
	for _, item in emitters do
		item.Emitter.Rate = item.Rate * scale
	end
end

-- Frame step ------------------------------------------------------------------------------------

local moveParts: { BasePart } = {}
local moveFrames: { CFrame } = {}

local function step(dt: number)
	frame += 1
	if dirty then
		dirty = false
		list = {}
		for _, entry in entries do
			table.insert(list, entry)
		end
	end
	local t = Schedule.Now()
	local camera = workspace.CurrentCamera
	local focus = if camera then camera.CFrame.Position else Vector3.zero
	local info = Controller.Info
	local root = info.Root
	local floor = info.Floor
	local near = if root then root.Position else focus
	local climbing = root ~= nil and info.State == "Climb"

	table.clear(moveParts)
	table.clear(moveFrames)
	local carried: { { Part: BasePart, Delta: CFrame } } = {}

	for index, entry in list do
		local part = entry.Part
		if not part.Parent then
			continue
		end
		local distance = math.min((entry.Home - focus).Magnitude, (entry.Home - near).Magnitude)
		-- Far mechanisms update rarely; very far ones not at all (they're pure functions of time).
		if distance > 1100 then
			continue
		elseif distance > 450 and (frame + index) % 4 ~= 0 then
			continue
		end
		local tag = entry.Tag
		local target: CFrame? = nil
		if tag == Tags.Mover then
			target = stepMover(entry, t)
		elseif tag == Tags.Timed then
			target = stepTimed(entry, t)
		elseif tag == Tags.Collapse then
			target = stepCollapse(entry, t, floor)
		elseif tag == Tags.Switch then
			stepSwitch(entry, t, root, floor)
		elseif tag == Tags.SwitchGate then
			target = stepGate(entry, t, dt)
		elseif tag == Tags.Water then
			target = stepWater(entry, t)
		elseif tag == Tags.WindZone or tag == Tags.LaunchVent then
			stepCycleFx(entry, t)
		end
		if target and target ~= entry.Last then
			if part == floor or (climbing and (part.Position - near).Magnitude < part.Size.Magnitude / 2 + 6) then
				table.insert(carried, { Part = part, Delta = target * entry.Last:Inverse() })
			end
			entry.Last = target
			table.insert(moveParts, part)
			table.insert(moveFrames, target)
		end
	end

	if #moveParts > 0 then
		workspace:BulkMoveTo(moveParts, moveFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
	Controller.PlatformCheck()
	-- Carry ignores parts that aren't what the runner stands on or climbs.
	for _, item in carried do
		Controller.Carry(item.Part, item.Delta, dt)
	end
end

-- Public -------------------------------------------------------------------------------------------

-- Is a hazard part currently dangerous? (lasers off, water not rising → false)
function Mechanisms.IsLive(part: BasePart): boolean
	local value = live[part]
	if value ~= nil then
		return value
	end
	return part:GetAttribute("Active") ~= false
end

-- The course system reports progress so rising water knows when to climb.
-- `restarted` resets the water (a checkpoint retry gives you a fair go).
function Mechanisms.SetCourse(courseId: string?, checkpoint: number, restarted: boolean?)
	course.Id = courseId
	course.Checkpoint = checkpoint
	if restarted then
		course.Restarted = Schedule.Now()
	end
end

-- Rebuild every collapsed plank and close every gate (fresh attempt).
function Mechanisms.ResetCourseState()
	for _, entry in entries do
		if entry.Tag == Tags.Collapse and entry.TriggeredAt then
			entry.TriggeredAt, entry.FallAt = nil, nil
			entry.Part.CanCollide = entry.Base.CanCollide
			entry.Part.Transparency = entry.Base.Transparency
			entry.Part.CFrame = entry.Origin
			entry.Last = entry.Origin
		end
	end
	table.clear(switchUntil)
end

-- Height of the rising water on a course (nil when it isn't rising).
function Mechanisms.WaterLevel(courseId: string): number?
	for _, entry in entries do
		if entry.Tag == Tags.Water and entry.Part:GetAttribute("CourseId") == courseId and live[entry.Part] then
			return entry.Top
		end
	end
	return nil
end

-- Sweeper arms: where they'd knock the runner, if they're touching.
local function checkSweepers()
	local info = Controller.Info
	local root = info.Root
	if not root then
		return
	end
	local feet = root.Position - Vector3.new(0, 3, 0)
	for _, entry in list do
		if entry.Tag == Tags.Mover and entry.Kind == "Spin" and entry.Part:GetAttribute("Sweeper") then
			local part = entry.Part
			if (entry.Home - root.Position).Magnitude < part.Size.Magnitude then
				local hit = false
				for _, y in { 0.4, 1.4, 2.4 } do
					if MathUtil.InBox(part.CFrame, part.Size, feet + Vector3.new(0, y, 0), 0.6) then
						hit = true
						break
					end
				end
				if hit then
					local speed = math.rad(attr(part, "Speed", 60))
					local offset = MathUtil.Flat(root.Position - entry.Home)
					local tangent = Vector3.yAxis:Cross(offset) * speed
					local push = if tangent.Magnitude > 0.1 then tangent.Unit else MathUtil.FlatUnit(offset)
					Controller.Impulse(push * 38 + Vector3.yAxis * 34, "Knocked")
				end
			end
		end
	end
end

function Mechanisms.Start()
	for _, tag in MANAGED do
		for _, instance in CollectionService:GetTagged(tag) do
			register(instance, tag)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(instance)
			register(instance, tag)
		end)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(unregister)
	end
	Net.Listen("Switch.Opened", function(id: string, untilTime: number)
		if type(id) == "string" and type(untilTime) == "number" then
			local was = switchUntil[id] or 0
			switchUntil[id] = math.max(was, untilTime)
			if was < Schedule.Now() then
				Mechanisms.SwitchChanged:Fire(id, untilTime - Schedule.Now())
			end
		end
	end)
	RunService.PreSimulation:Connect(step)
	RunService.Heartbeat:Connect(checkSweepers)
end

return Mechanisms
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="142">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-2000</float>
      <float name="Gravity">180</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>