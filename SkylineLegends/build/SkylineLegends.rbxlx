			Shirt = rgb(150, 82, 52),
			Pants = rgb(70, 70, 76),
			Hair = rgb(60, 40, 30),
			Hat = "Hardhat",
		},
		Greeting = {
			"HA! A runner! Mind the cargo!",
			"Titan's the biggest crane in the city. Biggest in the world, probably.",
		},
		Idle = { "I know a shortcut through the scrapyard. Never tell anyone, though." },
	},
	{
		Id = "rook",
		Name = "Rook",
		Role = "Scrap Collector",
		District = "Ironworks",
		Spot = "iron_rook",
		Personality = "Scrappy teenager, entrepreneurial, always has a deal.",
		Look = {
			Skin = SKIN[2],
			Shirt = rgb(120, 130, 110),
			Pants = rgb(80, 70, 60),
			Hair = rgb(200, 80, 50),
			Hat = "Bandana",
		},
		Greeting = { "Psst. Got scrap? I got credits.", "You run fast. I could use someone fast." },
		Idle = { "Every gear up there's worth something to someone." },
	},

	-- Verdant Hollow ----------------------------------------------------------------------
	{
		Id = "wren",
		Name = "Dr. Wren Alder",
		Role = "Botanist and Astronomer",
		District = "Verdant",
		Spot = "ver_wren",
		Personality = "Enthusiastic, absent-minded, half botanist half stargazer.",
		Look = {
			Skin = SKIN[3],
			Shirt = rgb(240, 240, 230),
			Pants = rgb(84, 140, 70),
			Hair = rgb(60, 40, 30),
			Hat = "Glasses",
		},
		Greeting = {
			"Oh! Mind the moss, it's older than the city.",
			"The observatory saw everything the night the Citadel went dark.",
		},
		Idle = { "Plants grow toward light. Runners, toward heights. Fascinating, really." },
	},
	{
		Id = "moss",
		Name = "Old Moss",
		Role = "Vine Stringer",
		District = "Verdant",
		Spot = "ver_moss",
		Personality = "Hermit, speaks in riddles, strung every vine in the Hollow.",
		Look = {
			Skin = SKIN[4],
			Shirt = rgb(70, 110, 60),
			Pants = rgb(110, 80, 58),
			Hair = rgb(200, 210, 190),
			Hat = "Leaves",
		},
		Greeting = { "The vine holds those who let go at the right time.", "Hmm. Another one who climbs." },
		Idle = { "Look where the water falls. Then look behind it." },
	},
	{
		Id = "fern",
		Name = "Ranger Fern",
		Role = "Hollow Ranger",
		District = "Verdant",
		Spot = "ver_fern",
		Personality = "Earnest young ranger, protective of the gardens.",
		Look = {
			Skin = SKIN[1],
			Shirt = rgb(96, 150, 80),
			Pants = rgb(90, 70, 50),
			Hair = rgb(230, 190, 90),
			Hat = "Ranger",
		},
		Greeting = { "Stay on the paths. Well, the high paths.", "The seed bank needs a careful runner." },
		Idle = { "Those ruins collapse if you stand still on them. Keep moving." },
	},

	-- Gilded Exchange ------------------------------------------------------------------------
	{
		Id = "vex",
		Name = "Vex",
		Role = "Veteran Courier",
		District = "Gilded",
		Spot = "gil_vex",
		Personality = "Cocky, brilliant, the fastest courier still running, and wants a rival.",
		Look = {
			Skin = SKIN[4],
			Shirt = rgb(26, 28, 40),
			Pants = rgb(255, 70, 190),
			Hair = rgb(255, 255, 255),
			Hat = "Shades",
		},
		Greeting = { "Oh, you're the new hotshot. Cute.", "Speed's easy. Doing it with style is the job." },
		Idle = { "My Express Lane time is still up on the board. Go look at it. Then weep." },
	},
	{
		Id = "pria",
		Name = "Analyst Pria Shah",
		Role = "Exchange Data Analyst",
		District = "Gilded",
		Spot = "gil_pria",
		Personality = "Nervous, meticulous, the only person still reading the Exchange's data feeds.",
		Look = {
			Skin = SKIN[3],
			Shirt = rgb(70, 230, 255),
			Pants = rgb(40, 52, 70),
			Hair = rgb(20, 20, 30),
			Hat = "Headset",
		},
		Greeting = {
			"The feeds... they're still transmitting. Something up there is still transmitting.",
			"Please don't touch the lasers.",
		},
		Idle = { "The Citadel's signal repeats every eleven minutes. Like a heartbeat." },
	},
	{
		Id = "lumen",
		Name = "LUMEN",
		Role = "Maintenance Intelligence",
		District = "Gilded",
		Spot = "gil_lumen",
		Personality = "Polite maintenance AI, glitchy, tries its best.",
		Look = {
			Skin = rgb(110, 230, 255),
			Shirt = rgb(40, 52, 70),
			Pants = rgb(40, 52, 70),
			Hair = rgb(110, 230, 255),
			Hat = "Antenna",
		},
		Greeting = {
			"GREETINGS, VALUED VISITOR. PLEASE ENJOY THE EXCHANGE.",
			"MAINTENANCE REQUEST QUEUE: 4,112 ITEMS. YOU MAY HELP.",
		},
		Idle = { "HOLOGRAPHIC PLATFORMS ARE SOLID WHEN BRIGHT. THIS IS A SAFETY FEATURE." },
	},

	-- Frostreach -----------------------------------------------------------------------------
	{
		Id = "sigrun",
		Name = "Elder Sigrun",
		Role = "Village Elder",
		District = "Frostreach",
		Spot = "fro_sigrun",
		Personality = "Stoic, patient, remembers the last runner who came down from the Citadel.",
		Look = {
			Skin = SKIN[2],
			Shirt = rgb(200, 60, 60),
			Pants = rgb(110, 114, 126),
			Hair = rgb(240, 240, 245),
			Hat = "Fur",
		},
		Greeting = { "The mountain decides who climbs. Today, perhaps, it decides you.", "Warm yourself. Then work." },
		Idle = { "Ice remembers your speed. It will not help you stop." },
	},
	{
		Id = "kesh",
		Name = "Kesh",
		Role = "Ice Guide",
		District = "Frostreach",
		Spot = "fro_kesh",
		Personality = "Adventurous, reckless, laughs at the wind.",
		Look = {
			Skin = SKIN[3],
			Shirt = rgb(255, 200, 120),
			Pants = rgb(70, 74, 86),
			Hair = rgb(30, 25, 25),
			Hat = "Goggles",
		},
		Greeting = {
			"Ha! Fresh boots! The glacier'll fix that.",
			"Watch the snow streams. They warn you before a gust.",
		},
		Idle = { "Never stop on the ridge. Never." },
	},
	{
		Id = "bram",
		Name = "Bram the Keeper",
		Role = "Signal Mast Keeper",
		District = "Frostreach",
		Spot = "fro_bram",
		Personality = "Lonely, kind, has kept the mast lamp lit for twenty years.",
		Look = {
			Skin = SKIN[1],
			Shirt = rgb(120, 86, 62),
			Pants = rgb(70, 60, 50),
			Hair = rgb(180, 150, 120),
			Hat = "Beanie",
		},
		Greeting = {
			"Twenty years I've kept the lamp lit. Nobody's answered.",
			"You came up the mountain? Then maybe the Citadel's next.",
		},
		Idle = { "My logs are scattered on the slopes. The wind took them." },
	},

	-- Aether Citadel ---------------------------------------------------------------------------
	{
		Id = "warden",
		Name = "The Warden",
		Role = "Guardian of the Keel",
		District = "Citadel",
		Spot = "cit_warden",
		Personality = "An ancient construct, formal and sad, still following orders from people long gone.",
		Look = {
			Skin = rgb(236, 232, 244),
			Shirt = rgb(240, 196, 100),
			Pants = rgb(170, 160, 196),
			Hair = rgb(180, 140, 255),
			Hat = "Crown",
		},
		Greeting = { "RUNNER. YOU HAVE CLIMBED FAR.", "THE KEEL MUST NOT FALL. PROVE YOU WILL NOT LET IT." },
		Idle = { "THE SKYWRIGHTS SEALED THE CITADEL TO SAVE THE CITY BELOW. I REMAIN." },
	},
	{
		Id = "ilse",
		Name = "Ilse Marrow",
		Role = "Lost Cartographer",
		District = "Citadel",
		Spot = "cit_ilse",
		Personality = "Brave, tired, climbed up ten years ago and has been mapping the Citadel ever since.",
		Look = {
			Skin = SKIN[2],
			Shirt = rgb(150, 110, 255),
			Pants = rgb(120, 86, 62),
			Hair = rgb(140, 70, 40),
			Hat = "Hood",
		},
		Greeting = {
			"Another runner! Ten years. Ten years, and nobody else made it up.",
			"My maps blew all over the Citadel. Help me find them?",
		},
		Idle = { "The gravity here bends around the Keel. Use it." },
	},
	{
		Id = "echo",
		Name = "Echo",
		Role = "Skywright Recording",
		District = "Citadel",
		Spot = "cit_echo",
		Personality = "A flickering recording of the Skywright who sealed the Citadel.",
		Look = {
			Skin = rgb(200, 170, 255),
			Shirt = rgb(200, 170, 255),
			Pants = rgb(200, 170, 255),
			Hair = rgb(255, 255, 255),
			Hat = "None",
		},
		Greeting = {
			"...if anyone hears this... the Keel was failing...",
			"...we cut the skyways so the Citadel wouldn't drag the city down...",
		},
		Idle = { "...find the echo stones... they hold the rest..." },
	},
}

local NPCs = {}
NPCs.List = list
NPCs.ById = {} :: { [string]: NPC }
for _, npc in list do
	NPCs.ById[npc.Id] = npc
end

return NPCs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[-- Levels, reputation ranks and where experience comes from.

local Progression = {}

Progression.MaxLevel = 100

-- XP needed to go from `level` to `level + 1`.
function Progression.XPToNext(level: number): number
	if level >= Progression.MaxLevel then
		return math.huge
	end
	return math.floor(120 + 28 * level + 1.6 * level * level)
end

-- Skill points granted on reaching a level (more at rank milestones).
function Progression.SkillPointsFor(level: number): number
	if level <= 1 then
		return 0
	end
	if level % 10 == 0 then
		return 2
	end
	return 1
end

-- Credits granted on reaching a level.
function Progression.LevelCredits(level: number): number
	return 50 + level * 10
end

export type Rank = { Level: number, Name: string, Color: Color3, Blurb: string }

-- Reputation ranks, earned by level.
Progression.Ranks = {
	{ Level = 1, Name = "Newcomer", Color = Color3.fromRGB(200, 205, 215), Blurb = "Fresh boots, big city." },
	{
		Level = 5,
		Name = "Errand Runner",
		Color = Color3.fromRGB(150, 210, 255),
		Blurb = "The terraces know your face.",
	},
	{ Level = 10, Name = "Courier", Color = Color3.fromRGB(110, 230, 170), Blurb = "Trusted with real deliveries." },
	{
		Level = 15,
		Name = "Rooftop Regular",
		Color = Color3.fromRGB(120, 240, 120),
		Blurb = "You take the high road. Always.",
	},
	{
		Level = 20,
		Name = "Pathfinder",
		Color = Color3.fromRGB(240, 220, 90),
		Blurb = "You see lines other runners miss.",
	},
	{ Level = 30, Name = "Free Runner", Color = Color3.fromRGB(255, 180, 70), Blurb = "No route is closed to you." },
	{
		Level = 40,
		Name = "Trailblazer",
		Color = Color3.fromRGB(255, 130, 70),
		Blurb = "Other runners follow your lines.",
	},
	{
		Level = 50,
		Name = "Skyline Runner",
		Color = Color3.fromRGB(255, 100, 120),
		Blurb = "A name chalked on rooftops.",
	},
	{
		Level = 60,
		Name = "Vanguard",
		Color = Color3.fromRGB(240, 90, 200),
		Blurb = "First into every forgotten tower.",
	},
	{ Level = 70, Name = "Ace", Color = Color3.fromRGB(190, 110, 255), Blurb = "Your splits are guild legend." },
	{
		Level = 80,
		Name = "Paragon",
		Color = Color3.fromRGB(140, 130, 255),
		Blurb = "Movement as language. You're fluent.",
	},
	{
		Level = 90,
		Name = "Legend of the Guild",
		Color = Color3.fromRGB(110, 200, 255),
		Blurb = "Recruits study your ghost.",
	},
	{
		Level = 100,
		Name = "Skyline Legend",
		Color = Color3.fromRGB(255, 225, 120),
		Blurb = "The city is one again, and it runs on your lines.",
	},
} :: { Rank }

function Progression.RankFor(level: number): (Rank, number)
	local best, index = Progression.Ranks[1], 1
	for i, rank in Progression.Ranks do
		if level >= rank.Level then
			best, index = rank, i
		end
	end
	return best, index
end

-- Base XP and credit amounts. Course rewards scale with course difficulty
-- (see Logic/Rewards).
Progression.XP = {
	FirstCompletion = 160, -- × difficulty factor
	MedalUpgrade = { 60, 90, 140, 220 }, -- bronze → platinum, × difficulty factor
	Distinction = 70,
	Repeat = 24, -- × difficulty × performance
	PersonalBest = 30,
	Discovery = 60,
	Landmark = 120,
	Letter = 45,
	Lesson = 40,
	MasteryTier = 250,
	Achievement = 0, -- achievements list their own rewards
	RaceFinish = 80,
	RaceWin = 160,
	RelayFinish = 150,
	TowerFloor = 45,
	EndlessSection = 6,
}

Progression.Credits = {
	FirstCompletion = 60,
	MedalUpgrade = { 20, 35, 60, 100 },
	Repeat = 12,
	Discovery = 25,
	Cache = 120,
	RaceFinish = 40,
	RaceWin = 120,
	RelayFinish = 80,
	TowerFloor = 20,
	EndlessSection = 3,
}

-- Prestige tokens are only awarded for significant achievements.
Progression.Prestige = {
	Platinum = 1,
	ChapterComplete = 3,
	ExpertTrial = 2,
	WeeklyExpedition = 1,
	MasteryTier = 1, -- tiers 3+
	TowerMilestone = 2,
}

return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[-- The quest catalogue: the main story, district side quests, expert trials,
-- plus templates for daily objectives, weekly expeditions and contracts.
--
-- Every quest tells the player where to begin (Start), what success requires
-- (each step's Text) and what they'll receive (Rewards), before they accept.
--
-- Step kinds (checked by Services/QuestService from validated events):
--   Talk      Npc                      speak to someone (Say = their lines)
--   Reach     Point                    get to a place
--   Collect   Points                   pick up every item (shown only while active)
--   Activate  Points                   switch on relays/terminals/lanterns
--   Deliver   From, To, Fragile?, Time? carry a package to each destination
--   Course    Course, Medal?, NoFalls?, Shortcut?, Flow?
--   Courses   Count, District?          finish N different courses
--   Technique Action, Count, District?
--   Chain     Actions, District?        perform the moves in order in one chain
--   Flow      Tier, District?           reach a flow tier (1-5)
--   Discover  Count, District?
--   Lessons   Count                     training yard lessons
--   Timed     From, To, Time            get from A to B within the limit
--   Race / Relay  Count                 finish multiplayer races / relays
--   Mastery   Tier, Count               reach a tier in Count categories
--   Crew                                join or found a crew
--   Tower     Floor                     clear a Spire floor

export type Step = { [string]: any }
export type Quest = {
	Id: string,
	Type: string, -- "Main" | "Side" | "Expert"
	Chapter: number?,
	Giver: string,
	District: string,
	Name: string,
	Summary: string,
	Start: string,
	Requires: { Level: number?, Quests: { string }? },
	Intro: { string },
	Outro: { string },
	Steps: { Step },
	Rewards: { XP: number?, Credits: number?, Prestige: number?, Items: { string }? },
	Order: number?,
}

local Q: { Quest } = {
	-----------------------------------------------------------------------------
	-- Prologue: First Steps
	-----------------------------------------------------------------------------
	{
		Id = "p_welcome",
		Type = "Main",
		Chapter = 0,
		Giver = "orla",
		District = "Hub",
		Name = "Welcome to the Guild",
		Summary = "Report to Coach Tam in the Training Yard and learn to move like a runner.",
		Start = "Talk to Guildmaster Orla in the Guildhall.",
		Requires = { Level = 1 },
		Intro = {
			"So you're the new recruit. Welcome to the Runners' Guild.",
			"Ten years ago the skyways failed. Lifts stopped, bridges fell, and Meridian broke into islands of rooftops.",
			"Runners are how the city stays one city. We carry what can't be carried any other way.",
			"First you learn to move. Coach Tam is waiting in the Training Yard.",
		},
		Outro = { "Tam says you've got good instincts. Don't let it go to your head." },
		Steps = {
			{
				Kind = "Talk",
				Npc = "tam",
				Text = "Meet Coach Tam in the Training Yard",
				Say = {
					"New recruit! Excellent! I'm Tam.",
					"Every lesson station in the yard teaches one technique. Step on the pad and follow the card.",
					"Do them in any order. When you've cleared six, come find Orla.",
				},
			},
			{ Kind = "Lessons", Count = 6, Text = "Clear 6 Training Yard lessons" },
			{
				Kind = "Talk",
				Npc = "orla",
				Text = "Report back to Orla",
				Say = {
					"Six lessons. Not bad for your first hour.",
				},
			},
		},
		Rewards = { XP = 300, Credits = 150, Items = { "outfit_recruit" } },
	},
	{
		Id = "p_graduation",
		Type = "Main",
		Chapter = 0,
		Giver = "orla",
		District = "Hub",
		Name = "Graduation",
		Summary = "Run Coach Tam's Graduation Run to earn your Guild pass.",
		Start = "Talk to Guildmaster Orla in the Guildhall.",
		Requires = { Quests = { "p_welcome" } },
		Intro = {
			"One more thing before I send you anywhere. The Graduation Run.",
			"Every basic technique in one route. Finish it, any time, any medal.",
		},
		Outro = {
			"That's a Guild runner if ever I saw one.",
			"Here's your pass. The lift gate to Tinroof Terraces is open to you now.",
		},
		Steps = {
			{ Kind = "Course", Course = "hub_graduation", Text = "Complete the Graduation Run" },
			{ Kind = "Talk", Npc = "orla", Text = "Collect your Guild pass from Orla" },
		},
		Rewards = { XP = 450, Credits = 200, Items = { "shoes_trainers", "title_graduate" } },
	},

	-----------------------------------------------------------------------------
	-- Chapter 1: Lines on the Wind (Tinroof Terraces)
	-----------------------------------------------------------------------------
	{
		Id = "c1_arrival",
		Type = "Main",
		Chapter = 1,
		Giver = "orla",
		District = "Tinroof",
		Name = "A Runner in Tinroof",
		Summary = "Travel to Tinroof Terraces and introduce yourself to Mrs. Okafor.",
		Start = "Talk to Guildmaster Orla in the Guildhall.",
		Requires = { Quests = { "p_graduation" } },
		Intro = {
			"Tinroof Terraces. Families, gardens and a lot of washing lines.",
			"Their relay on the Old Bell water tower went dark years ago. Without it, they can't call for help.",
			"Take the lift gate. Mrs. Okafor runs the place. Be polite.",
		},
		Outro = { "Okafor likes you. That's rare." },
		Steps = {
			{ Kind = "Reach", Point = "tin_plaza", Text = "Travel to Tinroof Terraces through the lift gates" },
			{
				Kind = "Talk",
				Npc = "okafor",
				Text = "Introduce yourself to Mrs. Okafor",
				Say = {
					"The Guild finally remembered us! Good.",
					"We've managed. But managing isn't living. Gran Petra needs help first, she always does.",
				},
			},
		},
		Rewards = { XP = 250, Credits = 120 },
	},
	{
		Id = "c1_seedlings",
		Type = "Main",
		Chapter = 1,
		Giver = "petra",
		District = "Tinroof",
		Name = "Seedlings for Three Roofs",
		Summary = "Carry Gran Petra's delicate seedling trays to three rooftop gardens without a hard landing.",
		Start = "Talk to Gran Petra in her rooftop garden.",
		Requires = { Quests = { "c1_arrival" } },
		Intro = {
			"Three buildings, three gardens, one old woman with bad knees.",
			"These seedlings are delicate, dear. A big thump and they're mulch.",
			"Roll your landings or keep them small. If they get crushed, come back and I'll pot another tray.",
		},
		Outro = { "Every tray in one piece! You've got gentle feet for a runner." },
		Steps = {
			{
				Kind = "Deliver",
				From = "tin_seedlings",
				To = { "tin_garden_a", "tin_garden_b", "tin_garden_c" },
				Fragile = true,
				Text = "Deliver seedlings to all three gardens (no stumbles or falls)",
			},
			{ Kind = "Talk", Npc = "petra", Text = "Tell Gran Petra the gardens are planted" },
		},
		Rewards = { XP = 400, Credits = 200, Items = { "pack_satchel" } },
	},
	{
		Id = "c1_routes",
		Type = "Main",
		Chapter = 1,
		Giver = "okafor",
		District = "Tinroof",
		Name = "Learning the Terraces",
		Summary = "Run three Tinroof courses to learn the roofs.",
		Start = "Talk to Mrs. Okafor on the Tinroof plaza.",
		Requires = { Quests = { "c1_seedlings" } },
		Intro = {
			"If you're going up the Old Bell, you'd better know these roofs.",
			"The course gates around the plaza each start a route. Run any three.",
		},
		Outro = { "You move like you were born up here." },
		Steps = {
			{ Kind = "Courses", Count = 3, District = "Tinroof", Text = "Complete 3 different Tinroof courses" },
			{ Kind = "Talk", Npc = "okafor", Text = "Report to Mrs. Okafor" },
		},
		Rewards = { XP = 450, Credits = 220 },
	},
	{
		Id = "c1_bell",
		Type = "Main",
		Chapter = 1,
		Giver = "okafor",
		District = "Tinroof",
		Name = "The Old Bell Relay",
		Summary = "Climb the Old Bell water tower and restart the Tinroof relay.",
		Start = "Talk to Mrs. Okafor on the Tinroof plaza.",
		Requires = { Quests = { "c1_routes" } },
		Intro = {
			"The relay's on top of the Old Bell, the tallest water tower in the Terraces.",
			"Run the Old Bell Ascent and switch it on. Then Tinroof can talk to the Guild again.",
		},
		Outro = {
			"Listen... that's the Guild's channel! We're back on the network!",
			"Orla sent these for you. Spring Soles. Tinroof made, Guild approved.",
		},
		Steps = {
			{ Kind = "Course", Course = "tin_bell", Text = "Complete the Old Bell Ascent" },
			{ Kind = "Activate", Points = { "tin_relay" }, Text = "Switch on the relay atop the Old Bell" },
			{ Kind = "Talk", Npc = "okafor", Text = "Return to Mrs. Okafor" },
		},
		Rewards = { XP = 700, Credits = 350, Prestige = 3, Items = { "shoes_spring", "title_tinroof" } },
	},

	-----------------------------------------------------------------------------
	-- Chapter 2: The Silent Cranes (Ironworks)
	-----------------------------------------------------------------------------
	{
		Id = "c2_arrival",
		Type = "Main",
		Chapter = 2,
		Giver = "orla",
		District = "Ironworks",
		Name = "Sparks and Steel",
		Summary = "Travel to the Ironworks Quarter and find Engineer Sadie Kowalski.",
		Start = "Talk to Guildmaster Orla in the Guildhall.",
		Requires = { Quests = { "c1_bell" }, Level = 6 },
		Intro = {
			"The Ironworks built every skyway in Meridian. If anyone can fix them, it's them.",
			"But their power grid is in pieces. Find Engineer Kowalski.",
		},
		Outro = { "Sadie says you'll do. From her that's a medal." },
		Steps = {
			{ Kind = "Reach", Point = "iron_plaza", Text = "Travel to the Ironworks Quarter" },
			{
				Kind = "Talk",
				Npc = "sadie",
				Text = "Find Engineer Sadie Kowalski",
				Say = {
					"A runner. Good. The relays I need are on top of things nobody can climb.",
				},
			},
		},
		Rewards = { XP = 400, Credits = 200 },
	},
	{
		Id = "c2_relays",
		Type = "Main",
		Chapter = 2,
		Giver = "sadie",
		District = "Ironworks",
		Name = "Power Relays",
		Summary = "Activate five power relays perched on cranes, stacks and gantries.",
		Start = "Talk to Engineer Sadie in the Ironworks plaza.",
		Requires = { Quests = { "c2_arrival" } },
		Intro = {
			"Five relays. One on each high point of the quarter.",
			"They're marked with amber beacons. Climb up, slap the switch, come back.",
		},
		Outro = { "Grid's at seventy percent. The cranes are waking up." },
		Steps = {
			{
				Kind = "Activate",
				Points = { "iron_relay_1", "iron_relay_2", "iron_relay_3", "iron_relay_4", "iron_relay_5" },
				Text = "Activate all five power relays",
			},
			{ Kind = "Talk", Npc = "sadie", Text = "Report to Sadie" },
		},
		Rewards = { XP = 650, Credits = 300 },
	},
	{
		Id = "c2_cranes",
		Type = "Main",
		Chapter = 2,
		Giver = "brak",
		District = "Ironworks",
		Name = "Crane Inspection",
		Summary = "Prove the cranes are safe by running Crane Crossing at silver or better.",
		Start = "Talk to Foreman Brak by the cranes.",
		Requires = { Quests = { "c2_relays" } },
		Intro = {
			"POWER'S BACK! Now someone has to check the cranes move right.",
			"Run Crane Crossing. Silver or better, so I know you actually looked at them!",
		},
		Outro = { "HA! Smooth as oil! Titan's next, runner." },
		Steps = {
			{ Kind = "Course", Course = "iron_crane", Medal = 2, Text = "Earn silver or better on Crane Crossing" },
			{ Kind = "Talk", Npc = "brak", Text = "Report to Foreman Brak" },
		},
		Rewards = { XP = 700, Credits = 320 },
	},
	{
		Id = "c2_titan",
		Type = "Main",
		Chapter = 2,
		Giver = "sadie",
		District = "Ironworks",
		Name = "The Titan Wakes",
		Summary = "Run the Titan Crane and switch on the master relay at its peak.",
		Start = "Talk to Engineer Sadie in the Ironworks plaza.",
		Requires = { Quests = { "c2_cranes" } },
		Intro = {
			"Titan's jib holds the master relay. With it on, the Ironworks joins the network.",
			"It's also the worst climb in the quarter. Have fun.",
		},
		Outro = {
			"Network's live. And I built you something: a Kinetic Harness. It'll let you dash.",
			"Don't make me regret it.",
		},
		Steps = {
			{ Kind = "Course", Course = "iron_titan", Text = "Complete the Titan Crane" },
			{ Kind = "Activate", Points = { "iron_master" }, Text = "Switch on the master relay" },
			{ Kind = "Talk", Npc = "sadie", Text = "Return to Sadie" },
		},
		Rewards = { XP = 1100, Credits = 500, Prestige = 3, Items = { "title_ironworks" } },
	},

	-----------------------------------------------------------------------------
	-- Chapter 3: Roots and Ruins (Verdant Hollow)
	-----------------------------------------------------------------------------
	{
		Id = "c3_arrival",
		Type = "Main",
		Chapter = 3,
		Giver = "orla",
		District = "Verdant",
