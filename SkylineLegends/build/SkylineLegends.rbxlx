		Branch = "Agility",
		Name = "Slick Slide",
		Description = "Slides lose 10% less speed per rank.",
		MaxRank = 2,
		Cost = 1,
		Requires = {},
		Tier = 1,
		Column = 2,
		Effects = { { "SlideFriction", "Mul", -0.1 } },
	},
	{
