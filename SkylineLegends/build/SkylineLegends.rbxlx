Achievements.List = list
Achievements.ById = {} :: { [string]: Achievement }
for _, achievement in list do
	Achievements.ById[achievement.Id] = achievement
end

-- "Every course" always means every course and room that exists.
do
	local Courses = require(script.Parent.Courses)
	local count = 0
	for _, course in Courses.List do
		if course.Kind == "Course" or course.Kind == "Room" then
			count += 1
		end
	end
	Achievements.ById.courses_all.Target = count

	local Lore = require(script.Parent.Lore)
	local letters = 0
	for _, districtLetters in Lore.Letters do
		letters += #districtLetters
	end
	Achievements.ById.letters_all.Target = letters
end

return Achievements
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Cosmetics</string>
            <string name="Source"><![CDATA[-- Every cosmetic: outfits, gloves, shoes, backpacks, trails, landing effects,
-- emotes, titles and victory animations.
--
-- Nothing here affects movement. Items are built from parts and effects at
-- runtime (Services/CosmeticService, client Effects), so no uploaded assets
-- are needed. Each item says where it comes from:
--   Shop      bought with credits (Price) at the Guildhall outfitter or a district stall
--   Prestige  bought with prestige tokens (PrestigePrice)
--   Reward    granted by an achievement, quest, mastery tier, medal or mode (Source explains)

export type Item = {
	Id: string,
	Category: string,
	Name: string,
	Description: string,
	Rarity: string,
	Price: number?,
	PrestigePrice: number?,
	Source: string, -- "Shop" | "Prestige" | "Reward"
	Unlock: string?, -- how a Reward item is earned (shown in the locker)
	District: string?,
	Style: string?,
	Colors: { Color3 }?,
	Default: boolean?,
	Text: string?,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local items: { Item } = {}

local function add(item: Item)
	table.insert(items, item)
end

local function shop(
	category: string,
	id: string,
	name: string,
	price: number,
	rarity: string,
	style: string,
	colors: { Color3 },
	description: string,
	district: string?
)
	add({
		Id = id,
		Category = category,
		Name = name,
		Description = description,
		Rarity = rarity,
		Price = price,
		Source = "Shop",
		Style = style,
		Colors = colors,
		District = district,
	})
end

local function prestige(
	category: string,
	id: string,
	name: string,
	cost: number,
	style: string,
	colors: { Color3 },
	description: string
)
	add({
		Id = id,
		Category = category,
		Name = name,
		Description = description,
		Rarity = "Prestige",
		PrestigePrice = cost,
		Source = "Prestige",
		Style = style,
		Colors = colors,
	})
end

local function reward(
	category: string,
	id: string,
	name: string,
	rarity: string,
	style: string,
	colors: { Color3 },
	description: string,
	unlock: string,
	district: string?
)
	add({
		Id = id,
		Category = category,
		Name = name,
		Description = description,
		Rarity = rarity,
		Source = "Reward",
		Unlock = unlock,
		Style = style,
		Colors = colors,
		District = district,
	})
end

