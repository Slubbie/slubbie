      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Access</string>
            <string name="Source"><![CDATA[-- Who can go where: district access milestones and course ability requirements.

local Abilities = require(script.Parent.Parent.Config.Abilities)
local Districts = require(script.Parent.Parent.Config.Districts)
local Quests = require(script.Parent.Parent.Config.Quests)

local Access = {}

-- Main story quest that must be finished before each district opens.
Access.Gates = {
	Hub = nil,
	Tinroof = "p_graduation",
	Ironworks = "c1_bell",
	Verdant = "c2_titan",
	Gilded = "c3_starfall",
	Frostreach = "c4_signal",
	Citadel = "c5_mast",
} :: { [string]: string? }

export type ProfileLike = { Level: number?, Quests: { Completed: { [string]: any } }? }

-- (allowed, reason)
function Access.District(level: number, completed: { [string]: any }, districtId: string): (boolean, string?)
	local district = Districts.ById[districtId]
	if not district then
		return false, "Unknown district"
	end
	if districtId == "Hub" then
		return true, nil
	end
	if level < district.Level then
		return false, ("Reach level %d"):format(district.Level)
	end
	local gate = Access.Gates[districtId]
	if gate and not completed[gate] then
		local quest = Quests.ById[gate]
		return false, ('Complete "%s"'):format(if quest then quest.Name else gate)
	end
	return true, nil
end

-- Abilities a player has at a level.
function Access.Abilities(level: number): { [string]: boolean }
	return Abilities.ForLevel(level)
end

-- Which required abilities are missing. `requires` is a list of ability ids.
function Access.Missing(level: number, requires: { string }): { string }
	local have = Abilities.ForLevel(level)
	local missing = {}
	for _, id in requires do
		if not have[id] then
			table.insert(missing, id)
		end
	end
	return missing
end

-- Human-readable requirement line, e.g. "Needs Grapple Swing (level 16)".
function Access.MissingText(missing: { string }): string?
	if #missing == 0 then
		return nil
	end
	local parts = {}
	for _, id in missing do
		local ability = Abilities.ById[id]
		if ability then
			table.insert(parts, ("%s (level %d)"):format(ability.Name, ability.Level))
		end
	end
	return "Needs " .. table.concat(parts, ", ")
end

return Access
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">GhostCodec</string>
            <string name="Source"><![CDATA[-- Compact ghost replays.
--
-- A ghost is sampled at a fixed rate. Each frame stores position (0.1 stud
-- precision), yaw (2° steps) and the movement state, delta-encoded as integers
-- so a two-minute run is a few tens of kilobytes of JSON in a DataStore.

local GhostCodec = {}

GhostCodec.Rate = 15 -- frames per second
GhostCodec.MaxSeconds = 600
GhostCodec.States = {
	"Ground",
	"Crouch",
	"Slide",
	"Roll",
	"Stumble",
	"Air",
	"WallRun",
	"WallClimb",
	"Ledge",
	"Climb",
	"Balance",
	"Zipline",
	"Swing",
	"Pull",
	"Vault",
	"Mantle",
	"Dash",
}
local stateIndex = {}
for index, name in GhostCodec.States do
	stateIndex[name] = index
end

export type Frame = { X: number, Y: number, Z: number, Yaw: number, State: string }
export type Encoded = { V: number, Rate: number, N: number, D: { number }, Splits: { number }?, Time: number? }

function GhostCodec.Encode(frames: { Frame }, splits: { number }?, totalTime: number?): Encoded
	local data = table.create(#frames * 5)
	local px, py, pz, pyaw, pstate = 0, 0, 0, 0, 0
	for _, frame in frames do
		local x = math.floor(frame.X * 10 + 0.5)
		local y = math.floor(frame.Y * 10 + 0.5)
		local z = math.floor(frame.Z * 10 + 0.5)
		local yaw = math.floor(((frame.Yaw % 360) / 2) + 0.5) % 180
		local state = stateIndex[frame.State] or 1
		table.insert(data, x - px)
		table.insert(data, y - py)
		table.insert(data, z - pz)
		table.insert(data, yaw - pyaw)
		table.insert(data, state - pstate)
		px, py, pz, pyaw, pstate = x, y, z, yaw, state
	end
	return { V = 1, Rate = GhostCodec.Rate, N = #frames, D = data, Splits = splits, Time = totalTime }
end

function GhostCodec.Decode(encoded: any): { Frame }?
	if type(encoded) ~= "table" or type(encoded.D) ~= "table" or type(encoded.N) ~= "number" then
		return nil
	end
	local data = encoded.D
	if #data < encoded.N * 5 then
		return nil
	end
	local frames = table.create(encoded.N)
	local x, y, z, yaw, state = 0, 0, 0, 0, 0
	for i = 0, encoded.N - 1 do
		local base = i * 5
		x += data[base + 1]
		y += data[base + 2]
		z += data[base + 3]
		yaw += data[base + 4]
		state += data[base + 5]
		frames[i + 1] = {
			X = x / 10,
			Y = y / 10,
			Z = z / 10,
			Yaw = yaw * 2,
			State = GhostCodec.States[state] or "Ground",
		}
	end
	return frames
end

-- Basic shape checks before the server stores a submitted ghost.
function GhostCodec.Validate(encoded: any, expectedSeconds: number): boolean
	if type(encoded) ~= "table" or type(encoded.D) ~= "table" or type(encoded.N) ~= "number" then
		return false
	end
	if encoded.Rate ~= GhostCodec.Rate or encoded.N < 1 then
		return false
	end
	if #encoded.D ~= encoded.N * 5 then
		return false
	end
	local seconds = encoded.N / GhostCodec.Rate
	if seconds > GhostCodec.MaxSeconds or math.abs(seconds - expectedSeconds) > 3 then
		return false
	end
	for _, value in encoded.D do
		if type(value) ~= "number" or value ~= value or math.abs(value) > 1e6 then
			return false
		end
	end
	return true
end

return GhostCodec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Leveling</string>
            <string name="Source"><![CDATA[-- Level maths from total experience.

local Progression = require(script.Parent.Parent.Config.Progression)

local Leveling = {}

-- cumulative[L] = total XP needed to reach level L.
local cumulative = { [1] = 0 }
for level = 1, Progression.MaxLevel - 1 do
	cumulative[level + 1] = cumulative[level] + Progression.XPToNext(level)
end

function Leveling.TotalFor(level: number): number
	return cumulative[math.clamp(level, 1, Progression.MaxLevel)]
end

-- (level, xp into this level, xp needed for the next level)
function Leveling.FromXP(totalXP: number): (number, number, number)
	local level = 1
	-- Binary search the cumulative table.
	local lo, hi = 1, Progression.MaxLevel
	while lo <= hi do
		local mid = (lo + hi) // 2
		if cumulative[mid] <= totalXP then
			level = mid
			lo = mid + 1
		else
			hi = mid - 1
		end
	end
	if level >= Progression.MaxLevel then
		return Progression.MaxLevel, 0, 0
	end
	return level, totalXP - cumulative[level], Progression.XPToNext(level)
end

-- Total skill points earned by a level.
function Leveling.SkillPoints(level: number): number
	local total = 0
	for l = 2, level do
		total += Progression.SkillPointsFor(l)
	end
	return total
end

return Leveling
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Medals</string>
            <string name="Source"><![CDATA[-- Medal maths. Thresholds are { bronze, silver, gold, platinum } in seconds
-- (lower is better). Medal values: 0 none, 1 bronze ... 4 platinum.

local Medals = {}

function Medals.For(seconds: number, thresholds: { number }): number
	local medal = 0
	for index, limit in thresholds do
		if seconds <= limit then
			medal = index
		end
	end
	return medal
end

-- The next medal above the one this time earns, and its time limit.
function Medals.Next(seconds: number?, thresholds: { number }): (number?, number?)
	local current = if seconds then Medals.For(seconds, thresholds) else 0
	if current >= #thresholds then
		return nil, nil
	end
	return current + 1, thresholds[current + 1]
end

-- 0..1 position of a time on the medal bar (bronze at 0, platinum at 1).
function Medals.BarPosition(seconds: number, thresholds: { number }): number
	local bronze, platinum = thresholds[1], thresholds[#thresholds]
	if bronze <= platinum then
		return 1
	end
	return math.clamp((bronze - seconds) / (bronze - platinum), 0, 1)
end

-- Build thresholds from route par times (seconds of ideal play per route).
-- Platinum demands the best route executed well; bronze is a relaxed finish.
function Medals.FromPar(accessible: number, fast: number, expert: number): { number }
	-- Par times assume ideal lines, so thresholds leave room for real runs.
	local best = math.min(accessible, fast, expert)
	local platinum = best * 1.12 + 1
	local gold = math.max(math.min(accessible, fast) * 1.3 + 1.5, platinum + 1)
	local silver = math.max(accessible * 1.55 + 3, gold + 2)
	local bronze = math.max(accessible * 2.4 + 8, silver + 6)
	local function round(x: number): number
		return math.floor(x * 2 + 0.5) / 2
	end
	return { round(bronze), round(silver), round(gold), round(platinum) }
end

return Medals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">MoveStats</string>
            <string name="Source"><![CDATA[-- Effective movement attributes for a player.
--
-- Standard attributes come from Config/Movement. Skill tree effects modify a
-- copy unless the run is standardized (ranked runs, races, relays). Practice
-- assists make things more forgiving but mark the run as assisted.

local MovementConfig = require(script.Parent.Parent.Config.Movement)
local SkillTree = require(script.Parent.Parent.Config.SkillTree)

local MoveStats = {}

MoveStats.Assists = {
	{ Id = "Stamina", Name = "Endless Stamina", Text = "Stamina never runs out." },
	{ Id = "Grab", Name = "Generous Grabs", Text = "Ledges and ropes can be caught from further away." },
	{ Id = "Timing", Name = "Relaxed Timing", Text = "Longer coyote time, jump buffer and roll window." },
	{ Id = "Balance", Name = "Steady Beams", Text = "Balance beams barely sway." },
}

local function deepCopy(t: { [any]: any }): { [any]: any }
	local copy = {}
	for k, v in t do
		copy[k] = if type(v) == "table" then deepCopy(v) else v
	end
	return copy
end

local function apply(stats: { [string]: any }, path: string, op: string, amount: number)
	local container = stats
	local key = path
	local dot = string.find(path, ".", 1, true)
	if dot then
		container = stats[string.sub(path, 1, dot - 1)]
		key = string.sub(path, dot + 1)
	end
	if type(container) ~= "table" or type(container[key]) ~= "number" then
		return
	end
	if op == "Add" then
		container[key] += amount
	elseif op == "Mul" then
		container[key] *= math.max(1 + amount, 0.05)
	end
end

-- Returns (stats, perks). `ranks` maps skill ids to ranks.
function MoveStats.Compute(
	ranks: { [string]: number }?,
	standardized: boolean?,
	assists: { [string]: boolean }?
): ({ [string]: any }, { [string]: number })
	local stats = deepCopy(MovementConfig :: any)
	local perks: { [string]: number } = {}
	for nodeId, rank in (ranks or {}) :: { [string]: number } do
		local node = SkillTree.ById[nodeId]
		if node and rank > 0 then
			rank = math.min(rank, node.MaxRank)
			for _, effect in node.Effects do
				if effect[1] == "Perk" then
					perks[effect[2]] = (perks[effect[2]] or 0) + effect[3] * rank
				elseif not standardized then
					apply(stats, effect[1], effect[2], effect[3] * rank)
				end
			end
		end
	end
	if assists and not standardized then
		if assists.Stamina then
			for key in stats.Costs do
				stats.Costs[key] = 0
			end
		end
		if assists.Grab then
			stats.LedgeReach += 0.8
			stats.LedgeMaxAbove += 0.8
			stats.RopeGrabRange += 1.2
			stats.ZipGrabRange += 1.2
		end
		if assists.Timing then
			stats.CoyoteTime = math.max(stats.CoyoteTime, 0.22)
			stats.JumpBuffer = math.max(stats.JumpBuffer, 0.22)
			stats.RollWindow += 0.15
			stats.WallCoyote += 0.1
		end
		if assists.Balance then
			stats.BalanceSway *= 0.35
		end
	end
	stats.StaminaRegenDelay = math.max(stats.StaminaRegenDelay, 0.1)
	return stats, perks
end

function MoveStats.Standard(): { [string]: any }
	return deepCopy(MovementConfig :: any)
end

return MoveStats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Reach</string>
            <string name="Source"><![CDATA[-- The movement envelope: how far and how high the standard attributes can go.
--
-- Course segments, tower floors and endless sections size every gap and wall
-- from these numbers (never from hand-typed distances), so every obstacle in the
-- game stays physically achievable. Values are conservative: they assume
-- reasonable, not frame-perfect, execution.

local MovementConfig = require(script.Parent.Parent.Config.Movement)

type Stats = typeof(MovementConfig)

local Reach = {}

-- Edge allowance: you take off a little before the edge and need your feet
-- over the far platform to land.
Reach.EdgeMargin = 1.2

local function stats(s: Stats?): Stats
	return s or MovementConfig
end

-- Seconds of flight after leaving the ground at vertical speed `vy`, landing
-- `dy` studs higher (negative = lower). nil if the height can't be reached.
function Reach.AirTime(vy: number, dy: number, s: Stats?): number?
	local m = stats(s)
	local up = m.Gravity
	local down = m.Gravity * m.FallGravityMultiplier
	local apex = vy * vy / (2 * up)
	if dy > apex then
		return nil
	end
	return vy / up + math.sqrt(2 * (apex - dy) / down)
end

function Reach.JumpApex(s: Stats?): number
	local m = stats(s)
	return m.JumpVelocity ^ 2 / (2 * m.Gravity)
end

function Reach.DoubleJumpApex(s: Stats?): number
	local m = stats(s)
	return Reach.JumpApex(m) + m.DoubleJumpVelocity ^ 2 / (2 * m.Gravity)
end

-- Longest edge-to-edge gap clearable with a plain jump at `speed`.
function Reach.JumpDistance(dy: number, speed: number?, s: Stats?): number
	local m = stats(s)
	local t = Reach.AirTime(m.JumpVelocity, dy, m)
	if not t then
		return 0
	end
	return math.max((speed or m.SprintSpeed) * t - Reach.EdgeMargin, 0)
end

-- With a double jump at the top of the first jump.
function Reach.DoubleJumpDistance(dy: number, speed: number?, s: Stats?): number
	local m = stats(s)
	local first = m.JumpVelocity / m.Gravity
	local apex = Reach.JumpApex(m)
	local rest = Reach.AirTime(m.DoubleJumpVelocity, dy - apex, m)
	if not rest then
		return 0
	end
	return math.max((speed or m.SprintSpeed) * (first + rest) - Reach.EdgeMargin, 0)
end

-- Jump, then dash at the apex.
function Reach.DashJumpDistance(dy: number, speed: number?, s: Stats?): number
	local m = stats(s)
	local v = speed or m.SprintSpeed
	local first = m.JumpVelocity / m.Gravity
	local apex = Reach.JumpApex(m) + m.DashLift * m.DashTime
	local rest = Reach.AirTime(m.DashLift, dy - apex, m)
	if not rest then
		return 0
	end
	local exitSpeed = math.max(v, m.DashSpeed * 0.6)
	return math.max(v * first + m.DashSpeed * m.DashTime + exitSpeed * rest - Reach.EdgeMargin, 0)
end

-- Highest ledge (above the floor you jump from) a jump can catch.
function Reach.LedgeHeight(s: Stats?): number
	local m = stats(s)
	return m.RootHeight + Reach.JumpApex(m) + m.LedgeMaxAbove
end

-- Highest ledge reachable by running up a wall and catching the top.
function Reach.WallClimbHeight(s: Stats?): number
	local m = stats(s)
	local t = m.WallClimbTime
	local rise = m.WallClimbSpeed * t - 0.5 * m.WallClimbGravity * t * t
	local vy = math.max(m.WallClimbSpeed - m.WallClimbGravity * t, 0)
	rise += vy * vy / (2 * m.Gravity)
	return m.RootHeight + rise + m.LedgeMaxAbove
end

-- Height gained per kick when alternating between two walls `width` apart.
function Reach.ShaftKickRise(width: number, s: Stats?): number
	local m = stats(s)
	local travel = math.max(width - 2, 1) / m.WallKickOut
	return m.WallKickUp * travel - 0.5 * m.Gravity * travel * travel
end

-- Distance along the wall and height lost after wall running for `seconds`.
function Reach.WallRun(seconds: number, s: Stats?): (number, number)
	local m = stats(s)
	local dt = 1 / 120
	local t, y, vy = 0, 0, m.WallRunStartLift
	while t < seconds do
		local g = m.WallRunGravity + (m.WallRunGravityEnd - m.WallRunGravity) * math.min(t / m.WallRunMaxTime, 1)
		vy -= g * dt
		y += vy * dt
		t += dt
	end
	return m.WallRunSpeed * seconds, -y
end

-- Root rise from a bounce or vent launch of vertical speed `vy`.
function Reach.LaunchHeight(vy: number, s: Stats?): number
	local m = stats(s)
	return vy * vy / (2 * m.Gravity)
end

-- Launch speed needed to rise `height` studs (with a safety margin).
function Reach.LaunchSpeedFor(height: number, s: Stats?): number
	local m = stats(s)
	return math.sqrt(2 * m.Gravity * (height + 3))
end

return Reach
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[-- Course reward maths: first completions, medal upgrades, distinctions and
-- repeat runs scaled by difficulty and performance.

local Progression = require(script.Parent.Parent.Config.Progression)

local Rewards = {}

export type Breakdown = { Label: string, XP: number, Credits: number, Prestige: number }
export type Result = {
	Seconds: number,
	Medal: number,
	Distinctions: { [string]: boolean },
	Mode: string, -- "Casual" | "Practice" | "Ranked" | "Race" | "Relay"
}
export type Record = {
	Medal: number,
	Completions: number,
	Best: number?,
	Distinctions: { [string]: boolean },
}

function Rewards.DifficultyFactor(difficulty: number): number
	return 0.6 + 0.2 * math.clamp(difficulty, 1, 10)
end

-- Repeat runs pay full value for the first few runs of a course each session.
Rewards.RepeatFullRuns = 8
Rewards.RepeatTailFactor = 0.25

function Rewards.Course(
	difficulty: number,
	thresholds: { number },
	result: Result,
	record: Record,
	repeatsThisSession: number
): ({ Breakdown }, number, number, number)
	local factor = Rewards.DifficultyFactor(difficulty)
	local lines: { Breakdown } = {}
	local function add(label: string, xp: number, credits: number, prestige: number?)
		table.insert(lines, {
			Label = label,
			XP = math.floor(xp + 0.5),
			Credits = math.floor(credits + 0.5),
			Prestige = prestige or 0,
		})
	end

	if result.Mode == "Practice" then
		-- Practice is for learning: a small token amount only.
		add("Practice run", 10, 0)
	else
		if (record.Completions or 0) == 0 then
			add(
				"First completion",
				Progression.XP.FirstCompletion * factor,
				Progression.Credits.FirstCompletion * factor
			)
		else
			local performance = math.clamp(thresholds[1] / math.max(result.Seconds, 1), 0.5, 1.6)
			local scale = if repeatsThisSession < Rewards.RepeatFullRuns then 1 else Rewards.RepeatTailFactor
			add(
				"Repeat run",
				Progression.XP.Repeat * factor * performance * scale,
				Progression.Credits.Repeat * factor * performance * scale
			)
		end
		local names = { "Bronze", "Silver", "Gold", "Platinum" }
		for medal = (record.Medal or 0) + 1, result.Medal do
			add(
				names[medal] .. " medal",
				Progression.XP.MedalUpgrade[medal] * factor,
				Progression.Credits.MedalUpgrade[medal] * factor,
				if medal == 4 then Progression.Prestige.Platinum else 0
			)
		end
		for id, earned in result.Distinctions do
			if earned and not (record.Distinctions or {})[id] then
				add("Distinction: " .. id, Progression.XP.Distinction * factor, 25 * factor)
			end
		end
		if record.Best and result.Seconds < record.Best then
			add("Personal best", Progression.XP.PersonalBest * factor, 0)
		end
	end

	local xp, credits, prestige = 0, 0, 0
	for _, line in lines do
		xp += line.XP
		credits += line.Credits
		prestige += line.Prestige
	end
	return lines, xp, credits, prestige
end

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Rotation</string>
            <string name="Source"><![CDATA[-- Day/week numbers and deterministic picks for rotating objectives.

local Rotation = {}

local DAY = 86400
local WEEK = DAY * 7
-- The Unix epoch was a Thursday; shift so weeks start on Monday (UTC).
local WEEK_OFFSET = DAY * 3

function Rotation.Day(now: number?): number
	return math.floor((now or os.time()) / DAY)
end

function Rotation.Week(now: number?): number
	return math.floor(((now or os.time()) + WEEK_OFFSET) / WEEK)
end

function Rotation.SecondsUntilNextDay(now: number?): number
	local t = now or os.time()
	return DAY - (t % DAY)
end

function Rotation.SecondsUntilNextWeek(now: number?): number
	local t = (now or os.time()) + WEEK_OFFSET
	return WEEK - (t % WEEK)
end

-- Small deterministic hash (FNV-1a style) for seeding.
function Rotation.Hash(...: any): number
	local h = 2166136261
	for _, part in { ... } do
		local text = tostring(part)
		for i = 1, #text do
			h = bit32.bxor(h, string.byte(text, i))
			h = (h * 16777619) % 4294967296
		end
	end
	return h
end

-- A small LCG so picks are identical on every machine (and in tests).
export type Rng = { Next: (Rng) -> number, Int: (Rng, number, number) -> number, Pick: (Rng, { any }) -> any }

function Rotation.Rng(seed: number): Rng
	local state = seed % 2147483647
	if state <= 0 then
		state += 2147483646
	end
	local rng = {}
	function rng.Next(_self): number
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
	function rng.Int(self, lo: number, hi: number): number
		return lo + math.floor(self:Next() * (hi - lo + 1))
	end
	function rng.Pick(self, list: { any }): any
		return list[self:Int(1, #list)]
	end
	return rng :: any
end

-- Pick `count` distinct entries from `list` using `seed`.
function Rotation.PickDistinct(list: { any }, count: number, seed: number): { any }
	local pool = table.clone(list)
	local rng = Rotation.Rng(seed)
	local result = {}
	while #result < count and #pool > 0 do
		local index = rng:Int(1, #pool)
		table.insert(result, table.remove(pool, index))
	end
	return result
end

return Rotation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Schedule</string>
            <string name="Source"><![CDATA[-- Deterministic timelines for every timed mechanism (doors, vents, lasers,
-- retracting bridges, blinking holograms, gusts, moving platforms).
--
-- Everything is a pure function of shared server time, so every client sees
-- the same door open at the same moment, and courses behave identically on
-- every server.

local Schedule = {}

-- 0..1 position through a repeating cycle.
function Schedule.Fraction(t: number, period: number, phase: number?): number
	if period <= 0 then
		return 0
	end
	return ((t / period) + (phase or 0)) % 1
end

-- Smooth there-and-back motion: 0 → 1 → 0 over one period.
function Schedule.PingPong(t: number, period: number, phase: number?): number
	local f = Schedule.Fraction(t, period, phase)
	return 0.5 - 0.5 * math.cos(f * math.pi * 2)
end

-- Move, pause at each end, move back. `hold` is the fraction of the period
-- spent paused (split between both ends), giving players a beat to board.
function Schedule.Shuttle(t: number, period: number, phase: number?, hold: number?): number
	local f = Schedule.Fraction(t, period, phase)
	local pause = math.clamp(hold or 0.3, 0, 0.9) / 2
	local travel = 0.5 - pause
	if f < pause then
		return 0
	elseif f < pause + travel then
		local a = (f - pause) / travel
		return a * a * (3 - 2 * a)
	elseif f < pause * 2 + travel then
		return 1
	else
		local a = (f - pause * 2 - travel) / travel
		return 1 - a * a * (3 - 2 * a)
	end
end

-- On/off cycle with a warning period before each switch.
-- Returns (on, warning, secondsUntilChange).
function Schedule.Cycle(
	t: number,
	period: number,
	onFraction: number,
	phase: number?,
	warn: number?
): (boolean, boolean, number)
	local f = Schedule.Fraction(t, period, phase)
	local onTime = period * onFraction
	local now = f * period
	local on = now < onTime
	local untilChange = if on then onTime - now else period - now
	local warning = untilChange <= (warn or 0.6)
	return on, warning, untilChange
end

-- Angle (radians) of a pendulum swing.
function Schedule.Pendulum(t: number, period: number, amplitude: number, phase: number?): number
	local f = Schedule.Fraction(t, period, phase)
	return math.sin(f * math.pi * 2) * amplitude
end

-- Shared clock. workspace:GetServerTimeNow() is synchronised across clients.
function Schedule.Now(): number
	return workspace:GetServerTimeNow()
end

return Schedule
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Stats</string>
            <string name="Source"><![CDATA[-- Statistic lookup for achievements, the journal and quests.
--
-- Counters (moves performed, races won...) live in profile.Stats. Everything
-- else is derived from the rest of the profile so it can never drift out of
-- sync. Discovery ids encode their kind as a prefix: cache_, letter_,
-- landmark_, secret_.

local Courses = require(script.Parent.Parent.Config.Courses)
local Mastery = require(script.Parent.Parent.Config.Mastery)
local Quests = require(script.Parent.Parent.Config.Quests)
local Leveling = require(script.Parent.Leveling)

local Stats = {}

local function count(t: { [any]: any }?): number
	local n = 0
	for _ in (t or {}) :: { [any]: any } do
		n += 1
	end
	return n
end

local function countPrefix(t: { [string]: any }?, prefix: string): number
	local n = 0
	for id in (t or {}) :: { [string]: any } do
		if string.sub(id, 1, #prefix) == prefix then
			n += 1
		end
	end
	return n
end

local function courseCount(profile: any, predicate: (any, any) -> boolean): number
	local n = 0
	for id, record in profile.Courses or {} do
		local course = Courses.ById[id]
		if course and predicate(course, record) then
			n += 1
		end
	end
	return n
end

local function masteryTiers(profile: any): { number }
	local tiers = {}
	local data = profile.Mastery or {}
	for _, category in Mastery.Categories do
		local points = (data.Points or {})[category.Id] or 0
		table.insert(tiers, Mastery.TierOf(category.Id, points, data.Challenges or {}))
	end
	return tiers
end

local function chaptersCompleted(profile: any): number
	local done = (profile.Quests or {}).Completed or {}
	local chapters: { [number]: boolean } = {}
	for _, quest in Quests.List do
		if quest.Type == "Main" and quest.Chapter then
			if chapters[quest.Chapter] == nil then
				chapters[quest.Chapter] = true
			end
			if not done[quest.Id] then
				chapters[quest.Chapter] = false
			end
		end
	end
	local n = 0
	for _, complete in chapters do
		if complete then
			n += 1
		end
	end
	return n
end

local derived: { [string]: (any, any) -> number } = {
	Level = function(profile)
		return (Leveling.FromXP(profile.XP or 0))
	end,
	CoursesCleared = function(profile)
		return courseCount(profile, function(course, record)
			return (course.Kind == "Course" or course.Kind == "Room") and (record.Completions or 0) > 0
		end)
	end,
	RoomsCleared = function(profile)
		return courseCount(profile, function(course, record)
			return course.Kind == "Room" and (record.Completions or 0) > 0
		end)
	end,
	Bronze = function(profile)
		return courseCount(profile, function(_, record)
			return (record.Medal or 0) >= 1
		end)
	end,
	Silver = function(profile)
		return courseCount(profile, function(_, record)
			return (record.Medal or 0) >= 2
		end)
	end,
	Gold = function(profile)
		return courseCount(profile, function(_, record)
			return (record.Medal or 0) >= 3
		end)
	end,
	Platinum = function(profile)
		return courseCount(profile, function(_, record)
			return (record.Medal or 0) >= 4
		end)
	end,
	NoFallCourses = function(profile)
		return courseCount(profile, function(_, record)
			return (record.Distinctions or {}).NoFall == true
		end)
	end,
	ShortcutCourses = function(profile)
		return courseCount(profile, function(_, record)
			return (record.Distinctions or {}).Shortcut == true
		end)
	end,
	AllTokenCourses = function(profile)
		return courseCount(profile, function(_, record)
			return (record.Distinctions or {}).AllTokens == true
		end)
	end,
	FlowCourses = function(profile)
		return courseCount(profile, function(_, record)
			return (record.Distinctions or {}).Flow == true
		end)
	end,
	Discoveries = function(profile)
		return count(profile.Discoveries)
	end,
	Caches = function(profile)
		return countPrefix(profile.Discoveries, "cache_")
	end,
	Letters = function(profile)
		return countPrefix(profile.Discoveries, "letter_")
	end,
	Landmarks = function(profile)
		return countPrefix(profile.Discoveries, "landmark_")
	end,
	DistrictsVisited = function(profile)
		return count((profile.Districts or {}).Visited)
	end,
	ItemsOwned = function(profile)
		return count(profile.Inventory)
	end,
	BestMasteryTier = function(profile)
		local best = 0
		for _, tier in masteryTiers(profile) do
			best = math.max(best, tier)
		end
		return best
	end,
	LowestMasteryTier = function(profile)
		local lowest = math.huge
		for _, tier in masteryTiers(profile) do
			lowest = math.min(lowest, tier)
		end
		return if lowest == math.huge then 0 else lowest
	end,
	MasteryTiers = function(profile)
		local total = 0
		for _, tier in masteryTiers(profile) do
			total += tier
		end
		return total
	end,
	ChaptersCompleted = chaptersCompleted,
	QuestsCompleted = function(profile)
		return count((profile.Quests or {}).Completed)
	end,
	TowerFloor = function(profile)
		return (profile.Tower or {}).Highest or 0
	end,
	EndlessBest = function(profile)
		return (profile.Endless or {}).Best or 0
	end,
	DistrictCachesComplete = function(profile, context)
		local totals = context and context.CacheTotals
		if not totals then
			return 0
		end
		local n = 0
		for district, total in totals do
			local found = countPrefix(profile.Discoveries, "cache_" .. string.lower(district) .. "_")
			if total > 0 and found >= total then
				n += 1
			end
		end
		return n
	end,
}

function Stats.Get(profile: any, key: string, context: any?): number
	local fn = derived[key]
	if fn then
		return fn(profile, context)
	end
	if string.sub(key, 1, 7) == "Secret_" then
		return if (profile.Discoveries or {})["secret_" .. string.lower(string.sub(key, 8))] then 1 else 0
	end
	return (profile.Stats or {})[key] or 0
end

function Stats.IsDerived(key: string): boolean
	return derived[key] ~= nil or string.sub(key, 1, 7) == "Secret_"
end

-- Mastery tier for every category, keyed by id.
function Stats.MasteryTiers(profile: any): { [string]: number }
	local result = {}
	local data = profile.Mastery or {}
	for _, category in Mastery.Categories do
		local points = (data.Points or {})[category.Id] or 0
		result[category.Id] = Mastery.TierOf(category.Id, points, data.Challenges or {})
	end
	return result
end

return Stats
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Networking for every system in Skyline Legends, through four remotes.
--
-- Messages are addressed by route ("Course.Checkpoint", "Shop.Buy", ...). Every
-- client→server route must be declared in ROUTES with a rate limit, so new
-- features plug in by adding a line here and a handler on the server.
--
--   Server:  Net.On(route, fn(player, ...))          fire-and-forget from a client
--            Net.Handle(route, fn(player, ...) → ...) request/response
--            Net.Push(player, route, ...)             server → one client
--            Net.PushAll(route, ...) / Net.PushOthers(player, route, ...)
--   Client:  Net.Send(route, ...) / Net.Invoke(route, ...) / Net.Listen(route, fn)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- Allowed client→server routes: { per-second rate, burst }.
local ROUTES: { [string]: { number } } = {
	-- Movement relay and validation
	["Move.State"] = { 20, 40 },
	["Move.Action"] = { 25, 50 },
	["Move.Fall"] = { 4, 8 },
	["Move.Flow"] = { 2, 4 },
	-- Courses
	["Course.Start"] = { 2, 4 },
	["Course.Checkpoint"] = { 6, 12 },
	["Course.Token"] = { 10, 20 },
	["Course.Shortcut"] = { 4, 8 },
	["Course.Abort"] = { 2, 4 },
	["Course.Restart"] = { 2, 4 },
	["Course.Ghost"] = { 1, 2 },
	["Course.Preview"] = { 4, 8 },
	["Course.Leaderboard"] = { 2, 6 },
	["Course.GetGhost"] = { 1, 4 },
	-- Progress
	["Profile.Get"] = { 1, 4 },
	["Settings.Save"] = { 1, 4 },
	["Skill.Unlock"] = { 4, 8 },
	["Skill.Respec"] = { 1, 2 },
	["Shop.Buy"] = { 3, 6 },
	["Shop.Equip"] = { 6, 12 },
	-- World
	["Travel.Go"] = { 1, 3 },
	["Travel.Spawn"] = { 1, 3 },
	["Discover.Touch"] = { 6, 12 },
	["Lesson.Complete"] = { 4, 8 },
	["Lesson.Reset"] = { 1, 3 },
	-- Quests and NPCs
	["Quest.Talk"] = { 3, 6 },
	["Quest.Accept"] = { 3, 6 },
	["Quest.Abandon"] = { 2, 4 },
	["Quest.Pin"] = { 4, 8 },
	["Quest.Point"] = { 6, 12 },
	["Quest.Claim"] = { 4, 8 },
	["Contract.Take"] = { 2, 4 },
	-- Modes
	["Race.List"] = { 2, 4 },
	["Race.Create"] = { 1, 3 },
	["Race.Join"] = { 2, 4 },
	["Race.Leave"] = { 2, 4 },
	["Race.Ready"] = { 2, 4 },
	["Relay.Create"] = { 1, 3 },
	["Relay.Join"] = { 2, 4 },
	["Relay.Leave"] = { 2, 4 },
	["Relay.Ready"] = { 2, 4 },
	["Tower.Enter"] = { 1, 3 },
	["Tower.Floor"] = { 4, 8 },
	["Tower.Leave"] = { 1, 3 },
	["Endless.Start"] = { 1, 2 },
	["Endless.Gate"] = { 6, 12 },
	["Endless.End"] = { 1, 3 },
	["Switch.Press"] = { 6, 12 },
	-- Social
	["Crew.Create"] = { 1, 2 },
	["Crew.Invite"] = { 2, 4 },
	["Crew.Respond"] = { 2, 4 },
	["Crew.Leave"] = { 1, 2 },
	["Crew.Kick"] = { 2, 4 },
	["Crew.Get"] = { 2, 4 },
	["Social.Invite"] = { 2, 4 },
	["Social.Respond"] = { 2, 4 },
	["Social.Players"] = { 2, 4 },
	["Emote.Play"] = { 3, 6 },
}

type Bucket = { Tokens: number, Updated: number }

local Net = {}

local isServer = RunService:IsServer()
local folder: Folder
local c2s: RemoteEvent
local s2c: RemoteEvent
local rpc: RemoteFunction

if isServer then
	folder = Instance.new("Folder")
	folder.Name = "SkylineNet"
	c2s = Instance.new("RemoteEvent")
	c2s.Name = "C2S"
	c2s.Parent = folder
	s2c = Instance.new("RemoteEvent")
	s2c.Name = "S2C"
	s2c.Parent = folder
	rpc = Instance.new("RemoteFunction")
	rpc.Name = "RPC"
	rpc.Parent = folder
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("SkylineNet") :: Folder
	c2s = folder:WaitForChild("C2S") :: RemoteEvent
	s2c = folder:WaitForChild("S2C") :: RemoteEvent
	rpc = folder:WaitForChild("RPC") :: RemoteFunction
end

-- Server ------------------------------------------------------------------------

local eventHandlers: { [string]: (Player, ...any) -> () } = {}
local requestHandlers: { [string]: (Player, ...any) -> ...any } = {}
local buckets: { [Player]: { [string]: Bucket } } = {}

local function allow(player: Player, route: string): boolean
	local limit = ROUTES[route]
	if not limit then
		return false
	end
	local perPlayer = buckets[player]
	if not perPlayer then
		perPlayer = {}
		buckets[player] = perPlayer
	end
	local now = os.clock()
	local bucket = perPlayer[route]
	if not bucket then
		bucket = { Tokens = limit[2], Updated = now }
		perPlayer[route] = bucket
	end
	bucket.Tokens = math.min(limit[2], bucket.Tokens + (now - bucket.Updated) * limit[1])
	bucket.Updated = now
	if bucket.Tokens < 1 then
		return false
	end
	bucket.Tokens -= 1
	return true
end

if isServer then
	c2s.OnServerEvent:Connect(function(player: Player, route: any, ...)
		if type(route) ~= "string" or not allow(player, route) then
			return
		end
		local handler = eventHandlers[route]
		if handler then
			local ok, err = pcall(handler, player, ...)
			if not ok then
				warn(("[Net] %s from %s failed: %s"):format(route, player.Name, tostring(err)))
			end
		end
	end)
	rpc.OnServerInvoke = function(player: Player, route: any, ...)
		if type(route) ~= "string" or not allow(player, route) then
			return nil
		end
		local handler = requestHandlers[route]
		if not handler then
			return nil
		end
		local results = table.pack(pcall(handler, player, ...))
		if not results[1] then
			warn(("[Net] %s from %s failed: %s"):format(route, player.Name, tostring(results[2])))
			return nil
		end
		return table.unpack(results, 2, results.n)
	end
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

function Net.On(route: string, handler: (Player, ...any) -> ())
	assert(isServer, "Net.On is server-only")
	assert(ROUTES[route], "Undeclared route " .. route)
	eventHandlers[route] = handler
end

function Net.Handle(route: string, handler: (Player, ...any) -> ...any)
	assert(isServer, "Net.Handle is server-only")
	assert(ROUTES[route], "Undeclared route " .. route)
	requestHandlers[route] = handler
end

function Net.Push(player: Player, route: string, ...)
	s2c:FireClient(player, route, ...)
end

function Net.PushAll(route: string, ...)
	s2c:FireAllClients(route, ...)
end

function Net.PushOthers(except: Player, route: string, ...)
	for _, player in Players:GetPlayers() do
		if player ~= except then
			s2c:FireClient(player, route, ...)
		end
	end
end

-- Client ------------------------------------------------------------------------

local listeners: { [string]: { (...any) -> () } } = {}
local pending: { [string]: { { any } } } = {}

if not isServer then
	s2c.OnClientEvent:Connect(function(route: string, ...)
		local list = listeners[route]
		if list then
			for _, fn in list do
				task.spawn(fn, ...)
			end
		else
			-- Nobody is listening yet (scripts still starting): keep it for them.
			local queue = pending[route]
			if not queue then
				queue = {}
				pending[route] = queue
			end
			if #queue < 64 then
				table.insert(queue, table.pack(...))
			end
		end
	end)
end

function Net.Send(route: string, ...)
	c2s:FireServer(route, ...)
end

function Net.Invoke(route: string, ...): ...any
	return rpc:InvokeServer(route, ...)
end

function Net.Listen(route: string, fn: (...any) -> ())
	local list = listeners[route]
	if not list then
		list = {}
		listeners[route] = list
	end
	table.insert(list, fn)
	local queue = pending[route]
	if queue then
		pending[route] = nil
		for _, args in queue do
			task.spawn(fn, table.unpack(args, 1, args.n))
		end
	end
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">Tags</string>
          <string name="Source"><![CDATA[-- World tagging conventions shared by the world builder (server) and the
-- movement, mechanism and course systems (client).
--
-- Gameplay surfaces are identified by CollectionService tags plus attributes,
-- so a hand-built map (or a new district) works with every system as long as
-- it follows these conventions.

local Tags = {
	-- Surfaces --------------------------------------------------------------
	Climbable = "Climbable", -- ladders, vines, mesh: climb in any direction
	Balance = "Balance", -- narrow beams: balance traversal along the part's longest axis
	LowClearance = "LowClearance", -- slide/crouch under (collision group LowClearance)
	Ice = "Ice", -- slippery ground that keeps momentum
	NoWallRun = "NoWallRun", -- attribute or tag: not runnable
	NoLedge = "NoLedge", -- attribute or tag: not grabbable
	Precision = "PrecisionPad", -- small landing targets

	-- Traversal objects -------------------------------------------------------
	Zipline = "Zipline", -- attributes A, B (Vector3 endpoints of the cable)
	SwingRope = "SwingRope", -- attributes Pivot (Vector3), Length (number)
	GrappleAnchor = "GrappleAnchor", -- swing anchor (ring)
	PullAnchor = "PullAnchor", -- pull anchor (diamond); attribute Exit (Vector3) optional
	BouncePad = "BouncePad", -- attribute Power (vertical speed)
	LaunchVent = "LaunchVent", -- attributes Power, Period, OnFraction, Phase, Warn
	WindZone = "WindZone", -- attributes Force (Vector3 accel), Period, OnFraction, Phase, Warn
	GravityZone = "GravityZone", -- attributes Scale (0..1), Lift (accel)
	Conveyor = "Conveyor", -- anchored part with AssemblyLinearVelocity

	-- Mechanisms (animated on each client from shared time) -------------------
	Mover = "Mover", -- attribute Kind = Linear | Orbit | Spin | Pendulum | Shuttle
	Timed = "Timed", -- attribute Kind = Retract | Blink | Door | Laser | Vent | Gust
	Collapse = "Collapse", -- falls a moment after you land on it, then resets
	Hazard = "Hazard", -- touching it sends you back to your checkpoint (attribute Active)
	KillZone = "KillZone", -- volume: falling into it respawns you
	Switch = "PressureSwitch", -- attributes SwitchId, Duration, Coop
	SwitchGate = "SwitchGate", -- attribute SwitchId
	Water = "RisingWater", -- attributes CourseId, StartCP, Rate, BaseY, MaxY

	-- Courses -------------------------------------------------------------------
	CourseStart = "CourseStart", -- attributes CourseId
	CourseCheckpoint = "CourseCheckpoint", -- attributes CourseId, Index (volume)
	CourseFinish = "CourseFinish", -- attributes CourseId (volume)
	CourseToken = "CourseToken", -- attributes CourseId, Index
	CourseShortcut = "CourseShortcut", -- attributes CourseId (volume)

	-- World ----------------------------------------------------------------------
	Discovery = "Discovery", -- attributes Id, Kind (Cache | Letter | Landmark | Secret)
	QuestPoint = "QuestPoint", -- attributes Id
	ContractPoint = "ContractPoint", -- attributes District
	TravelGate = "TravelGate", -- attributes District
	NPCSpot = "NPCSpot", -- attributes Id
	LessonZone = "LessonZone", -- attributes LessonId
	Board = "Board", -- attributes Kind (Race | Jobs | Courses | Leaderboard), District
	Decor = "Decor",
	-- Animated R6 rigs that aren't player characters (ghosts, NPCs). Attributes:
	-- MS (movement state), MA (aux Vector3), MB (aux number), GV (velocity), Emote
	Rig = "SkylineRig",
	SurfaceIcon = "SurfaceIcon", -- billboard icons shown per accessibility setting
}

-- Collision groups (registered by the server at start).
Tags.Groups = {
	World = "Default",
	Players = "Players",
	PlayersLow = "PlayersLow", -- crouching/sliding: passes LowClearance
	PlayersPhase = "PlayersPhase", -- scripted moves (vault/mantle): passes world geometry
	LowClearance = "LowClearance",
	Ghosts = "Ghosts",
	Cosmetic = "Cosmetic",
}

return Tags
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="34">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[-- Text formatting used by the HUD, menus and results.

local Format = {}

-- 83.456 → "1:23.46"; 9.1 → "9.10"
function Format.Time(seconds: number?): string
	if not seconds or seconds ~= seconds or seconds == math.huge then
		return "--:--.--"
	end
	local negative = seconds < 0
	seconds = math.abs(seconds)
	local minutes = math.floor(seconds / 60)
	local rest = seconds - minutes * 60
	local text
	if minutes > 0 then
		text = ("%d:%05.2f"):format(minutes, rest)
	else
		text = ("%.2f"):format(rest)
	end
	return if negative then "-" .. text else text
end

-- Split delta: "+0.42" / "-1.05"
function Format.Delta(seconds: number): string
	local sign = if seconds >= 0 then "+" else "-"
	return sign .. Format.Time(math.abs(seconds))
end

-- 1234567 → "1,234,567"
function Format.Number(n: number): string
	local text = tostring(math.floor(n + 0.5))
	local negative = string.sub(text, 1, 1) == "-"
	if negative then
		text = string.sub(text, 2)
	end
	local formatted = string.reverse((string.gsub(string.reverse(text), "(%d%d%d)", "%1,")))
	if string.sub(formatted, 1, 1) == "," then
		formatted = string.sub(formatted, 2)
	end
	return if negative then "-" .. formatted else formatted
end

-- 3725 → "1h 2m"
function Format.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	if hours > 0 then
		return ("%dh %dm"):format(hours, minutes)
	elseif minutes > 0 then
		return ("%dm %ds"):format(minutes, seconds % 60)
	end
	return ("%ds"):format(seconds)
end

function Format.Plural(count: number, word: string, plural: string?): string
	return ("%s %s"):format(Format.Number(count), if count == 1 then word else (plural or word .. "s"))
end

-- "WallRun" → "Wall Run"
function Format.Spaced(id: string): string
	return (string.gsub(id, "(%l)(%u)", "%1 %2"))
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">MathUtil</string>
            <string name="Source"><![CDATA[-- Small vector and number helpers shared by client and server.

local MathUtil = {}

function MathUtil.Flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function MathUtil.FlatUnit(v: Vector3, fallback: Vector3?): Vector3
	local flat = Vector3.new(v.X, 0, v.Z)
	if flat.Magnitude < 1e-4 then
		return fallback or Vector3.zAxis
	end
	return flat.Unit
end

-- Frame-rate independent smoothing toward a target (numbers, Vector3s, CFrames via Lerp).
function MathUtil.Damp(current: any, target: any, rate: number, dt: number): any
	local alpha = 1 - math.exp(-rate * dt)
	if type(current) == "number" then
		return current + (target - current) * alpha
	end
	return current:Lerp(target, alpha)
end

-- Move a number toward a target by at most `step`.
function MathUtil.Approach(current: number, target: number, step: number): number
	if current < target then
		return math.min(current + step, target)
	end
	return math.max(current - step, target)
end

-- Turns unit vector `from` toward unit vector `to` by at most `maxAngle` radians.
function MathUtil.RotateToward(from: Vector3, to: Vector3, maxAngle: number): Vector3
	local angle = math.acos(math.clamp(from:Dot(to), -1, 1))
	if angle <= maxAngle then
		return to
	end
	local axis = from:Cross(to)
	if axis.Magnitude < 1e-5 then
		axis = Vector3.yAxis
	end
	return CFrame.fromAxisAngle(axis.Unit, maxAngle):VectorToWorldSpace(from)
end

-- Rotation that turns unit vector `a` into unit vector `b`.
function MathUtil.RotationBetween(a: Vector3, b: Vector3): CFrame
	local dot = math.clamp(a:Dot(b), -1, 1)
	local axis = a:Cross(b)
	if axis.Magnitude < 1e-5 then
		if dot > 0 then
			return CFrame.identity
		end
		return CFrame.Angles(math.pi, 0, 0)
	end
	return CFrame.fromAxisAngle(axis.Unit, math.acos(dot))
end

-- Closest point on segment AB to P, plus the 0..1 parameter along it.
function MathUtil.ClosestOnSegment(a: Vector3, b: Vector3, p: Vector3): (Vector3, number)
	local ab = b - a
	local lengthSquared = ab:Dot(ab)
	if lengthSquared < 1e-6 then
		return a, 0
	end
	local t = math.clamp((p - a):Dot(ab) / lengthSquared, 0, 1)
	return a + ab * t, t
end

-- Smoothstep easing.
function MathUtil.Smooth(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

function MathUtil.EaseOutCubic(t: number): number
	t = math.clamp(t, 0, 1)
	return 1 - (1 - t) ^ 3
end

-- Quadratic Bezier.
function MathUtil.Bezier(a: Vector3, control: Vector3, b: Vector3, t: number): Vector3
	local u = 1 - t
	return a * (u * u) + control * (2 * u * t) + b * (t * t)
end

-- Yaw-only CFrame looking along a direction from a position.
function MathUtil.FlatLook(position: Vector3, direction: Vector3): CFrame
	local flat = MathUtil.FlatUnit(direction)
	return CFrame.lookAt(position, position + flat)
end

-- Whether `point` lies inside a part-shaped box (cframe + size), with padding.
function MathUtil.InBox(cframe: CFrame, size: Vector3, point: Vector3, pad: number?): boolean
	local p = cframe:PointToObjectSpace(point)
	local half = size / 2 + Vector3.one * (pad or 0)
	return math.abs(p.X) <= half.X and math.abs(p.Y) <= half.Y and math.abs(p.Z) <= half.Z
end

return MathUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[-- Minimal synchronous signal for in-process events between modules.

export type Connection = { Disconnect: (Connection) -> (), Connected: boolean }
export type Signal = {
	Connect: (Signal, (...any) -> ()) -> Connection,
	Once: (Signal, (...any) -> ()) -> Connection,
	Fire: (Signal, ...any) -> (),
	DisconnectAll: (Signal) -> (),
}

local Signal = {}
Signal.__index = Signal

function Signal.new(): Signal
	return setmetatable({ _handlers = {} }, Signal) :: any
end

function Signal:Connect(fn: (...any) -> ())
	local handlers = self._handlers
	local connection = { Connected = true }
	function connection.Disconnect(conn)
		if not conn.Connected then
			return
		end
		conn.Connected = false
		local index = table.find(handlers, fn)
		if index then
			table.remove(handlers, index)
		end
	end
	table.insert(handlers, fn)
	return connection
end

function Signal:Once(fn: (...any) -> ())
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal:Fire(...)
	-- Copy so handlers can disconnect while we iterate.
	for _, fn in table.clone(self._handlers) do
		local ok, err = pcall(fn, ...)
		if not ok then
			warn("[Signal] handler error: " .. tostring(err))
		end
	end
end

function Signal:DisconnectAll()
	table.clear(self._handlers)
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="38">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="39">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Skyline Legends: server bootstrap.
--
-- Order matters: profiles start loading as soon as players join, the city is
-- generated (deterministically, so every server builds the same Meridian),
-- then every service starts, and only then are characters spawned.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Remotes exist before any client asks for them.
require(ReplicatedStorage.Shared.Net)

local DataService = require(script.Data.DataService)
local WorldBuilder = require(script.World.WorldBuilder)

local Services = script.Services
local AchievementService = require(Services.AchievementService)
local CosmeticService = require(Services.CosmeticService)
local CourseService = require(Services.CourseService)
local CrewService = require(Services.CrewService)
local DiscoveryService = require(Services.DiscoveryService)
local DistrictService = require(Services.DistrictService)
local EconomyService = require(Services.EconomyService)
local EndlessService = require(Services.EndlessService)
local LessonService = require(Services.LessonService)
local MasteryService = require(Services.MasteryService)
local MovementGuard = require(Services.MovementGuard)
local NPCService = require(Services.NPCService)
local PlayerService = require(Services.PlayerService)
local ProgressionService = require(Services.ProgressionService)
local QuestService = require(Services.QuestService)
local RaceService = require(Services.RaceService)
local RecordService = require(Services.RecordService)
local RelayService = require(Services.RelayService)
local SocialService = require(Services.SocialService)
local TowerService = require(Services.TowerService)

DataService.Start()

local started = os.clock()
WorldBuilder.Build()
for name, cframe in WorldBuilder.Spawns do
	PlayerService.Spawns[name] = cframe
end
MovementGuard.RefreshCache()
print(("[Skyline] Meridian built in %.1fs"):format(os.clock() - started))

local ordered = {
	{ "Progression", ProgressionService },
	{ "Economy", EconomyService },
	{ "Cosmetics", CosmeticService },
	{ "MovementGuard", MovementGuard },
	{ "Districts", DistrictService },
	{ "Discoveries", DiscoveryService },
	{ "Achievements", AchievementService },
	{ "Mastery", MasteryService },
	{ "Records", RecordService },
	{ "Courses", CourseService },
	{ "Quests", QuestService },
	{ "NPCs", NPCService },
	{ "Lessons", LessonService },
	{ "Tower", TowerService },
	{ "Endless", EndlessService },
	{ "Races", RaceService },
	{ "Relays", RelayService },
	{ "Crews", CrewService },
	{ "Social", SocialService },
	{ "Players", PlayerService },
}
for _, entry in ordered do
	local ok, err = pcall(entry[2].Start)
	if not ok then
		warn(("[Skyline] %s failed to start: %s"):format(entry[1], tostring(err)))
	end
end

workspace:SetAttribute("SkylineReady", true)
print("[Skyline] Server ready")
]]></string>
      </Properties>
      <Item class="Folder" referent="40">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Reliable saving with session locking.
--
-- Each profile is stored as { Data, Lock = { JobId, Time } }. A server only
-- writes a profile while it holds the lock, so joining a new server right
-- after leaving another can never roll progress back. Profiles autosave every
-- couple of minutes, on leave and on shutdown, with retries.
--
-- Without DataStore access (Studio with API services off) everything still
-- works in memory and a warning explains why progress won't persist.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Schema = require(script.Parent.Schema)

local STORE_NAME = "SkylineLegends_Profiles_v1"
local AUTOSAVE_INTERVAL = 120
local LOCK_EXPIRY = 30 * 60
local MAX_LOAD_ATTEMPTS = 6

local DataService = {}
DataService.Persistent = true
DataService.Loaded = Signal.new() -- (player, profile)
DataService.Releasing = Signal.new() -- (player, profile) just before the final save

local store: DataStore? = nil
local profiles: { [Player]: { [string]: any } } = {}
local dirty: { [Player]: boolean } = {}
local loading: { [Player]: boolean } = {}
local jobId = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false)

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function openStore()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		DataService.Persistent = false
		warn("[Data] DataStores unavailable; progress will not be saved this session: " .. tostring(result))
	end
end

-- Store access -------------------------------------------------------------------

local function load(player: Player): { [string]: any }?
	if not store then
		return Schema.Default()
	end
	local key = keyFor(player)
	for attempt = 1, MAX_LOAD_ATTEMPTS do
		local lockedElsewhere = false
		local loaded: { [string]: any }? = nil
		local force = attempt == MAX_LOAD_ATTEMPTS
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(key, function(old: any)
				if type(old) == "table" and type(old.Lock) == "table" and not force then
					local lock = old.Lock
					if lock.JobId ~= jobId and os.time() - (lock.Time or 0) < LOCK_EXPIRY then
						lockedElsewhere = true
						return nil
					end
				end
				local data = if type(old) == "table" and type(old.Data) == "table" then old.Data else nil
				loaded = Schema.Migrate(data or Schema.Default())
				return { Data = loaded, Lock = { JobId = jobId, Time = os.time() } }
			end)
		end)
		if ok and loaded then
			return loaded
		end
		if not ok then
			if string.find(tostring(err), "403") or string.find(tostring(err), "API") then
				-- No API access in Studio: run in memory.
				DataService.Persistent = false
				warn("[Data] No DataStore access (enable Studio Access to API Services to test saving).")
				return Schema.Default()
			end
			warn(("[Data] Load attempt %d for %s failed: %s"):format(attempt, player.Name, tostring(err)))
		elseif lockedElsewhere then
			-- The previous server is probably still saving; give it time.
			warn(("[Data] %s's profile is still open on another server; retrying."):format(player.Name))
		end
		if not player.Parent then
			return nil
		end
		task.wait(math.min(2 ^ attempt, 15))
	end
	return nil
end

local function save(player: Player, release: boolean): boolean
	local profile = profiles[player]
	if not profile then
		return true
	end
	if not store or not DataService.Persistent then
		return true
	end
	local key = keyFor(player)
	for attempt = 1, 4 do
		local stolen = false
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(key, function(old: any)
				if type(old) == "table" and type(old.Lock) == "table" and old.Lock.JobId ~= jobId then
					-- Another server took over this profile; never overwrite it.
					stolen = true
					return nil
				end
				return { Data = profile, Lock = if release then nil else { JobId = jobId, Time = os.time() } }
			end)
		end)
		if ok then
			if stolen then
				warn(("[Data] %s's profile was claimed by another server; skipped save."):format(player.Name))
			else
				dirty[player] = nil
			end
			return not stolen
		end
		warn(("[Data] Save attempt %d for %s failed: %s"):format(attempt, player.Name, tostring(err)))
		task.wait(attempt)
	end
	return false
end

-- Public API ------------------------------------------------------------------------

function DataService.Get(player: Player): { [string]: any }?
	return profiles[player]
end

-- Waits for a player's profile (or nil if they leave first).
function DataService.Await(player: Player, timeout: number?): { [string]: any }?
	local deadline = os.clock() + (timeout or 30)
	while player.Parent and not profiles[player] and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

-- Mark changed and send one top-level section to the owning client.
function DataService.Push(player: Player, section: string)
	local profile = profiles[player]
	if not profile then
		return
	end
	dirty[player] = true
	Net.Push(player, "Profile.Section", section, profile[section])
end

function DataService.MarkDirty(player: Player)
	dirty[player] = true
end

function DataService.SaveNow(player: Player)
	task.spawn(save, player, false)
end

local function onPlayerAdded(player: Player)
	if loading[player] or profiles[player] then
		return
	end
	loading[player] = true
	local profile = load(player)
	loading[player] = nil
	if not player.Parent then
		return
	end
	if not profile then
		player:Kick("Skyline Legends couldn't load your progress safely. Please rejoin in a moment.")
		return
	end
	profile.LastJoin = os.time()
	profiles[player] = profile
	player:SetAttribute("ProfileLoaded", true)
	Net.Push(player, "Profile.Full", profile, DataService.Persistent)
	DataService.Loaded:Fire(player, profile)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	DataService.Releasing:Fire(player, profile)
	save(player, true)
	profiles[player] = nil
	dirty[player] = nil
end

function DataService.Start()
	openStore()
	Net.Handle("Profile.Get", function(player)
		return profiles[player], DataService.Persistent
	end)
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- Track play time and autosave.
	task.spawn(function()
		local elapsed = 0
		while true do
			task.wait(10)
			elapsed += 10
			for player, profile in profiles do
				profile.PlaySeconds = (profile.PlaySeconds or 0) + 10
				dirty[player] = true
			end
			if elapsed >= AUTOSAVE_INTERVAL then
				elapsed = 0
				for player in profiles do
					if dirty[player] then
						task.spawn(save, player, false)
					end
				end
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not DataService.Persistent then
			return
		end
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Schema</string>
            <string name="Source"><![CDATA[-- The saved profile: defaults and migrations.
--
-- Bump VERSION and add a step to MIGRATIONS whenever the shape changes, so old
-- saves upgrade cleanly instead of losing progress.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Cosmetics = require(ReplicatedStorage.Shared.Config.Cosmetics)
local SettingsConfig = require(ReplicatedStorage.Shared.Config.Settings)

local Schema = {}

Schema.VERSION = 1

function Schema.Default(): { [string]: any }
	local inventory = {}
	for _, id in Cosmetics.StarterItems() do
		inventory[id] = true
	end
	local equipped = {}
	for category, id in Cosmetics.Defaults do
		equipped[category] = id
	end
	equipped.Emote = nil
	equipped.Emotes = { "emote_wave", "emote_salute", "emote_stretch" }

	return {
		Version = Schema.VERSION,
		Created = os.time(),
		LastJoin = os.time(),
		PlaySeconds = 0,
		XP = 0,
		Credits = 250,
		Prestige = 0,
		Skills = {},
		Mastery = { Points = {}, Challenges = {}, Claimed = {} },
		Courses = {},
		Quests = { Active = {}, Completed = {}, Pinned = {} },
		Daily = { Day = 0, Picks = {}, Progress = {}, Done = {}, Bonus = false },
		Weekly = { Week = 0, Picks = {}, Progress = {}, Done = {}, Seen = {} },
		Contracts = { Offers = {}, Active = nil, Completed = 0, Refresh = 0 },
		Discoveries = {},
		Lessons = {},
		Districts = { Visited = { Hub = true }, Last = "Hub" },
		Achievements = {},
		Stats = {},
		Inventory = inventory,
		Equipped = equipped,
		Settings = SettingsConfig.Defaults(),
		Bindings = {},
		Tower = { Highest = 0, Best = {} },
		Endless = { Best = 0 },
		Crew = nil,
		Flags = {},
	}
end

local MIGRATIONS: { [number]: (any) -> () } = {
	-- [2] = function(profile) ... end,
}

-- Fill any missing keys from the defaults (recursively for plain tables).
local function fill(target: { [any]: any }, defaults: { [any]: any })
	for key, value in defaults do
		if target[key] == nil then
			target[key] = if type(value) == "table" then table.clone(value) else value
		elseif type(value) == "table" and type(target[key]) == "table" and next(value) ~= nil then
			-- Only recurse into record-like defaults (string keys).
			local first = next(value)
			if type(first) == "string" then
				fill(target[key], value)
			end
		end
	end
end

function Schema.Migrate(profile: any): { [string]: any }
	if type(profile) ~= "table" then
		return Schema.Default()
	end
	local version = profile.Version or 1
	while version < Schema.VERSION do
		version += 1
		local step = MIGRATIONS[version]
		if step then
			step(profile)
		end
	end
	profile.Version = Schema.VERSION
	fill(profile, Schema.Default())
	-- Settings may gain new options between versions.
	for key, value in SettingsConfig.Defaults() do
		if SettingsConfig.Sanitize(key, profile.Settings[key]) == nil then
			profile.Settings[key] = value
		end
	end
	-- Starter items are always owned.
	for _, id in Cosmetics.StarterItems() do
		profile.Inventory[id] = true
	end
	return profile
end

return Schema
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">Events</string>
          <string name="Source"><![CDATA[-- Server-side event bus. Gameplay services announce validated events here and
-- progression systems (quests, achievements, mastery, dailies, crews) listen,
-- so adding a new system never means editing the systems that feed it.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local Events = {
	-- (player, action: string, value: number?, district: string?)
	Action = Signal.new(),
	-- (player, chain: { string }) every time a validated chain grows
	Chain = Signal.new(),
	-- (player, chainLength: number, variety: number) when a chain ends
	ChainEnded = Signal.new(),
	-- (player, breaker: string) stumble / fall / respawn
	Break = Signal.new(),
	-- (player, tier: number, district: string?)
	FlowTier = Signal.new(),
	-- (player, result) after a validated course/room/relay finish
	CourseFinished = Signal.new(),
	-- (player, courseId, tokenIndex)
	Token = Signal.new(),
	-- (player, discoveryId, kind, district)
	Discovery = Signal.new(),
	-- (player, districtId) arrival in a district
	DistrictEntered = Signal.new(),
	-- (player, questId, quest)
	QuestCompleted = Signal.new(),
	-- (player, kind: "Contract" | "Daily" | "Weekly")
	ObjectiveCompleted = Signal.new(),
	-- (player, lessonId)
	Lesson = Signal.new(),
	-- (player, newLevel, oldLevel)
	LevelUp = Signal.new(),
	-- (player, place: number, racers: number)
	RaceFinished = Signal.new(),
	-- (player, teamSize: number)
	RelayFinished = Signal.new(),
	-- (player, floor: number)
	TowerFloor = Signal.new(),
	-- (player, sectionsThisRun: number)
	EndlessSection = Signal.new(),
	-- (player, sectionsTotal: number) when an endless run ends
	EndlessEnded = Signal.new(),
	-- (player)
	CoopSwitch = Signal.new(),
	-- (player, crewId)
	CrewJoined = Signal.new(),
	-- (player, categoryId, tier)
	MasteryTier = Signal.new(),
	-- (player, itemId)
	ItemGranted = Signal.new(),
	-- (player, statKey) a stat changed; achievements re-check it
	StatChanged = Signal.new(),
	-- (player, npcId)
	Talk = Signal.new(),
}

return Events
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="44">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">AchievementService</string>
            <string name="Source"><![CDATA[-- The achievement journal: checks stats after relevant events and pays out
-- automatically, with an unlock card.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Achievements = require(ReplicatedStorage.Shared.Config.Achievements)
local Stats = require(ReplicatedStorage.Shared.Logic.Stats)

local DataService = require(script.Parent.Parent.Data.DataService)
local DiscoveryService = require(script.Parent.DiscoveryService)
local Events = require(script.Parent.Parent.Events)
local Notify = require(script.Parent.Notify)
local ProgressionService = require(script.Parent.ProgressionService)

local AchievementService = {}

local pending: { [Player]: boolean } = {}

local lastStatsPush: { [Player]: number } = {}

local function check(player: Player)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local context = { CacheTotals = DiscoveryService.CacheTotals }
	local earnedAny = false
	for _, achievement in Achievements.List do
		if not profile.Achievements[achievement.Id] then
			local value = Stats.Get(profile, achievement.Stat, context)
			if value >= achievement.Target then
				profile.Achievements[achievement.Id] = os.time()
				earnedAny = true
				ProgressionService.Grant(player, {
					XP = achievement.XP,
					Credits = achievement.Credits,
					Prestige = achievement.Prestige,
					Items = if achievement.Item then { achievement.Item } else nil,
				}, nil, true)
				Notify.Send(player, {
					Kind = "Achievement",
					Title = achievement.Name,
					Text = achievement.Text,
					XP = achievement.XP,
					Credits = achievement.Credits,
					Prestige = achievement.Prestige,
					Item = achievement.Item,
					Sound = "Achievement",
				})
			end
		end
	end
	if earnedAny then
		DataService.Push(player, "Achievements")
	end
	-- Counters feed the journal's progress bars (at most once every few seconds).
	local now = os.clock()
	if now - (lastStatsPush[player] or 0) > 4 then
		lastStatsPush[player] = now
		DataService.Push(player, "Stats")
	end
end

function AchievementService.Queue(player: Player)
	pending[player] = true
end

function AchievementService.Start()
	-- Any of these can move a statistic; checks are batched once a second.
	local function queue(player: Player)
		pending[player] = true
	end
	Events.StatChanged:Connect(queue)
	Events.CourseFinished:Connect(queue)
	Events.Discovery:Connect(queue)
	Events.QuestCompleted:Connect(queue)
	Events.LevelUp:Connect(queue)
	Events.MasteryTier:Connect(queue)
	Events.ItemGranted:Connect(queue)
	Events.RaceFinished:Connect(queue)
	Events.RelayFinished:Connect(queue)
	Events.TowerFloor:Connect(queue)
	Events.EndlessEnded:Connect(queue)
	DataService.Loaded:Connect(queue)

	task.spawn(function()
		while true do
			task.wait(1)
			for player in pending do
				pending[player] = nil
				if player.Parent then
					local ok, err = pcall(check, player)
					if not ok then
						warn("[Achievements] " .. tostring(err))
					end
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		pending[player] = nil
		lastStatsPush[player] = nil
	end)
end

return AchievementService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">CosmeticService</string>
            <string name="Source"><![CDATA[-- Builds equipped cosmetics onto characters out of parts, so they replicate to
-- everyone and need no uploaded meshes. Effects that play on events (landing
-- effects, victory animations, trail emission) are driven by each client from
-- character attributes set here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Cosmetics = require(ReplicatedStorage.Shared.Config.Cosmetics)
local Tags = require(ReplicatedStorage.Shared.Tags)

local DataService = require(script.Parent.Parent.Data.DataService)
local EconomyService = require(script.Parent.EconomyService)
local PlayerService = require(script.Parent.PlayerService)

local CosmeticService = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

local function piece(
	parent: Instance,
	limb: BasePart,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part
	local part = Instance.new("Part")
	part.Name = "Cosmetic"
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Shape = shape or Enum.PartType.Block
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.CollisionGroup = Tags.Groups.Cosmetic
	part.CFrame = limb.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = limb
	weld.Part1 = part
	weld.Parent = part
	part.Parent = parent
	return part
end

local function c(colors: { Color3 }?, index: number, fallback: Color3): Color3
	return (colors and colors[index]) or fallback
end

-- Outfits -------------------------------------------------------------------------------

local function sleeves(folder: Folder, character: Model, color: Color3, full: boolean, stripe: Color3?)
	for _, name in { "Left Arm", "Right Arm" } do
		local arm = character:FindFirstChild(name) :: BasePart?
		if arm then
			local height = if full then 1.62 else 1.05
			local y = if full then 0.2 else 0.48
			piece(folder, arm, Vector3.new(1.08, height, 1.08), CFrame.new(0, y, 0), color)
			if stripe then
				local side = if name == "Left Arm" then -0.55 else 0.55
				piece(folder, arm, Vector3.new(0.06, height, 0.3), CFrame.new(side, y, 0), stripe, Enum.Material.Neon)
			end
		end
	end
end

local function pants(folder: Folder, character: Model, color: Color3, stripe: Color3?)
	for _, name in { "Left Leg", "Right Leg" } do
		local leg = character:FindFirstChild(name) :: BasePart?
		if leg then
			piece(folder, leg, Vector3.new(1.07, 1.55, 1.07), CFrame.new(0, 0.22, 0), color)
			if stripe then
				local side = if name == "Left Leg" then -0.55 else 0.55
				piece(folder, leg, Vector3.new(0.06, 1.55, 0.25), CFrame.new(side, 0.22, 0), stripe)
			end
		end
	end
end

local function buildOutfit(folder: Folder, character: Model, item: Cosmetics.Item)
	local torso = character:FindFirstChild("Torso") :: BasePart?
	local head = character:FindFirstChild("Head") :: BasePart?
	if not torso or not head then
		return
	end
	local primary = c(item.Colors, 1, Color3.new(0.3, 0.3, 0.3))
	local secondary = c(item.Colors, 2, Color3.new(0.8, 0.8, 0.8))
	local accent = c(item.Colors, 3, Color3.new(1, 0.8, 0.3))
	local style = item.Style

	-- Every outfit has a body shell.
	piece(folder, torso, Vector3.new(2.1, 2.06, 1.12), CFrame.new(), primary)

	if style == "Hoodie" then
		piece(folder, head, Vector3.new(1.45, 1.15, 0.45), CFrame.new(0, 0.05, 0.62), primary)
		piece(folder, head, Vector3.new(1.55, 0.3, 1.25), CFrame.new(0, 0.62, 0.15), primary)
		piece(folder, torso, Vector3.new(1.2, 0.5, 0.08), CFrame.new(0, -0.55, -0.6), secondary)
		piece(folder, torso, Vector3.new(0.08, 0.6, 0.06), CFrame.new(-0.25, 0.55, -0.6), accent)
		piece(folder, torso, Vector3.new(0.08, 0.6, 0.06), CFrame.new(0.25, 0.55, -0.6), accent)
		sleeves(folder, character, primary, true, nil)
	elseif style == "Jacket" then
		piece(folder, torso, Vector3.new(2.16, 0.35, 1.2), CFrame.new(0, 0.95, 0), secondary)
		piece(folder, torso, Vector3.new(0.1, 2.06, 0.06), CFrame.new(0, 0, -0.6), accent, Enum.Material.Neon)
		piece(folder, torso, Vector3.new(2.14, 0.12, 1.16), CFrame.new(0, -0.3, 0), accent)
		sleeves(folder, character, primary, true, accent)
	elseif style == "Vest" then
		piece(folder, torso, Vector3.new(0.6, 0.45, 0.08), CFrame.new(-0.5, -0.3, -0.6), secondary)
		piece(folder, torso, Vector3.new(0.6, 0.45, 0.08), CFrame.new(0.5, -0.3, -0.6), secondary)
		piece(folder, torso, Vector3.new(2.14, 0.15, 1.16), CFrame.new(0, 0.9, 0), accent)
	elseif style == "Coat" then
		piece(folder, torso, Vector3.new(2.1, 1.0, 0.18), CFrame.new(0, -1.45, 0.5), primary)
		piece(folder, torso, Vector3.new(2.18, 0.45, 1.24), CFrame.new(0, 0.95, 0), secondary)
		piece(folder, torso, Vector3.new(2.14, 0.14, 1.16), CFrame.new(0, -0.75, 0), accent)
		sleeves(folder, character, primary, true, nil)
	elseif style == "Suit" then
		piece(folder, torso, Vector3.new(0.3, 1.2, 0.06), CFrame.new(0, 0.25, -0.6), accent)
		piece(folder, torso, Vector3.new(0.9, 0.5, 0.06), CFrame.new(0, 0.8, -0.59), secondary)
		sleeves(folder, character, primary, true, nil)
		pants(folder, character, secondary, nil)
	elseif style == "Robe" then
		piece(folder, torso, Vector3.new(2.14, 1.3, 1.16), CFrame.new(0, -1.55, 0), primary)
		piece(folder, torso, Vector3.new(2.16, 0.2, 1.18), CFrame.new(0, -0.5, 0), accent, Enum.Material.Neon)
		piece(folder, torso, Vector3.new(0.5, 2.06, 0.08), CFrame.new(0, 0, -0.6), secondary)
		sleeves(folder, character, primary, true, nil)
	elseif style == "Tracksuit" then
		sleeves(folder, character, primary, true, secondary)
		pants(folder, character, primary, secondary)
		piece(folder, torso, Vector3.new(0.06, 2.06, 0.06), CFrame.new(0, 0, -0.6), accent)
	end
end

-- Gloves, shoes, packs --------------------------------------------------------------------

local function buildGloves(folder: Folder, character: Model, item: Cosmetics.Item)
	for _, name in { "Left Arm", "Right Arm" } do
		local arm = character:FindFirstChild(name) :: BasePart?
		if arm then
			local primary = c(item.Colors, 1, Color3.new(0.3, 0.3, 0.3))
			local secondary = c(item.Colors, 2, Color3.new(0.1, 0.1, 0.1))
			local height = if item.Style == "Gauntlet" then 0.75 else 0.45
			piece(folder, arm, Vector3.new(1.1, height, 1.1), CFrame.new(0, -1 + height / 2, 0), primary)
			if item.Style == "Wrap" then
				piece(folder, arm, Vector3.new(1.12, 0.1, 1.12), CFrame.new(0, -0.6, 0), secondary)
				piece(folder, arm, Vector3.new(1.12, 0.1, 1.12), CFrame.new(0, -0.82, 0), secondary)
			else
				piece(
					folder,
					arm,
					Vector3.new(0.9, 0.22, 0.1),
					CFrame.new(0, -0.85, -0.56),
					secondary,
					Enum.Material.Neon
				)
			end
		end
	end
end

local function buildShoes(folder: Folder, character: Model, item: Cosmetics.Item)
	for _, name in { "Left Leg", "Right Leg" } do
		local leg = character:FindFirstChild(name) :: BasePart?
		if leg then
			local primary = c(item.Colors, 1, Color3.new(1, 1, 1))
			local secondary = c(item.Colors, 2, Color3.new(0.2, 0.2, 0.2))
			local height = if item.Style == "Boot" then 0.8 elseif item.Style == "HighTop" then 0.65 else 0.45
			piece(folder, leg, Vector3.new(1.08, height, 1.14), CFrame.new(0, -1 + height / 2, -0.05), primary)
			piece(folder, leg, Vector3.new(1.1, 0.14, 1.22), CFrame.new(0, -0.95, -0.06), secondary)
			piece(
				folder,
				leg,
				Vector3.new(0.08, 0.2, 0.7),
				CFrame.new(0.55, -0.78, -0.05),
				secondary,
				Enum.Material.Neon
			)
		end
	end
end

local function buildPack(folder: Folder, character: Model, item: Cosmetics.Item)
	local torso = character:FindFirstChild("Torso") :: BasePart?
	if not torso then
		return
	end
	local primary = c(item.Colors, 1, Color3.new(0.4, 0.3, 0.2))
	local secondary = c(item.Colors, 2, Color3.new(1, 0.8, 0.3))
	local style = item.Style
	if style == "Satchel" then
		piece(folder, torso, Vector3.new(1.2, 1.0, 0.45), CFrame.new(0.35, -0.25, 0.75), primary)
		piece(
			folder,
			torso,
			Vector3.new(0.2, 2.5, 0.12),
			CFrame.new(0, 0.1, -0.6) * CFrame.Angles(0, 0, math.rad(40)),
			secondary
		)
	elseif style == "Courier" then
		piece(folder, torso, Vector3.new(1.7, 1.3, 0.6), CFrame.new(0, 0, 0.82), primary)
		piece(folder, torso, Vector3.new(1.74, 0.45, 0.64), CFrame.new(0, 0.48, 0.82), secondary)
	elseif style == "Tank" then
		for _, x in { -0.45, 0.45 } do
			piece(
				folder,
				torso,
				Vector3.new(1.6, 0.7, 0.7),
				CFrame.new(x, 0, 0.85) * CFrame.Angles(0, 0, math.rad(90)),
				primary,
				Enum.Material.Metal,
				Enum.PartType.Cylinder
			)
		end
		piece(
			folder,
			torso,
			Vector3.new(0.3, 0.3, 0.3),
			CFrame.new(0, 0.9, 0.85),
			secondary,
			Enum.Material.Neon,
			Enum.PartType.Ball
		)
	elseif style == "Planter" then
		piece(folder, torso, Vector3.new(1.5, 0.9, 0.7), CFrame.new(0, -0.3, 0.85), primary, Enum.Material.Wood)
		for i, offset in { Vector3.new(-0.4, 0.4, 0.85), Vector3.new(0.35, 0.55, 0.8), Vector3.new(0, 0.75, 0.95) } do
			local leaf = Color3.fromRGB(70, 150 + i * 15, 80)
			piece(
				folder,
				torso,
				Vector3.new(0.55, 0.55, 0.55),
				CFrame.new(offset),
				leaf,
				Enum.Material.Grass,
				Enum.PartType.Ball
			)
		end
		piece(
			folder,
			torso,
			Vector3.new(0.3, 0.3, 0.3),
			CFrame.new(0.1, 1.05, 0.9),
			secondary,
			Enum.Material.SmoothPlastic,
			Enum.PartType.Ball
		)
	elseif style == "Cube" then
		piece(
			folder,
			torso,
			Vector3.new(1, 1, 1),
			CFrame.new(0, 0.5, 1.4) * CFrame.Angles(math.rad(45), math.rad(45), 0),
			primary,
			Enum.Material.Neon
		)
		piece(
			folder,
			torso,
			Vector3.new(1.2, 1.2, 1.2),
			CFrame.new(0, 0.5, 1.4) * CFrame.Angles(math.rad(45), math.rad(45), 0),
			secondary,
			Enum.Material.ForceField
		)
	elseif style == "Frame" then
		for _, x in { -0.6, 0.6 } do
			piece(folder, torso, Vector3.new(0.15, 2.6, 0.15), CFrame.new(x, 0.2, 0.75), primary)
		end
		piece(folder, torso, Vector3.new(1.4, 1.2, 0.6), CFrame.new(0, -0.1, 0.95), secondary)
		piece(
			folder,
			torso,
			Vector3.new(0.6, 1.0, 1.0),
			CFrame.new(0, 1.0, 0.9) * CFrame.Angles(0, 0, math.rad(90)),
			Color3.fromRGB(200, 180, 140),
			Enum.Material.Fabric,
			Enum.PartType.Cylinder
		)
	elseif style == "Wings" then
		for _, side in { -1, 1 } do
			local wing = piece(
				folder,
				torso,
				Vector3.new(0.12, 2.2, 1.4),
				CFrame.new(side * 0.9, 0.5, 0.9) * CFrame.Angles(0, side * math.rad(35), side * math.rad(-25)),
				primary
			)
			wing.Shape = Enum.PartType.Block
			piece(
				folder,
				torso,
				Vector3.new(0.14, 0.25, 1.5),
				CFrame.new(side * 1.05, 1.35, 1.0) * CFrame.Angles(0, side * math.rad(35), side * math.rad(-25)),
				secondary,
				Enum.Material.Neon
			)
		end
	elseif style == "Beacon" then
		piece(folder, torso, Vector3.new(1.2, 1.2, 0.6), CFrame.new(0, -0.1, 0.8), primary)
		piece(
			folder,
			torso,
			Vector3.new(0.12, 2.4, 0.12),
			CFrame.new(0.4, 1.3, 0.8),
			Color3.fromRGB(80, 80, 90),
			Enum.Material.Metal
		)
		local tip = piece(
			folder,
			torso,
			Vector3.new(0.35, 0.35, 0.35),
			CFrame.new(0.4, 2.55, 0.8),
			secondary,
			Enum.Material.Neon,
			Enum.PartType.Ball
		)
		local light = Instance.new("PointLight")
		light.Color = secondary
		light.Range = 8
		light.Brightness = 1.2
		light.Parent = tip
	elseif style == "Crystal" then
		local crystal = piece(
			folder,
			torso,
			Vector3.new(0.9, 1.6, 0.9),
			CFrame.new(0, 0.6, 1.3) * CFrame.Angles(0, math.rad(45), math.rad(12)),
			primary,
			Enum.Material.Neon
		)
		local attachment = Instance.new("Attachment")
		attachment.Parent = crystal
		local motes = Instance.new("ParticleEmitter")
		motes.Texture = SPARKLE
		motes.Color = ColorSequence.new(secondary)
		motes.LightEmission = 1
		motes.Rate = 6
		motes.Lifetime = NumberRange.new(0.8, 1.4)
		motes.Speed = NumberRange.new(0.5, 1.5)
		motes.SpreadAngle = Vector2.new(180, 180)
		motes.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
		motes.Parent = attachment
	elseif style == "Banner" then
		piece(
			folder,
			torso,
			Vector3.new(0.14, 4.2, 0.14),
			CFrame.new(-0.6, 1.4, 0.75),
			Color3.fromRGB(90, 70, 50),
			Enum.Material.Wood
		)
		piece(folder, torso, Vector3.new(0.06, 1.3, 1.6), CFrame.new(-0.6, 2.7, 1.55), primary, Enum.Material.Fabric)
		piece(folder, torso, Vector3.new(0.07, 0.3, 1.6), CFrame.new(-0.6, 2.3, 1.55), secondary, Enum.Material.Fabric)
	end
end

local function buildTrail(folder: Folder, character: Model, item: Cosmetics.Item)
	local torso = character:FindFirstChild("Torso") :: BasePart?
	if not torso then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailTop"
	a0.Position = Vector3.new(0, 0.8, 0.3)
	a0.Parent = torso
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailBottom"
	a1.Position = Vector3.new(0, -0.9, 0.3)
	a1.Parent = torso
	local first = c(item.Colors, 1, Color3.new(1, 1, 1))
	local second = c(item.Colors, 2, first)
	local trail = Instance.new("Trail")
	trail.Name = "SkylineTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(first, second)
	trail.Lifetime = if item.Style == "Ribbon" then 0.35 else 0.22
	trail.LightEmission = if item.Style == "Aether" or item.Style == "Ribbon" then 0.7 else 0.3
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.2) })
	trail.MinLength = 0.2
	trail.FaceCamera = true
	trail.Enabled = false -- clients enable it at speed
	trail.Parent = folder
	if item.Style ~= "Ribbon" then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "SkylineTrailParticles"
		emitter.Texture = SPARKLE
		emitter.Color = ColorSequence.new(first, second)
		emitter.LightEmission = 0.8
		emitter.Rate = 0 -- clients raise it at speed
		emitter.Lifetime = NumberRange.new(0.4, 0.9)
		emitter.Speed = NumberRange.new(0.5, 2)
		emitter.SpreadAngle = Vector2.new(60, 60)
		emitter.Drag = 2
		if item.Style == "Leaves" then
			emitter.Acceleration = Vector3.new(0, -6, 0)
			emitter.RotSpeed = NumberRange.new(-180, 180)
			emitter.Size = NumberSequence.new(0.35)
		elseif item.Style == "Frost" then
			emitter.Acceleration = Vector3.new(0, -2, 0)
			emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
		elseif item.Style == "Sparks" then
			emitter.Acceleration = Vector3.new(0, -30, 0)
			emitter.Speed = NumberRange.new(3, 6)
			emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) })
		else
			emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
		end
		emitter.Parent = a1
	end
end

-- Apply ---------------------------------------------------------------------------------

function CosmeticService.Apply(player: Player)
	local character = player.Character
	local profile = DataService.Get(player)
	if not character or not profile then
		return
	end
	local old = character:FindFirstChild("SkylineCosmetics")
	if old then
		old:Destroy()
	end
	for _, name in { "TrailTop", "TrailBottom" } do
		local torso = character:FindFirstChild("Torso")
		local attachment = torso and torso:FindFirstChild(name)
		if attachment then
			attachment:Destroy()
		end
	end
	local folder = Instance.new("Folder")
	folder.Name = "SkylineCosmetics"
	folder.Parent = character

	local equipped = profile.Equipped
	local function get(category: string): Cosmetics.Item?
		local id = equipped[category]
		local item = id and Cosmetics.ById[id]
		if item and item.Category == category and profile.Inventory[id] then
			return item
		end
		return nil
	end

	local outfit = get("Outfit")
	if outfit and outfit.Style ~= "None" then
		buildOutfit(folder, character, outfit)
	end
	local gloves = get("Gloves")
	if gloves and gloves.Style ~= "None" then
		buildGloves(folder, character, gloves)
	end
	local shoes = get("Shoes")
	if shoes and shoes.Style ~= "None" then
		buildShoes(folder, character, shoes)
	end
	local pack = get("Backpack")
	if pack and pack.Style ~= "None" then
		buildPack(folder, character, pack)
	end
	local trail = get("Trail")
	if trail and trail.Style ~= "None" then
		buildTrail(folder, character, trail)
	end

	local landing = get("Landing")
	character:SetAttribute("LandingFx", if landing then landing.Style else "Dust")
	character:SetAttribute(
		"LandingColor",
		if landing and landing.Colors and landing.Colors[1] then landing.Colors[1] else nil
	)
	local victory = get("Victory")
	character:SetAttribute("Victory", if victory then victory.Style else "FistPump")
	local title = get("Title")
	player:SetAttribute("Title", if title and title.Text and title.Text ~= "" then title.Text else nil)
end

function CosmeticService.Start()
	EconomyService.OnEquipChanged = CosmeticService.Apply
	table.insert(PlayerService.CharacterAdded, function(player, character)
		character:WaitForChild("Torso", 10)
		CosmeticService.Apply(player)
	end)
end

return CosmeticService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">CourseService</string>
            <string name="Source"><![CDATA[-- Course runs: starting, checkpoints, tokens, shortcuts, retries, finishing,
-- medals, distinctions, rewards, personal records, leaderboards and ghosts.
--
-- Modes:
--   Casual    your own movement (skill tree applies); medals, rewards, records
--   Practice  assists allowed, custom checkpoints, no medals (learn a route)
--   Ranked    standardized attributes and the course's full kit; leaderboards
--             and ghosts. Upgrades never decide who's fastest.
--   Race / Relay / Tower  started by their services, which handle rewards
--
-- The client runs the timer for responsiveness; the server checks every
-- checkpoint against where the character actually was, enforces order,
-- bounds the finish time, and rejects impossible runs from the boards.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Abilities = require(ReplicatedStorage.Shared.Config.Abilities)
local Courses = require(ReplicatedStorage.Shared.Config.Courses)
local FlowConfig = require(ReplicatedStorage.Shared.Config.Flow)
local GhostCodec = require(ReplicatedStorage.Shared.Logic.GhostCodec)
local Medals = require(ReplicatedStorage.Shared.Logic.Medals)
local Net = require(ReplicatedStorage.Shared.Net)
local Rewards = require(ReplicatedStorage.Shared.Logic.Rewards)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local WorldBuilder = require(script.Parent.Parent.World.WorldBuilder)
local DistrictService = require(script.Parent.DistrictService)
local MovementGuard = require(script.Parent.MovementGuard)
local Notify = require(script.Parent.Notify)
local ProgressionService = require(script.Parent.ProgressionService)
local RecordService = require(script.Parent.RecordService)

local CourseService = {}

-- (player, run, result) after every validated finish (any mode).
CourseService.Finished = Signal.new()
-- (player, run, index) after every validated checkpoint.
CourseService.CheckpointReached = Signal.new()
-- (player, run, reason) when a run ends without finishing.
CourseService.Ended = Signal.new()

export type Run = {
	Id: number,
	CourseId: string,
	Meta: any,
	Mode: string,
	StartAt: number, -- server time the clock starts
	StartClock: number, -- os.clock at the same moment (for strike checks)
	Checkpoint: number,
	Splits: { number },
	Tokens: { [number]: boolean },
	Shortcut: boolean,
	Falls: number,
	Retries: number,
	ServerFlow: number,
	FromCheckpoint: number,
	EndAt: number?, -- checkpoint index that ends this run (relay legs)
	NoRewards: boolean,
	Context: any,
	Standardized: boolean,
}

local runs: { [Player]: Run } = {}
local repeats: { [Player]: { [string]: number } } = {}
local pendingGhost: { [Player]: { CourseId: string, Seconds: number, Ranked: boolean, Expires: number } } = {}
local nextRunId = 0

local COUNTDOWN = { Casual = 3, Ranked = 3, Practice = 1.5, Race = 4, Relay = 3, Tower = 2 }

-- Helpers ----------------------------------------------------------------------------------

local function now(): number
	return workspace:GetServerTimeNow()
end

function CourseService.Meta(courseId: string): any?
	return WorldBuilder.Courses[courseId]
end

local function courseInfo(courseId: string, meta: any): (string, string, string, number)
	local course = Courses.ById[courseId]
	local name = if course then course.Name else (meta.Name or courseId)
	local district = meta.District or (course and course.District) or "Hub"
	local kind = meta.Kind or (course and course.Kind) or "Course"
	local difficulty = if course then course.Difficulty else (meta.Difficulty or 1)
	return name, district, kind, difficulty
end

local function recordFor(profile: any, courseId: string): any
	local record = profile.Courses[courseId]
	if not record then
		record = { Medal = 0, Completions = 0, Attempts = 0, Distinctions = {}, Tokens = {} }
		profile.Courses[courseId] = record
	end
	record.Distinctions = record.Distinctions or {}
	record.Tokens = record.Tokens or {}
	return record
end

local function kitFor(meta: any): { [string]: boolean }
	local set = {}
	for _, list in { meta.Requires, meta.FastRequires, meta.ExpertRequires } do
		for _, id in list or {} do
			set[id] = true
		end
	end
	return set
end

local function missingAbilities(player: Player, meta: any): { string }
	local have = ProgressionService.Abilities(player)
	local missing = {}
	for _, id in meta.Requires or {} do
		if not have[id] then
			local ability = Abilities.ById[id]
			table.insert(missing, if ability then ability.Name else id)
		end
	end
	return missing
end

local function volumeNear(player: Player, volume: { CFrame: CFrame, Size: Vector3 }, slack: number?): boolean
	local radius = math.max(volume.Size.X, volume.Size.Y, volume.Size.Z) / 2 + (slack or 8)
	return MovementGuard.WasNear(player, volume.CFrame.Position, radius, 1.6)
end

local function spawnFor(run: Run): CFrame
	local meta = run.Meta
	if run.Checkpoint > 0 then
		local checkpoint = meta.Checkpoints[run.Checkpoint]
		if checkpoint then
			return checkpoint.Spawn
		end
	end
	return meta.Spawn
end

local function clearRun(player: Player, reason: string?)
	local run = runs[player]
	if not run then
		return
	end
	runs[player] = nil
	ProgressionService.SetTemporary(player, nil)
	if reason then
		CourseService.Ended:Fire(player, run, reason)
	end
end

-- Public API for other services --------------------------------------------------------------

export type BeginOptions = {
	Countdown: number?,
	StartAt: number?,
	FromCheckpoint: number?,
	EndAt: number?,
	NoRewards: boolean?,
	Context: any?,
	Standardized: boolean?,
	Kit: { [string]: boolean }?,
	SkipChecks: boolean?,
	Spawn: CFrame?,
	NoTeleport: boolean?, -- the runner is already in place (relay handoffs)
}

-- Start a run. Returns (ok, info | reason).
function CourseService.Begin(player: Player, courseId: string, mode: string, options: BeginOptions?): (boolean, any)
	local meta = WorldBuilder.Courses[courseId]
	local profile = DataService.Get(player)
	if not meta or not profile then
		return false, "Unknown course"
	end
	local opts = options or {}
	local _, district = courseInfo(courseId, meta)
	if not opts.SkipChecks then
		local ok, reason = DistrictService.CanEnter(player, district)
		if not ok then
			return false, reason
		end
		local missing = missingAbilities(player, meta)
		if #missing > 0 then
			return false, "Needs " .. table.concat(missing, ", ")
		end
	end
	clearRun(player, "Replaced")

	nextRunId += 1
	local countdown = opts.Countdown or COUNTDOWN[mode] or 3
	local startAt = opts.StartAt or (now() + countdown)
	local standardized = opts.Standardized
	if standardized == nil then
		standardized = mode == "Ranked" or mode == "Race" or mode == "Relay"
	end
	local run: Run = {
		Id = nextRunId,
		CourseId = courseId,
		Meta = meta,
		Mode = mode,
		StartAt = startAt,
		StartClock = os.clock() + (startAt - now()),
		Checkpoint = opts.FromCheckpoint or 0,
		Splits = {},
		Tokens = {},
		Shortcut = false,
		Falls = 0,
		Retries = 0,
		ServerFlow = 0,
		FromCheckpoint = opts.FromCheckpoint or 0,
		EndAt = opts.EndAt,
		NoRewards = opts.NoRewards == true,
		Context = opts.Context,
		Standardized = standardized,
	}
	runs[player] = run

	-- Ranked-style runs lend the full kit for the course so everyone races the same moves.
	local kit = opts.Kit
	if not kit and standardized then
		kit = kitFor(meta)
	end
	ProgressionService.SetTemporary(player, kit)

	local spawn = opts.Spawn or spawnFor(run)
	MovementGuard.AllowTeleport(player, spawn.Position, 20)
	local record = recordFor(profile, courseId)
	if mode ~= "Practice" then
		record.Attempts = (record.Attempts or 0) + 1
		DataService.MarkDirty(player)
	end
	local info = {
		RunId = run.Id,
		CourseId = courseId,
		Mode = mode,
		StartAt = startAt,
		Spawn = spawn,
		Standardized = standardized,
		FromCheckpoint = run.FromCheckpoint,
		EndAt = run.EndAt,
		BestSplits = if mode == "Ranked" then record.RankedSplits else record.Splits,
		Best = if mode == "Ranked" then record.RankedBest else record.Best,
		Context = opts.Context,
		NoTeleport = opts.NoTeleport == true,
		KillY = meta.KillY,
	}
	Net.Push(player, "Course.Run", info)
	return true, info
end

function CourseService.Active(player: Player): Run?
	return runs[player]
end

function CourseService.End(player: Player, reason: string?)
	clearRun(player, reason or "Ended")
	Net.Push(player, "Course.Ended", reason or "Ended")
end

-- Finishing --------------------------------------------------------------------------------------

local function finish(player: Player, run: Run, clientSeconds: any, clientFlow: any): any
	local meta = run.Meta
	local profile = DataService.Get(player)
	if not profile then
		return nil
	end
	local name, district, kind, difficulty = courseInfo(run.CourseId, meta)
	local serverSeconds = now() - run.StartAt
	local seconds = serverSeconds
	-- Trust the client's precise clock when it agrees with ours (latency allowance).
	if type(clientSeconds) == "number" and clientSeconds == clientSeconds then
		if clientSeconds <= serverSeconds + 0.3 and clientSeconds >= serverSeconds - 1.5 then
			seconds = clientSeconds
		end
	end
	seconds = math.floor(seconds * 1000 + 0.5) / 1000

	-- Plausibility: nothing beats the ideal par by this much.
	local par = math.min(meta.Par.A, meta.Par.F, meta.Par.E)
	local partial = run.FromCheckpoint > 0 or run.EndAt ~= nil
	if not partial and seconds < par * 0.45 then
		clearRun(player, "Rejected")
		Notify.Warn(player, "That run couldn't be verified.")
		return { Rejected = true }
	end
	local strikes = MovementGuard.StrikesSince(player, run.StartClock)
	local verified = strikes < 3

	-- Distinctions.
	local distinctions: { [string]: boolean } = {}
	if run.Falls == 0 and run.Retries == 0 then
		distinctions.NoFall = true
	end
	if run.Shortcut then
		distinctions.Shortcut = true
	end
	local tokenCount = 0
	for _ in run.Tokens do
		tokenCount += 1
	end
	if #meta.Tokens > 0 and tokenCount >= #meta.Tokens then
		distinctions.AllTokens = true
	end
	-- Flow: the client's score, capped by what the server's validated moves could earn.
	local flowScore = if type(clientFlow) == "number" and clientFlow == clientFlow then math.max(clientFlow, 0) else 0
	local cap = run.ServerFlow * 2.2 * (1 + FlowConfig.TransitionBonus) + seconds * 10 * 2.2
	flowScore = math.floor(math.min(flowScore, cap))
	if meta.FlowTarget and flowScore >= meta.FlowTarget * FlowConfig.DistinctionFraction then
		distinctions.Flow = true
	end

	local practice = run.Mode == "Practice"
	local medal = if practice or partial then 0 else Medals.For(seconds, meta.Medals)
	local record = recordFor(profile, run.CourseId)
	local previous = {
		Medal = record.Medal or 0,
		Best = record.Best,
		RankedBest = record.RankedBest,
		Completions = record.Completions or 0,
	}

	-- Rewards (modes with their own payouts skip these).
	local lines, xp, credits, prestige = {}, 0, 0, 0
	if not run.NoRewards and not partial then
		repeats[player] = repeats[player] or {}
		local count = repeats[player][run.CourseId] or 0
		repeats[player][run.CourseId] = count + 1
		local rewardMode = if practice then "Practice" else run.Mode
		lines, xp, credits, prestige = Rewards.Course(difficulty, meta.Medals, {
			Seconds = seconds,
			Medal = medal,
			Distinctions = distinctions,
			Mode = rewardMode,
		}, {
			Medal = record.Medal or 0,
			Completions = record.Completions or 0,
			Best = record.Best,
			Distinctions = record.Distinctions,
		}, count)
	end

	-- Records.
	local newBest, newRankedBest = false, false
	local newDistinctions = {}
	if not practice and not partial then
		record.Completions = (record.Completions or 0) + 1
		record.Medal = math.max(record.Medal or 0, medal)
		for id, earned in distinctions do
			if earned and not record.Distinctions[id] then
				record.Distinctions[id] = true
				table.insert(newDistinctions, id)
			end
		end
		if not record.Best or seconds < record.Best then
			record.Best = seconds
			record.Splits = run.Splits
			newBest = true
		end
		if run.Mode == "Ranked" and verified then
			if not record.RankedBest or seconds < record.RankedBest then
				record.RankedBest = seconds
				record.RankedSplits = run.Splits
				newRankedBest = true
			end
			RecordService.Submit(run.CourseId, player, seconds)
		end
		record.LastFlow = flowScore
		record.BestFlow = math.max(record.BestFlow or 0, flowScore)
		DataService.MarkDirty(player)
		DataService.Push(player, "Courses")
	end
	if newBest or newRankedBest then
		pendingGhost[player] =
			{ CourseId = run.CourseId, Seconds = seconds, Ranked = newRankedBest, Expires = os.clock() + 60 }
	end
	if xp > 0 or credits > 0 or prestige > 0 then
		ProgressionService.Grant(player, { XP = xp, Credits = credits, Prestige = prestige }, nil, true)
	end

	local result = {
		CourseId = run.CourseId,
		Name = name,
		District = district,
		Kind = kind,
		Mode = run.Mode,
		Seconds = seconds,
		Medal = medal,
		PreviousMedal = previous.Medal,
		PreviousBest = if run.Mode == "Ranked" then previous.RankedBest else previous.Best,
		NewBest = if run.Mode == "Ranked" then newRankedBest else newBest,
		FirstCompletion = previous.Completions == 0 and not practice and not partial,
		Distinctions = distinctions,
		NewDistinctions = newDistinctions,
		Lines = lines,
		XP = xp,
		Credits = credits,
		Prestige = prestige,
		Tokens = tokenCount,
		TokenTotal = #meta.Tokens,
		Falls = run.Falls,
		Retries = run.Retries,
		Splits = run.Splits,
		Flow = flowScore,
		FlowTarget = meta.FlowTarget,
		Medals = meta.Medals,
		Verified = verified,
		Partial = partial,
	}
	clearRun(player, nil)
	if not partial then
		Events.CourseFinished:Fire(player, result)
	end
	CourseService.Finished:Fire(player, run, result)
	return result
end

-- Remote handlers ----------------------------------------------------------------------------------

local function onStart(player: Player, courseId: any, mode: any): (boolean, any)
	if type(courseId) ~= "string" or type(mode) ~= "string" then
		return false, "Bad request"
	end
	if mode ~= "Casual" and mode ~= "Practice" and mode ~= "Ranked" then
		return false, "Unknown mode"
	end
	local meta = WorldBuilder.Courses[courseId]
	local profile = DataService.Get(player)
	if not meta or not profile then
		return false, "Unknown course"
	end
	local _, _, kind = courseInfo(courseId, meta)
	if kind == "Tower" or kind == "Relay" then
		return false, "Use the board for this mode"
	end
	-- Start at the gate, or jump straight to a course you've already finished in this district.
	local nearStart = MovementGuard.WasNear(player, meta.Spawn.Position, 90, 3)
	if not nearStart then
		local record = profile.Courses[courseId]
		local _, district = courseInfo(courseId, meta)
		local here = MovementGuard.District(player)
		if not (record and (record.Completions or 0) > 0 and here == district) then
			return false, "Head to the start gate first"
		end
	end
	local existing = runs[player]
	if existing and existing.Context ~= nil then
		return false, "Finish or leave your current event first"
	end
	return CourseService.Begin(player, courseId, mode)
end

local function onCheckpoint(player: Player, index: any, clientSeconds: any, clientFlow: any): any
	local run = runs[player]
	if not run then
		return nil
	end
	if now() < run.StartAt - 0.25 then
		return nil
	end
	local meta = run.Meta
	if index == "Finish" then
		if run.EndAt then
			return nil
		end
		if run.Checkpoint < #meta.Checkpoints then
			return { Error = "Missed a checkpoint" }
		end
		if not volumeNear(player, meta.Finish, 10) then
			return nil
		end
		return finish(player, run, clientSeconds, clientFlow)
	end
	if type(index) ~= "number" or index ~= math.floor(index) then
		return nil
	end
	local checkpoint = meta.Checkpoints[index]
	if not checkpoint or index <= run.Checkpoint then
		return nil
	end
	if not volumeNear(player, checkpoint.Volume, 8) then
		return nil
	end
	run.Checkpoint = index
	local elapsed = now() - run.StartAt
	if type(clientSeconds) == "number" and clientSeconds <= elapsed + 0.3 and clientSeconds >= elapsed - 1.5 then
		elapsed = clientSeconds
	end
	run.Splits[index] = math.floor(elapsed * 1000 + 0.5) / 1000
	CourseService.CheckpointReached:Fire(player, run, index)
	if run.EndAt and index >= run.EndAt then
		-- A relay leg (or any partial run) ends at its exchange.
		return finish(player, run, clientSeconds, clientFlow)
	end
	return { Index = index, Split = run.Splits[index] }
end

local function onToken(player: Player, index: any)
	local run = runs[player]
	if not run or type(index) ~= "number" or run.Tokens[index] then
		return
	end
	local position = run.Meta.Tokens[index]
	if not position or not MovementGuard.WasNear(player, position, 10, 1.6) then
		return
	end
	run.Tokens[index] = true
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	profile.Stats.TokensCollected = (profile.Stats.TokensCollected or 0) + 1
	local record = recordFor(profile, run.CourseId)
	local first = not record.Tokens[tostring(index)]
	if first and run.Mode ~= "Practice" then
		record.Tokens[tostring(index)] = true
		ProgressionService.Grant(player, { XP = 10, Credits = 6 }, nil, true)
	end
	DataService.MarkDirty(player)
	Events.Token:Fire(player, run.CourseId, index)
	Events.StatChanged:Fire(player, "TokensCollected")
end

local function onShortcut(player: Player)
	local run = runs[player]
	if not run or run.Shortcut then
		return
	end
	for _, volume in run.Meta.Shortcuts or {} do
		if volumeNear(player, volume, 8) then
			run.Shortcut = true
			return
		end
	end
end

-- kind: "Checkpoint" (retry), "Fall", "Start" (restart), "Practice" (custom spot)
local function onRestart(player: Player, kind: any, position: any)
	local run = runs[player]
	if not run then
		return
	end
	if kind == "Start" then
		if run.Context ~= nil then
			return -- events (races, relays) can't be restarted
		end
		CourseService.Begin(player, run.CourseId, run.Mode, { SkipChecks = true })
		return
	end
	if kind == "Practice" then
		if
			run.Mode == "Practice"
			and typeof(position) == "Vector3"
			and MovementGuard.VisitedRecently(player, position, 12)
		then
			MovementGuard.AllowTeleport(player, position, 15)
		end
		return
	end
	if kind == "Fall" then
		run.Falls += 1
	else
		run.Retries += 1
	end
	MovementGuard.AllowTeleport(player, spawnFor(run).Position, 20)
end

local function onAbort(player: Player)
	local run = runs[player]
	if run and run.Context == nil then
		clearRun(player, "Abort")
	end
end

local function onGhostUpload(player: Player, courseId: any, encoded: any)
	local pending = pendingGhost[player]
	if not pending or pending.CourseId ~= courseId or os.clock() > pending.Expires then
		return
	end
	pendingGhost[player] = nil
	if not GhostCodec.Validate(encoded, pending.Seconds) then
		return
	end
	encoded.Time = pending.Seconds
	encoded.Name = player.DisplayName
	RecordService.SaveGhost(courseId, player.UserId, encoded)
	if pending.Ranked then
		RecordService.SaveGhost(courseId .. "#R", player.UserId, encoded)
	end
end

-- which: "Best" (yours) | "Ranked" (your ranked) | "Top" (board leader) | "Friend" (fastest friend)
local function onGetGhost(player: Player, courseId: any, which: any): any
	if type(courseId) ~= "string" or not WorldBuilder.Courses[courseId] then
		return nil
	end
	if which == "Best" then
		return RecordService.LoadGhost(courseId, player.UserId)
	elseif which == "Ranked" then
		return RecordService.LoadGhost(courseId .. "#R", player.UserId)
	elseif which == "Top" then
		for _, entry in RecordService.Top(courseId, 3) do
			local ghost = RecordService.LoadGhost(courseId .. "#R", entry.UserId)
			if ghost then
				return ghost
			end
		end
	elseif which == "Friend" then
		for _, entry in RecordService.Friends(courseId, player, 15) do
			if entry.UserId ~= player.UserId then
				local ghost = RecordService.LoadGhost(courseId .. "#R", entry.UserId)
				if ghost then
					return ghost
				end
			end
		end
	end
	return nil
end

local function onPreview(player: Player, courseId: any): any
	if type(courseId) ~= "string" then
		return nil
	end
	local meta = WorldBuilder.Courses[courseId]
	local profile = DataService.Get(player)
	if not meta or not profile then
		return nil
	end
	local _, district = courseInfo(courseId, meta)
	local canEnter, reason = DistrictService.CanEnter(player, district)
	local missing = missingAbilities(player, meta)
	local have = ProgressionService.Abilities(player)
	local function lacking(list: { string }): { string }
		local result = {}
		for _, id in list do
			if not have[id] then
				table.insert(result, id)
			end
		end
		return result
	end
	return {
		CourseId = courseId,
		Record = profile.Courses[courseId],
		Locked = if not canEnter then reason elseif #missing > 0 then "Needs " .. table.concat(missing, ", ") else nil,
		MissingFast = lacking(meta.FastRequires or {}),
		MissingExpert = lacking(meta.ExpertRequires or {}),
		Top = RecordService.Top(courseId, 5),
		Friends = RecordService.Friends(courseId, player, 15),
		Online = RecordService.Online(),
	}
end

local function onLeaderboard(player: Player, courseId: any, scope: any): any
	if type(courseId) ~= "string" or not WorldBuilder.Courses[courseId] then
		return nil
	end
	if scope == "Friends" then
		return RecordService.Friends(courseId, player, 40)
	end
	return RecordService.Top(courseId, 25)
end

function CourseService.Start()
	DistrictService.IsBusy = function(player: Player): boolean
		return runs[player] ~= nil
	end
	Net.Handle("Course.Start", onStart)
	Net.Handle("Course.Checkpoint", onCheckpoint)
	Net.On("Course.Token", onToken)
	Net.On("Course.Shortcut", onShortcut)
	Net.On("Course.Restart", onRestart)
	Net.On("Course.Abort", onAbort)
	Net.On("Course.Ghost", onGhostUpload)
	Net.Handle("Course.GetGhost", onGetGhost)
	Net.Handle("Course.Preview", onPreview)
	Net.Handle("Course.Leaderboard", onLeaderboard)

	-- Validated moves during a run bound the flow score it can claim.
	Events.Action:Connect(function(player: Player, action: string)
		local run = runs[player]
		if run then
			run.ServerFlow += FlowConfig.Points[action] or 0
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		clearRun(player, "Left")
		repeats[player] = nil
		pendingGhost[player] = nil
	end)
	-- A new character (death, travel reset) ends any run.
	local function watch(player: Player)
		player.CharacterAdded:Connect(function()
			if runs[player] and runs[player].Context == nil then
				clearRun(player, "Respawn")
				Net.Push(player, "Course.Ended", "Respawn")
			end
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
end

return CourseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">CrewService</string>
            <string name="Source"><![CDATA[-- Runner crews: small persistent groups with a name, a tag shown on
-- nametags, and a weekly crew goal everyone contributes to by finishing
-- courses, races, relays and Spire floors. Reaching each goal tier pays every
-- member (claimed automatically the next time they're online).
--
-- Crews live in their own DataStore so they work across servers; invites go
-- to players in the same server.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Net = require(ReplicatedStorage.Shared.Net)
local Rotation = require(ReplicatedStorage.Shared.Logic.Rotation)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local Notify = require(script.Parent.Notify)
local ProgressionService = require(script.Parent.ProgressionService)

local CrewService = {}

local STORE = "SkylineLegends_Crews_v1"
local MAX_MEMBERS = 20
local GOAL_TIERS = { 60, 180, 400 }
local GOAL_REWARDS = {
	{ XP = 400, Credits = 250 },
	{ XP = 800, Credits = 500 },
	{ XP = 1500, Credits = 900, Prestige = 1 },
}

type Crew = {
	Id: string,
	Name: string,
	Tag: string,
	Owner: number,
	Members: { [string]: { Name: string, Joined: number } },
	Created: number,
	Week: number,
	Points: number,
	Total: number,
}

local store: DataStore? = nil
local cache: { [string]: Crew } = {}
local pendingPoints: { [string]: number } = {}
local invites: { [Player]: { [string]: number } } = {} -- crewId → expiry

local function load(crewId: string): Crew?
	local cached = cache[crewId]
	if cached then
		return cached
	end
	if not store then
		return nil
	end
	local ok, result = pcall(function()
		return (store :: DataStore):GetAsync(crewId)
	end)
	if ok and type(result) == "table" then
		cache[crewId] = result
		return result
	end
	return nil
end

-- Atomically change a crew (and keep the cache in step).
local function update(crewId: string, fn: (Crew) -> boolean): Crew?
	local crew = cache[crewId]
	if store then
		local result: Crew? = nil
		local ok = pcall(function()
			(store :: DataStore):UpdateAsync(crewId, function(old)
				if type(old) ~= "table" then
					return nil
				end
				if not fn(old) then
					return nil
				end
				result = old
				return old
			end)
		end)
		if ok and result then
			cache[crewId] = result
			return result
		end
		if ok then
			return cache[crewId]
		end
	end
	-- Memory only (Studio without API access).
	if crew and fn(crew) then
		return crew
	end
	return crew
end

local function filter(text: string, player: Player): string?
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, player.UserId)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if ok and type(result) == "string" then
		return result
	end
	return nil
end

local function memberCount(crew: Crew): number
	local n = 0
	for _ in crew.Members do
		n += 1
	end
	return n
end

local function rollWeek(crew: Crew)
	local week = Rotation.Week()
	if crew.Week ~= week then
		crew.Week = week
		crew.Points = 0
	end
end

local function setTag(player: Player, crew: Crew?)
	player:SetAttribute("CrewTag", if crew then crew.Tag else nil)
	player:SetAttribute("CrewName", if crew then crew.Name else nil)
end

local function view(player: Player, crew: Crew): { [string]: any }
	local members = {}
	for userId, entry in crew.Members do
		local id = tonumber(userId) or 0
		table.insert(members, {
			UserId = id,
			Name = entry.Name,
			Owner = id == crew.Owner,
			Online = Players:GetPlayerByUserId(id) ~= nil,
		})
	end
	table.sort(members, function(a, b)
		if a.Owner ~= b.Owner then
			return a.Owner
		end
		return a.Name < b.Name
	end)
	return {
		Id = crew.Id,
		Name = crew.Name,
		Tag = crew.Tag,
		Members = members,
		Week = crew.Week,
		Points = crew.Points,
		Total = crew.Total,
		Tiers = GOAL_TIERS,
		Rewards = GOAL_REWARDS,
		IsOwner = player.UserId == crew.Owner,
		ResetIn = Rotation.SecondsUntilNextWeek(),
	}
end

-- Pay any goal tiers reached this week that this member hasn't claimed yet.
local function claim(player: Player, crew: Crew)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	rollWeek(crew)
	local claims = profile.Flags.CrewClaims
	if type(claims) ~= "table" or claims.Week ~= crew.Week or claims.Crew ~= crew.Id then
		claims = { Week = crew.Week, Crew = crew.Id, Tier = 0 }
		profile.Flags.CrewClaims = claims
	end
	for tier = claims.Tier + 1, #GOAL_TIERS do
		if crew.Points >= GOAL_TIERS[tier] then
			claims.Tier = tier
			ProgressionService.Grant(player, GOAL_REWARDS[tier], nil, true)
			profile.Stats.CrewGoals = (profile.Stats.CrewGoals or 0) + 1
			Notify.Send(player, {
				Kind = "Reward",
				Title = ("Crew goal %d reached"):format(tier),
				Text = crew.Name,
				XP = GOAL_REWARDS[tier].XP,
				Credits = GOAL_REWARDS[tier].Credits,
				Prestige = GOAL_REWARDS[tier].Prestige,
			})
			Events.StatChanged:Fire(player, "CrewGoals")
		end
	end
	DataService.MarkDirty(player)
end

local function addPoints(player: Player, amount: number)
	local profile = DataService.Get(player)
	local crewId = profile and profile.Crew
	if type(crewId) ~= "string" then
		return
	end
	pendingPoints[crewId] = (pendingPoints[crewId] or 0) + amount
	local crew = cache[crewId]
	if crew then
		rollWeek(crew)
		crew.Points += amount
		crew.Total = (crew.Total or 0) + amount
		-- Online members claim tiers as soon as they're reached.
		for userId in crew.Members do
			local member = Players:GetPlayerByUserId(tonumber(userId) or 0)
			if member then
				claim(member, crew)
			end
		end
	end
end

-- Remote handlers -------------------------------------------------------------------------------

local function onCreate(player: Player, name: any, tag: any): (boolean, any)
	local profile = DataService.Get(player)
	if not profile then
		return false, "Not ready"
	end
	if profile.Crew then
		return false, "Leave your crew first"
	end
	if type(name) ~= "string" or type(tag) ~= "string" then
		return false, "Give your crew a name and a tag"
	end
	name = string.sub((string.gsub(name, "^%s+", "")), 1, 24)
	tag = string.upper(string.sub((string.gsub(tag, "[^%w]", "")), 1, 4))
	if #name < 3 or #tag < 2 then
		return false, "Names need 3+ characters, tags 2-4 letters"
	end
	local cleanName = filter(name, player)
	local cleanTag = filter(tag, player)
	if not cleanName or not cleanTag or string.find(cleanName, "#") or string.find(cleanTag, "#") then
		return false, "Try a different name"
	end
	local crew: Crew = {
		Id = "crew_" .. HttpService:GenerateGUID(false):sub(1, 13),
		Name = cleanName,
		Tag = cleanTag,
		Owner = player.UserId,
		Members = { [tostring(player.UserId)] = { Name = player.DisplayName, Joined = os.time() } },
		Created = os.time(),
		Week = Rotation.Week(),
		Points = 0,
		Total = 0,
	}
	if store then
		local ok = pcall(function()
			(store :: DataStore):SetAsync(crew.Id, crew)
		end)
		if not ok then
			store = nil
		end
	end
	cache[crew.Id] = crew
	profile.Crew = crew.Id
	profile.Stats.CrewJoined = 1
	DataService.Push(player, "Crew")
	DataService.MarkDirty(player)
	setTag(player, crew)
	Events.CrewJoined:Fire(player, crew.Id)
	Events.StatChanged:Fire(player, "CrewJoined")
	return true, view(player, crew)
end

local function onInvite(player: Player, userId: any)
	local profile = DataService.Get(player)
	local crew = profile and type(profile.Crew) == "string" and load(profile.Crew)
	local target = type(userId) == "number" and Players:GetPlayerByUserId(userId)
	if not crew or not target or target == player then
		return
	end
	if memberCount(crew) >= MAX_MEMBERS then
		Notify.Warn(player, "Your crew is full.")
		return
	end
	invites[target] = invites[target] or {}
	invites[target][crew.Id] = os.clock() + 300
	Net.Push(target, "Crew.Invite", { CrewId = crew.Id, Name = crew.Name, Tag = crew.Tag, From = player.DisplayName })
	Notify.Toast(player, "Invite sent", target.DisplayName)
end

local function onRespond(player: Player, crewId: any, accept: any): (boolean, any)
	local pending = invites[player]
	if type(crewId) ~= "string" or not pending or not pending[crewId] or os.clock() > pending[crewId] then
		return false, "That invite has expired"
	end
	pending[crewId] = nil
	if not accept then
		return true, nil
	end
	local profile = DataService.Get(player)
	if not profile then
		return false, "Not ready"
	end
	if profile.Crew then
		return false, "Leave your crew first"
	end
	local full = false
	local crew = update(crewId, function(c)
		if memberCount(c) >= MAX_MEMBERS then
			full = true
			return false
		end
		c.Members[tostring(player.UserId)] = { Name = player.DisplayName, Joined = os.time() }
		return true
	end)
	if not crew or full then
		return false, "That crew is full"
	end
	profile.Crew = crewId
	profile.Stats.CrewJoined = 1
	DataService.Push(player, "Crew")
	DataService.MarkDirty(player)
	setTag(player, crew)
	Events.CrewJoined:Fire(player, crewId)
	Events.StatChanged:Fire(player, "CrewJoined")
	claim(player, crew)
	return true, view(player, crew)
end

local function onLeave(player: Player)
	local profile = DataService.Get(player)
	local crewId = profile and profile.Crew
	if not profile or type(crewId) ~= "string" then
		return
	end
	update(crewId, function(c)
		c.Members[tostring(player.UserId)] = nil
		if c.Owner == player.UserId then
			-- Hand the crew to the longest-standing member.
			local best, joined = nil, math.huge
			for userId, entry in c.Members do
				if entry.Joined < joined then
					best, joined = tonumber(userId), entry.Joined
				end
			end
			c.Owner = best or 0
		end
		return true
	end)
	profile.Crew = nil
	DataService.Push(player, "Crew")
	DataService.MarkDirty(player)
	setTag(player, nil)
end

local function onKick(player: Player, userId: any)
	local profile = DataService.Get(player)
	local crewId = profile and profile.Crew
	if type(crewId) ~= "string" or type(userId) ~= "number" or userId == player.UserId then
		return
	end
	local crew = load(crewId)
	if not crew or crew.Owner ~= player.UserId then
		return
	end
	update(crewId, function(c)
		c.Members[tostring(userId)] = nil
		return true
	end)
	local target = Players:GetPlayerByUserId(userId)
	if target then
		local targetProfile = DataService.Get(target)
		if targetProfile and targetProfile.Crew == crewId then
			targetProfile.Crew = nil
			DataService.Push(target, "Crew")
			setTag(target, nil)
			Notify.Warn(target, "You were removed from " .. crew.Name)
		end
	end
end

local function onGet(player: Player): any
	local profile = DataService.Get(player)
	local crewId = profile and profile.Crew
	if type(crewId) ~= "string" then
		return nil
	end
	local crew = load(crewId)
	if not crew or not crew.Members[tostring(player.UserId)] then
		-- Removed while away.
		if profile then
			profile.Crew = nil
			DataService.Push(player, "Crew")
		end
		setTag(player, nil)
		return nil
	end
	claim(player, crew)
	return view(player, crew)
end

function CrewService.Start()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE)
	end)
	store = if ok then result else nil

	Net.Handle("Crew.Create", onCreate)
	Net.On("Crew.Invite", onInvite)
	Net.Handle("Crew.Respond", onRespond)
	Net.On("Crew.Leave", onLeave)
	Net.On("Crew.Kick", onKick)
	Net.Handle("Crew.Get", onGet)

	DataService.Loaded:Connect(function(player, profile)
		if type(profile.Crew) == "string" then
			task.spawn(function()
				local crew = load(profile.Crew)
				if crew and crew.Members[tostring(player.UserId)] then
					setTag(player, crew)
					claim(player, crew)
				end
			end)
		end
	end)
	-- Contributions.
	Events.CourseFinished:Connect(function(player: Player, result: any)
		if result.Mode ~= "Practice" then
			addPoints(player, 1 + math.max((result.Medal or 0) - (result.PreviousMedal or 0), 0))
		end
	end)
	Events.RaceFinished:Connect(function(player: Player)
		addPoints(player, 3)
	end)
	Events.RelayFinished:Connect(function(player: Player)
		addPoints(player, 4)
	end)
	Events.TowerFloor:Connect(function(player: Player)
		addPoints(player, 1)
	end)
	Players.PlayerRemoving:Connect(function(player)
		invites[player] = nil
	end)
	-- Flush crew points to the store every minute.
	task.spawn(function()
		while true do
			task.wait(60)
			for crewId, amount in pendingPoints do
				pendingPoints[crewId] = nil
				task.spawn(function()
					if store then
						pcall(function()
							(store :: DataStore):UpdateAsync(crewId, function(old)
								if type(old) ~= "table" then
									return nil
								end
								rollWeek(old)
								old.Points += amount
								old.Total = (old.Total or 0) + amount
								cache[crewId] = old
								return old
							end)
						end)
					end
				end)
			end
		end
	end)
end

return CrewService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">DiscoveryService</string>
            <string name="Source"><![CDATA[-- Discoveries: hidden courier caches, lost letters, landmarks and secrets.
--
-- The world builder tags each one (Tags.Discovery) with Id, Kind and District.
-- Clients report touches; the server checks the character really was there.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Progression = require(ReplicatedStorage.Shared.Config.Progression)
local Tags = require(ReplicatedStorage.Shared.Tags)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local MovementGuard = require(script.Parent.MovementGuard)
local Notify = require(script.Parent.Notify)
local ProgressionService = require(script.Parent.ProgressionService)

local DiscoveryService = {}

type Entry = { Part: BasePart, Kind: string, District: string, Title: string?, Text: string? }

local entries: { [string]: Entry } = {}
DiscoveryService.CacheTotals = {} :: { [string]: number }

function DiscoveryService.Index()
	table.clear(entries)
	table.clear(DiscoveryService.CacheTotals)
	for _, instance in CollectionService:GetTagged(Tags.Discovery) do
		if instance:IsA("BasePart") then
			local id = instance:GetAttribute("Id")
			local kind = instance:GetAttribute("Kind")
			local district = instance:GetAttribute("District")
			if type(id) == "string" and type(kind) == "string" and type(district) == "string" then
				entries[id] = {
					Part = instance,
					Kind = kind,
					District = district,
					Title = instance:GetAttribute("Title") :: string?,
					Text = instance:GetAttribute("Text") :: string?,
				}
				if kind == "Cache" then
					DiscoveryService.CacheTotals[district] = (DiscoveryService.CacheTotals[district] or 0) + 1
				end
			end
		end
	end
end

-- Counts per district for the map: { [district] = { Found, Total } }.
function DiscoveryService.Summary(player: Player): { [string]: { Found: number, Total: number } }
	local profile = DataService.Get(player)
	local result = {}
	for id, entry in entries do
		local bucket = result[entry.District]
		if not bucket then
			bucket = { Found = 0, Total = 0 }
			result[entry.District] = bucket
		end
		bucket.Total += 1
		if profile and profile.Discoveries[id] then
			bucket.Found += 1
		end
	end
	return result
end

local function discover(player: Player, id: any)
	if type(id) ~= "string" then
		return
	end
	local entry = entries[id]
	local profile = DataService.Get(player)
	if not entry or not profile or profile.Discoveries[id] then
		return
	end
	local radius = if entry.Kind == "Landmark" or entry.Kind == "Secret"
		then math.max(entry.Part.Size.Magnitude / 2, 12) + 8
		else 12
	if not MovementGuard.WasNear(player, entry.Part.Position, radius, 2) then
		return
	end
	profile.Discoveries[id] = os.time()
	DataService.Push(player, "Discoveries")

	local perks = ProgressionService.Perks(player)
	local creditBonus = 1 + (perks.CreditBonus or 0)
	local xp, credits = Progression.XP.Discovery, Progression.Credits.Discovery
	if entry.Kind == "Cache" then
		credits = Progression.Credits.Cache
	elseif entry.Kind == "Letter" then
		xp = Progression.XP.Letter
	elseif entry.Kind == "Landmark" then
		xp = Progression.XP.Landmark
	elseif entry.Kind == "Secret" then
		xp = Progression.XP.Discovery * 2
		credits = Progression.Credits.Cache
	end
	ProgressionService.Grant(player, { XP = xp, Credits = math.floor(credits * creditBonus) }, nil, true)
	Notify.Send(player, {
		Kind = "Discovery",
		Title = entry.Title or (entry.Kind .. " found"),
		Text = entry.Text,
		Icon = entry.Kind,
		XP = xp,
		Credits = math.floor(credits * creditBonus),
		Sound = "Discovery",
	})
	Events.Discovery:Fire(player, id, entry.Kind, entry.District)
	Events.StatChanged:Fire(player, "Discoveries")
end

function DiscoveryService.Start()
	DiscoveryService.Index()
	Net.On("Discover.Touch", discover)
end

return DiscoveryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">DistrictService</string>
            <string name="Source"><![CDATA[-- District access, fast travel between plazas, and arrival tracking.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Access = require(ReplicatedStorage.Shared.Logic.Access)
local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Net = require(ReplicatedStorage.Shared.Net)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local MovementGuard = require(script.Parent.MovementGuard)
local Notify = require(script.Parent.Notify)
local PlayerService = require(script.Parent.PlayerService)
local ProgressionService = require(script.Parent.ProgressionService)

local DistrictService = {}

-- Set by CourseService: whether a player is mid-run (travel is blocked).
DistrictService.IsBusy = nil :: ((Player) -> boolean)?

local lastTravel: { [Player]: number } = {}

function DistrictService.CanEnter(player: Player, districtId: string): (boolean, string?)
	local profile = DataService.Get(player)
	if not profile then
		return false, "Not ready"
	end
	return Access.District(ProgressionService.Level(player), profile.Quests.Completed, districtId)
end

function DistrictService.SpawnCFrame(districtId: string): CFrame
	return PlayerService.Spawns[districtId] or CFrame.new(Districts.ById[districtId].Origin + Vector3.new(0, 5, 0))
end

local function onDistrictChanged(player: Player, districtId: string)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	if not profile.Districts.Visited[districtId] then
		profile.Districts.Visited[districtId] = true
		local district = Districts.ById[districtId]
		Notify.Send(player, {
			Kind = "District",
			Title = district.Name,
			Text = district.Tagline,
		})
		Events.StatChanged:Fire(player, "DistrictsVisited")
	end
	profile.Districts.Last = districtId
	DataService.Push(player, "Districts")
	Events.DistrictEntered:Fire(player, districtId)
end

function DistrictService.Start()
	MovementGuard.OnDistrictChanged = onDistrictChanged

	Net.Handle("Travel.Go", function(player, districtId)
		if type(districtId) ~= "string" or not Districts.ById[districtId] then
			return false, "Unknown district"
		end
		if DistrictService.IsBusy and DistrictService.IsBusy(player) then
			return false, "Finish or leave your current run first"
		end
		if os.clock() - (lastTravel[player] or 0) < 2 then
			return false, "Slow down"
		end
		local ok, reason = DistrictService.CanEnter(player, districtId)
		if not ok then
			return false, reason
		end
		lastTravel[player] = os.clock()
		local destination = DistrictService.SpawnCFrame(districtId)
			+ Vector3.new(math.random(-4, 4), 3.5, math.random(-4, 4))
		MovementGuard.AllowTeleport(player, destination.Position, 25)
		local profile = DataService.Get(player)
		if profile then
			profile.Stats.Travels = (profile.Stats.Travels or 0) + 1
			Events.StatChanged:Fire(player, "Travels")
		end
		return true, destination
	end)

	-- "Get me out of here": back to the plaza of the current district.
	Net.Handle("Travel.Spawn", function(player)
		if DistrictService.IsBusy and DistrictService.IsBusy(player) then
			return false, "Use retry during a run"
		end
		local district = MovementGuard.District(player) or "Hub"
		local destination = DistrictService.SpawnCFrame(district) + Vector3.new(0, 3.5, 0)
		MovementGuard.AllowTeleport(player, destination.Position, 25)
		return true, destination
	end)
end

return DistrictService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[-- Credits, prestige tokens, the shop and equipping cosmetics.
--
-- Credits come from steady play; prestige tokens only from significant
-- achievements. District items unlock in the shop once you've visited that
-- district, so every stall sells things tied to a place you've been.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Cosmetics = require(ReplicatedStorage.Shared.Config.Cosmetics)
local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Net = require(ReplicatedStorage.Shared.Net)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local Notify = require(script.Parent.Notify)
local ProgressionService = require(script.Parent.ProgressionService)

local EconomyService = {}

-- Called after equipment changes so characters update (set by CosmeticService).
EconomyService.OnEquipChanged = nil :: ((Player) -> ())?

function EconomyService.AddCredits(player: Player, amount: number, _reason: string?)
	local profile = DataService.Get(player)
	if not profile or amount <= 0 then
		return
	end
	amount = math.floor(amount + 0.5)
	profile.Credits += amount
	profile.Stats.CreditsEarned = (profile.Stats.CreditsEarned or 0) + amount
	DataService.Push(player, "Credits")
end

function EconomyService.AddPrestige(player: Player, amount: number, _reason: string?)
	local profile = DataService.Get(player)
	if not profile or amount <= 0 then
		return
	end
	profile.Prestige += math.floor(amount)
	DataService.Push(player, "Prestige")
end

function EconomyService.Owns(player: Player, itemId: string): boolean
	local profile = DataService.Get(player)
	return profile ~= nil and profile.Inventory[itemId] == true
end

function EconomyService.GrantItem(player: Player, itemId: string, silent: boolean?)
	local profile = DataService.Get(player)
	local item = Cosmetics.ById[itemId]
	if not profile or not item or profile.Inventory[itemId] then
		return
	end
	profile.Inventory[itemId] = true
	DataService.Push(player, "Inventory")
	Events.ItemGranted:Fire(player, itemId)
	Events.StatChanged:Fire(player, "ItemsOwned")
	if not silent then
		Notify.Send(player, {
			Kind = "Item",
			Title = item.Name,
			Text = Cosmetics.CategoryNames[item.Category] .. " unlocked: " .. item.Description,
			Item = itemId,
			Color = Cosmetics.Rarities[item.Rarity],
			Sound = "Unlock",
		})
	end
end

-- Whether an item is on sale to this player right now (and why not).
function EconomyService.CanBuy(player: Player, itemId: string): (boolean, string?)
	local profile = DataService.Get(player)
	local item = Cosmetics.ById[itemId]
	if not profile or not item then
		return false, "Unknown item"
	end
	if profile.Inventory[itemId] then
		return false, "Already owned"
	end
	if item.Source == "Reward" then
		return false, item.Unlock or "Earned, not bought"
	end
	if item.District and not profile.Districts.Visited[item.District] then
		local district = Districts.ById[item.District]
		return false, "Visit " .. (if district then district.Name else item.District) .. " to unlock"
	end
	if item.Source == "Prestige" then
		if profile.Prestige < (item.PrestigePrice or 0) then
			return false, ("Needs %d prestige tokens"):format(item.PrestigePrice or 0)
		end
	elseif profile.Credits < (item.Price or 0) then
		return false, ("Needs %d credits"):format(item.Price or 0)
	end
	return true, nil
end

local function equip(player: Player, category: string, itemId: string?): (boolean, string?)
	local profile = DataService.Get(player)
	if not profile or not table.find(Cosmetics.Categories, category) then
		return false, "Unknown category"
	end
	if category == "Emote" then
		-- Emotes: toggle in the equipped list (up to 8).
		if type(itemId) ~= "string" then
			return false, "Pick an emote"
		end
		local item = Cosmetics.ById[itemId]
		if not item or item.Category ~= "Emote" or not profile.Inventory[itemId] then
			return false, "Not owned"
		end
		local list = profile.Equipped.Emotes or {}
		local index = table.find(list, itemId)
		if index then
			table.remove(list, index)
		elseif #list >= Cosmetics.MultiEquip.Emote then
			return false, "Emote wheel is full"
		else
			table.insert(list, itemId)
		end
		profile.Equipped.Emotes = list
	else
		local target = itemId or Cosmetics.Defaults[category]
		local item = target and Cosmetics.ById[target]
		if not item or item.Category ~= category or not profile.Inventory[target] then
			return false, "Not owned"
		end
		profile.Equipped[category] = target
	end
	DataService.Push(player, "Equipped")
	if EconomyService.OnEquipChanged then
		EconomyService.OnEquipChanged(player)
	end
	return true, nil
end

function EconomyService.Start()
	ProgressionService.AddCredits = EconomyService.AddCredits
	ProgressionService.AddPrestige = EconomyService.AddPrestige
	ProgressionService.GrantItem = EconomyService.GrantItem

	Net.Handle("Shop.Buy", function(player, itemId)
		if type(itemId) ~= "string" then
			return false, "Invalid item"
		end
		local ok, reason = EconomyService.CanBuy(player, itemId)
		if not ok then
			return false, reason
		end
		local profile = DataService.Get(player) :: any
		local item = Cosmetics.ById[itemId]
		if item.Source == "Prestige" then
			profile.Prestige -= item.PrestigePrice or 0
			DataService.Push(player, "Prestige")
		else
			profile.Credits -= item.Price or 0
			DataService.Push(player, "Credits")
		end
		EconomyService.GrantItem(player, itemId, true)
		-- Wearables are put on straight away.
		if item.Category ~= "Emote" and item.Category ~= "Title" then
			equip(player, item.Category, itemId)
		end
		DataService.SaveNow(player)
		return true, nil
	end)

	Net.Handle("Shop.Equip", function(player, category, itemId)
		if type(category) ~= "string" or (itemId ~= nil and type(itemId) ~= "string") then
			return false, "Invalid"
		end
		return equip(player, category, itemId)
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">EndlessService</string>
            <string name="Source"><![CDATA[-- The Dreamline: endless runs of tested sections.
--
-- Each runner gets a lane off the Dreamline lobby. Sections from the library
-- (sized from the movement envelope, so always clearable) are built a few
-- ahead of you and torn down behind you; every gate you pass raises the
-- difficulty a little. You have three lives: a fall costs one and puts you
-- back at your last gate. Your best run is your Dreamline record.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Net = require(ReplicatedStorage.Shared.Net)
local Progression = require(ReplicatedStorage.Shared.Config.Progression)
local Rotation = require(ReplicatedStorage.Shared.Logic.Rotation)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local CourseBuilder = require(script.Parent.Parent.World.CourseBuilder)
local Dreamline = require(script.Parent.Parent.World.Dreamline)
local Kit = require(script.Parent.Parent.World.Kit)
local Sections = require(script.Parent.Parent.World.Sections)
local CourseService = require(script.Parent.CourseService)
local MovementGuard = require(script.Parent.MovementGuard)
local Notify = require(script.Parent.Notify)
local ProgressionService = require(script.Parent.ProgressionService)

local EndlessService = {}

local AHEAD = 3
local KEEP_BEHIND = 2
local LIVES = 3

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local THEME = {
	Id = "Dreamline",
	Surface = rgb(70, 60, 110),
	SurfaceMaterial = Enum.Material.Glass,
	Trim = rgb(255, 160, 240),
	Wall = rgb(120, 110, 180),
	WallMaterial = Enum.Material.Marble,
	Accent = rgb(150, 255, 230),
	Signal = rgb(255, 160, 240),
	Beam = rgb(200, 180, 255),
	BeamMaterial = Enum.Material.Marble,
	Rope = rgb(255, 220, 250),
	Climb = "Mesh",
	BodyDepth = 0,
	Floating = true,
}

type Lane = {
	Index: number,
	Root: Folder,
	B: any,
	Ctx: any,
	Cursor: CFrame,
	Built: number, -- sections built
	Folders: { [number]: Folder },
	Cleared: number,
	Lives: number,
	Rng: Rotation.Rng,
	Abilities: { [string]: boolean },
	Started: number,
	XP: number,
	Credits: number,
}

local lanes: { [Player]: Lane } = {}
local laneTaken: { [number]: Player } = {}
local container: Folder

local function difficultyAt(cleared: number): number
	return math.min(1 + cleared * 0.32, 10)
end

local function lend(player: Player, lane: Lane)
	local kit = {}
	for _, set in lane.Ctx.Requires do
		for id in set do
			kit[id] = true
		end
	end
	ProgressionService.SetTemporary(player, kit)
end

local function buildNext(lane: Lane)
	lane.Built += 1
	local index = lane.Built
	local folder = lane.B:Group("Section" .. index)
	lane.Folders[index] = folder
	lane.B:Within(folder, function()
		local difficulty = difficultyAt(index - 1)
		local pool = Sections.Available(difficulty, lane.Abilities)
		local section = lane.Rng:Pick(pool)
		local segments = section.Make(lane.Rng, difficulty)
		table.insert(segments, { "CP" })
		lane.Cursor = CourseBuilder.Segments(lane.Ctx, lane.Cursor, segments)
	end)
end

local function state(lane: Lane): { [string]: any }
	local nextGate = lane.Ctx.Checkpoints[lane.Cleared + 1]
	return {
		Lane = lane.Index,
		CourseId = lane.Ctx.Id,
		Cleared = lane.Cleared,
		Lives = lane.Lives,
		KillY = lane.Ctx.MinY - 30,
		Respawn = if lane.Cleared > 0
			then lane.Ctx.Checkpoints[lane.Cleared].Spawn
			else Dreamline.LaneStart(lane.Index) * CFrame.new(0, 3.5, -8),
		NextGate = if nextGate then nextGate.Volume.CFrame.Position else nil,
		Difficulty = math.floor(difficultyAt(lane.Cleared) * 10) / 10,
	}
end

local function finishRun(player: Player, reason: string)
	local lane = lanes[player]
	if not lane then
		return
	end
	lanes[player] = nil
	laneTaken[lane.Index] = nil
	ProgressionService.SetTemporary(player, nil)
	local profile = DataService.Get(player)
	local best = 0
	local record = false
	if profile then
		best = profile.Endless.Best or 0
		if lane.Cleared > best then
			profile.Endless.Best = lane.Cleared
			best = lane.Cleared
			record = true
		end
		profile.Stats.EndlessRuns = (profile.Stats.EndlessRuns or 0) + 1
		DataService.Push(player, "Endless")
		DataService.MarkDirty(player)
	end
	Events.EndlessEnded:Fire(player, lane.Cleared)
	Events.StatChanged:Fire(player, "EndlessBest")
	local lobbyCF =
		CFrame.lookAt(Districts.Dreamline + Vector3.new(0, 3.5, 6), Districts.Dreamline + Vector3.new(0, 3.5, -60))
	MovementGuard.AllowTeleport(player, lobbyCF.Position, 20)
	Net.Push(player, "Endless.Ended", {
		Reason = reason,
		Cleared = lane.Cleared,
		Best = best,
		Record = record,
		XP = lane.XP,
		Credits = lane.Credits,
		Seconds = os.clock() - lane.Started,
		Lobby = lobbyCF,
	})
	if record and lane.Cleared >= 5 then
		Notify.Send(player, {
			Kind = "Unlock",
			Title = "New Dreamline record",
			Text = ("%d sections"):format(lane.Cleared),
			Sound = "Medal",
		})
	end
	-- Let the runner get clear before the lane dissolves.
	local root = lane.Root
	task.delay(1, function()
		root:Destroy()
	end)
end

local function onStart(player: Player): (boolean, any)
	if lanes[player] then
		return false, "Already running"
	end
	if not MovementGuard.WasNear(player, Districts.Dreamline, 400, 3) then
		return false, "Enter the Dreamline from its lobby"
	end
	if CourseService.Active(player) then
		return false, "Finish your current run first"
	end
	local index: number? = nil
	for i = 1, Dreamline.Lanes do
		if not laneTaken[i] then
			index = i
			break
		end
	end
	if not index then
		return false, "Every lane is busy. Try again in a moment."
	end
	laneTaken[index] = player
	local seed = Rotation.Hash(player.UserId, os.time())
	local start = Dreamline.LaneStart(index)
	local B = Kit.new(container, "Lane" .. index, { Signal = THEME.Signal }, seed)
	local ctx = CourseBuilder.NewContext(
		B,
		THEME :: any,
		("endless_%d_%d"):format(player.UserId, seed % 100000),
		1,
		start,
		B.Core
	)
	local lane: Lane = {
		Index = index,
		Root = B.Root,
		B = B,
		Ctx = ctx,
		Cursor = start,
		Built = 0,
		Folders = {},
		Cleared = 0,
		Lives = LIVES,
		Rng = Rotation.Rng(seed),
		Abilities = ProgressionService.Abilities(player),
		Started = os.clock(),
		XP = 0,
		Credits = 0,
	}
	B:Within(B:Group("Start"), function()
		lane.Cursor = CourseBuilder.Segments(ctx, lane.Cursor, { { "Run", 18 } })
	end)
	for _ = 1, AHEAD do
		buildNext(lane)
	end
	lanes[player] = lane
	lend(player, lane)
	local spawn = start * CFrame.new(0, 3.5, -8)
	MovementGuard.AllowTeleport(player, spawn.Position, 20)
	local info = state(lane)
	info.Spawn = spawn
	return true, info
end

-- index > 0: passed that gate. index == -1: fell (costs a life).
local function onGate(player: Player, index: any)
	local lane = lanes[player]
	if not lane or type(index) ~= "number" then
		return
	end
	if index == -1 then
		lane.Lives -= 1
		Events.Break:Fire(player, "Fall")
		if lane.Lives <= 0 then
			finishRun(player, "Out of lives")
			return
		end
		local info = state(lane)
		MovementGuard.AllowTeleport(player, info.Respawn.Position, 20)
		Net.Push(player, "Endless.State", info)
		return
	end
	if index ~= lane.Cleared + 1 then
		return
	end
	local gate = lane.Ctx.Checkpoints[index]
	if not gate then
		return
	end
	local volume = gate.Volume
	local radius = math.max(volume.Size.X, volume.Size.Y, volume.Size.Z) / 2 + 8
	if not MovementGuard.WasNear(player, volume.CFrame.Position, radius, 1.6) then
		return
	end
	lane.Cleared = index
	-- Rewards grow slowly with depth.
	local scale = 1 + math.floor(index / 10) * 0.25
	local xp = math.floor(Progression.XP.EndlessSection * scale + 0.5)
	local credits = math.floor(Progression.Credits.EndlessSection * scale + 0.5)
	lane.XP += xp
	lane.Credits += credits
	ProgressionService.Grant(player, { XP = xp, Credits = credits }, nil, true)
	Events.EndlessSection:Fire(player, index)
	-- Keep sections ahead, clear the ones far behind.
	while lane.Built < index + AHEAD do
		buildNext(lane)
	end
	for old, folder in lane.Folders do
		if old < index - KEEP_BEHIND then
			folder:Destroy()
			lane.Folders[old] = nil
		end
	end
	lend(player, lane)
	Net.Push(player, "Endless.State", state(lane))
	if index % 10 == 0 then
		Notify.Send(
			player,
			{ Kind = "Toast", Title = ("%d sections!"):format(index), Text = "The Dreamline bends harder from here." }
		)
	end
end

local function onEnd(player: Player)
	finishRun(player, "Left")
end

function EndlessService.Active(player: Player): boolean
	return lanes[player] ~= nil
end

function EndlessService.Start()
	container = Instance.new("Folder")
	container.Name = "SkylineEndless"
	container.Parent = workspace
	Net.Handle("Endless.Start", onStart)
	Net.On("Endless.Gate", onGate)
	Net.On("Endless.End", onEnd)
	Players.PlayerRemoving:Connect(function(player)
		finishRun(player, "Left")
	end)
end

return EndlessService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">LessonService</string>
            <string name="Source"><![CDATA[-- Training Yard lessons. The client walks the player through each station's
-- steps; the server checks they were really at the station, that the lesson's
-- technique is unlocked, and that the moves it teaches were actually performed
-- (validated by the movement guard) before paying out.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Lessons = require(ReplicatedStorage.Shared.Config.Lessons)
local Net = require(ReplicatedStorage.Shared.Net)
local Progression = require(ReplicatedStorage.Shared.Config.Progression)
local Tags = require(ReplicatedStorage.Shared.Tags)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local MovementGuard = require(script.Parent.MovementGuard)
local Notify = require(script.Parent.Notify)
local ProgressionService = require(script.Parent.ProgressionService)

local LessonService = {}

local zones: { [string]: BasePart } = {}
local byId: { [string]: Lessons.Lesson } = {}
-- Recent validated actions per player: { [player] = { [action] = lastTime } }
local recent: { [Player]: { [string]: number } } = {}

local function onComplete(player: Player, lessonId: any)
	if type(lessonId) ~= "string" then
		return
	end
	local lesson = byId[lessonId]
	local zone = zones[lessonId]
	local profile = DataService.Get(player)
	if not lesson or not zone or not profile or profile.Lessons[lessonId] then
		return
	end
	if lesson.Ability and not ProgressionService.HasAbility(player, lesson.Ability) then
		return
	end
	local radius = zone.Size.Magnitude / 2 + 10
	if not MovementGuard.WasNear(player, zone.Position, radius, 4) then
		return
	end
	-- Every move the lesson asks for must have been seen recently (basic jumps aren't reported).
	local seen = recent[player] or {}
	for _, step in lesson.Steps do
		local wanted = step.Chain or { step.Action }
		for _, action in wanted do
			if action and action ~= "Jump" and action ~= "Land" and os.clock() - (seen[action] or -math.huge) > 120 then
				return
			end
		end
	end
	profile.Lessons[lessonId] = os.time()
	ProgressionService.Grant(player, { XP = Progression.XP.Lesson, Credits = 20 }, nil, true)
	Notify.Send(player, {
		Kind = "Lesson",
		Title = "Lesson complete: " .. lesson.Name,
		XP = Progression.XP.Lesson,
		Credits = 20,
		Sound = "Unlock",
	})
	DataService.Push(player, "Lessons")
	DataService.MarkDirty(player)
	Events.Lesson:Fire(player, lessonId)
end

local function onReset(player: Player, lessonId: any)
	local zone = type(lessonId) == "string" and zones[lessonId]
	if not zone then
		return
	end
	local spawn = zone:GetAttribute("Spawn")
	if typeof(spawn) == "CFrame" and MovementGuard.WasNear(player, zone.Position, zone.Size.Magnitude / 2 + 40, 3) then
		MovementGuard.AllowTeleport(player, spawn.Position, 15)
	end
end

function LessonService.Start()
	for _, lesson in Lessons.List do
		byId[lesson.Id] = lesson
	end
	for _, part in CollectionService:GetTagged(Tags.LessonZone) do
		if part:IsA("BasePart") then
			local id = part:GetAttribute("LessonId")
			if type(id) == "string" then
				zones[id] = part
			end
		end
	end
	Events.Action:Connect(function(player: Player, action: string)
		local seen = recent[player]
		if not seen then
			seen = {}
			recent[player] = seen
		end
		seen[action] = os.clock()
	end)
	Players.PlayerRemoving:Connect(function(player)
		recent[player] = nil
	end)
	Net.On("Lesson.Complete", onComplete)
	Net.On("Lesson.Reset", onReset)
end

return LessonService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">MasteryService</string>
            <string name="Source"><![CDATA[-- Technique mastery: points from validated moves (capped per minute so
-- spamming doesn't work) plus proficiency challenges that gate each tier.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Courses = require(ReplicatedStorage.Shared.Config.Courses)
local Mastery = require(ReplicatedStorage.Shared.Config.Mastery)
local Stats = require(ReplicatedStorage.Shared.Logic.Stats)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local Notify = require(script.Parent.Notify)
local ProgressionService = require(script.Parent.ProgressionService)

local MasteryService = {}

-- Items granted at tier 3 (Expert) for some categories; Grandmaster gives a title.
local EXPERT_ITEMS = {
	Climbing = "gloves_climber",
	Grappling = "gloves_hook",
	WallRunning = "shoes_wall",
	PrecisionLanding = "land_precision",
}

-- Which categories each action feeds.
local actionCategories: { [string]: { { Id: string, Points: number } } } = {}
for _, category in Mastery.Categories do
	for action, points in category.Actions do
		local list = actionCategories[action]
		if not list then
			list = {}
			actionCategories[action] = list
		end
		table.insert(list, { Id = category.Id, Points = points })
	end
end

type Budget = { Window: number, Used: { [string]: number } }
local budgets: { [Player]: Budget } = {}
local streaks: { [Player]: { [string]: number } } = {}

local function tiersOf(profile: any): { [string]: number }
	return Stats.MasteryTiers(profile)
end

local function settle(player: Player, before: { [string]: number })
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local after = tiersOf(profile)
	for _, category in Mastery.Categories do
		local old, new = before[category.Id] or 0, after[category.Id] or 0
		for tier = old + 1, new do
			local reward = Mastery.TierRewards[tier]
			local items = {}
			if tier == 3 and EXPERT_ITEMS[category.Id] then
				table.insert(items, EXPERT_ITEMS[category.Id])
			end
			if tier == 5 then
				table.insert(items, "title_master_" .. string.lower(category.Id))
			end
			ProgressionService.Grant(player, {
				XP = reward.XP,
				Credits = reward.Credits,
				Prestige = reward.Prestige,
				Items = items,
			}, nil, true)
			Notify.Send(player, {
				Kind = "Mastery",
				Title = ("%s: %s"):format(category.Name, Mastery.TierNames[tier]),
				Text = category.Blurb,
				Color = category.Color,
				XP = reward.XP,
				Credits = reward.Credits,
				Prestige = reward.Prestige,
				Sound = "Mastery",
			})
			Events.MasteryTier:Fire(player, category.Id, tier)
		end
	end
	DataService.Push(player, "Mastery")
end

local function addPoints(player: Player, categoryId: string, action: string, points: number)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local budget = budgets[player]
	local now = os.clock()
	if not budget or now - budget.Window > 60 then
		budget = { Window = now, Used = {} }
		budgets[player] = budget
	end
	local key = categoryId .. ":" .. action
	local used = budget.Used[key] or 0
	local allowed = math.max(0, math.min(points, Mastery.PointsPerMinuteCap - used))
	if allowed <= 0 then
		return
	end
	budget.Used[key] = used + allowed
	profile.Mastery.Points[categoryId] = (profile.Mastery.Points[categoryId] or 0) + allowed
end

local function complete(player: Player, challengeId: string)
	local profile = DataService.Get(player)
	if not profile or profile.Mastery.Challenges[challengeId] then
		return
	end
	local challenge = Mastery.ChallengeById[challengeId]
	profile.Mastery.Challenges[challengeId] = true
	Notify.Send(player, {
		Kind = "Toast",
		Title = "Challenge complete: " .. challenge.Name,
		Text = challenge.Text,
		Icon = Mastery.ById[challenge.Category].Icon,
		Sound = "Challenge",
	})
end

-- Is `needle` a subsequence (in order) of `haystack`?
local function containsInOrder(haystack: { string }, needle: { string }): boolean
	local index = 1
	for _, action in haystack do
		if action == needle[index] then
			index += 1
			if index > #needle then
				return true
			end
		end
	end
	return false
end

local function onAction(player: Player, action: string, value: number?)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local before = tiersOf(profile)
	for _, entry in actionCategories[action] or ({} :: { { Id: string, Points: number } }) do
		addPoints(player, entry.Id, action, entry.Points)
	end
	local playerStreaks = streaks[player]
	if not playerStreaks then
		playerStreaks = {}
		streaks[player] = playerStreaks
	end
	for _, challenge in Mastery.Challenges do
		if not profile.Mastery.Challenges[challenge.Id] then
			if challenge.Kind == "Count" and challenge.Action == action then
				if (profile.Stats[action] or 0) >= (challenge.Count or 1) then
					complete(player, challenge.Id)
				end
			elseif challenge.Kind == "Feat" and challenge.Action == action then
				if value and value >= (challenge.Value or math.huge) then
					complete(player, challenge.Id)
				end
			elseif challenge.Kind == "Streak" and challenge.Action == action then
				playerStreaks[challenge.Id] = (playerStreaks[challenge.Id] or 0) + 1
				if playerStreaks[challenge.Id] >= (challenge.Count or 1) then
					complete(player, challenge.Id)
				end
			end
		end
	end
	settle(player, before)
end

local function onBreak(player: Player, breaker: string)
	local playerStreaks = streaks[player]
	if not playerStreaks then
		return
	end
	for _, challenge in Mastery.Challenges do
		if challenge.Kind == "Streak" and challenge.Breaks and table.find(challenge.Breaks, breaker) then
			playerStreaks[challenge.Id] = 0
		end
	end
end

local function onChain(player: Player, actions: { string })
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local before = tiersOf(profile)
	local variety = {}
	local distinct = 0
	for _, action in actions do
		if not variety[action] then
			variety[action] = true
			distinct += 1
		end
	end
	for _, challenge in Mastery.Challenges do
		if not profile.Mastery.Challenges[challenge.Id] then
			if challenge.Kind == "Chain" and challenge.Actions and containsInOrder(actions, challenge.Actions) then
				complete(player, challenge.Id)
			elseif challenge.Kind == "ChainLength" and #actions >= (challenge.Count or math.huge) then
				complete(player, challenge.Id)
			elseif challenge.Kind == "ChainVariety" and distinct >= (challenge.Count or math.huge) then
				complete(player, challenge.Id)
			end
		end
	end
	settle(player, before)
end

local function onChainEnded(player: Player, length: number, variety: number)
	local profile = DataService.Get(player)
	if not profile or length < 3 then
		return
	end
	local before = tiersOf(profile)
	addPoints(player, "FlowChains", "Chain", math.floor(length * (1 + variety * 0.5)))
	settle(player, before)
end

local function onCourseFinished(player: Player)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local before = tiersOf(profile)
	for _, challenge in Mastery.Challenges do
		if challenge.Kind == "Medal" and not profile.Mastery.Challenges[challenge.Id] then
			local n = 0
			for id, record in profile.Courses do
				local course = Courses.ById[id]
				if
					course
					and (record.Medal or 0) >= (challenge.Medal or 1)
					and table.find(course.Focus, challenge.Focus)
				then
					n += 1
				end
			end
			if n >= (challenge.Count or 1) then
				complete(player, challenge.Id)
			end
		end
	end
	settle(player, before)
end

function MasteryService.Start()
	Events.Action:Connect(onAction)
	Events.Break:Connect(onBreak)
	Events.Chain:Connect(onChain)
	Events.ChainEnded:Connect(onChainEnded)
	Events.CourseFinished:Connect(onCourseFinished)
	Players.PlayerRemoving:Connect(function(player)
		budgets[player] = nil
		streaks[player] = nil
	end)
end

return MasteryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">MovementGuard</string>
            <string name="Source"><![CDATA[-- Server-side movement relay and validation.
--
-- Movement is simulated on each player's own client for responsiveness. The
-- server relays it to everyone else for animation and only counts what it can
-- check: every reported technique must be plausible where the character
-- actually is (a wall run needs a wall nearby, a grapple needs an anchor in
-- range, double jumps need the ability...). Positions are sampled to catch
-- impossible speeds, and every teleport must have been announced first.
--
-- Validated actions feed flow chains, mastery, quests, dailies and
-- achievements through Events.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Abilities = require(ReplicatedStorage.Shared.Config.Abilities)
local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Flow = require(ReplicatedStorage.Shared.Config.Flow)
local GhostCodec = require(ReplicatedStorage.Shared.Logic.GhostCodec)
local MathUtil = require(ReplicatedStorage.Shared.Util.MathUtil)
local MovementConfig = require(ReplicatedStorage.Shared.Config.Movement)
local Net = require(ReplicatedStorage.Shared.Net)
local Tags = require(ReplicatedStorage.Shared.Tags)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local ProgressionService = require(script.Parent.ProgressionService)

local SAMPLE_INTERVAL = 0.2
local HISTORY_SECONDS = 120
local MAX_PLAUSIBLE_SPEED = MovementConfig.MaxSpeed * 1.5 + 40
local MAX_FALL_SPEED = MovementConfig.MaxFallSpeed * 1.4 + 40

local MovementGuard = {}

type Sample = { T: number, P: Vector3 }
type Chain = { Actions: { string }, Last: number, Seen: { [string]: boolean }, Variety: number }
type PlayerState = {
	Samples: { Sample },
	Allowance: { Position: Vector3, Radius: number, Expires: number }?,
	Strikes: { number },
	Chain: Chain,
	District: string?,
}

local states: { [Player]: PlayerState } = {}

-- Every action the client may report, the ability it needs, and its check.
local VALID_ACTIONS: { [string]: { Ability: string?, Check: string? } } = {
	Jump = {},
	Land = {},
	Vault = { Ability = "Vault", Check = "Geometry" },
	Mantle = { Ability = "LedgeGrab", Check = "Geometry" },
	LedgeGrab = { Ability = "LedgeGrab", Check = "Geometry" },
	LedgeLeap = { Ability = "LedgeLeap", Check = "Geometry" },
	Slide = { Ability = "Slide" },
	SlideJump = { Ability = "Slide" },
	Climb = { Ability = "Climb", Check = "Climbable" },
	ClimbHop = { Ability = "Climb", Check = "Climbable" },
	WallRun = { Ability = "WallRun", Check = "Wall" },
	WallJump = { Ability = "WallJump", Check = "Wall" },
	WallKick = { Ability = "WallJump", Check = "Wall" },
	WallClimb = { Ability = "WallRun", Check = "Wall" },
	DoubleJump = { Ability = "DoubleJump" },
	Dash = { Ability = "Dash" },
	Grapple = { Ability = "Grapple", Check = "Anchor" },
	GrappleRelease = { Ability = "Grapple", Check = "Anchor" },
	Pull = { Ability = "GrapplePull", Check = "PullAnchor" },
	RopeSwing = { Ability = "RopeSwing", Check = "Rope" },
	Zipline = { Ability = "Zipline", Check = "Zipline" },
	Balance = { Ability = "Balance", Check = "Beam" },
	BalanceCatch = { Ability = "Balance", Check = "Beam" },
	Roll = { Ability = "Roll" },
	PrecisionLand = {},
	Bounce = { Check = "Bounce" },
	Launch = {},
	Stumble = {},
	Skid = {},
}

-- Moves that count toward stats/mastery (Jump/Land/Skid are too common to matter).
local COUNTED = {
	Vault = true,
	Mantle = true,
	LedgeGrab = true,
	LedgeLeap = true,
	Slide = true,
	SlideJump = true,
	Climb = true,
	ClimbHop = true,
	WallRun = true,
	WallJump = true,
	WallKick = true,
	WallClimb = true,
	DoubleJump = true,
	Dash = true,
	Grapple = true,
	Pull = true,
	RopeSwing = true,
	Zipline = true,
	Balance = true,
	BalanceCatch = true,
	Roll = true,
	PrecisionLand = true,
	Bounce = true,
}

local VALID_STATES = {}
for _, name in GhostCodec.States do
	VALID_STATES[name] = true
end

-- Tagged world objects, cached once the world is built.
local cache: { [string]: { BasePart } } = {}

local function tagged(tag: string): { BasePart }
	local list = cache[tag]
	if not list then
		list = {}
		for _, instance in CollectionService:GetTagged(tag) do
			if instance:IsA("BasePart") then
				table.insert(list, instance)
			end
		end
		cache[tag] = list
	end
	return list
end

function MovementGuard.RefreshCache()
	table.clear(cache)
end

local function nearTagged(tag: string, position: Vector3, range: number): boolean
	for _, part in tagged(tag) do
		if part.Parent then
			local offset = part.CFrame:PointToObjectSpace(position)
			local half = part.Size / 2
			local clamped = Vector3.new(
				math.clamp(offset.X, -half.X, half.X),
				math.clamp(offset.Y, -half.Y, half.Y),
				math.clamp(offset.Z, -half.Z, half.Z)
			)
			if (offset - clamped).Magnitude <= range then
				return true
			end
		end
	end
	return false
end

local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Exclude

local function nearWall(position: Vector3, character: Model): boolean
	wallParams.FilterDescendantsInstances = { character }
	for i = 0, 7 do
		local angle = i * math.pi / 4
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle)) * 7
		for _, dy in { 0, 1.5, -1.5 } do
			local hit = workspace:Raycast(position + Vector3.new(0, dy, 0), direction, wallParams)
			if hit and math.abs(hit.Normal.Y) < 0.45 then
				return true
			end
		end
	end
	return false
end

local function nearGeometry(position: Vector3, character: Model): boolean
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local parts = workspace:GetPartBoundsInRadius(position, 8, params)
	for _, part in parts do
		if part.CanCollide then
			return true
		end
	end
	return false
end

local function nearZipline(position: Vector3): boolean
	for _, part in tagged(Tags.Zipline) do
		local a, b = part:GetAttribute("A"), part:GetAttribute("B")
		if typeof(a) == "Vector3" and typeof(b) == "Vector3" then
			local closest = MathUtil.ClosestOnSegment(a, b, position)
			if (closest - position).Magnitude < 14 then
				return true
			end
		end
	end
	return false
end

local function nearRope(position: Vector3): boolean
	for _, part in tagged(Tags.SwingRope) do
		local pivot = part:GetAttribute("Pivot")
		local length = part:GetAttribute("Length")
		if typeof(pivot) == "Vector3" and type(length) == "number" then
			if (pivot - position).Magnitude < length + 18 then
				return true
			end
		end
	end
	return false
end

-- Positions the character has had in the last few seconds (latency tolerance).
local function recentPositions(state: PlayerState, seconds: number): { Vector3 }
	local now = os.clock()
	local result = {}
	for i = #state.Samples, 1, -1 do
		local sample = state.Samples[i]
		if now - sample.T > seconds then
			break
		end
		table.insert(result, sample.P)
	end
	return result
end

local function plausible(player: Player, state: PlayerState, check: string?): boolean
	if not check then
		return true
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not root then
		return false
	end
	local positions = recentPositions(state, 1.2)
	table.insert(positions, 1, root.Position)
	for _, position in positions do
		local ok = false
		if check == "Wall" then
			ok = nearWall(position, character)
		elseif check == "Geometry" then
			ok = nearGeometry(position, character)
		elseif check == "Climbable" then
			ok = nearTagged(Tags.Climbable, position, 9)
		elseif check == "Beam" then
			ok = nearTagged(Tags.Balance, position, 9)
		elseif check == "Anchor" then
			ok = nearTagged(Tags.GrappleAnchor, position, MovementConfig.GrappleRange + 40)
		elseif check == "PullAnchor" then
			ok = nearTagged(Tags.PullAnchor, position, MovementConfig.GrappleRange + 40)
		elseif check == "Zipline" then
			ok = nearZipline(position)
		elseif check == "Rope" then
			ok = nearRope(position)
		elseif check == "Bounce" then
			ok = nearTagged(Tags.BouncePad, position, 12)
		end
		if ok then
			return true
		end
	end
	return false
end

-- Chains --------------------------------------------------------------------------------

local function endChain(player: Player, state: PlayerState)
	local chain = state.Chain
	if #chain.Actions >= 2 then
		Events.ChainEnded:Fire(player, #chain.Actions, chain.Variety)
		local profile = DataService.Get(player)
		if profile and #chain.Actions > (profile.Stats.LongestChain or 0) then
			profile.Stats.LongestChain = #chain.Actions
			Events.StatChanged:Fire(player, "LongestChain")
		end
	end
	state.Chain = { Actions = {}, Last = 0, Seen = {}, Variety = 0 }
end

local function pushChain(player: Player, state: PlayerState, action: string)
	local now = os.clock()
	if now - state.Chain.Last > Flow.ChainGap then
		endChain(player, state)
	end
	local chain = state.Chain
	chain.Last = now
	if action == "Jump" or action == "Land" then
		return -- glue, not content
	end
	table.insert(chain.Actions, action)
	if #chain.Actions > 120 then
		table.remove(chain.Actions, 1)
	end
	if not chain.Seen[action] then
		chain.Seen[action] = true
		chain.Variety += 1
	end
	Events.Chain:Fire(player, chain.Actions)
end

function MovementGuard.CurrentChain(player: Player): { string }
	local state = states[player]
	return if state then state.Chain.Actions else {}
end

-- Teleports and sampling -------------------------------------------------------------------

-- Allow the next large jump in position if it lands near `position`.
function MovementGuard.AllowTeleport(player: Player, position: Vector3, radius: number?)
	local state = states[player]
	if state then
		state.Allowance = { Position = position, Radius = radius or 20, Expires = os.clock() + 4 }
	end
end

-- Whether the player was somewhere near `position` in the last two minutes.
function MovementGuard.VisitedRecently(player: Player, position: Vector3, radius: number): boolean
	local state = states[player]
	if not state then
		return false
	end
	for _, sample in state.Samples do
		if (sample.P - position).Magnitude <= radius then
			return true
		end
	end
	return false
end

-- Number of speed violations since `since` (os.clock time).
function MovementGuard.StrikesSince(player: Player, since: number): number
	local state = states[player]
	if not state then
		return 0
	end
	local n = 0
	for _, t in state.Strikes do
		if t >= since then
			n += 1
		end
	end
	return n
end

function MovementGuard.Position(player: Player): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return if root then root.Position else nil
end

-- Was the character within `radius` of `position` at any point in the last `seconds`?
function MovementGuard.WasNear(player: Player, position: Vector3, radius: number, seconds: number?): boolean
	local state = states[player]
	local current = MovementGuard.Position(player)
	if current and (current - position).Magnitude <= radius then
		return true
	end
	if not state then
		return false
	end
	for _, p in recentPositions(state, seconds or 1.5) do
		if (p - position).Magnitude <= radius then
			return true
		end
	end
	return false
end

function MovementGuard.District(player: Player): string?
	local state = states[player]
	return state and state.District
end

-- Called when the player enters a new district (set by DistrictService).
MovementGuard.OnDistrictChanged = nil :: ((Player, string) -> ())?

local function sample(player: Player, state: PlayerState)
	local position = MovementGuard.Position(player)
	if not position then
		return
	end
	local now = os.clock()
	local last = state.Samples[#state.Samples]
	if last then
		local dt = now - last.T
		local delta = position - last.P
		local horizontal = MathUtil.Flat(delta).Magnitude / math.max(dt, 0.05)
		local vertical = math.abs(delta.Y) / math.max(dt, 0.05)
		if horizontal > MAX_PLAUSIBLE_SPEED or vertical > MAX_FALL_SPEED then
			local allowance = state.Allowance
			if
				allowance
				and now < allowance.Expires
				and (position - allowance.Position).Magnitude <= allowance.Radius
			then
				state.Allowance = nil
			else
				table.insert(state.Strikes, now)
				if #state.Strikes > 50 then
					table.remove(state.Strikes, 1)
				end
			end
		end
	end
	table.insert(state.Samples, { T = now, P = position })
	while #state.Samples > 0 and now - state.Samples[1].T > HISTORY_SECONDS do
		table.remove(state.Samples, 1)
	end

	local district = Districts.At(position)
	local id = district and district.Id
	if id and id ~= state.District then
		state.District = id
		if MovementGuard.OnDistrictChanged then
			MovementGuard.OnDistrictChanged(player, id)
		end
	end
end

-- Remote handlers ----------------------------------------------------------------------------

local function onState(player: Player, stateName: any, aux: any, auxNumber: any)
	if type(stateName) ~= "string" or not VALID_STATES[stateName] then
		return
	end
	local character = player.Character
	if not character then
		return
	end
	character:SetAttribute("MS", stateName)
	character:SetAttribute("MA", if typeof(aux) == "Vector3" and aux.Magnitude < 1e5 then aux else nil)
	character:SetAttribute(
		"MB",
		if type(auxNumber) == "number" and auxNumber == auxNumber then math.clamp(auxNumber, -1e4, 1e4) else nil
	)
end

local function onAction(player: Player, action: any, value: any)
	local state = states[player]
	if not state or type(action) ~= "string" then
		return
	end
	local rule = VALID_ACTIONS[action]
	if not rule then
		return
	end
	if
		rule.Ability
		and not Abilities.IsBasic(rule.Ability)
		and not ProgressionService.HasAbility(player, rule.Ability)
	then
		return
	end
	if not plausible(player, state, rule.Check) then
		return
	end
	local number = if type(value) == "number" and value == value then math.clamp(value, 0, 1000) else nil
	-- Relay for animation and effects on other clients.
	Net.PushOthers(player, "Move.Action", player, action)

	if action == "Stumble" then
		Events.Break:Fire(player, "Stumble")
		endChain(player, state)
		return
	end
	pushChain(player, state, action)

	if COUNTED[action] then
		local profile = DataService.Get(player)
		if profile then
			profile.Stats[action] = (profile.Stats[action] or 0) + 1
			DataService.MarkDirty(player)
		end
		Events.Action:Fire(player, action, number, state.District)
		Events.StatChanged:Fire(player, action)
	elseif action == "GrappleRelease" then
		Events.Action:Fire(player, action, number, state.District)
	end
end

local function onFall(player: Player, reason: any, target: any)
	local state = states[player]
	if not state then
		return
	end
	endChain(player, state)
	Events.Break:Fire(player, if type(reason) == "string" then reason else "Fall")
	-- Respawning to a recent safe spot is a legitimate teleport.
	if typeof(target) == "Vector3" and MovementGuard.VisitedRecently(player, target, 12) then
		MovementGuard.AllowTeleport(player, target, 15)
	end
end

local function onFlow(player: Player, tier: any)
	local state = states[player]
	if not state or type(tier) ~= "number" then
		return
	end
	tier = math.clamp(math.floor(tier), 0, #Flow.Tiers)
	-- A tier needs a real chain behind it.
	if #state.Chain.Actions < tier * 2 or state.Chain.Variety < math.min(tier, 4) then
		return
	end
	local profile = DataService.Get(player)
	if profile and tier > (profile.Stats.BestFlowTier or 0) then
		profile.Stats.BestFlowTier = tier
		Events.StatChanged:Fire(player, "BestFlowTier")
	end
	Events.FlowTier:Fire(player, tier, state.District)
end

function MovementGuard.Start()
	Net.On("Move.State", onState)
	Net.On("Move.Action", onAction)
	Net.On("Move.Fall", onFall)
	Net.On("Move.Flow", onFlow)

	local function add(player: Player)
		states[player] = {
			Samples = {},
			Allowance = nil,
			Strikes = {},
			Chain = { Actions = {}, Last = 0, Seen = {}, Variety = 0 },
			District = nil,
		}
		player.CharacterAdded:Connect(function(character)
			local root = character:WaitForChild("HumanoidRootPart", 10)
			if root and states[player] then
				MovementGuard.AllowTeleport(player, (root :: BasePart).Position, 30)
			end
		end)
	end
	Players.PlayerAdded:Connect(add)
	for _, player in Players:GetPlayers() do
		add(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(SAMPLE_INTERVAL)
			for player, state in states do
				sample(player, state)
			end
		end
	end)
end

return MovementGuard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">NPCService</string>
            <string name="Source"><![CDATA[-- The people of Meridian: builds each character at their spot as an R6 rig
-- with a hand-made look (hair and hats from parts), a name card and a talk
-- prompt. Clients animate them (Animation/Animator) and run the dialogue.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NPCs = require(ReplicatedStorage.Shared.Config.NPCs)
local Tags = require(ReplicatedStorage.Shared.Tags)

local NPCService = {}

NPCService.Spots = {} :: { [string]: CFrame }

local folder: Folder

local function weld(part: BasePart, to: BasePart, offset: CFrame)
	part.CFrame = to.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = part
	w.Parent = part
end

local function piece(
	model: Model,
	head: BasePart,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part
	local part = Instance.new("Part")
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Shape = shape or Enum.PartType.Block
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CollisionGroup = Tags.Groups.Cosmetic
	weld(part, head, offset)
	part.Parent = model
	return part
end

local function dress(model: Model, npc: NPCs.NPC)
	local head = model:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local look = npc.Look
	local hair = look.Hair
	local hat = look.Hat or "None"
	-- Hair cap (skipped under full hoods/helmets).
	if hat ~= "Hood" and hat ~= "Hardhat" and hat ~= "Wrap" and hat ~= "Fur" then
		piece(model, head, Vector3.new(2.1, 0.5, 1.15), CFrame.new(0, 0.55, 0.05), hair, Enum.Material.Fabric)
		piece(model, head, Vector3.new(2.1, 0.9, 0.3), CFrame.new(0, 0.2, 0.5), hair, Enum.Material.Fabric)
	end
	local accent = look.Shirt
	if hat == "Cap" then
		piece(model, head, Vector3.new(2.15, 0.45, 1.2), CFrame.new(0, 0.75, 0), accent)
		piece(model, head, Vector3.new(1.4, 0.12, 0.8), CFrame.new(0, 0.6, -0.85), accent)
	elseif hat == "Bun" then
		piece(
			model,
			head,
			Vector3.new(0.8, 0.8, 0.8),
			CFrame.new(0, 0.7, 0.55),
			hair,
			Enum.Material.Fabric,
			Enum.PartType.Ball
		)
	elseif hat == "Beanie" then
		piece(model, head, Vector3.new(2.2, 0.7, 1.25), CFrame.new(0, 0.8, 0), accent, Enum.Material.Fabric)
	elseif hat == "Hood" then
		piece(model, head, Vector3.new(2.3, 1.4, 1.35), CFrame.new(0, 0.35, 0.12), accent, Enum.Material.Fabric)
	elseif hat == "Hardhat" then
		piece(model, head, Vector3.new(2.3, 0.6, 1.4), CFrame.new(0, 0.8, 0), Color3.fromRGB(240, 196, 40))
		piece(model, head, Vector3.new(2.6, 0.1, 1.7), CFrame.new(0, 0.55, 0), Color3.fromRGB(240, 196, 40))
	elseif hat == "Goggles" or hat == "Glasses" or hat == "Shades" or hat == "Visor" then
		local color = if hat == "Shades"
			then Color3.fromRGB(20, 20, 24)
			elseif hat == "Visor" then Color3.fromRGB(120, 230, 255)
			else Color3.fromRGB(60, 60, 70)
		piece(
			model,
			head,
			Vector3.new(1.9, 0.35, 0.15),
			CFrame.new(0, 0.15, -0.6),
			color,
			if hat == "Visor" then Enum.Material.Neon else Enum.Material.Glass
		)
		if hat == "Goggles" then
			piece(
				model,
				head,
				Vector3.new(2.15, 0.2, 1.25),
				CFrame.new(0, 0.15, 0),
				Color3.fromRGB(80, 60, 40),
				Enum.Material.Leather
			)
		end
	elseif hat == "Crown" then
		piece(
			model,
			head,
			Vector3.new(1.6, 0.4, 1.0),
			CFrame.new(0, 0.9, 0),
			Color3.fromRGB(255, 205, 70),
			Enum.Material.Neon
		)
	elseif hat == "Halo" then
		local ring = piece(
			model,
			head,
			Vector3.new(0.12, 1.6, 1.6),
			CFrame.new(0, 1.3, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color3.fromRGB(255, 235, 150),
			Enum.Material.Neon,
			Enum.PartType.Cylinder
		)
		ring.Transparency = 0.2
	elseif hat == "Antenna" then
		piece(
			model,
			head,
			Vector3.new(0.1, 1.2, 0.1),
			CFrame.new(0.5, 1.1, 0),
			Color3.fromRGB(60, 60, 70),
			Enum.Material.Metal
		)
		piece(
			model,
			head,
			Vector3.new(0.3, 0.3, 0.3),
			CFrame.new(0.5, 1.75, 0),
			Color3.fromRGB(255, 80, 80),
			Enum.Material.Neon,
			Enum.PartType.Ball
		)
	elseif hat == "Bandana" or hat == "Wrap" then
		piece(
			model,
			head,
			Vector3.new(2.15, if hat == "Wrap" then 1.0 else 0.35, 1.2),
			CFrame.new(0, if hat == "Wrap" then 0.5 else 0.45, 0),
			accent,
			Enum.Material.Fabric
		)
	elseif hat == "Straw" or hat == "Ranger" then
		local color = if hat == "Straw" then Color3.fromRGB(225, 196, 120) else Color3.fromRGB(120, 90, 60)
		piece(
			model,
			head,
			Vector3.new(0.15, 3.2, 3.2),
			CFrame.new(0, 0.62, 0) * CFrame.Angles(0, 0, math.rad(90)),
			color,
			Enum.Material.Fabric,
			Enum.PartType.Cylinder
		)
		piece(
			model,
			head,
			Vector3.new(0.8, 1.6, 1.6),
			CFrame.new(0, 0.95, 0) * CFrame.Angles(0, 0, math.rad(90)),
			color,
			Enum.Material.Fabric,
			Enum.PartType.Cylinder
		)
	elseif hat == "Fur" then
		piece(
			model,
			head,
			Vector3.new(2.4, 1.0, 1.45),
			CFrame.new(0, 0.6, 0.05),
			Color3.fromRGB(150, 120, 90),
			Enum.Material.Fabric
		)
	elseif hat == "Headset" then
		piece(
			model,
			head,
			Vector3.new(2.3, 0.15, 0.3),
			CFrame.new(0, 0.85, 0),
			Color3.fromRGB(40, 40, 46),
			Enum.Material.Metal
		)
		for _, x in { -1.1, 1.1 } do
			piece(
				model,
				head,
				Vector3.new(0.3, 0.6, 0.6),
				CFrame.new(x, 0, 0),
				Color3.fromRGB(40, 40, 46),
				Enum.Material.Metal
			)
		end
	elseif hat == "Leaves" then
		for i = 1, 5 do
			local angle = i * math.pi * 2 / 5
			piece(
				model,
				head,
				Vector3.new(0.6, 0.15, 0.9),
				CFrame.new(math.cos(angle) * 0.6, 0.8, math.sin(angle) * 0.5) * CFrame.Angles(0, angle, math.rad(20)),
				Color3.fromRGB(100, 170, 70),
				Enum.Material.Grass
			)
		end
	end
end

local function build(npc: NPCs.NPC, spot: CFrame)
	local description = Instance.new("HumanoidDescription")
	local look = npc.Look
	description.HeadColor = look.Skin
	description.LeftArmColor = look.Shirt
	description.RightArmColor = look.Shirt
	description.TorsoColor = look.Shirt
	description.LeftLegColor = look.Pants
	description.RightLegColor = look.Pants
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R6)
	end)
	if not ok or not model then
		warn("[NPC] Could not build " .. npc.Id .. ": " .. tostring(model))
		return
	end
	model.Name = npc.Id
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		humanoid.BreakJointsOnDeath = false
	end
	-- NPCs never block runners or cameras.
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CollisionGroup = Tags.Groups.Cosmetic
			part.CanQuery = false
		end
	end
	dress(model, npc)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		root.Anchored = true
	end
	model:PivotTo(spot + Vector3.new(0, 3, 0))

	-- Name card.
	local head = model:FindFirstChild("Head") :: BasePart?
	if head then
		local gui = Instance.new("BillboardGui")
		gui.Name = "NameCard"
		gui.Size = UDim2.fromOffset(220, 52)
		gui.StudsOffset = Vector3.new(0, 2.6, 0)
		gui.MaxDistance = 70
		gui.LightInfluence = 0
		gui.Parent = head
		local name = Instance.new("TextLabel")
		name.Size = UDim2.new(1, 0, 0.58, 0)
		name.BackgroundTransparency = 1
		name.Font = Enum.Font.GothamBold
		name.TextScaled = true
		name.TextColor3 = Color3.new(1, 1, 1)
		name.TextStrokeTransparency = 0.4
		name.Text = npc.Name
		name.Parent = gui
		local role = Instance.new("TextLabel")
		role.Size = UDim2.new(1, 0, 0.4, 0)
		role.Position = UDim2.fromScale(0, 0.6)
		role.BackgroundTransparency = 1
		role.Font = Enum.Font.Gotham
		role.TextScaled = true
		role.TextColor3 = Color3.fromRGB(255, 220, 150)
		role.TextStrokeTransparency = 0.5
		role.Text = npc.Role
		role.Parent = gui

		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "TalkPrompt"
		prompt.ActionText = "Talk"
		prompt.ObjectText = npc.Name
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("Npc", npc.Id)
		prompt.Parent = head
	end

	model:SetAttribute("Npc", npc.Id)
	model:SetAttribute("RigKind", "NPC")
	model:SetAttribute("MS", "Ground")
	if npc.Pose then
		model:SetAttribute("Emote", npc.Pose)
		model:SetAttribute("EmoteAt", 1)
	end
	CollectionService:AddTag(model, Tags.Rig)
	model.Parent = folder
end

function NPCService.Start()
	folder = Instance.new("Folder")
	folder.Name = "SkylineNPCs"
	folder.Parent = workspace
	local spots: { [string]: CFrame } = {}
	for _, part in CollectionService:GetTagged(Tags.NPCSpot) do
		if part:IsA("BasePart") then
			local id = part:GetAttribute("Id")
			if type(id) == "string" then
				spots[id] = part.CFrame
			end
		end
	end
	for _, npc in NPCs.List do
		local spot = spots[npc.Spot]
		if spot then
			NPCService.Spots[npc.Id] = spot
			task.spawn(build, npc, spot)
		else
			warn("[NPC] No spot for " .. npc.Id .. " (" .. npc.Spot .. ")")
		end
	end
end

return NPCService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Notify</string>
            <string name="Source"><![CDATA[-- Player-facing notifications (toasts, banners, unlock cards).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local Notify = {}

export type Payload = {
	Kind: string, -- Toast | LevelUp | Rank | Ability | Item | Achievement | Mastery | Quest | Reward | Discovery | Warning | Unlock
	Title: string,
	Text: string?,
	Icon: string?,
	Color: Color3?,
	XP: number?,
	Credits: number?,
	Prestige: number?,
	Item: string?,
	Sound: string?,
}

function Notify.Send(player: Player, payload: Payload)
	Net.Push(player, "Notify", payload)
end

function Notify.Toast(player: Player, title: string, text: string?, icon: string?)
	Net.Push(player, "Notify", { Kind = "Toast", Title = title, Text = text, Icon = icon })
end

function Notify.Warn(player: Player, text: string)
	Net.Push(player, "Notify", { Kind = "Warning", Title = text })
end

return Notify
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[-- Characters: R6 spawning (keeping each player's avatar look), collision
-- groups, nametags with rank, title and crew tag, and spawn locations.
--
-- Falls never kill: clients respawn themselves at their checkpoint or last
-- safe rooftop. A character only dies if the player resets, and then it
-- respawns at the plaza of the district they were in.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Cosmetics = require(ReplicatedStorage.Shared.Config.Cosmetics)
local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Tags = require(ReplicatedStorage.Shared.Tags)

local DataService = require(script.Parent.Parent.Data.DataService)

local PlayerService = {}

-- District spawn CFrames, registered by the world builder.
PlayerService.Spawns = {} :: { [string]: CFrame }
-- Called with each new character (set by other services).
PlayerService.CharacterAdded = {} :: { (Player, Model) -> () }

local descriptions: { [Player]: HumanoidDescription } = {}

local function getDescription(player: Player): HumanoidDescription
	local cached = descriptions[player]
	if cached then
		return cached:Clone()
	end
	local description: HumanoidDescription? = nil
	if player.UserId > 0 then
		local ok, result = pcall(function()
			return Players:GetHumanoidDescriptionFromUserId(player.UserId)
		end)
		if ok then
			description = result
		end
	end
	if not description then
		-- Studio test players get a tidy default runner.
		local fallback = Instance.new("HumanoidDescription")
		fallback.HeadColor = Color3.fromRGB(234, 184, 146)
		fallback.TorsoColor = Color3.fromRGB(70, 110, 140)
		fallback.LeftArmColor = Color3.fromRGB(234, 184, 146)
		fallback.RightArmColor = Color3.fromRGB(234, 184, 146)
		fallback.LeftLegColor = Color3.fromRGB(40, 44, 52)
		fallback.RightLegColor = Color3.fromRGB(40, 44, 52)
		description = fallback
	end
	descriptions[player] = description :: HumanoidDescription
	return (description :: HumanoidDescription):Clone()
end

function PlayerService.SpawnFor(player: Player): CFrame
	local profile = DataService.Get(player)
	local last = if profile then profile.Districts.Last else "Hub"
	if profile and last == "Hub" and not profile.Flags.Graduated then
		-- New runners start in the Training Yard.
		return PlayerService.Spawns.Training or PlayerService.Spawns.Hub or CFrame.new(Districts.ById.Hub.Origin)
	end
	return PlayerService.Spawns[last]
		or PlayerService.Spawns.Hub
		or CFrame.new(Districts.ById.Hub.Origin + Vector3.new(0, 5, 0))
end

-- Nametag ------------------------------------------------------------------------

local function buildNametag(player: Player, character: Model)
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "SkylineNametag"
	gui.Size = UDim2.fromOffset(220, 58)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 2.6, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	gui.Adornee = head
	gui.ResetOnSpawn = false

	local name = Instance.new("TextLabel")
	name.Name = "PlayerName"
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0, 24)
	name.Font = Enum.Font.GothamBold
	name.TextSize = 18
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.5
	name.Parent = gui

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(0, 24)
	title.Size = UDim2.new(1, 0, 0, 18)
	title.Font = Enum.Font.GothamMedium
	title.TextSize = 14
	title.TextStrokeTransparency = 0.6
	title.Parent = gui

	local function refresh()
		local crew = player:GetAttribute("CrewTag")
		local prefix = if type(crew) == "string" and crew ~= "" then "[" .. crew .. "] " else ""
		name.Text = prefix .. player.DisplayName
		local level = player:GetAttribute("Level") or 1
		local equippedTitle = player:GetAttribute("Title")
		local rank = player:GetAttribute("Rank") or "Newcomer"
		local label = if type(equippedTitle) == "string" and equippedTitle ~= "" then equippedTitle else rank
		title.Text = ("Lv %d  ·  %s"):format(level, label)
		local color = player:GetAttribute("RankColor")
		title.TextColor3 = if typeof(color) == "Color3" then color else Color3.fromRGB(200, 205, 215)
	end
	refresh()
	for _, attribute in { "Level", "Rank", "Title", "CrewTag", "RankColor" } do
		player:GetAttributeChangedSignal(attribute):Connect(refresh)
	end
	gui.Parent = head
end

-- Spawning ----------------------------------------------------------------------------

local function setCollisionGroups(character: Model)
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") then
			part.CollisionGroup = Tags.Groups.Players
		end
	end
	character.DescendantAdded:Connect(function(part)
		if part:IsA("BasePart") and part.CollisionGroup == Tags.Groups.World then
			part.CollisionGroup = Tags.Groups.Players
		end
	end)
end

local function spawnCharacter(player: Player)
	if not player.Parent then
		return
	end
	if player.Character then
		player.Character:Destroy()
	end
	local character = Players:CreateHumanoidModelFromDescription(getDescription(player), Enum.HumanoidRigType.R6)
	character.Name = player.Name
	local animate = character:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayName = player.DisplayName
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.UseJumpPower = true

	setCollisionGroups(character)
	buildNametag(player, character)

	local spawnCFrame = PlayerService.SpawnFor(player)
	local offset = Vector3.new(math.random(-3, 3), 3.5, math.random(-3, 3))
	character:PivotTo(spawnCFrame + offset)
	player.Character = character
	character.Parent = workspace

	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart
	root:SetNetworkOwner(player)

	for _, callback in PlayerService.CharacterAdded do
		task.spawn(callback, player, character)
	end

	local respawning = false
	local function respawn()
		if respawning then
			return
		end
		respawning = true
		task.wait(2)
		if player.Parent and player.Character == character then
			spawnCharacter(player)
		end
	end
	humanoid.Died:Connect(respawn)
	root.AncestryChanged:Connect(function()
		if not root:IsDescendantOf(workspace) then
			task.spawn(respawn)
		end
	end)
end

function PlayerService.Respawn(player: Player)
	task.spawn(spawnCharacter, player)
end

local function onPlayerAdded(player: Player)
	-- Wait for the profile so we spawn in the right district.
	DataService.Await(player, 20)
	if player.Parent then
		spawnCharacter(player)
	end
end

function PlayerService.Start()
	Players.CharacterAutoLoads = false
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		descriptions[player] = nil
	end)
	-- Keep the equipped title attribute in sync for nametags.
	DataService.Loaded:Connect(function(player, profile)
		local item = Cosmetics.ById[profile.Equipped.Title or ""]
		player:SetAttribute("Title", if item and item.Text and item.Text ~= "" then item.Text else nil)
	end)
end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[-- Experience, levels, reputation ranks, skill points, the skill tree and
-- ability unlocks.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Abilities = require(ReplicatedStorage.Shared.Config.Abilities)
local Leveling = require(ReplicatedStorage.Shared.Logic.Leveling)
local MoveStats = require(ReplicatedStorage.Shared.Logic.MoveStats)
local Net = require(ReplicatedStorage.Shared.Net)
local Progression = require(ReplicatedStorage.Shared.Config.Progression)
local SkillTree = require(ReplicatedStorage.Shared.Config.SkillTree)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local Notify = require(script.Parent.Notify)

local ProgressionService = {}

-- Set by EconomyService to avoid a require cycle.
ProgressionService.AddCredits = nil :: ((Player, number, string?) -> ())?
ProgressionService.AddPrestige = nil :: ((Player, number, string?) -> ())?
ProgressionService.GrantItem = nil :: ((Player, string, boolean?) -> ())?

function ProgressionService.Level(player: Player): number
	local profile = DataService.Get(player)
	if not profile then
		return 1
	end
	return (Leveling.FromXP(profile.XP))
end

-- Abilities lent for the duration of a mode (ranked kits, Spire floors, Dreamline lanes).
local temporary: { [Player]: { [string]: boolean } } = {}

function ProgressionService.Abilities(player: Player): { [string]: boolean }
	local set = Abilities.ForLevel(ProgressionService.Level(player))
	local extra = temporary[player]
	if extra then
		for id, on in extra do
			if on then
				set[id] = true
			end
		end
	end
	return set
end

-- Lend abilities (or clear the loan with nil). The client is told so its movement matches.
function ProgressionService.SetTemporary(player: Player, set: { [string]: boolean }?)
	temporary[player] = set :: any
	Net.Push(player, "Abilities.Temp", set)
end

function ProgressionService.HasAbility(player: Player, id: string): boolean
	return ProgressionService.Abilities(player)[id] == true
end

function ProgressionService.Perks(player: Player): { [string]: number }
	local profile = DataService.Get(player)
	local _, perks = MoveStats.Compute(if profile then profile.Skills else nil, true, nil)
	return perks
end

function ProgressionService.FreePoints(player: Player): number
	local profile = DataService.Get(player)
	if not profile then
		return 0
	end
	local level = ProgressionService.Level(player)
	return Leveling.SkillPoints(level) - SkillTree.SpentPoints(profile.Skills)
end

local function updateAttributes(player: Player)
	local level = ProgressionService.Level(player)
	local rank = Progression.RankFor(level)
	player:SetAttribute("Level", level)
	player:SetAttribute("Rank", rank.Name)
	player:SetAttribute("RankColor", rank.Color)
end

local function onLevelUp(player: Player, oldLevel: number, newLevel: number)
	local credits = 0
	for level = oldLevel + 1, newLevel do
		credits += Progression.LevelCredits(level)
	end
	if ProgressionService.AddCredits then
		ProgressionService.AddCredits(player, credits, "Level up")
	end
	local _, oldIndex = Progression.RankFor(oldLevel)
	local newRank, newIndex = Progression.RankFor(newLevel)
	Notify.Send(player, {
		Kind = "LevelUp",
		Title = ("Level %d"):format(newLevel),
		Text = ("+%d skill point%s"):format(
			Leveling.SkillPoints(newLevel) - Leveling.SkillPoints(oldLevel),
			if Leveling.SkillPoints(newLevel) - Leveling.SkillPoints(oldLevel) == 1 then "" else "s"
		),
		Credits = credits,
		Sound = "LevelUp",
	})
	if newIndex > oldIndex then
		Notify.Send(player, {
			Kind = "Rank",
			Title = newRank.Name,
			Text = newRank.Blurb,
			Color = newRank.Color,
			Sound = "Rank",
		})
	end
	for _, ability in Abilities.List do
		if ability.Level > oldLevel and ability.Level <= newLevel then
			Notify.Send(player, {
				Kind = "Ability",
				Title = ability.Name .. " unlocked",
				Text = (if ability.Gear then ability.Gear .. ": " else "") .. ability.Summary,
				Icon = ability.Icon,
				Sound = "Unlock",
			})
		end
	end
	updateAttributes(player)
	DataService.Push(player, "Skills")
	Events.LevelUp:Fire(player, newLevel, oldLevel)
	Events.StatChanged:Fire(player, "Level")
end

-- Add experience (XP bonus perks apply). Returns the amount actually added.
function ProgressionService.AddXP(player: Player, amount: number, _reason: string?): number
	local profile = DataService.Get(player)
	if not profile or amount <= 0 then
		return 0
	end
	local bonus = ProgressionService.Perks(player).XPBonus or 0
	local gained = math.floor(amount * (1 + bonus) + 0.5)
	local oldLevel = (Leveling.FromXP(profile.XP))
	profile.XP += gained
	local newLevel = (Leveling.FromXP(profile.XP))
	DataService.Push(player, "XP")
	if newLevel > oldLevel then
		onLevelUp(player, oldLevel, newLevel)
	end
	return gained
end

-- Give a reward bundle: { XP, Credits, Prestige, Items }.
function ProgressionService.Grant(player: Player, rewards: { [string]: any }, reason: string?, silent: boolean?)
	local xp = 0
	if rewards.XP and rewards.XP > 0 then
		xp = ProgressionService.AddXP(player, rewards.XP, reason)
	end
	if rewards.Credits and rewards.Credits > 0 and ProgressionService.AddCredits then
		ProgressionService.AddCredits(player, rewards.Credits, reason)
	end
	if rewards.Prestige and rewards.Prestige > 0 and ProgressionService.AddPrestige then
		ProgressionService.AddPrestige(player, rewards.Prestige, reason)
	end
	for _, itemId in rewards.Items or {} do
		if ProgressionService.GrantItem then
			ProgressionService.GrantItem(player, itemId, false)
		end
	end
	if not silent and reason then
		Notify.Send(player, {
			Kind = "Reward",
			Title = reason,
			XP = xp,
			Credits = rewards.Credits,
			Prestige = rewards.Prestige,
		})
	end
end

function ProgressionService.Start()
	DataService.Loaded:Connect(function(player)
		updateAttributes(player)
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		temporary[player] = nil
	end)

	Net.Handle("Skill.Unlock", function(player, nodeId)
		local profile = DataService.Get(player)
		if not profile or type(nodeId) ~= "string" then
			return false, "Not ready"
		end
		local ok, reason = SkillTree.CanUnlock(profile.Skills, ProgressionService.FreePoints(player), nodeId)
		if not ok then
			return false, reason
		end
		profile.Skills[nodeId] = (profile.Skills[nodeId] or 0) + 1
		DataService.Push(player, "Skills")
		return true, nil
	end)

	Net.Handle("Skill.Respec", function(player)
		local profile = DataService.Get(player)
		if not profile then
			return false, "Not ready"
		end
		if next(profile.Skills) == nil then
			return false, "Nothing to refund"
		end
		if profile.Credits < SkillTree.RespecCost then
			return false, ("Needs %d credits"):format(SkillTree.RespecCost)
		end
		profile.Credits -= SkillTree.RespecCost
		profile.Skills = {}
		DataService.Push(player, "Credits")
		DataService.Push(player, "Skills")
		return true, nil
	end)
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[-- Quests: the main story, side quests and expert trials (Config/Quests), plus
-- daily objectives, weekly expeditions and district contracts.
--
-- Every step is checked against validated events (course finishes, moves the
-- movement guard accepted, discoveries, points the character was actually
-- near), never against what the client says it did.
--
-- Profile layout:
--   Quests    = { Active = { [id] = { Step, Progress, Started } }, Completed = { [id] = time }, Pinned = { id } }
--   Daily     = { Day, Picks = { id }, Progress = { [id] = n }, Done = { [id] = true }, Bonus }
--   Weekly    = { Week, Picks, Progress, Done, Seen }
--   Contracts = { Offers = { [district] = { offer } }, Active = contract?, Completed, Refresh }

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Courses = require(ReplicatedStorage.Shared.Config.Courses)
local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Net = require(ReplicatedStorage.Shared.Net)
local NPCs = require(ReplicatedStorage.Shared.Config.NPCs)
local Progression = require(ReplicatedStorage.Shared.Config.Progression)
local Quests = require(ReplicatedStorage.Shared.Config.Quests)
local Rotation = require(ReplicatedStorage.Shared.Logic.Rotation)
local Stats = require(ReplicatedStorage.Shared.Logic.Stats)
local Tags = require(ReplicatedStorage.Shared.Tags)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local MovementGuard = require(script.Parent.MovementGuard)
local Notify = require(script.Parent.Notify)
local ProgressionService = require(script.Parent.ProgressionService)

local QuestService = {}

local points: { [string]: Vector3 } = {}
local contractPoints: { [string]: { Id: string, Position: Vector3 } } = {}
local contractByDistrict: { [string]: { string } } = {}
local npcSpots: { [string]: Vector3 } = {}

-- Carried packages for deliveries: { [player] = { Quest, Fragile, Expires? } }
local carrying: { [Player]: { QuestId: string?, Contract: boolean?, Fragile: boolean, Expires: number? } } = {}

-- Helpers -------------------------------------------------------------------------------------

local function push(player: Player)
	DataService.Push(player, "Quests")
	DataService.MarkDirty(player)
end

local function district(player: Player): string?
	return MovementGuard.District(player)
end

local function available(profile: any, quest: Quests.Quest, level: number): boolean
	if profile.Quests.Completed[quest.Id] or profile.Quests.Active[quest.Id] then
		return false
	end
	local requires = quest.Requires or {}
	if requires.Level and level < requires.Level then
		return false
	end
	for _, id in requires.Quests or {} do
		if not profile.Quests.Completed[id] then
			return false
		end
	end
	return true
end

function QuestService.Available(player: Player): { string }
	local profile = DataService.Get(player)
	local result = {}
	if not profile then
		return result
	end
	local level = ProgressionService.Level(player)
	for _, quest in Quests.List do
		if available(profile, quest, level) then
			table.insert(result, quest.Id)
		end
	end
	return result
end

local function pin(profile: any, questId: string)
	local pinned = profile.Quests.Pinned
	if table.find(pinned, questId) then
		return
	end
	if #pinned >= Quests.MaxPinned then
		table.remove(pinned, #pinned)
	end
	table.insert(pinned, 1, questId)
end

local function unpin(profile: any, questId: string)
	local index = table.find(profile.Quests.Pinned, questId)
	if index then
		table.remove(profile.Quests.Pinned, index)
	end
end

-- Completion --------------------------------------------------------------------------------------

local checkStep: (Player, string) -> ()

local function completeQuest(player: Player, quest: Quests.Quest)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	profile.Quests.Active[quest.Id] = nil
	profile.Quests.Completed[quest.Id] = os.time()
	unpin(profile, quest.Id)
	if carrying[player] and carrying[player].QuestId == quest.Id then
		carrying[player] = nil
	end
	if quest.Id == "p_graduation" then
		profile.Flags.Graduated = true
	end
	ProgressionService.Grant(player, quest.Rewards, nil, true)
	Notify.Send(player, {
		Kind = "Quest",
		Title = "Quest complete: " .. quest.Name,
		Text = quest.Outro[1],
		XP = quest.Rewards.XP,
		Credits = quest.Rewards.Credits,
		Prestige = quest.Rewards.Prestige,
		Sound = "Quest",
	})
	-- Finishing a chapter's last main quest pays a chapter bonus.
	if quest.Type == "Main" and quest.Chapter then
		local done = true
		for _, other in Quests.List do
			if other.Type == "Main" and other.Chapter == quest.Chapter and not profile.Quests.Completed[other.Id] then
				done = false
				break
			end
		end
		if done and quest.Chapter > 0 then
			ProgressionService.Grant(player, { Prestige = Progression.Prestige.ChapterComplete }, nil, true)
			Notify.Send(player, {
				Kind = "Unlock",
				Title = (Quests.ChapterNames[quest.Chapter] or "Chapter") .. " complete",
				Prestige = Progression.Prestige.ChapterComplete,
				Sound = "Unlock",
			})
		end
	end
	push(player)
	Events.QuestCompleted:Fire(player, quest.Id, quest)
end

local function advance(player: Player, questId: string)
	local profile = DataService.Get(player)
	local quest = Quests.ById[questId]
	if not profile or not quest then
		return
	end
	local state = profile.Quests.Active[questId]
	if not state then
		return
	end
	state.Step += 1
	state.Progress = {}
	if state.Step > #quest.Steps then
		completeQuest(player, quest)
		return
	end
	push(player)
	Notify.Send(player, { Kind = "Objective", Title = quest.Name, Text = quest.Steps[state.Step].Text })
	-- Some steps may already be satisfied (lessons done, crew joined...).
	checkStep(player, questId)
end

local function currentStep(profile: any, questId: string): (Quests.Step?, any)
	local quest = Quests.ById[questId]
	local state = profile.Quests.Active[questId]
	if not quest or not state then
		return nil, nil
	end
	return quest.Steps[state.Step], state
end

local function countSet(t: { [any]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

-- Steps that depend on standing state rather than an event.
checkStep = function(player: Player, questId: string)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local step = currentStep(profile, questId)
	if not step then
		return
	end
	local kind = step.Kind
	if kind == "Lessons" then
		if countSet(profile.Lessons) >= (step.Count or 1) then
			advance(player, questId)
		end
	elseif kind == "Crew" then
		if profile.Crew then
			advance(player, questId)
		end
	elseif kind == "Mastery" then
		local reached = 0
		for _, tier in Stats.MasteryTiers(profile) do
			if tier >= (step.Tier or 1) then
				reached += 1
			end
		end
		if reached >= (step.Count or 1) then
			advance(player, questId)
		end
	elseif kind == "Tower" then
		if (profile.Tower.Highest or 0) >= (step.Floor or 1) then
			advance(player, questId)
		end
	elseif kind == "Course" then
		local record = profile.Courses[step.Course]
		-- A course already conquered to the required standard counts straight away
		-- (but not for no-fall / shortcut / flow conditions, which need a fresh run).
		if record and (record.Completions or 0) > 0 and (record.Medal or 0) >= (step.Medal or 0) then
			if not step.NoFalls and not step.Shortcut and not step.Flow then
				advance(player, questId)
			end
		end
	end
end

-- For each active quest whose current step is `kind`, call fn(step, state, questId).
local function forActive(player: Player, kind: string, fn: (any, any, string) -> boolean?)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local ids = {}
	for questId in profile.Quests.Active do
		table.insert(ids, questId)
	end
	for _, questId in ids do
		local step, state = currentStep(profile, questId)
		if step and state and step.Kind == kind then
			if fn(step, state, questId) then
				advance(player, questId)
			end
		end
	end
end

-- Dailies, weeklies and contracts ---------------------------------------------------------------

local function refreshDaily(player: Player, profile: any)
	local day = Rotation.Day()
	local daily = profile.Daily
	if daily.Day == day then
		return
	end
	daily.Day = day
	daily.Progress = {}
	daily.Done = {}
	daily.Bonus = false
	daily.Picks = {}
	local have = ProgressionService.Abilities(player)
	for tier = 1, 3 do
		local pool = {}
		for _, template in Quests.Daily do
			if template.Tier == tier and (not template.Needs or have[template.Needs]) then
				table.insert(pool, template.Id)
			end
		end
		local pick = Rotation.PickDistinct(pool, 1, Rotation.Hash(player.UserId, day, tier))
		if pick[1] then
			table.insert(daily.Picks, pick[1])
		end
	end
end

local function refreshWeekly(profile: any)
	local week = Rotation.Week()
	local weekly = profile.Weekly
	if weekly.Week == week then
		return
	end
	weekly.Week = week
	weekly.Progress = {}
	weekly.Done = {}
	weekly.Seen = {}
	local ids = {}
	for _, template in Quests.Weekly do
		table.insert(ids, template.Id)
	end
	-- The same three for everyone this week.
	weekly.Picks = Rotation.PickDistinct(ids, 3, Rotation.Hash("weekly", week))
end

local function templateById(list: { any }, id: string): any?
	for _, template in list do
		if template.Id == id then
			return template
		end
	end
	return nil
end

-- Add progress to every daily/weekly objective of `kind` that `filter` accepts.
local function objective(player: Player, kind: string, amount: number, filter: ((any) -> boolean)?, key: any?)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	refreshDaily(player, profile)
	refreshWeekly(profile)
	local changed = false
	for _, entry in
		{
			{ Data = profile.Daily, List = Quests.Daily, Kind = "Daily" },
			{ Data = profile.Weekly, List = Quests.Weekly, Kind = "Weekly" },
		}
	do
		local data = entry.Data
		for index, id in data.Picks do
			local template = templateById(entry.List, id)
			if template and template.Kind == kind and not data.Done[id] and (not filter or filter(template)) then
				local target = template.Count or 1
				if key ~= nil then
					-- Distinct-key objectives (e.g. different districts).
					local seen = data.Seen or {}
					data.Seen = seen
					local seenKey = id .. ":" .. tostring(key)
					if seen[seenKey] then
						continue
					end
					seen[seenKey] = true
				end
				data.Progress[id] = math.min((data.Progress[id] or 0) + amount, target)
				changed = true
				if data.Progress[id] >= target then
					data.Done[id] = true
					local reward = if entry.Kind == "Daily"
						then Quests.DailyRewards[template.Tier or index] or Quests.DailyRewards[1]
						else Quests.WeeklyReward
					ProgressionService.Grant(player, reward, nil, true)
					profile.Stats[if entry.Kind == "Daily" then "Dailies" else "Weeklies"] = (
						profile.Stats[if entry.Kind == "Daily" then "Dailies" else "Weeklies"] or 0
					) + 1
					Notify.Send(player, {
						Kind = "Quest",
						Title = (if entry.Kind == "Daily" then "Daily complete: " else "Expedition complete: ")
							.. template.Text,
						XP = reward.XP,
						Credits = reward.Credits,
						Prestige = reward.Prestige,
						Sound = "Quest",
					})
					Events.ObjectiveCompleted:Fire(player, entry.Kind)
					Events.StatChanged:Fire(player, if entry.Kind == "Daily" then "Dailies" else "Weeklies")
					if entry.Kind == "Daily" and not data.Bonus then
						local all = true
						for _, pick in data.Picks do
							if not data.Done[pick] then
								all = false
							end
						end
						if all then
							data.Bonus = true
							ProgressionService.Grant(player, Quests.DailyBonus, nil, true)
							Notify.Send(player, {
								Kind = "Reward",
								Title = "All dailies done!",
								XP = Quests.DailyBonus.XP,
								Credits = Quests.DailyBonus.Credits,
							})
						end
					end
				end
			end
		end
	end
	if changed then
		DataService.Push(player, "Daily")
		DataService.Push(player, "Weekly")
		DataService.MarkDirty(player)
	end
end

-- Contracts: three offers per district board, refreshed on a timer or when taken.
local function makeOffers(player: Player, profile: any, districtId: string): { any }
	local offers = {}
	local seed = Rotation.Hash(
		player.UserId,
		districtId,
		profile.Contracts.Completed or 0,
		math.floor(os.time() / Quests.ContractRefresh)
	)
	local rng = Rotation.Rng(seed)
	local spots = contractByDistrict[districtId] or {}
	local courses = Courses.Of(districtId, "Course")
	local difficulty = (Districts.ById[districtId] and Districts.ById[districtId].Order or 1)
	for slot = 1, 3 do
		local template = Quests.Contracts[((slot - 1) % #Quests.Contracts) + 1]
		local offer: { [string]: any } = { Kind = template.Kind, Name = template.Name, District = districtId }
		if template.Kind == "Delivery" and #spots >= 2 then
			local from = spots[rng:Int(1, #spots)]
			local to = from
			while to == from do
				to = spots[rng:Int(1, #spots)]
			end
			local distance = (contractPoints[from].Position - contractPoints[to].Position).Magnitude
			offer.From, offer.To = from, to
			offer.Time = math.floor(distance / 14 + 25)
			offer.Text = ("Carry a parcel across %s within %ds."):format(Districts.ById[districtId].Short, offer.Time)
		elseif template.Kind == "Relays" and #spots >= 3 then
			local picks = Rotation.PickDistinct(spots, 3, seed + slot)
			offer.Points = picks
			offer.Time = 90 + difficulty * 10
			offer.Text = ("Ping %d relay points within %ds."):format(#picks, offer.Time)
		elseif #courses > 0 then
			local course = courses[rng:Int(1, #courses)]
			offer.Kind = "Course"
			offer.Name = "Route Certification"
			offer.Course = course.Id
			offer.Medal = if rng:Next() < 0.6 then 2 else 3
			offer.Text = ("Earn %s or better on %s."):format(Courses.MedalNames[offer.Medal], course.Name)
		else
			continue
		end
		offer.Reward = { XP = 140 + difficulty * 40, Credits = 90 + difficulty * 30 }
		table.insert(offers, offer)
	end
	return offers
end

local function finishContract(player: Player, profile: any)
	local contract = profile.Contracts.Active
	if not contract then
		return
	end
	profile.Contracts.Active = nil
	profile.Contracts.Completed = (profile.Contracts.Completed or 0) + 1
	profile.Stats.Contracts = (profile.Stats.Contracts or 0) + 1
	if carrying[player] and carrying[player].Contract then
		carrying[player] = nil
	end
	ProgressionService.Grant(player, contract.Reward, nil, true)
	Notify.Send(player, {
		Kind = "Quest",
		Title = "Contract complete: " .. contract.Name,
		XP = contract.Reward.XP,
		Credits = contract.Reward.Credits,
		Sound = "Quest",
	})
	DataService.Push(player, "Contracts")
	DataService.MarkDirty(player)
	Events.ObjectiveCompleted:Fire(player, "Contract")
	Events.StatChanged:Fire(player, "Contracts")
	objective(player, "Contracts", 1)
end

local function failContract(player: Player, profile: any, reason: string)
	if not profile.Contracts.Active then
		return
	end
	profile.Contracts.Active = nil
	if carrying[player] and carrying[player].Contract then
		carrying[player] = nil
	end
	Notify.Warn(player, "Contract failed: " .. reason)
	DataService.Push(player, "Contracts")
end

-- Points ---------------------------------------------------------------------------------------------

local function onPoint(player: Player, id: any)
	if type(id) ~= "string" then
		return
	end
	local position = points[id] or (contractPoints[id] and contractPoints[id].Position)
	if not position or not MovementGuard.WasNear(player, position, 16, 2) then
		return
	end
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local now = os.time()

	forActive(player, "Reach", function(step)
		return step.Point == id
	end)
	for _, kind in { "Collect", "Activate" } do
		forActive(player, kind, function(step, state)
			if table.find(step.Points, id) and not state.Progress[id] then
				state.Progress[id] = true
				Notify.Send(player, {
					Kind = "Objective",
					Title = step.Text,
					Text = ("%d / %d"):format(countSet(state.Progress), #step.Points),
				})
				push(player)
			end
			return countSet(state.Progress) >= #step.Points
		end)
	end
	forActive(player, "Deliver", function(step, state, questId)
		local carry = carrying[player]
		if id == step.From and not (carry and carry.QuestId == questId) then
			carrying[player] = {
				QuestId = questId,
				Fragile = step.Fragile == true,
				Expires = if step.Time then os.clock() + step.Time else nil,
			}
			state.Progress = {}
			Notify.Send(player, {
				Kind = "Objective",
				Title = "Package picked up",
				Text = if step.Fragile
					then "Fragile! No stumbles or falls."
					elseif step.Time then ("You have %ds."):format(step.Time)
					else nil,
			})
			Net.Push(player, "Quest.Carry", questId, step.Fragile == true, step.Time)
			push(player)
			return false
		end
		if carry and carry.QuestId == questId and table.find(step.To, id) and not state.Progress[id] then
			if carry.Expires and os.clock() > carry.Expires then
				return false
			end
			state.Progress[id] = true
			Notify.Send(player, {
				Kind = "Objective",
				Title = "Delivered",
				Text = ("%d / %d"):format(countSet(state.Progress), #step.To),
			})
			push(player)
			if countSet(state.Progress) >= #step.To then
				carrying[player] = nil
				Net.Push(player, "Quest.Carry", nil)
				return true
			end
		end
		return false
	end)
	forActive(player, "Timed", function(step, state)
		if id == step.From then
			state.Progress = { Started = os.clock() }
			Notify.Send(player, { Kind = "Objective", Title = "Go!", Text = ("%ds on the clock"):format(step.Time) })
			Net.Push(player, "Quest.Timer", step.Time)
			return false
		end
		local started = state.Progress.Started
		if id == step.To and type(started) == "number" then
			if os.clock() - started <= step.Time + 1 then
				Net.Push(player, "Quest.Timer", nil)
				return true
			end
			state.Progress = {}
			Notify.Warn(player, "Too slow. Head back to the start and try again.")
			Net.Push(player, "Quest.Timer", nil)
		end
		return false
	end)

	-- Contracts.
	local contract = profile.Contracts.Active
	if contract then
		if contract.Expires and now > contract.Expires then
			failContract(player, profile, "out of time")
			return
		end
		if contract.Kind == "Delivery" then
			if id == contract.From and not contract.Picked then
				contract.Picked = true
				carrying[player] = { Contract = true, Fragile = false, Expires = nil }
				contract.Expires = now + contract.Time
				Notify.Send(
					player,
					{ Kind = "Objective", Title = "Parcel picked up", Text = ("%ds to deliver"):format(contract.Time) }
				)
				Net.Push(player, "Quest.Timer", contract.Time)
				DataService.Push(player, "Contracts")
			elseif id == contract.To and contract.Picked then
				Net.Push(player, "Quest.Timer", nil)
				finishContract(player, profile)
			end
		elseif contract.Kind == "Relays" then
			contract.Done = contract.Done or {}
			if table.find(contract.Points, id) and not contract.Done[id] then
				contract.Done[id] = true
				if not contract.Expires then
					contract.Expires = now + contract.Time
					Net.Push(player, "Quest.Timer", contract.Time)
				end
				if countSet(contract.Done) >= #contract.Points then
					Net.Push(player, "Quest.Timer", nil)
					finishContract(player, profile)
				else
					DataService.Push(player, "Contracts")
				end
			end
		end
	end
end

-- Talking ------------------------------------------------------------------------------------------

local function nearNpc(player: Player, npcId: string): boolean
	local spot = npcSpots[npcId]
	return spot ~= nil and MovementGuard.WasNear(player, spot, 22, 2)
end

local function offerFor(quest: Quests.Quest): { [string]: any }
	local steps = {}
	for _, step in quest.Steps do
		table.insert(steps, step.Text)
	end
	return {
		Id = quest.Id,
		Name = quest.Name,
		Type = quest.Type,
		Chapter = quest.Chapter,
		Summary = quest.Summary,
		Intro = quest.Intro,
		Steps = steps,
		Rewards = quest.Rewards,
	}
end

local function onTalk(player: Player, npcId: any): any
	if type(npcId) ~= "string" then
		return nil
	end
	local npc = NPCs.ById[npcId]
	local profile = DataService.Get(player)
	if not npc or not profile or not nearNpc(player, npcId) then
		return nil
	end
	Events.Talk:Fire(player, npcId)
	local response: { [string]: any } = { Npc = npcId, Lines = {}, Offers = {}, Service = npc.Service, Completed = {} }

	-- Talk steps first: they move the story along.
	local spoke = false
	forActive(player, "Talk", function(step, _, questId)
		if step.Npc == npcId then
			spoke = true
			for _, line in step.Say or {} do
				table.insert(response.Lines, line)
			end
			local quest = Quests.ById[questId]
			local state = profile.Quests.Active[questId]
			if quest and state and state.Step == #quest.Steps then
				for _, line in quest.Outro do
					table.insert(response.Lines, line)
				end
				table.insert(response.Completed, { Id = quest.Id, Name = quest.Name, Rewards = quest.Rewards })
			end
			return true
		end
		return false
	end)

	-- New work this character can give.
	local level = ProgressionService.Level(player)
	for _, quest in Quests.List do
		if quest.Giver == npcId and available(profile, quest, level) then
			table.insert(response.Offers, offerFor(quest))
		end
	end
	if not spoke then
		local lines = if #response.Offers > 0 then npc.Greeting else npc.Idle
		local pick = lines[math.random(1, #lines)]
		table.insert(response.Lines, pick)
		-- Point the way if a quest waits elsewhere.
		for questId in profile.Quests.Active do
			local quest = Quests.ById[questId]
			local state = profile.Quests.Active[questId]
			local step = quest and state and quest.Steps[state.Step]
			if quest and step and quest.Giver == npcId then
				table.insert(response.Lines, 'Still working on "' .. quest.Name .. '"? ' .. step.Text .. ".")
				break
			end
		end
	end
	return response
end

local function onAccept(player: Player, questId: any): (boolean, string?)
	if type(questId) ~= "string" then
		return false, "Bad request"
	end
	local quest = Quests.ById[questId]
	local profile = DataService.Get(player)
	if not quest or not profile then
		return false, "Unknown quest"
	end
	if not available(profile, quest, ProgressionService.Level(player)) then
		return false, "Not available"
	end
	-- Expert trials and some side quests are offered from the journal, not a person.
	if quest.Type ~= "Expert" and not nearNpc(player, quest.Giver) then
		return false, "Talk to " .. (NPCs.ById[quest.Giver] and NPCs.ById[quest.Giver].Name or "them") .. " first"
	end
	profile.Quests.Active[questId] = { Step = 1, Progress = {}, Started = os.time() }
	pin(profile, questId)
	push(player)
	Notify.Send(
		player,
		{ Kind = "Objective", Title = "New quest: " .. quest.Name, Text = quest.Steps[1].Text, Sound = "Quest" }
	)
	checkStep(player, questId)
	return true, nil
end

local function onAbandon(player: Player, questId: any)
	local profile = DataService.Get(player)
	local quest = type(questId) == "string" and Quests.ById[questId]
	if not profile or not quest or not profile.Quests.Active[questId] then
		return
	end
	if quest.Type == "Main" then
		Notify.Warn(player, "Story quests can't be abandoned.")
		return
	end
	profile.Quests.Active[questId] = nil
	unpin(profile, questId)
	if carrying[player] and carrying[player].QuestId == questId then
		carrying[player] = nil
		Net.Push(player, "Quest.Carry", nil)
	end
	push(player)
end

local function onPin(player: Player, questId: any, pinned: any)
	local profile = DataService.Get(player)
	if not profile or type(questId) ~= "string" or not profile.Quests.Active[questId] then
		return
	end
	if pinned then
		pin(profile, questId)
	else
		unpin(profile, questId)
	end
	push(player)
end

local function onClaim(player: Player): any
	-- Refreshes rolling objectives and returns their state (rewards are paid automatically).
	local profile = DataService.Get(player)
	if not profile then
		return nil
	end
	refreshDaily(player, profile)
	refreshWeekly(profile)
	DataService.Push(player, "Daily")
	DataService.Push(player, "Weekly")
	return {
		Daily = profile.Daily,
		Weekly = profile.Weekly,
		NextDay = Rotation.SecondsUntilNextDay(),
		NextWeek = Rotation.SecondsUntilNextWeek(),
	}
end

-- Contract board: (district) → offers; (district, index) → take; (nil) → abandon.
local function onContract(player: Player, districtId: any, index: any): any
	local profile = DataService.Get(player)
	if not profile then
		return nil
	end
	if districtId == nil then
		failContract(player, profile, "abandoned")
		return true
	end
	if type(districtId) ~= "string" or not Districts.ById[districtId] then
		return nil
	end
	local contracts = profile.Contracts
	contracts.Offers = contracts.Offers or {}
	if not contracts.Offers[districtId] or os.time() > (contracts.Refresh or 0) then
		contracts.Offers[districtId] = makeOffers(player, profile, districtId)
		contracts.Refresh = os.time() + Quests.ContractRefresh
	end
	if index == nil then
		return {
			Offers = contracts.Offers[districtId],
			Active = contracts.Active,
			Refresh = contracts.Refresh - os.time(),
		}
	end
	if contracts.Active then
		return { Error = "Finish or abandon your current contract first" }
	end
	local offer = type(index) == "number" and contracts.Offers[districtId][index]
	if not offer then
		return nil
	end
	local active = table.clone(offer)
	active.Taken = os.time()
	if active.Kind == "Relays" then
		active.Expires = nil -- starts at the first relay point
	end
	contracts.Active = active
	table.remove(contracts.Offers[districtId], index)
	DataService.Push(player, "Contracts")
	DataService.MarkDirty(player)
	Notify.Send(player, { Kind = "Objective", Title = "Contract: " .. active.Name, Text = active.Text })
	return { Active = active }
end

-- Event wiring ----------------------------------------------------------------------------------------

local function onCourseFinished(player: Player, result: any)
	local profile = DataService.Get(player)
	if not profile or result.Mode == "Practice" then
		return
	end
	local distinctions = result.Distinctions or {}
	forActive(player, "Course", function(step)
		if step.Course ~= result.CourseId then
			return false
		end
		local record = profile.Courses[result.CourseId]
		local medal = math.max(
			result.Medal or 0,
			if step.NoFalls or step.Shortcut or step.Flow then 0 else (record and record.Medal or 0)
		)
		if (step.Medal or 0) > 0 and medal < step.Medal then
			return false
		end
		if (step.Medal or 0) > 0 and step.NoFalls and (result.Medal or 0) < step.Medal then
			return false
		end
		if step.NoFalls and not distinctions.NoFall then
			return false
		end
		if step.Shortcut and not distinctions.Shortcut then
			return false
		end
		if step.Flow and not distinctions.Flow then
			return false
		end
		return true
	end)
	forActive(player, "Courses", function(step, state)
		if step.District and step.District ~= result.District then
			return false
		end
		state.Progress[result.CourseId] = true
		push(player)
		return countSet(state.Progress) >= (step.Count or 1)
	end)
	objective(player, "Courses", 1)
	objective(player, "Districts", 1, nil, result.District)
	if (result.Medal or 0) > 0 then
		objective(player, "Medal", 1, function(template)
			return (result.Medal or 0) >= (template.Medal or 1)
		end)
	end
	if distinctions.NoFall then
		objective(player, "NoFall", 1)
	end
	-- Contracts: course certification.
	local contract = profile.Contracts.Active
	if
		contract
		and contract.Kind == "Course"
		and contract.Course == result.CourseId
		and (result.Medal or 0) >= (contract.Medal or 1)
	then
		finishContract(player, profile)
	end
end

local function chainContains(chain: { string }, wanted: { string }): boolean
	local index = 1
	for _, action in chain do
		if action == wanted[index] then
			index += 1
			if index > #wanted then
				return true
			end
		end
	end
	return false
end

function QuestService.Start()
	-- Index world points.
	for _, part in CollectionService:GetTagged(Tags.QuestPoint) do
		if part:IsA("BasePart") then
			local id = part:GetAttribute("Id")
			if type(id) == "string" then
				points[id] = part.Position
			end
		end
	end
	for _, part in CollectionService:GetTagged(Tags.ContractPoint) do
		if part:IsA("BasePart") then
			local id = part:GetAttribute("Id")
			local districtId = part:GetAttribute("District")
			if type(id) == "string" and type(districtId) == "string" then
				contractPoints[id] = { Id = id, Position = part.Position }
				contractByDistrict[districtId] = contractByDistrict[districtId] or {}
				table.insert(contractByDistrict[districtId], id)
			end
		end
	end
	for _, list in contractByDistrict do
		table.sort(list)
	end
	for _, part in CollectionService:GetTagged(Tags.NPCSpot) do
		if part:IsA("BasePart") then
			local id = part:GetAttribute("Id")
			if type(id) == "string" then
				for _, npc in NPCs.List do
					if npc.Spot == id then
						npcSpots[npc.Id] = part.Position
					end
				end
			end
		end
	end

	Net.Handle("Quest.Talk", onTalk)
	Net.Handle("Quest.Accept", onAccept)
	Net.On("Quest.Abandon", onAbandon)
	Net.On("Quest.Pin", onPin)
	Net.On("Quest.Point", onPoint)
	Net.Handle("Quest.Claim", onClaim)
	Net.Handle("Contract.Take", onContract)

	DataService.Loaded:Connect(function(player, profile)
		refreshDaily(player, profile)
		refreshWeekly(profile)
		-- New players start the prologue straight away.
		if not profile.Quests.Completed.p_welcome and not profile.Quests.Active.p_welcome then
			profile.Quests.Active.p_welcome = { Step = 1, Progress = {}, Started = os.time() }
			pin(profile, "p_welcome")
		end
		for questId in profile.Quests.Active do
			task.defer(checkStep, player, questId)
		end
	end)

	Events.CourseFinished:Connect(onCourseFinished)
	Events.Action:Connect(function(player: Player, action: string, _, districtId: string?)
		forActive(player, "Technique", function(step, state)
			if step.Action ~= action or (step.District and step.District ~= districtId) then
				return false
			end
			state.Progress.Count = (state.Progress.Count or 0) + 1
			if state.Progress.Count % 5 == 0 then
				push(player)
			end
			return state.Progress.Count >= (step.Count or 1)
		end)
		objective(player, "Technique", 1, function(template)
			return template.Action == action
		end)
	end)
	Events.Chain:Connect(function(player: Player, chain: { string })
		local here = district(player)
		forActive(player, "Chain", function(step)
			if step.District and step.District ~= here then
				return false
			end
			return chainContains(chain, step.Actions)
		end)
	end)
	Events.ChainEnded:Connect(function(player: Player, length: number)
		objective(player, "ChainLength", 1, function(template)
			return length >= (template.Count or 1)
		end)
	end)
	Events.FlowTier:Connect(function(player: Player, tier: number, districtId: string?)
		forActive(player, "Flow", function(step)
			return tier >= (step.Tier or 1) and (not step.District or step.District == districtId)
		end)
		objective(player, "Flow", 1, function(template)
			return tier >= (template.Tier2 or 3)
		end)
	end)
	Events.Discovery:Connect(function(player: Player, id: string, kind: string, districtId: string)
		forActive(player, "Discover", function(step, state)
			if (step.District and step.District ~= districtId) or (step.Type and step.Type ~= kind) then
				return false
			end
			state.Progress[id] = true
			push(player)
			return countSet(state.Progress) >= (step.Count or 1)
		end)
		objective(player, "Discover", 1)
	end)
	Events.Lesson:Connect(function(player: Player)
		forActive(player, "Lessons", function(step)
			local profile = DataService.Get(player)
			return profile ~= nil and countSet(profile.Lessons) >= (step.Count or 1)
		end)
	end)
	Events.Token:Connect(function(player: Player)
		objective(player, "Tokens", 1)
	end)
	Events.RaceFinished:Connect(function(player: Player)
		forActive(player, "Race", function(step, state)
			state.Progress.Count = (state.Progress.Count or 0) + 1
			return state.Progress.Count >= (step.Count or 1)
		end)
		objective(player, "Race", 1)
		objective(player, "Social", 1)
	end)
	Events.RelayFinished:Connect(function(player: Player)
		forActive(player, "Relay", function(step, state)
			state.Progress.Count = (state.Progress.Count or 0) + 1
			return state.Progress.Count >= (step.Count or 1)
		end)
		objective(player, "Social", 1)
	end)
	Events.TowerFloor:Connect(function(player: Player, floor: number)
		forActive(player, "Tower", function(step)
			return floor >= (step.Floor or 1)
		end)
		objective(player, "Tower", 1)
	end)
	Events.EndlessSection:Connect(function(player: Player)
		objective(player, "Endless", 1)
	end)
	Events.MasteryTier:Connect(function(player: Player)
		local profile = DataService.Get(player)
		if profile then
			for questId in profile.Quests.Active do
				checkStep(player, questId)
			end
		end
	end)
	Events.CrewJoined:Connect(function(player: Player)
		forActive(player, "Crew", function()
			return true
		end)
	end)
	-- Fragile packages break on stumbles and falls; timed packages expire.
	Events.Break:Connect(function(player: Player, reason: string)
		local carry = carrying[player]
		if not carry or not carry.Fragile then
			return
		end
		carrying[player] = nil
		local profile = DataService.Get(player)
		if profile and carry.QuestId then
			local state = profile.Quests.Active[carry.QuestId]
			if state then
				state.Progress = {}
			end
			push(player)
		end
		Net.Push(player, "Quest.Carry", nil)
		Notify.Warn(player, ("The package broke (%s). Pick up a fresh one."):format(string.lower(reason)))
	end)
	Players.PlayerRemoving:Connect(function(player)
		carrying[player] = nil
	end)
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">RaceService</string>
            <string name="Source"><![CDATA[-- Multiplayer races. Anyone can open a lobby for a course at a race board;
-- others join from the board or by invite. When everyone is ready the racers
-- line up on the start, the countdown runs, and every runner uses the same
-- standardized movement and the course's full kit. Places, times and rewards
-- are settled when the last runner finishes or the clock runs out.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Courses = require(ReplicatedStorage.Shared.Config.Courses)
local Net = require(ReplicatedStorage.Shared.Net)
local Progression = require(ReplicatedStorage.Shared.Config.Progression)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local WorldBuilder = require(script.Parent.Parent.World.WorldBuilder)
local CourseService = require(script.Parent.CourseService)
local DistrictService = require(script.Parent.DistrictService)
local Notify = require(script.Parent.Notify)
local ProgressionService = require(script.Parent.ProgressionService)
local RelayService = require(script.Parent.RelayService)

local RaceService = {}

local MAX_RACERS = 8
local COUNTDOWN = 5

type Lobby = {
	Id: string,
	CourseId: string,
	Host: Player,
	Members: { Player },
	Ready: { [Player]: boolean },
	State: string, -- "Lobby" | "Running"
	StartAt: number,
	Results: { { Player: Player, Seconds: number } },
	Racers: { Player },
	Deadline: number?,
	Round: number,
}

local lobbies: { [string]: Lobby } = {}
local memberOf: { [Player]: Lobby } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function summary(lobby: Lobby): { [string]: any }
	local members = {}
	for _, member in lobby.Members do
		table.insert(members, {
			UserId = member.UserId,
			Name = member.DisplayName,
			Level = member:GetAttribute("Level"),
			Ready = lobby.Ready[member] == true,
			Host = member == lobby.Host,
		})
	end
	local results = {}
	for place, entry in lobby.Results do
		table.insert(
			results,
			{ Place = place, UserId = entry.Player.UserId, Name = entry.Player.DisplayName, Seconds = entry.Seconds }
		)
	end
	local course = Courses.ById[lobby.CourseId]
	return {
		Id = lobby.Id,
		CourseId = lobby.CourseId,
		CourseName = if course then course.Name else lobby.CourseId,
		District = if course then course.District else "Hub",
		State = lobby.State,
		Members = members,
		Max = MAX_RACERS,
		StartAt = lobby.StartAt,
		Results = results,
		Round = lobby.Round,
	}
end

local function broadcast(lobby: Lobby)
	local data = summary(lobby)
	for _, member in lobby.Members do
		Net.Push(member, "Race.Lobby", data)
	end
end

local function leave(player: Player)
	local lobby = memberOf[player]
	if not lobby then
		return
	end
	memberOf[player] = nil
	local index = table.find(lobby.Members, player)
	if index then
		table.remove(lobby.Members, index)
	end
	lobby.Ready[player] = nil
	local run = CourseService.Active(player)
	if run and run.Context == lobby.Id then
		CourseService.End(player, "Left race")
	end
	Net.Push(player, "Race.Lobby", nil)
	if #lobby.Members == 0 then
		lobbies[lobby.Id] = nil
		return
	end
	if lobby.Host == player then
		lobby.Host = lobby.Members[1]
	end
	broadcast(lobby)
end

local function settle(lobby: Lobby)
	if lobby.State ~= "Running" then
		return
	end
	lobby.State = "Lobby"
	lobby.Deadline = nil
	local field = #lobby.Racers
	for place, entry in lobby.Results do
		local player = entry.Player
		local profile = DataService.Get(player)
		if profile then
			local win = place == 1 and field >= 2
			profile.Stats.RacesFinished = (profile.Stats.RacesFinished or 0) + 1
			if win then
				profile.Stats.RacesWon = (profile.Stats.RacesWon or 0) + 1
			end
			-- Larger fields pay a little more.
			local scale = 1 + math.min(field - 1, 7) * 0.08
			local xp = math.floor((if win then Progression.XP.RaceWin else Progression.XP.RaceFinish) * scale)
			local credits =
				math.floor((if win then Progression.Credits.RaceWin else Progression.Credits.RaceFinish) * scale)
			if field < 2 then
				xp, credits = math.floor(xp * 0.4), math.floor(credits * 0.4)
			end
			ProgressionService.Grant(player, { XP = xp, Credits = credits }, nil, true)
			DataService.MarkDirty(player)
			Events.RaceFinished:Fire(player, place, field)
			Events.StatChanged:Fire(player, "RacesFinished")
			if win then
				Events.StatChanged:Fire(player, "RacesWon")
			end
			Net.Push(player, "Race.Reward", { Place = place, Field = field, XP = xp, Credits = credits })
		end
	end
	-- Anyone still running didn't finish in time.
	for _, racer in lobby.Racers do
		local run = CourseService.Active(racer)
		if run and run.Context == lobby.Id then
			CourseService.End(racer, "Time")
		end
	end
	for _, member in lobby.Members do
		lobby.Ready[member] = false
	end
	broadcast(lobby)
end

local function begin(lobby: Lobby)
	local meta = WorldBuilder.Courses[lobby.CourseId]
	if not meta then
		return
	end
	lobby.State = "Running"
	lobby.Round += 1
	lobby.Results = {}
	lobby.Racers = table.clone(lobby.Members)
	lobby.StartAt = now() + COUNTDOWN
	-- Line up across the start, centre outwards.
	local slots = { 0, -2.5, 2.5, -5, 5, -1.25, 1.25, -3.75 }
	for index, racer in lobby.Racers do
		local spawn = meta.Spawn * CFrame.new(slots[index] or 0, 0, (index > 5 and 2.5 or 0))
		local ok = CourseService.Begin(racer, lobby.CourseId, "Race", {
			StartAt = lobby.StartAt,
			Context = lobby.Id,
			NoRewards = true,
			SkipChecks = true,
			Spawn = spawn,
		})
		if not ok then
			Notify.Warn(racer, "Couldn't join the start line.")
		end
	end
	-- Generous cut-off: well past the bronze time.
	local bronze = meta.Medals[1] or 120
	local deadline = lobby.StartAt + bronze * 1.5 + 20
	lobby.Deadline = deadline
	broadcast(lobby)
	local round = lobby.Round
	task.delay(deadline - now() + 0.5, function()
		if lobby.State == "Running" and lobby.Round == round then
			settle(lobby)
		end
	end)
end

-- Open races and relay teams in this server (for the race board).
local function onList(_: Player): any
	local list = {}
	for _, lobby in lobbies do
		table.insert(list, summary(lobby))
	end
	return { Races = list, Relays = RelayService.List() }
end

local function onCreate(player: Player, courseId: any): (boolean, any)
	if type(courseId) ~= "string" then
		return false, "Pick a course"
	end
	local course = Courses.ById[courseId]
	if not course or course.Kind ~= "Course" or not WorldBuilder.Courses[courseId] then
		return false, "Races run on district courses"
	end
	local ok, reason = DistrictService.CanEnter(player, course.District)
	if not ok then
		return false, reason
	end
	if CourseService.Active(player) then
		return false, "Finish your current run first"
	end
	leave(player)
	local lobby: Lobby = {
		Id = HttpService:GenerateGUID(false),
		CourseId = courseId,
		Host = player,
		Members = { player },
		Ready = {},
		State = "Lobby",
		StartAt = 0,
		Results = {},
		Racers = {},
		Deadline = nil,
		Round = 0,
	}
	lobbies[lobby.Id] = lobby
	memberOf[player] = lobby
	broadcast(lobby)
	return true, summary(lobby)
end

function RaceService.Join(player: Player, lobbyId: string): (boolean, any)
	local lobby = lobbies[lobbyId]
	if not lobby then
		return false, "That race has closed"
	end
	if memberOf[player] == lobby then
		return true, summary(lobby)
	end
	if #lobby.Members >= MAX_RACERS then
		return false, "The race is full"
	end
	if lobby.State ~= "Lobby" then
		return false, "That race has already started"
	end
	local course = Courses.ById[lobby.CourseId]
	if course then
		local ok, reason = DistrictService.CanEnter(player, course.District)
		if not ok then
			return false, reason
		end
	end
	if CourseService.Active(player) then
		return false, "Finish your current run first"
	end
	leave(player)
	table.insert(lobby.Members, player)
	memberOf[player] = lobby
	broadcast(lobby)
	return true, summary(lobby)
end

local function onJoin(player: Player, lobbyId: any): (boolean, any)
	if type(lobbyId) ~= "string" then
		return false, "Bad request"
	end
	return RaceService.Join(player, lobbyId)
end

local function onReady(player: Player, ready: any)
	local lobby = memberOf[player]
	if not lobby or lobby.State ~= "Lobby" then
		return
	end
	lobby.Ready[player] = ready == true
	local all = #lobby.Members > 0
	for _, member in lobby.Members do
		if not lobby.Ready[member] then
			all = false
		end
	end
	broadcast(lobby)
	if all then
		begin(lobby)
	end
end

function RaceService.LobbyOf(player: Player): string?
	local lobby = memberOf[player]
	return if lobby then lobby.Id else nil
end

function RaceService.Start()
	Net.Handle("Race.List", onList)
	Net.Handle("Race.Create", onCreate)
	Net.Handle("Race.Join", onJoin)
	Net.On("Race.Leave", leave)
	Net.On("Race.Ready", onReady)

	CourseService.Finished:Connect(function(player: Player, run: any, result: any)
		if run.Mode ~= "Race" then
			return
		end
		local lobby = lobbies[run.Context]
		if not lobby or lobby.State ~= "Running" or result.Rejected then
			return
		end
		table.insert(lobby.Results, { Player = player, Seconds = result.Seconds })
		broadcast(lobby)
		if #lobby.Results >= #lobby.Racers then
			settle(lobby)
		end
	end)
	CourseService.CheckpointReached:Connect(function(player: Player, run: any, index: number)
		if run.Mode ~= "Race" then
			return
		end
		local lobby = lobbies[run.Context]
		if lobby then
			for _, member in lobby.Members do
				if member ~= player then
					Net.Push(member, "Race.Progress", player.UserId, index)
				end
			end
		end
	end)
	CourseService.Ended:Connect(function(player: Player, run: any, reason: string)
		if run.Mode == "Race" and reason ~= "Time" then
			local lobby = lobbies[run.Context]
			if lobby and lobby.State == "Running" then
				local index = table.find(lobby.Racers, player)
				if index then
					table.remove(lobby.Racers, index)
				end
				if #lobby.Results >= #lobby.Racers then
					settle(lobby)
				else
					broadcast(lobby)
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(leave)
end

return RaceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">RecordService</string>
            <string name="Source"><![CDATA[-- Course records: global leaderboards, friends' times and ghost replays.
--
-- Only standardized runs (ranked time trials) go on the boards, so upgrades
-- from the skill tree never decide who's fastest. Times are stored in
-- OrderedDataStores (centiseconds, lower is better); ghosts in a DataStore
-- keyed by course and runner. Without DataStore access (Studio), records are
-- kept in memory for the session.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local RecordService = {}

local BOARD_PREFIX = "SkylineLegends_Board_v1_"
local GHOST_STORE = "SkylineLegends_Ghosts_v1"
local CACHE_SECONDS = 60

export type Entry = { UserId: number, Name: string, Seconds: number, Rank: number }

local online = true
local ghostStore: DataStore? = nil
local boards: { [string]: OrderedDataStore } = {}
local memoryBoards: { [string]: { [number]: number } } = {}
local memoryGhosts: { [string]: any } = {}
local names: { [number]: string } = {}
local topCache: { [string]: { Time: number, Entries: { Entry } } } = {}
local friendCache: { [number]: { Time: number, Ids: { number } } } = {}

local function boardFor(courseId: string): OrderedDataStore?
	if not online then
		return nil
	end
	local existing = boards[courseId]
	if existing then
		return existing
	end
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(BOARD_PREFIX .. courseId)
	end)
	if ok then
		boards[courseId] = result
		return result
	end
	online = false
	return nil
end

local function nameFor(userId: number): string
	local cached = names[userId]
	if cached then
		return cached
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		names[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, result = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local name = if ok and type(result) == "string" then result else ("Runner " .. userId)
	names[userId] = name
	return name
end

local function failed(err: any)
	local text = tostring(err)
	if string.find(text, "403") or string.find(text, "API") or string.find(text, "Studio") then
		online = false
	end
end

-- Leaderboards ------------------------------------------------------------------------------------

-- Submit a ranked time. Keeps the best; returns true if it improved.
function RecordService.Submit(courseId: string, player: Player, seconds: number): boolean
	local centis = math.floor(seconds * 100 + 0.5)
	local userId = player.UserId
	names[userId] = player.DisplayName
	topCache[courseId] = nil
	-- Always mirrored in memory, so this server's boards work even if the store hiccups.
	local memory = memoryBoards[courseId] or {}
	memoryBoards[courseId] = memory
	local memoryImproved = not memory[userId] or centis < memory[userId]
	if memoryImproved then
		memory[userId] = centis
	end
	local board = boardFor(courseId)
	if not board then
		return memoryImproved
	end
	local improved = false
	local ok, err = pcall(function()
		board:UpdateAsync(tostring(userId), function(old)
			if type(old) == "number" and old <= centis then
				return nil
			end
			improved = true
			return centis
		end)
	end)
	if not ok then
		failed(err)
		return memoryImproved
	end
	return improved
end

-- Top `count` times on a course.
function RecordService.Top(courseId: string, count: number?): { Entry }
	local wanted = math.clamp(count or 10, 1, 50)
	local cached = topCache[courseId]
	if cached and os.clock() - cached.Time < CACHE_SECONDS and #cached.Entries >= math.min(wanted, #cached.Entries) then
		return cached.Entries
	end
	local entries: { Entry } = {}
	local board = boardFor(courseId)
	if board then
		local ok, err = pcall(function()
			local pages = board:GetSortedAsync(true, wanted)
			for rank, item in pages:GetCurrentPage() do
				local userId = tonumber(item.key) or 0
				table.insert(
					entries,
					{ UserId = userId, Name = nameFor(userId), Seconds = item.value / 100, Rank = rank }
				)
			end
		end)
		if not ok then
			failed(err)
		end
	end
	if not board or not online then
		local memory = memoryBoards[courseId] or {}
		local list = {}
		for userId, centis in memory do
			table.insert(list, { UserId = userId, Centis = centis })
		end
		table.sort(list, function(a, b)
			return a.Centis < b.Centis
		end)
		entries = {}
		for rank = 1, math.min(wanted, #list) do
			local item = list[rank]
			table.insert(
				entries,
				{ UserId = item.UserId, Name = nameFor(item.UserId), Seconds = item.Centis / 100, Rank = rank }
			)
		end
	end
	topCache[courseId] = { Time = os.clock(), Entries = entries }
	return entries
end

-- A single runner's ranked best (seconds) or nil.
function RecordService.Best(courseId: string, userId: number): number?
	local board = boardFor(courseId)
	if board then
		local ok, result = pcall(function()
			return board:GetAsync(tostring(userId))
		end)
		if ok then
			return if type(result) == "number" then result / 100 else nil
		end
		failed(result)
	end
	local memory = memoryBoards[courseId]
	local centis = memory and memory[userId]
	return if centis then centis / 100 else nil
end

local function friendIds(player: Player): { number }
	local cached = friendCache[player.UserId]
	if cached and os.clock() - cached.Time < 300 then
		return cached.Ids
	end
	local ids = {}
	local ok = pcall(function()
		local pages = Players:GetFriendsAsync(player.UserId)
		local scanned = 0
		while scanned < 3 do
			for _, friend in pages:GetCurrentPage() do
				table.insert(ids, friend.Id)
				names[friend.Id] = friend.DisplayName or friend.Username
			end
			scanned += 1
			if pages.IsFinished or #ids >= 60 then
				break
			end
			pages:AdvanceToNextPageAsync()
		end
	end)
	if not ok then
		-- Fall back to friends in this server.
		for _, other in Players:GetPlayers() do
			if other ~= player then
				local isFriend = false
				pcall(function()
					isFriend = (player :: any):IsFriendsWithAsync(other.UserId)
				end)
				if isFriend then
					table.insert(ids, other.UserId)
				end
			end
		end
	end
	friendCache[player.UserId] = { Time = os.clock(), Ids = ids }
	return ids
end

-- Ranked bests of a player's friends (fastest first), including the player.
function RecordService.Friends(courseId: string, player: Player, limit: number?): { Entry }
	local result: { Entry } = {}
	local ids = friendIds(player)
	table.insert(ids, 1, player.UserId)
	for index, userId in ids do
		if index > (limit or 25) then
			break
		end
		local seconds = RecordService.Best(courseId, userId)
		if seconds then
			table.insert(result, { UserId = userId, Name = nameFor(userId), Seconds = seconds, Rank = 0 })
		end
	end
	table.sort(result, function(a, b)
		return a.Seconds < b.Seconds
	end)
	for rank, entry in result do
		entry.Rank = rank
	end
	return result
end

-- Ghosts ---------------------------------------------------------------------------------------------

local function ghostKey(courseId: string, userId: number): string
	return courseId .. "_" .. userId
end

function RecordService.SaveGhost(courseId: string, userId: number, encoded: any)
	local key = ghostKey(courseId, userId)
	memoryGhosts[key] = encoded
	if not online or not ghostStore then
		return
	end
	local ok, err = pcall(function()
		(ghostStore :: DataStore):SetAsync(key, encoded, { userId })
	end)
	if not ok then
		failed(err)
	end
end

function RecordService.LoadGhost(courseId: string, userId: number): any?
	local key = ghostKey(courseId, userId)
	local cached = memoryGhosts[key]
	if cached then
		return cached
	end
	if not online or not ghostStore then
		return nil
	end
	local ok, result = pcall(function()
		return (ghostStore :: DataStore):GetAsync(key)
	end)
	if ok and type(result) == "table" then
		memoryGhosts[key] = result
		return result
	elseif not ok then
		failed(result)
	end
	return nil
end

function RecordService.Online(): boolean
	return online
end

function RecordService.Start()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GHOST_STORE)
	end)
	if ok then
		ghostStore = result
	else
		online = false
	end
end

return RecordService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">RelayService</string>
            <string name="Source"><![CDATA[-- Co-op relays. A relay course is split into legs at its exchange gates. A
-- team of up to one runner per leg readies up; each runner waits at their
-- exchange, and the baton passes the moment the runner before them crosses
-- it. Fewer runners than legs? Someone runs more than one leg. The team's
-- total time earns a shared medal on the relay course.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Courses = require(ReplicatedStorage.Shared.Config.Courses)
local Medals = require(ReplicatedStorage.Shared.Logic.Medals)
local Net = require(ReplicatedStorage.Shared.Net)
local Progression = require(ReplicatedStorage.Shared.Config.Progression)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local WorldBuilder = require(script.Parent.Parent.World.WorldBuilder)
local CourseService = require(script.Parent.CourseService)
local DistrictService = require(script.Parent.DistrictService)
local MovementGuard = require(script.Parent.MovementGuard)
local ProgressionService = require(script.Parent.ProgressionService)

local RelayService = {}

type Team = {
	Id: string,
	CourseId: string,
	Host: Player,
	Members: { Player },
	Ready: { [Player]: boolean },
	State: string, -- "Lobby" | "Running"
	Legs: { { Runner: Player, From: number, To: number? } },
	Leg: number,
	StartAt: number,
	LegTimes: { number },
}

local teams: { [string]: Team } = {}
local memberOf: { [Player]: Team } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function legCount(team: Team): number
	local meta = WorldBuilder.Courses[team.CourseId]
	return if meta then #meta.Exchanges + 1 else 1
end

local function summary(team: Team): { [string]: any }
	local members = {}
	for _, member in team.Members do
		table.insert(members, {
			UserId = member.UserId,
			Name = member.DisplayName,
			Ready = team.Ready[member] == true,
			Host = member == team.Host,
		})
	end
	local legs = {}
	for index, leg in team.Legs do
		table.insert(
			legs,
			{ Index = index, UserId = leg.Runner.UserId, Name = leg.Runner.DisplayName, Time = team.LegTimes[index] }
		)
	end
	local course = Courses.ById[team.CourseId]
	return {
		Id = team.Id,
		CourseId = team.CourseId,
		CourseName = if course then course.Name else team.CourseId,
		State = team.State,
		Members = members,
		Max = legCount(team),
		Legs = legs,
		Leg = team.Leg,
		StartAt = team.StartAt,
	}
end

local function broadcast(team: Team)
	local data = summary(team)
	for _, member in team.Members do
		Net.Push(member, "Relay.Team", data)
	end
end

local function stop(team: Team, reason: string)
	if team.State ~= "Running" then
		return
	end
	team.State = "Lobby"
	for _, member in team.Members do
		team.Ready[member] = false
		local run = CourseService.Active(member)
		if run and run.Context == team.Id then
			CourseService.End(member, reason)
		end
	end
	for _, member in team.Members do
		Net.Push(member, "Relay.Stopped", reason)
	end
	broadcast(team)
end

local function leave(player: Player)
	local team = memberOf[player]
	if not team then
		return
	end
	if team.State == "Running" then
		stop(team, player.DisplayName .. " left the team")
	end
	memberOf[player] = nil
	local index = table.find(team.Members, player)
	if index then
		table.remove(team.Members, index)
	end
	team.Ready[player] = nil
	Net.Push(player, "Relay.Team", nil)
	if #team.Members == 0 then
		teams[team.Id] = nil
		return
	end
	if team.Host == player then
		team.Host = team.Members[1]
	end
	broadcast(team)
end

local function beginLeg(team: Team, index: number, startAt: number, inPlace: boolean)
	local leg = team.Legs[index]
	team.Leg = index
	local ok, reason = CourseService.Begin(leg.Runner, team.CourseId, "Relay", {
		StartAt = startAt,
		FromCheckpoint = leg.From,
		EndAt = leg.To,
		Context = team.Id,
		NoRewards = true,
		SkipChecks = true,
		NoTeleport = inPlace,
	})
	if not ok then
		stop(team, "Couldn't hand over: " .. tostring(reason))
		return
	end
	broadcast(team)
end

local function start(team: Team)
	local meta = WorldBuilder.Courses[team.CourseId]
	if not meta then
		return
	end
	team.State = "Running"
	team.LegTimes = {}
	team.Legs = {}
	local exchanges = meta.Exchanges
	local legs = #exchanges + 1
	for index = 1, legs do
		local runner = team.Members[(index - 1) % #team.Members + 1]
		table.insert(team.Legs, {
			Runner = runner,
			From = if index == 1 then 0 else exchanges[index - 1],
			To = if index <= #exchanges then exchanges[index] else nil,
		})
	end
	team.StartAt = now() + 4
	-- Waiting runners go to their exchange now.
	local placed: { [Player]: boolean } = { [team.Legs[1].Runner] = true }
	for index = 2, legs do
		local leg = team.Legs[index]
		if not placed[leg.Runner] then
			placed[leg.Runner] = true
			local checkpoint = meta.Checkpoints[leg.From]
			if checkpoint then
				MovementGuard.AllowTeleport(leg.Runner, checkpoint.Spawn.Position, 20)
				Net.Push(leg.Runner, "Relay.Wait", { Spawn = checkpoint.Spawn, Leg = index })
			end
		end
	end
	beginLeg(team, 1, team.StartAt, false)
end

local function finishRelay(team: Team, finalSeconds: number)
	local meta = WorldBuilder.Courses[team.CourseId]
	team.State = "Lobby"
	local total = finalSeconds
	local medal = if meta then Medals.For(total, meta.Medals) else 0
	local size = #team.Members
	for _, member in team.Members do
		team.Ready[member] = false
		local profile = DataService.Get(member)
		if profile then
			local record = profile.Courses[team.CourseId]
				or { Medal = 0, Completions = 0, Distinctions = {}, Tokens = {} }
			profile.Courses[team.CourseId] = record
			local first = (record.Completions or 0) == 0
			record.Completions = (record.Completions or 0) + 1
			record.Medal = math.max(record.Medal or 0, medal)
			if not record.Best or total < record.Best then
				record.Best = total
			end
			profile.Stats.RelaysFinished = (profile.Stats.RelaysFinished or 0) + 1
			local scale = (if first then 1.5 else 1) * (1 + (size - 1) * 0.15)
			local xp = math.floor(Progression.XP.RelayFinish * scale)
			local credits = math.floor(Progression.Credits.RelayFinish * scale)
			ProgressionService.Grant(member, { XP = xp, Credits = credits }, nil, true)
			DataService.Push(member, "Courses")
			DataService.MarkDirty(member)
			Events.RelayFinished:Fire(member, size)
			Events.StatChanged:Fire(member, "RelaysFinished")
			Net.Push(member, "Relay.Results", {
				CourseId = team.CourseId,
				Total = total,
				Medal = medal,
				LegTimes = team.LegTimes,
				Legs = summary(team).Legs,
				XP = xp,
				Credits = credits,
				TeamSize = size,
				Best = record.Best,
			})
		end
	end
	broadcast(team)
end

local function onCreate(player: Player, courseId: any): (boolean, any)
	local course = type(courseId) == "string" and Courses.ById[courseId]
	if not course or course.Kind ~= "Relay" or not WorldBuilder.Courses[courseId] then
		return false, "Pick a relay course"
	end
	local ok, reason = DistrictService.CanEnter(player, course.District)
	if not ok then
		return false, reason
	end
	if CourseService.Active(player) then
		return false, "Finish your current run first"
	end
	leave(player)
	local team: Team = {
		Id = HttpService:GenerateGUID(false),
		CourseId = courseId,
		Host = player,
		Members = { player },
		Ready = {},
		State = "Lobby",
		Legs = {},
		Leg = 0,
		StartAt = 0,
		LegTimes = {},
	}
	teams[team.Id] = team
	memberOf[player] = team
	broadcast(team)
	return true, summary(team)
end

function RelayService.Join(player: Player, teamId: string): (boolean, any)
	local team = teams[teamId]
	if not team then
		return false, "That team has disbanded"
	end
	if memberOf[player] == team then
		return true, summary(team)
	end
	if team.State ~= "Lobby" then
		return false, "They're mid-relay"
	end
	if #team.Members >= legCount(team) then
		return false, "The team is full"
	end
	local course = Courses.ById[team.CourseId]
	if course then
		local ok, reason = DistrictService.CanEnter(player, course.District)
		if not ok then
			return false, reason
		end
	end
	leave(player)
	table.insert(team.Members, player)
	memberOf[player] = team
	broadcast(team)
	return true, summary(team)
end

local function onJoin(player: Player, teamId: any): (boolean, any)
	if type(teamId) ~= "string" then
		return false, "Bad request"
	end
	return RelayService.Join(player, teamId)
end

local function onReady(player: Player, ready: any)
	local team = memberOf[player]
	if not team or team.State ~= "Lobby" then
		return
	end
	team.Ready[player] = ready == true
	local all = true
	for _, member in team.Members do
		if not team.Ready[member] then
			all = false
		end
	end
	broadcast(team)
	if all then
		start(team)
	end
end

function RelayService.TeamOf(player: Player): string?
	local team = memberOf[player]
	return if team then team.Id else nil
end

function RelayService.List(): { any }
	local list = {}
	for _, team in teams do
		table.insert(list, summary(team))
	end
	return list
end

function RelayService.Start()
	Net.Handle("Relay.Create", onCreate)
	Net.Handle("Relay.Join", onJoin)
	Net.On("Relay.Leave", leave)
	Net.On("Relay.Ready", onReady)

	CourseService.Finished:Connect(function(player: Player, run: any, result: any)
		if run.Mode ~= "Relay" then
			return
		end
		local team = teams[run.Context]
		if not team or team.State ~= "Running" or result.Rejected then
			return
		end
		local leg = team.Legs[team.Leg]
		if not leg or leg.Runner ~= player then
			return
		end
		team.LegTimes[team.Leg] = result.Seconds
		if team.Leg >= #team.Legs then
			-- Team time: from the first gun to the final finish.
			finishRelay(team, now() - team.StartAt)
			return
		end
		local nextLeg = team.Legs[team.Leg + 1]
		for _, member in team.Members do
			Net.Push(member, "Relay.Handoff", { From = player.UserId, To = nextLeg.Runner.UserId, Leg = team.Leg + 1 })
		end
		beginLeg(team, team.Leg + 1, now(), nextLeg.Runner == player)
	end)
	CourseService.Ended:Connect(function(player: Player, run: any, reason: string)
		if run.Mode == "Relay" and reason ~= "Replaced" then
			local team = teams[run.Context]
			if team and team.State == "Running" then
				stop(team, player.DisplayName .. " dropped the baton")
			end
		end
	end)
	Players.PlayerRemoving:Connect(leave)
end

return RelayService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">SocialService</string>
            <string name="Source"><![CDATA[-- Social features: who's online in this server (and what they're up to),
-- invites to run together or join a race or relay, emotes, co-op pressure
-- switches, and saving each player's settings and key bindings.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Cosmetics = require(ReplicatedStorage.Shared.Config.Cosmetics)
local Net = require(ReplicatedStorage.Shared.Net)
local SettingsConfig = require(ReplicatedStorage.Shared.Config.Settings)
local Tags = require(ReplicatedStorage.Shared.Tags)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local CourseService = require(script.Parent.CourseService)
local DistrictService = require(script.Parent.DistrictService)
local MovementGuard = require(script.Parent.MovementGuard)
local Notify = require(script.Parent.Notify)
local RaceService = require(script.Parent.RaceService)
local RelayService = require(script.Parent.RelayService)

local SocialService = {}

type Invite = { From: Player, Kind: string, Target: string?, Expires: number }
local invites: { [Player]: { [number]: Invite } } = {}
local switches: { [string]: { Position: Vector3, Duration: number } } = {}
local gates: { [string]: Vector3 } = {}
local switchUntil: { [string]: number } = {}

local function activity(player: Player): string
	local run = CourseService.Active(player)
	if run then
		if run.Mode == "Race" then
			return "Racing"
		elseif run.Mode == "Relay" then
			return "Running a relay"
		elseif run.Mode == "Tower" then
			return "Climbing the Spire"
		end
		return "On a course"
	end
	return "Exploring"
end

local function onPlayers(player: Player): any
	local list = {}
	for _, other in Players:GetPlayers() do
		local isFriend = false
		if other ~= player then
			pcall(function()
				isFriend = (player :: any):IsFriendsWithAsync(other.UserId)
			end)
		end
		table.insert(list, {
			UserId = other.UserId,
			Name = other.DisplayName,
			Level = other:GetAttribute("Level") or 1,
			Rank = other:GetAttribute("Rank"),
			Title = other:GetAttribute("Title"),
			Crew = other:GetAttribute("CrewTag"),
			District = MovementGuard.District(other) or "Hub",
			Activity = activity(other),
			Friend = isFriend,
			You = other == player,
			Race = RaceService.LobbyOf(other),
			Relay = RelayService.TeamOf(other),
		})
	end
	return list
end

-- kind: "Join" (come to me) | "Race" | "Relay"
local function onInvite(player: Player, userId: any, kind: any)
	local target = type(userId) == "number" and Players:GetPlayerByUserId(userId)
	if not target or target == player then
		return
	end
	local invite: Invite = { From = player, Kind = "Join", Target = nil, Expires = os.clock() + 120 }
	if kind == "Race" then
		local lobby = RaceService.LobbyOf(player)
		if not lobby then
			return
		end
		invite.Kind, invite.Target = "Race", lobby
	elseif kind == "Relay" then
		local team = RelayService.TeamOf(player)
		if not team then
			return
		end
		invite.Kind, invite.Target = "Relay", team
	end
	invites[target] = invites[target] or {}
	invites[target][player.UserId] = invite
	Net.Push(target, "Social.Invite", {
		From = player.UserId,
		Name = player.DisplayName,
		Kind = invite.Kind,
		District = MovementGuard.District(player),
	})
	Notify.Toast(player, "Invite sent", target.DisplayName)
end

local function onRespond(player: Player, fromUserId: any, accept: any): (boolean, any)
	local pending = invites[player]
	local invite = pending and type(fromUserId) == "number" and pending[fromUserId]
	if not invite or os.clock() > invite.Expires then
		return false, "That invite has expired"
	end
	if pending then
		pending[fromUserId] = nil
	end
	if not accept then
		return true, nil
	end
	if invite.Kind == "Race" and invite.Target then
		return RaceService.Join(player, invite.Target)
	elseif invite.Kind == "Relay" and invite.Target then
		return RelayService.Join(player, invite.Target)
	end
	-- Join: travel to the inviter's side.
	local from = invite.From
	if not from.Parent then
		return false, "They've left"
	end
	if CourseService.Active(player) then
		return false, "Finish your current run first"
	end
	local district = MovementGuard.District(from) or "Hub"
	local ok, reason = DistrictService.CanEnter(player, district)
	if not ok then
		return false, reason
	end
	local position = MovementGuard.Position(from)
	if not position then
		return false, "They're between places"
	end
	local destination = CFrame.new(position + Vector3.new(3, 1, 3))
	MovementGuard.AllowTeleport(player, destination.Position, 20)
	return true, { Teleport = destination }
end

-- Emotes: only equipped ones (or your equipped victory animation after a finish).
local lastEmote: { [Player]: number } = {}
local function onEmote(player: Player, name: any)
	local character = player.Character
	local profile = DataService.Get(player)
	if not character or not profile or (os.clock() - (lastEmote[player] or 0)) < 0.5 then
		return
	end
	lastEmote[player] = os.clock()
	if name == nil then
		character:SetAttribute("Emote", nil)
		character:SetAttribute("EmoteAt", nil)
		return
	end
	if type(name) ~= "string" then
		return
	end
	local allowed = false
	for _, id in profile.Equipped.Emotes or {} do
		local item = Cosmetics.ById[id]
		if item and item.Style == name and profile.Inventory[id] then
			allowed = true
		end
	end
	local victory = Cosmetics.ById[profile.Equipped.Victory or ""]
	if victory and victory.Style == name then
		allowed = true
	end
	if not allowed then
		return
	end
	character:SetAttribute("Emote", name)
	character:SetAttribute("EmoteAt", workspace:GetServerTimeNow())
end

-- Pressure plates: opening a gate for everyone. Holding it for someone else counts as co-op.
local function onSwitch(player: Player, switchId: any)
	if type(switchId) ~= "string" then
		return
	end
	local switch = switches[switchId]
	if not switch or not MovementGuard.WasNear(player, switch.Position, 10, 1.5) then
		return
	end
	local now = workspace:GetServerTimeNow()
	local untilTime = now + switch.Duration
	local wasOpen = (switchUntil[switchId] or 0) > now
	switchUntil[switchId] = untilTime
	Net.PushAll("Switch.Opened", switchId, untilTime)
	if not wasOpen then
		local gate = gates[switchId]
		if gate then
			for _, other in Players:GetPlayers() do
				if other ~= player then
					local position = MovementGuard.Position(other)
					if position and (position - gate).Magnitude < 45 then
						local profile = DataService.Get(player)
						if profile then
							profile.Stats.CoopSwitches = (profile.Stats.CoopSwitches or 0) + 1
							DataService.MarkDirty(player)
						end
						Events.CoopSwitch:Fire(player)
						Events.StatChanged:Fire(player, "CoopSwitches")
						break
					end
				end
			end
		end
	end
end

local function onSettings(player: Player, values: any, bindings: any)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	if type(values) == "table" then
		for id, value in values do
			if type(id) == "string" then
				local clean = SettingsConfig.Sanitize(id, value)
				if clean ~= nil then
					profile.Settings[id] = clean
				end
			end
		end
	end
	if bindings ~= nil then
		local clean = SettingsConfig.SanitizeBindings(bindings)
		if clean then
			profile.Bindings = clean
		end
	end
	DataService.MarkDirty(player)
end

function SocialService.Start()
	for _, part in CollectionService:GetTagged(Tags.Switch) do
		if part:IsA("BasePart") then
			local id = part:GetAttribute("SwitchId")
			if type(id) == "string" then
				switches[id] = { Position = part.Position, Duration = part:GetAttribute("Duration") or 5 }
			end
		end
	end
	for _, part in CollectionService:GetTagged(Tags.SwitchGate) do
		if part:IsA("BasePart") then
			local id = part:GetAttribute("SwitchId")
			if type(id) == "string" then
				gates[id] = part.Position
			end
		end
	end
	Net.Handle("Social.Players", onPlayers)
	Net.On("Social.Invite", onInvite)
	Net.Handle("Social.Respond", onRespond)
	Net.On("Emote.Play", onEmote)
	Net.On("Switch.Press", onSwitch)
	Net.On("Settings.Save", onSettings)
	Players.PlayerRemoving:Connect(function(player)
		invites[player] = nil
		lastEmote[player] = nil
	end)
end

return SocialService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">TowerService</string>
            <string name="Source"><![CDATA[-- The Spire: 25 enclosed floors beside the Guildhall, each a short route from
-- the section library that asks for more of your movement kit the higher you
-- climb. Clear a floor to open the next; every fifth floor is a milestone, and
-- clearing the 25th lifts you onto the roof (a secret of its own).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Net = require(ReplicatedStorage.Shared.Net)
local Progression = require(ReplicatedStorage.Shared.Config.Progression)

local DataService = require(script.Parent.Parent.Data.DataService)
local Events = require(script.Parent.Parent.Events)
local Spire = require(script.Parent.Parent.World.Spire)
local WorldBuilder = require(script.Parent.Parent.World.WorldBuilder)
local CourseService = require(script.Parent.CourseService)
local MovementGuard = require(script.Parent.MovementGuard)
local Notify = require(script.Parent.Notify)
local ProgressionService = require(script.Parent.ProgressionService)

local TowerService = {}

local inTower: { [Player]: number } = {} -- current floor
local clearedAt: { [Player]: number } = {}

local function lobby(): CFrame
	local hub = Districts.ById.Hub
	local base = hub.Origin + Districts.SpireOffset
	return CFrame.lookAt(base + Vector3.new(0, 3.5, 0), hub.Origin + Vector3.new(0, 3.5, 0))
end

local function kitFor(meta: any): { [string]: boolean }
	local set = {}
	for _, list in { meta.Requires, meta.FastRequires, meta.ExpertRequires } do
		for _, id in list or {} do
			set[id] = true
		end
	end
	return set
end

local function highest(player: Player): number
	local profile = DataService.Get(player)
	return if profile then profile.Tower.Highest or 0 else 0
end

local function enter(player: Player, floor: number): (boolean, any)
	local meta = WorldBuilder.Courses["spire_" .. floor]
	if not meta then
		return false, "No such floor"
	end
	local ok, info = CourseService.Begin(player, "spire_" .. floor, "Tower", {
		NoRewards = true,
		SkipChecks = true,
		Standardized = false,
		Kit = kitFor(meta),
		Context = "Tower",
	})
	if ok then
		inTower[player] = floor
		info.Floor = floor
		info.Highest = highest(player)
	end
	return ok, info
end

local function onEnter(player: Player, floor: any): (boolean, any)
	local top = math.min(highest(player) + 1, Spire.Floors)
	local wanted = if type(floor) == "number" then math.clamp(math.floor(floor), 1, top) else top
	local base = lobby().Position
	local nearLift = MovementGuard.WasNear(player, base, 90, 3)
	if not nearLift and not inTower[player] then
		return false, "Take the Spire lift beside the Guildhall"
	end
	local run = CourseService.Active(player)
	if run and run.Context ~= nil and run.Context ~= "Tower" then
		return false, "Finish your current event first"
	end
	return enter(player, wanted)
end

-- Move on after a clear: the next floor, a retry, or (after the last) the roof.
local function onFloor(player: Player, floor: any): (boolean, any)
	if type(floor) ~= "number" or not inTower[player] then
		return false, "Not in the Spire"
	end
	-- Only from inside a floor (running it, or just after clearing it).
	local run = CourseService.Active(player)
	local running = run ~= nil and run.Context == "Tower"
	if not running and os.clock() - (clearedAt[player] or -math.huge) > 300 then
		inTower[player] = nil
		return false, "Take the Spire lift beside the Guildhall"
	end
	local top = highest(player)
	if floor == Spire.Floors + 1 then
		if top < Spire.Floors or not Spire.Roof then
			return false, "Clear the top floor first"
		end
		local roof = Spire.Roof :: CFrame
		MovementGuard.AllowTeleport(player, roof.Position, 20)
		inTower[player] = nil
		return true, { Roof = roof }
	end
	if floor < 1 or floor > math.min(top + 1, Spire.Floors) then
		return false, "That floor isn't open yet"
	end
	return enter(player, floor)
end

local function onLeave(player: Player): any
	inTower[player] = nil
	local run = CourseService.Active(player)
	if run and run.Context == "Tower" then
		CourseService.End(player, "Left")
	end
	local destination = lobby()
	MovementGuard.AllowTeleport(player, destination.Position, 20)
	return destination
end

local function onFinished(player: Player, run: any, result: any)
	if run.Mode ~= "Tower" or result.Rejected then
		return
	end
	local floor = tonumber(string.match(run.CourseId, "spire_(%d+)")) or 0
	local profile = DataService.Get(player)
	if not profile or floor == 0 then
		return
	end
	local tower = profile.Tower
	tower.Best = tower.Best or {}
	local key = tostring(floor)
	local previousBest = tower.Best[key]
	local first = floor > (tower.Highest or 0)
	if not previousBest or result.Seconds < previousBest then
		tower.Best[key] = result.Seconds
	end
	tower.Highest = math.max(tower.Highest or 0, floor)
	local factor = if first then 1 else 0.3
	local xp = math.floor(Progression.XP.TowerFloor * (1 + floor * 0.12) * factor)
	local credits = math.floor(Progression.Credits.TowerFloor * (1 + floor * 0.1) * factor)
	local prestige = if first and floor % 5 == 0 then Progression.Prestige.TowerMilestone else 0
	ProgressionService.Grant(player, { XP = xp, Credits = credits, Prestige = prestige }, nil, true)
	if prestige > 0 then
		Notify.Send(player, {
			Kind = "Unlock",
			Title = ("Spire milestone: floor %d"):format(floor),
			Prestige = prestige,
			Sound = "Unlock",
		})
	end
	DataService.Push(player, "Tower")
	DataService.MarkDirty(player)
	clearedAt[player] = os.clock()
	Events.TowerFloor:Fire(player, floor)
	Events.StatChanged:Fire(player, "TowerFloor")
	Net.Push(player, "Tower.Cleared", {
		Floor = floor,
		Seconds = result.Seconds,
		Best = tower.Best[key],
		PreviousBest = previousBest,
		First = first,
		XP = xp,
		Credits = credits,
		Prestige = prestige,
		Next = if floor < Spire.Floors then floor + 1 else nil,
		Roof = floor >= Spire.Floors,
		Highest = tower.Highest,
	})
end

function TowerService.Start()
	Net.Handle("Tower.Enter", onEnter)
	Net.Handle("Tower.Floor", onFloor)
	Net.Handle("Tower.Leave", onLeave)
	CourseService.Finished:Connect(onFinished)
	CourseService.Ended:Connect(function(player: Player, run: any, reason: string)
		if run.Mode == "Tower" and reason ~= "Replaced" then
			inTower[player] = nil
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		inTower[player] = nil
		clearedAt[player] = nil
	end)
end

return TowerService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="66">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">CourseBuilder</string>
            <string name="Source"><![CDATA[-- Turns course recipes (Config/Courses) into geometry.
--
-- A course is built by walking a cursor: a CFrame on the top surface at the
-- end of the last platform, facing along the course. Each segment builds its
-- geometry relative to the cursor and returns the new cursor. Gap sizes and
-- wall heights come from Logic/Reach, so routes stay achievable.
--
-- While building, the context records everything the game needs at runtime:
-- checkpoints, tokens, shortcuts, rising water, par time and required
-- abilities per route, which become the course's medal thresholds.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Medals = require(ReplicatedStorage.Shared.Logic.Medals)
local MovementConfig = require(ReplicatedStorage.Shared.Config.Movement)
local Reach = require(ReplicatedStorage.Shared.Logic.Reach)
local Tags = require(ReplicatedStorage.Shared.Tags)

local Kit = require(script.Parent.Kit)

local M = MovementConfig
local LANE_SPACING = 26
local PLATFORM_THICKNESS = 2

local CourseBuilder = {}
CourseBuilder.LaneSpacing = LANE_SPACING

export type Theme = {
	Id: string,
	Surface: Color3,
	SurfaceMaterial: Enum.Material,
	Trim: Color3,
	Wall: Color3,
	WallMaterial: Enum.Material,
	Accent: Color3,
	Signal: Color3,
	Beam: Color3,
	BeamMaterial: Enum.Material,
	Rope: Color3,
	Climb: string,
	BodyDepth: number,
	Platform: ((Kit.Builder, CFrame, number, number, string?) -> ())?,
	Body: ((Kit.Builder, CFrame, number, number, number) -> ())?,
	WallStyle: ((Kit.Builder, CFrame, Vector3) -> BasePart)?,
	Deco: ((Kit.Builder, CFrame, number, number) -> ())?,
	AnchorMount: ((Kit.Builder, Vector3) -> ())?,
	Floating: boolean?,
}

export type Volume = { CFrame: CFrame, Size: Vector3 }
export type Meta = {
	Id: string,
	Spawn: CFrame,
	Checkpoints: { { Spawn: CFrame, Volume: Volume, Exchange: boolean } },
	Finish: Volume,
	Tokens: { Vector3 },
	Shortcuts: { Volume },
	KillY: number,
	Par: { A: number, F: number, E: number },
	Medals: { number },
	Requires: { string },
	FastRequires: { string },
	ExpertRequires: { string },
	Length: number,
	Folder: Folder,
	LocalMin: Vector3,
	LocalMax: Vector3,
	Origin: CFrame,
	FlowTarget: number,
	Exchanges: { number },
}

type Ctx = {
	B: Kit.Builder,
	Theme: Theme,
	Id: string,
	Difficulty: number,
	Width: number,
	Origin: CFrame,
	Folder: Folder,
	Lane: string?,
	LaneSign: number,
	Par: { [string]: number },
	Requires: { [string]: { [string]: boolean } },
	TokenSpots: { { Position: Vector3, Priority: number, Lane: string? } },
	Checkpoints: { { Spawn: CFrame, Volume: Volume, Exchange: boolean } },
	Shortcuts: { Volume },
	Water: { StartCP: number, Rate: number }?,
	SectionMin: Vector3,
	SectionMax: Vector3,
	Techniques: number,
	MinY: number,
	Safe: boolean,
	NoRecovery: boolean?,
}

-- Small geometry helpers --------------------------------------------------------------

local function fwd(c: CFrame, distance: number): CFrame
	return c * CFrame.new(0, 0, -distance)
end

local function track(ctx: Ctx, position: Vector3)
	ctx.MinY = math.min(ctx.MinY, position.Y)
	local p = ctx.Origin:PointToObjectSpace(position)
	ctx.SectionMin = ctx.SectionMin:Min(p)
	ctx.SectionMax = ctx.SectionMax:Max(p)
end

local function addPar(ctx: Ctx, seconds: number)
	local lane = ctx.Lane
	if lane then
		ctx.Par[lane] += seconds
	else
		ctx.Par.A += seconds
		ctx.Par.F += seconds
		ctx.Par.E += seconds
	end
end

local function require_(ctx: Ctx, ability: string)
	local lane = ctx.Lane
	if lane then
		ctx.Requires[lane][ability] = true
	else
		for _, name in { "A", "F", "E" } do
			ctx.Requires[name][ability] = true
		end
	end
	ctx.Techniques += 1
end

local function token(ctx: Ctx, position: Vector3, priority: number)
	table.insert(ctx.TokenSpots, { Position = position, Priority = priority, Lane = ctx.Lane })
end

-- A platform from the cursor forward. Returns the cursor at its far end.
local function platform(ctx: Ctx, c: CFrame, length: number, width: number?, role: string?): CFrame
	local w = width or ctx.Width
	local topCenter = c * CFrame.new(0, 0, -length / 2)
	local theme = ctx.Theme
	if theme.Platform then
		theme.Platform(ctx.B, topCenter, w, length, role)
	else
		ctx.B:Box(
			topCenter * CFrame.new(0, -PLATFORM_THICKNESS / 2, 0),
			Vector3.new(w, PLATFORM_THICKNESS, length),
			theme.Surface,
			theme.SurfaceMaterial
		)
	end
	if theme.Body and role ~= "Floating" and role ~= "Recovery" and role ~= "Mover" then
		theme.Body(ctx.B, topCenter * CFrame.new(0, -PLATFORM_THICKNESS, 0), w, length, theme.BodyDepth)
	end
	if theme.Deco and role == nil and length >= 14 then
		theme.Deco(ctx.B, topCenter, w, length)
	end
	if length >= 8 and role ~= "Start" and role ~= "Finish" and role ~= "Recovery" then
		token(ctx, (topCenter * CFrame.new(0, 3.5, 0)).Position, 0)
	end
	track(ctx, topCenter.Position)
	track(ctx, (c * CFrame.new(w / 2, 0, 0)).Position)
	track(ctx, (c * CFrame.new(-w / 2, 0, -length)).Position)
	return fwd(c, length)
end

-- A solid block whose top is `height` above the cursor, starting `ahead` studs forward.
local function block(ctx: Ctx, c: CFrame, ahead: number, height: number, depth: number, width: number?): BasePart
	local w = width or ctx.Width
	local below = 6
	local size = Vector3.new(w, height + below, depth)
	local cframe = c * CFrame.new(0, (height - below) / 2, -(ahead + depth / 2))
	local part = ctx.B:Box(cframe, size, ctx.Theme.Wall, ctx.Theme.WallMaterial)
	track(ctx, cframe.Position + Vector3.new(0, height / 2, 0))
	return part
end

local function signalStrip(ctx: Ctx, cframe: CFrame, size: Vector3)
	ctx.B:Detail(cframe, size, ctx.Theme.Signal, Enum.Material.Neon)
end

-- Climbable surface (ladder, vines or mesh) against a face, from y0 to y1.
-- `face` is a CFrame on the wall surface, looking away from the wall.
local function climbSurface(ctx: Ctx, face: CFrame, width: number, height: number, kind: string)
	local B, theme = ctx.B, ctx.Theme
	local surface = B:Box(
		face * CFrame.new(0, height / 2, -0.3),
		Vector3.new(width, height, 0.6),
		if kind == "Vines" then Color3.fromRGB(60, 110, 55) else theme.Wall,
		if kind == "Vines" then Enum.Material.LeafyGrass else theme.WallMaterial,
		{ Name = "ClimbSurface", Tag = Tags.Climbable, Attrs = { Kind = kind } }
	)
	if kind == "Ladder" then
		surface.Transparency = 0.6
		for _, x in { -width / 2 + 0.3, width / 2 - 0.3 } do
			B:Detail(
				face * CFrame.new(x, height / 2, -0.9),
				Vector3.new(0.35, height, 0.35),
				Color3.fromRGB(70, 72, 80),
				Enum.Material.Metal
			)
		end
		for y = 1, math.floor(height) - 1, 2 do
			B:Detail(
				face * CFrame.new(0, y, -0.9),
				Vector3.new(width - 0.6, 0.22, 0.22),
				Color3.fromRGB(90, 92, 100),
				Enum.Material.Metal
			)
		end
	elseif kind == "Vines" then
		for i = 1, math.max(2, math.floor(width / 1.5)) do
			local x = -width / 2 + (i - 0.5) * (width / math.max(2, math.floor(width / 1.5)))
			B:Detail(
				face * CFrame.new(x, height / 2, -0.75),
				Vector3.new(0.3, height, 0.3),
				Color3.fromRGB(80, 120, 60),
				Enum.Material.Grass
			)
		end
		for _ = 1, math.floor(height / 3) do
			B:Detail(
				face * CFrame.new(B:Rand(-width / 2, width / 2), B:Rand(0.5, height), -0.9),
				Vector3.new(1.4, 1.1, 0.4),
				Color3.fromRGB(70, B:RandInt(130, 170), 70),
				Enum.Material.LeafyGrass
			)
		end
	else -- Mesh
		surface.Transparency = 0.35
		surface.Material = Enum.Material.DiamondPlate
		for y = 0, math.floor(height), 2 do
			B:Detail(
				face * CFrame.new(0, y, -0.7),
				Vector3.new(width, 0.15, 0.15),
				Color3.fromRGB(150, 155, 160),
				Enum.Material.Metal
			)
		end
		for x = -width / 2, width / 2, 2 do
			B:Detail(
				face * CFrame.new(x, height / 2, -0.7),
				Vector3.new(0.15, height, 0.15),
				Color3.fromRGB(150, 155, 160),
				Enum.Material.Metal
			)
		end
	end
	B:Icon(surface, "#", Color3.fromRGB(150, 230, 140), Vector3.new(0, height / 2 + 1, 0))
	track(ctx, (face * CFrame.new(0, height, 0)).Position)
end

-- Safe landing below a gap, with a ladder back up the far side.
local function recovery(ctx: Ctx, startC: CFrame, gap: number, landY: number)
	if ctx.NoRecovery or gap < 5 then
		return
	end
	if not (ctx.Lane == "A" or (ctx.Lane == nil and ctx.Safe)) then
		return
	end
	local drop = 11
	local y = math.min(0, landY) - drop
	local top = startC * CFrame.new(0, y, -gap / 2)
	ctx.B:Box(
		top * CFrame.new(0, -0.75, 0),
		Vector3.new(ctx.Width + 2, 1.5, gap + 2),
		Color3.fromRGB(70, 130, 180),
		Enum.Material.Fabric,
		{ Name = "RecoveryPad" }
	)
	local mat = ctx.B:Detail(
		top * CFrame.new(0, 0.05, 0),
		Vector3.new(ctx.Width - 1, 0.1, gap - 1),
		Color3.fromRGB(110, 170, 220),
		Enum.Material.Fabric
	)
	ctx.B:Icon(mat, "↺", Color3.fromRGB(150, 210, 255), Vector3.new(0, 2, 0))
	-- Ladder up the front face of the landing platform.
	local face = startC * CFrame.new(0, y, -gap + 0.05) * CFrame.Angles(0, math.rad(180), 0)
	climbSurface(ctx, face, 3, landY - y + 0.2, "Ladder")
	track(ctx, top.Position)
end

local function wallStyle(ctx: Ctx, cframe: CFrame, size: Vector3): BasePart
	if ctx.Theme.WallStyle then
		return ctx.Theme.WallStyle(ctx.B, cframe, size)
	end
	return ctx.B:Box(cframe, size, ctx.Theme.Wall, ctx.Theme.WallMaterial)
end

-- Chevrons painted on a designed wall-run surface.
local function chevrons(ctx: Ctx, wall: BasePart, face: Enum.NormalId, vertical: boolean?)
	ctx.B:Text(wall, face, if vertical then "▲\n▲\n▲" else "»    »    »    »", {
		Color = ctx.Theme.Signal,
		PixelsPerStud = 10,
		LightInfluence = 0,
	})
	ctx.B:Icon(wall, if vertical then "▲" else "»", ctx.Theme.Signal, Vector3.new(0, wall.Size.Y / 2 + 1, 0))
end

local function lowBeam(ctx: Ctx, cframe: CFrame, width: number)
	local beam =
		ctx.B:Box(cframe, Vector3.new(width, 2, 1.4), Color3.fromRGB(240, 196, 40), Enum.Material.SmoothPlastic, {
			Name = "SlideBeam",
			Tag = Tags.LowClearance,
			Group = Tags.Groups.LowClearance,
		})
	for i = -2, 2 do
		ctx.B:Detail(
			cframe * CFrame.new(i * (width / 5), 0, -0.71),
			Vector3.new(width / 10, 2, 0.05),
			Color3.fromRGB(30, 30, 30),
			Enum.Material.SmoothPlastic,
			{ CanCollide = false }
		)
	end
	ctx.B:Icon(beam, "▼", Color3.fromRGB(255, 220, 80), Vector3.new(0, 2.2, 0))
	return beam
end

-- Segments -----------------------------------------------------------------------------------

local S: { [string]: (Ctx, CFrame, { [any]: any }) -> CFrame } = {}

S.Run = function(ctx, c, seg)
	local length = seg[2] or 16
	addPar(ctx, length / M.SprintSpeed)
	return platform(ctx, c, length, seg.W)
end

S.Gap = function(ctx, c, seg)
	local fraction = math.clamp(seg[2] or 0.5, 0.2, 0.95)
	local dy = seg.Rise or 0
	local speed = if seg.Walk then M.WalkSpeed else M.SprintSpeed
	local gap = math.max(fraction * Reach.JumpDistance(dy, speed), 3)
	local landing = seg.L or 14
	token(
		ctx,
		(c * CFrame.new(0, Reach.JumpApex() * 0.7 + 2 + math.max(dy, 0) * 0.5, -gap / 2)).Position,
		if fraction > 0.75 then 3 else 2
	)
	recovery(ctx, c, gap, dy)
	addPar(ctx, gap / speed + 0.1 + landing / M.SprintSpeed)
	return platform(ctx, c * CFrame.new(0, dy, -gap), landing)
end

S.Steps = function(ctx, c, seg)
	local count = seg[2] or 3
	local rise = seg.Rise or 2.5
	for _ = 1, count do
		local gap = math.max(0.42 * Reach.JumpDistance(rise), 2.5)
		c = platform(ctx, c * CFrame.new(0, rise, -gap), 7)
		addPar(ctx, gap / M.SprintSpeed + 0.35)
	end
	return c
end

S.Drop = function(ctx, c, seg)
	local height = seg[2] or 8
	-- A short gap, then a padded landing well below.
	local landC = c * CFrame.new(0, -height, -3)
	local after = platform(ctx, landC, 18, nil, "Landing")
	local pad = ctx.B:Detail(
		landC * CFrame.new(0, 0.06, -6),
		Vector3.new(ctx.Width - 2, 0.12, 8),
		ctx.Theme.Accent,
		Enum.Material.Fabric
	)
	ctx.B:Text(pad, Enum.NormalId.Top, "ROLL", { Color = Color3.new(1, 1, 1), PixelsPerStud = 8 })
	ctx.B:Icon(pad, "@", ctx.Theme.Signal, Vector3.new(0, 1.5, 0))
	token(ctx, (landC * CFrame.new(0, height * 0.5, -3)).Position, 1)
	addPar(ctx, math.sqrt(2 * height / (M.Gravity * M.FallGravityMultiplier)) + 0.15 + 18 / M.SprintSpeed)
	return after
end

S.Vault = function(ctx, c, seg)
	local count = seg[2] or 1
	local length = 10 + count * 10
	local after = platform(ctx, c, length, nil, "Course")
	for i = 1, count do
		local z = 8 + (i - 1) * 10
		local wall = ctx.B:Box(
			c * CFrame.new(0, 1.5, -z),
			Vector3.new(ctx.Width, 3, 1.6),
			ctx.Theme.Trim,
			ctx.Theme.WallMaterial,
			{ Name = "VaultWall" }
		)
		ctx.B:Icon(wall, "^", ctx.Theme.Signal, Vector3.new(0, 2.5, 0))
	end
	require_(ctx, "Vault")
	addPar(ctx, length / M.SprintSpeed + 0.05 * count)
	return after
end

S.Slide = function(ctx, c, seg)
	local count = seg[2] or 1
	local length = 10 + count * 12
	local after = platform(ctx, c, length, nil, "Course")
	for i = 1, count do
		local z = 8 + (i - 1) * 12
		lowBeam(ctx, c * CFrame.new(0, 3.6, -z), ctx.Width)
		-- Solid wall above the beam so it can't be jumped.
		wallStyle(ctx, c * CFrame.new(0, 4.6 + 4, -z), Vector3.new(ctx.Width, 8, 1.4))
	end
	require_(ctx, "Slide")
	addPar(ctx, length / 30)
	return after
end

S.Tunnel = function(ctx, c, seg)
	local length = seg[2] or 14
	local entry = platform(ctx, c, 4, nil, "Course")
	local after = platform(ctx, entry, length, nil, "Course")
	local center = entry * CFrame.new(0, 0, -length / 2)
	-- Low ceiling (crouch or slide), solid sides and roof.
	ctx.B:Box(
		center * CFrame.new(0, 3.3, 0),
		Vector3.new(ctx.Width, 1.4, length),
		Color3.fromRGB(240, 196, 40),
		Enum.Material.SmoothPlastic,
		{
			Name = "TunnelCeiling",
			Tag = Tags.LowClearance,
			Group = Tags.Groups.LowClearance,
		}
	)
	ctx.B:Box(
		center * CFrame.new(0, 5.5, 0),
		Vector3.new(ctx.Width + 2, 3, length),
		ctx.Theme.Wall,
		ctx.Theme.WallMaterial
	)
	for _, side in { -1, 1 } do
		ctx.B:Box(
			center * CFrame.new(side * (ctx.Width / 2 + 0.5), 2.5, 0),
			Vector3.new(1, 5, length),
			ctx.Theme.Wall,
			ctx.Theme.WallMaterial
		)
	end
	local sign = ctx.B:Detail(
		entry * CFrame.new(0, 7.6, 0.2),
		Vector3.new(4, 1.2, 0.2),
		Color3.fromRGB(240, 196, 40),
		Enum.Material.SmoothPlastic
	)
	ctx.B:Text(sign, Enum.NormalId.Back, "CROUCH", { Color = Color3.fromRGB(30, 30, 30) })
	local light =
		ctx.B:Detail(center * CFrame.new(0, 2.5, 0), Vector3.new(0.4, 0.2, 0.4), ctx.Theme.Signal, Enum.Material.Neon)
	ctx.B:Light(light, ctx.Theme.Signal, 14, 0.8)
	require_(ctx, "Slide")
	addPar(ctx, 4 / M.SprintSpeed + length / 16)
	return after
end

S.Ledge = function(ctx, c, seg)
	local height = math.clamp(seg[2] or 8, 4, Reach.LedgeHeight() - 1.4)
	local approach = platform(ctx, c, 6, nil, "Course")
	block(ctx, approach, 0, height, 14)
	local topC = approach * CFrame.new(0, height, 0)
	signalStrip(ctx, topC * CFrame.new(0, -0.15, 0.05), Vector3.new(ctx.Width, 0.3, 0.12))
	local after = platform(ctx, topC, 14, nil, "Course")
	token(ctx, (topC * CFrame.new(0, 2.5, -7)).Position, 1)
	require_(ctx, "LedgeGrab")
	addPar(ctx, 6 / M.SprintSpeed + 0.85 + height * 0.025 + 14 / M.SprintSpeed)
	return after
end

S.WallClimb = function(ctx, c, seg)
	local height = math.clamp(seg[2] or 13, Reach.LedgeHeight() - 1, Reach.WallClimbHeight() - 1.2)
	local approach = platform(ctx, c, 14, nil, "Course")
	local wall = block(ctx, approach, 0, height, 14)
	chevrons(ctx, wall, Enum.NormalId.Back, true)
	local topC = approach * CFrame.new(0, height, 0)
	signalStrip(ctx, topC * CFrame.new(0, -0.15, 0.05), Vector3.new(ctx.Width, 0.3, 0.12))
	local after = platform(ctx, topC, 14, nil, "Course")
	require_(ctx, "WallRun")
	require_(ctx, "LedgeGrab")
	addPar(ctx, 14 / M.SprintSpeed + 1.1 + 14 / M.SprintSpeed)
	return after
end

S.Shimmy = function(ctx, c, seg)
	local length = seg[2] or 14
	-- Shift sideways away from the centre lane.
	local side = if ctx.LaneSign ~= 0 then ctx.LaneSign else (seg.Side == "L" and -1 or 1)
	local B, theme = ctx.B, ctx.Theme
	local lipTop = 2.5
	-- The wall ahead, across the void, with a lip to hang from.
	local wallCenter = c * CFrame.new(side * (length / 2 + 1), lipTop - 7, -3.2)
	B:Box(wallCenter, Vector3.new(length + 8, 14, 2), theme.Wall, theme.WallMaterial, { Name = "ShimmyWall" })
	signalStrip(ctx, c * CFrame.new(side * (length / 2 + 1), lipTop - 0.15, -2.15), Vector3.new(length + 8, 0.3, 0.1))
	-- An overhang above the lip stops you climbing up until the far end.
	B:Box(
		c * CFrame.new(side * (length / 2 - 2), lipTop + 2.4, -3.6),
		Vector3.new(length + 2, 1.2, 4),
		theme.Trim,
		theme.WallMaterial,
		{ Name = "Overhang", Attrs = { NoLedge = true } }
	)
	-- Exit platform at the far end, flush with the lip.
	local exitC = c * CFrame.new(side * (length + 2), lipTop, -2.2)
	local after = platform(ctx, exitC, 12, nil, "Course")
	recovery(ctx, c * CFrame.new(side * (length / 2), 0, 0), 4, lipTop)
	token(ctx, (c * CFrame.new(side * (length / 2), lipTop - 2, -1.5)).Position, 2)
	require_(ctx, "LedgeGrab")
	addPar(ctx, 0.8 + length / M.ShimmySpeed + 0.5 + 12 / M.SprintSpeed)
	return after
end

S.Climb = function(ctx, c, seg)
	local height = math.clamp(seg[2] or 12, 4, 24)
	local kind = seg.Type or ctx.Theme.Climb
	local approach = platform(ctx, c, 6, nil, "Course")
	block(ctx, approach, 0, height, 14)
	local face = approach * CFrame.Angles(0, math.rad(180), 0) * CFrame.new(0, 0, 0.05)
	-- `face` looks back toward the player; the climb surface sits on the block's front face.
	climbSurface(ctx, face * CFrame.Angles(0, 0, 0), 4, height + 0.4, kind)
	local topC = approach * CFrame.new(0, height, 0)
	local after = platform(ctx, topC, 14, nil, "Course")
	require_(ctx, "Climb")
	addPar(ctx, 6 / M.SprintSpeed + height / M.ClimbUpSpeed + 0.7 + 14 / M.SprintSpeed)
	return after
end

S.WallRun = function(ctx, c, seg)
	local seconds = math.clamp(seg[2] or 0.8, 0.4, 1.25)
	local side = if seg.Side == "L" then -1 else 1
	local run, drop = Reach.WallRun(seconds * 1.1)
	local gap = 6 + run * 0.86
	local landY = -(drop + 1.5)
	local B = ctx.B
	local wallLength = gap + 4
	local wall = wallStyle(
		ctx,
		c * CFrame.new(side * 5, (12 + landY - 8) / 2, -(gap / 2 + 0)),
		Vector3.new(2, 12 - (landY - 8), wallLength)
	)
	wall.Name = "RunWall"
	chevrons(ctx, wall, if side > 0 then Enum.NormalId.Left else Enum.NormalId.Right)
	B:Detail(
		c * CFrame.new(side * 3.95, 4, -gap / 2),
		Vector3.new(0.1, 0.4, wallLength),
		ctx.Theme.Signal,
		Enum.Material.Neon
	)
	token(ctx, (c * CFrame.new(side * 2.6, 3.5, -gap * 0.55)).Position, 2)
	track(ctx, wall.Position)
	recovery(ctx, c, gap, landY)
	require_(ctx, "WallRun")
	addPar(ctx, gap / M.WallRunSpeed + 0.2 + 14 / M.SprintSpeed)
	return platform(ctx, c * CFrame.new(0, landY, -gap), 14)
end

S.TicTac = function(ctx, c, seg)
	local count = math.clamp(seg[2] or 2, 2, 4)
	local side = if seg.Side == "R" then 1 else -1
	local stride = 16
	local gap = 6 + count * stride + 2
	for i = 0, count - 1 do
		local s = if i % 2 == 0 then side else -side
		local z0 = 4 + i * stride
		local wall = wallStyle(ctx, c * CFrame.new(s * 5, 2, -(z0 + stride / 2)), Vector3.new(2, 20, stride + 6))
		wall.Name = "RunWall"
		chevrons(ctx, wall, if s > 0 then Enum.NormalId.Left else Enum.NormalId.Right)
		track(ctx, wall.Position)
	end
	token(ctx, (c * CFrame.new(0, 5, -gap / 2)).Position, 3)
	recovery(ctx, c, gap, -2)
	require_(ctx, "WallRun")
	require_(ctx, "WallJump")
	addPar(ctx, gap / 24 + 14 / M.SprintSpeed)
	return platform(ctx, c * CFrame.new(0, -2, -gap), 14)
end

S.Shaft = function(ctx, c, seg)
	local height = math.clamp(seg[2] or 16, 8, 24)
	local B = ctx.B
	local floor = platform(ctx, c, 12, nil, "Course")
	for _, side in { -1, 1 } do
		local wall = wallStyle(ctx, c * CFrame.new(side * 5, height / 2 + 2, -8), Vector3.new(2, height + 4, 12))
		wall.Name = "ShaftWall"
		B:Text(
			wall,
			if side > 0 then Enum.NormalId.Left else Enum.NormalId.Right,
			"<>",
			{ Color = ctx.Theme.Signal, PixelsPerStud = 6 }
		)
		track(ctx, wall.Position + Vector3.new(0, height / 2, 0))
	end
	block(ctx, floor, 0, height, 14)
	local topC = floor * CFrame.new(0, height, 0)
	signalStrip(ctx, topC * CFrame.new(0, -0.15, 0.05), Vector3.new(ctx.Width, 0.3, 0.12))
	token(ctx, (c * CFrame.new(0, height * 0.6, -7)).Position, 2)
	require_(ctx, "WallJump")
	local kicks = math.max(1, math.ceil((height - Reach.LedgeHeight() + 3) / Reach.ShaftKickRise(8)))
	addPar(ctx, 12 / M.SprintSpeed + 0.4 + kicks * 0.3 + 0.6 + 14 / M.SprintSpeed)
	return platform(ctx, topC, 14, nil, "Course")
end

S.Balance = function(ctx, c, seg)
	local length = seg[2] or 20
	local rise = seg.Rise or 0
	local B, theme = ctx.B, ctx.Theme
	local a = c.Position + Vector3.new(0, -0.5, 0)
	local endC = c * CFrame.new(0, rise, -length)
	local b = endC.Position + Vector3.new(0, -0.5, 0)
	local beam = B:Beam(a, b, 1.3, 1, theme.Beam, theme.BeamMaterial, { Name = "BalanceBeam", Tag = Tags.Balance })
	-- Dashed centre line marks a balance surface.
	local dashes = math.clamp(math.floor(length / 3), 2, 7)
	for i = 1, dashes - 1 do
		local t = i / dashes
		local p = a:Lerp(b, t) + Vector3.new(0, 0.52, 0)
		B:Detail(CFrame.lookAt(p, p + (b - a)), Vector3.new(0.18, 0.04, 1.2), Color3.new(1, 1, 1), Enum.Material.Neon)
	end
	B:Icon(beam, "=", Color3.fromRGB(240, 240, 255), Vector3.new(0, 2, 0))
	track(ctx, a)
	track(ctx, b)
	recovery(ctx, c, length, rise)
	token(ctx, (c * CFrame.new(0, rise / 2 + 2.5, -length / 2)).Position, 1)
	require_(ctx, "Balance")
	addPar(ctx, length / M.BalanceSpeed + 14 / M.SprintSpeed)
	return platform(ctx, endC, 14)
end

S.Zip = function(ctx, c, seg)
	local length = seg[2] or 50
	local drop = seg.Drop or 10
	local B = ctx.B
	local cableHeight = 7.8
	local a = (c * CFrame.new(0, cableHeight, -3)).Position
	local b = (c * CFrame.new(0, cableHeight - drop + 1.5, -length)).Position
	-- Posts at both ends.
	B:Box(
		c * CFrame.new(1.6, cableHeight / 2 + 0.5, -3),
		Vector3.new(0.8, cableHeight + 1, 0.8),
		Color3.fromRGB(80, 80, 90),
		Enum.Material.Metal
	)
	local endC = c * CFrame.new(0, -drop, -(length - 6))
	B:Box(
		endC * CFrame.new(1.6, (cableHeight + 1.5) / 2 + 0.5, -6),
		Vector3.new(0.8, cableHeight + 2.5, 0.8),
		Color3.fromRGB(80, 80, 90),
		Enum.Material.Metal
	)
	local cable = B:Rod(a, b, 0.25, Color3.fromRGB(40, 40, 45), Enum.Material.Metal, {
		Name = "ZiplineCable",
		CanCollide = false,
		Tag = Tags.Zipline,
		Attrs = { A = a, B = b },
	})
	B:Icon(cable, "~", ctx.Theme.Signal, Vector3.new(0, 1.5, 0))
	-- A step up to reach the cable comfortably.
	B:Box(
		c * CFrame.new(0, 0.6, -1.5),
		Vector3.new(4, 1.2, 3),
		ctx.Theme.Trim,
		ctx.Theme.SurfaceMaterial,
		{ Name = "ZipStep" }
	)
	track(ctx, a)
	track(ctx, b)
	token(ctx, (a:Lerp(b, 0.55)) - Vector3.new(0, 3.5, 0), 1)
	require_(ctx, "Zipline")
	local avg = math.clamp(M.ZipMinSpeed + drop * 1.2, M.ZipFlatSpeed, M.ZipMaxSpeed * 0.8)
	addPar(ctx, 0.6 + length / avg + 16 / M.SprintSpeed)
	return platform(ctx, endC, 16)
end

S.Rope = function(ctx, c, seg)
	local count = math.clamp(seg[2] or 2, 1, 4)
	local B, theme = ctx.B, ctx.Theme
	local spacing = 15
	local first = 7
	local gap = first + (count - 1) * spacing + 12
	local pivotY = 15
	-- Overhead support beam with end posts.
	B:Box(
		c * CFrame.new(0, pivotY + 0.6, -gap / 2),
		Vector3.new(1.2, 1.2, gap + 2),
		theme.Trim,
		theme.WallMaterial,
		{ Name = "RopeBeam" }
	)
	for _, z in { -1, -(gap + 1) } do
		B:Box(
			c * CFrame.new(ctx.Width / 2 - 1, pivotY / 2 - 3, z),
			Vector3.new(1.2, pivotY + 6, 1.2),
			theme.Trim,
			theme.WallMaterial
		)
	end
	for i = 0, count - 1 do
		local pivot = (c * CFrame.new(0, pivotY, -(first + i * spacing))).Position
		local ropeLength = 11
		local bottom = pivot - Vector3.new(0, ropeLength, 0)
		local rope = B:Rod(pivot, bottom, 0.4, theme.Rope, Enum.Material.Fabric, {
			Name = "SwingRope",
			CanCollide = false,
			Tag = Tags.SwingRope,
			Attrs = { Pivot = pivot, Length = ropeLength },
		})
		B:Ball(bottom, 0.9, theme.Rope, Enum.Material.Fabric, { Decor = true, CanCollide = false, Name = "RopeKnot" })
		B:Icon(rope, "Y", ctx.Theme.Signal, Vector3.new(0, -2, 0))
		token(ctx, bottom + Vector3.new(0, -1, -spacing / 2), 1)
	end
	track(ctx, (c * CFrame.new(0, pivotY + 1, 0)).Position)
	recovery(ctx, c, gap, 0)
	require_(ctx, "RopeSwing")
	addPar(ctx, count * 1.15 + 0.6 + 14 / M.SprintSpeed)
	return platform(ctx, fwd(c, gap), 14)
end

local function anchorPart(ctx: Ctx, position: Vector3, pull: boolean)
	local B = ctx.B
	if ctx.Theme.AnchorMount then
		ctx.Theme.AnchorMount(B, position)
	end
	if pull then
		local part = B:Box(
			CFrame.new(position) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
			Vector3.new(2.2, 2.2, 2.2),
			Color3.fromRGB(255, 150, 50),
			Enum.Material.Neon,
			{
				Name = "PullAnchor",
				Tag = Tags.PullAnchor,
				CanCollide = false,
			}
		)
		B:Icon(part, "◆", Color3.fromRGB(255, 170, 70), Vector3.new(0, 2.6, 0))
		B:Light(part, Color3.fromRGB(255, 150, 50), 12, 0.8)
	else
		local part = B:Ball(position, 2.4, Color3.fromRGB(90, 230, 255), Enum.Material.Neon, {
			Name = "GrappleAnchor",
			Tag = Tags.GrappleAnchor,
			CanCollide = false,
		})
		B:Cylinder(
			CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
			0.4,
			4.2,
			Color3.fromRGB(220, 250, 255),
			Enum.Material.Neon,
			{ Decor = true, CanCollide = false }
		)
		B:Icon(part, "◎", Color3.fromRGB(120, 235, 255), Vector3.new(0, 2.8, 0))
		B:Light(part, Color3.fromRGB(90, 230, 255), 12, 0.8)
	end
	track(ctx, position)
end

S.Grapple = function(ctx, c, seg)
	local count = math.clamp(seg[2] or 1, 1, 4)
	local spacing = 30
	local gap = 12 + (count - 1) * spacing + 20
	for i = 0, count - 1 do
		anchorPart(ctx, (c * CFrame.new(0, 19, -(14 + i * spacing))).Position, false)
	end
	token(ctx, (c * CFrame.new(0, 6, -gap * 0.5)).Position, 2)
	recovery(ctx, c, gap, 0)
	require_(ctx, "Grapple")
	addPar(ctx, count * 1.35 + 0.5 + 14 / M.SprintSpeed)
	return platform(ctx, fwd(c, gap), 14)
end

S.Pull = function(ctx, c, seg)
	local height = math.clamp(seg[2] or 16, 12, 26)
	local approach = platform(ctx, c, 10, nil, "Course")
	block(ctx, approach, 0, height, 14)
	local topC = approach * CFrame.new(0, height, 0)
	anchorPart(ctx, (topC * CFrame.new(0, 2.5, -1.5)).Position, true)
	require_(ctx, "GrapplePull")
	addPar(ctx, 10 / M.SprintSpeed + height / M.PullSpeed + 0.7 + 14 / M.SprintSpeed)
	return platform(ctx, topC, 14, nil, "Course")
end

S.DoubleGap = function(ctx, c, seg)
	local fraction = math.clamp(seg[2] or 0.75, 0.3, 0.97)
	local dy = seg.Rise or 0
	local single = Reach.JumpDistance(dy)
	local double = Reach.DoubleJumpDistance(dy)
	local gap = single + 2 + (double - single - 2) * fraction
	token(ctx, (c * CFrame.new(0, Reach.DoubleJumpApex() * 0.75 + math.max(dy, 0) * 0.3, -gap / 2)).Position, 3)
	recovery(ctx, c, gap, dy)
	require_(ctx, "DoubleJump")
	addPar(ctx, gap / M.SprintSpeed + 0.2 + 14 / M.SprintSpeed)
	return platform(ctx, c * CFrame.new(0, dy, -gap), 14)
end

S.DashGap = function(ctx, c, seg)
	local fraction = math.clamp(seg[2] or 0.75, 0.3, 0.97)
	local dy = seg.Rise or 0
	local single = Reach.JumpDistance(dy)
	local dash = Reach.DashJumpDistance(dy)
	local gap = single + 2 + (dash - single - 2) * fraction
	token(ctx, (c * CFrame.new(0, Reach.JumpApex() + 1, -gap / 2)).Position, 3)
	recovery(ctx, c, gap, dy)
	require_(ctx, "Dash")
	addPar(ctx, gap / (M.SprintSpeed + 6) + 0.1 + 14 / M.SprintSpeed)
	return platform(ctx, c * CFrame.new(0, dy, -gap), 14)
end

S.Bounce = function(ctx, c, seg)
	local height = math.clamp(seg[2] or 12, 6, 30)
	local B = ctx.B
	local approach = platform(ctx, c, 10, nil, "Course")
	local padCF = fwd(c, 5) * CFrame.new(0, 0.25, 0)
	local pad = B:Cylinder(
		padCF * CFrame.Angles(0, 0, math.rad(90)),
		0.5,
		6,
		Color3.fromRGB(120, 255, 170),
		Enum.Material.Neon,
		{
			Name = "BouncePad",
			Tag = Tags.BouncePad,
			Attrs = { Power = Reach.LaunchSpeedFor(height + 2) },
		}
	)
	B:Icon(pad, "⇈", Color3.fromRGB(150, 255, 190), Vector3.new(0, 2, 0))
	block(ctx, approach, 1, height, 14)
	local topC = approach * CFrame.new(0, height, -1)
	token(ctx, (fwd(c, 5) * CFrame.new(0, height * 0.7, 0)).Position, 2)
	addPar(ctx, 10 / M.SprintSpeed + 0.9 + 14 / M.SprintSpeed)
	return platform(ctx, topC, 14, nil, "Course")
end

S.Vent = function(ctx, c, seg)
	local height = math.clamp(seg[2] or 12, 6, 30)
	local period = seg.Period or 3.4
	local B = ctx.B
	local approach = platform(ctx, c, 10, nil, "Course")
	local ventCF = fwd(c, 5)
	B:Box(
		ventCF * CFrame.new(0, 0.15, 0),
		Vector3.new(5, 0.3, 5),
		Color3.fromRGB(60, 62, 68),
		Enum.Material.DiamondPlate,
		{ Name = "VentGrate" }
	)
	local zone =
		B:Box(ventCF * CFrame.new(0, 2.5, 0), Vector3.new(5, 5, 5), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, {
			Name = "LaunchVent",
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			Tag = Tags.LaunchVent,
			Attrs = {
				Power = Reach.LaunchSpeedFor(height + 2),
				Period = period,
				OnFraction = 0.38,
				Phase = (ctx.B:Rand(0, 1)),
				Warn = 0.8,
			},
		})
	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(0, -2.3, 0)
	attachment.Parent = zone
	B:Emitter(attachment, "Steam", Color3.fromRGB(235, 235, 240))
	B:Icon(zone, "⇈", Color3.fromRGB(255, 200, 120), Vector3.new(0, 2, 0))
	block(ctx, approach, 1, height, 14)
	local topC = approach * CFrame.new(0, height, -1)
	addPar(ctx, 10 / M.SprintSpeed + period * 0.4 + 0.9 + 14 / M.SprintSpeed)
	return platform(ctx, topC, 14, nil, "Course")
end

S.Movers = function(ctx, c, seg)
	local count = math.clamp(seg[2] or 1, 1, 3)
	local mode = seg.Mode or "Linear"
	local B = ctx.B
	local cursor = c
	for i = 1, count do
		local phase = (i - 1) * 0.37
		if mode == "Linear" then
			local gap = 26
			local start = cursor * CFrame.new(0, -0.5, -4.5)
			local part = B:Box(start, Vector3.new(8, 1, 8), ctx.Theme.Accent, Enum.Material.DiamondPlate, {
				Name = "MovingPlatform",
				Tag = Tags.Mover,
				Attrs = {
					Kind = "Shuttle",
					Origin = start,
					Offset = (cursor * CFrame.new(0, 0, -(gap - 4.5))).Position
						- (cursor * CFrame.new(0, 0, -4.5)).Position,
					Period = 6,
					Phase = phase,
					Hold = 0.35,
				},
			})
			B:Icon(part, "↔", ctx.Theme.Signal, Vector3.new(0, 2, 0))
			track(ctx, (cursor * CFrame.new(0, 0, -gap)).Position)
			recovery(ctx, cursor, gap, 0)
			cursor = platform(ctx, fwd(cursor, gap), 9)
			addPar(ctx, 3.2)
		elseif mode == "Pendulum" then
			local gap = 24
			local pivot = (cursor * CFrame.new(0, 16, -gap / 2)).Position
			local rest = cursor * CFrame.new(0, -1, -gap / 2)
			local axis = cursor.RightVector
			B:Box(
				CFrame.new(pivot),
				Vector3.new(3, 1, 3),
				Color3.fromRGB(70, 70, 76),
				Enum.Material.Metal,
				{ Name = "Pivot" }
			)
			B:Box(
				CFrame.new((pivot + rest.Position) / 2),
				Vector3.new(0.4, 16.5, 0.4),
				Color3.fromRGB(60, 60, 64),
				Enum.Material.Metal,
				{
					Name = "SwingChain",
					CanCollide = false,
					Tag = Tags.Mover,
					Attrs = {
						Kind = "PendulumRod",
						Pivot = pivot,
						Axis = axis,
						Amplitude = math.rad(24),
						Period = 4.2,
						Phase = phase,
						Origin = CFrame.new((pivot + rest.Position) / 2),
					},
				}
			)
			local cargo = B:Box(rest, Vector3.new(9, 2, 9), Color3.fromRGB(196, 120, 60), Enum.Material.WoodPlanks, {
				Name = "SwingCargo",
				Tag = Tags.Mover,
				Attrs = {
					Kind = "Pendulum",
					Pivot = pivot,
					Axis = axis,
					Amplitude = math.rad(24),
					Period = 4.2,
					Phase = phase,
					Origin = rest,
				},
			})
			B:Icon(cargo, "≈", ctx.Theme.Signal, Vector3.new(0, 2.5, 0))
			track(ctx, pivot)
			recovery(ctx, cursor, gap, 0)
			cursor = platform(ctx, fwd(cursor, gap), 9)
			addPar(ctx, 2.8)
		elseif mode == "Orbit" then
			local gap = 30
			local center = (cursor * CFrame.new(0, -0.5, -gap / 2)).Position
			for k = 0, 1 do
				local part = B:Box(
					CFrame.new(center + Vector3.new(9, 0, 0)),
					Vector3.new(7, 1, 7),
					ctx.Theme.Accent,
					Enum.Material.Marble,
					{
						Name = "OrbitPlatform",
						Tag = Tags.Mover,
						Attrs = {
							Kind = "Orbit",
							Center = center,
							Radius = 10,
							Period = 9,
							Phase = phase + k * 0.5,
							Origin = CFrame.new(center),
						},
					}
				)
				B:Icon(part, "○", ctx.Theme.Signal, Vector3.new(0, 2, 0))
			end
			local core = B:Ball(
				center + Vector3.new(0, -4, 0),
				3,
				ctx.Theme.Signal,
				Enum.Material.Neon,
				{ Decor = true, CanCollide = false }
			)
			B:Light(core, ctx.Theme.Signal, 20, 1)
			track(ctx, center + Vector3.new(14, 0, 14))
			track(ctx, center - Vector3.new(14, 0, 14))
			cursor = platform(ctx, fwd(cursor, gap), 9)
			addPar(ctx, 4)
		else -- Elevator
			local rise = 16
			local start = cursor * CFrame.new(0, -0.5, -5)
			local part = B:Box(start, Vector3.new(8, 1, 8), ctx.Theme.Accent, Enum.Material.DiamondPlate, {
				Name = "Elevator",
				Tag = Tags.Mover,
				Attrs = {
					Kind = "Shuttle",
					Origin = start,
					Offset = Vector3.new(0, rise, 0),
					Period = 7,
					Phase = phase,
					Hold = 0.4,
				},
			})
			B:Icon(part, "↕", ctx.Theme.Signal, Vector3.new(0, 2, 0))
			-- Guide rails.
			for _, x in { -4.6, 4.6 } do
				B:Detail(
					cursor * CFrame.new(x, rise / 2, -5),
					Vector3.new(0.4, rise + 4, 0.4),
					Color3.fromRGB(90, 90, 96),
					Enum.Material.Metal
				)
			end
			local topC = cursor * CFrame.new(0, rise, -9)
			block(ctx, cursor, 9, rise, 12)
			cursor = platform(ctx, topC, 12, nil, "Course")
			addPar(ctx, 4.5)
		end
	end
	return cursor
end

S.Collapse = function(ctx, c, seg)
	local length = seg[2] or 20
	local B = ctx.B
	local plank = 4
	local count = math.max(2, math.floor(length / plank))
	for i = 0, count - 1 do
		local cf = c * CFrame.new(0, -0.6, -(i + 0.5) * plank)
		local part =
			B:Box(cf, Vector3.new(ctx.Width - 2, 1.2, plank - 0.25), ctx.Theme.Beam, Enum.Material.WoodPlanks, {
				Name = "CollapsePlank",
				Tag = Tags.Collapse,
				Attrs = { Delay = 0.45, Respawn = 3.5, Origin = cf },
			})
		-- Cracks make it read as fragile.
		B:Detail(
			cf * CFrame.new(B:Rand(-2, 2), 0.61, 0),
			Vector3.new(0.15, 0.04, plank * 0.8),
			Color3.fromRGB(40, 30, 25),
			Enum.Material.SmoothPlastic
		)
		if i % 3 == 0 then
			B:Icon(part, "!", Color3.fromRGB(255, 190, 90), Vector3.new(0, 2, 0))
		end
		track(ctx, cf.Position)
	end
	recovery(ctx, c, count * plank, 0)
	require_(ctx, "Sprint")
	addPar(ctx, length / M.SprintSpeed + 0.2 + 12 / M.SprintSpeed)
	return platform(ctx, fwd(c, count * plank), 12)
end

S.Retract = function(ctx, c, seg)
	local length = seg[2] or 28
	local B = ctx.B
	local section = 8
	local count = math.max(2, math.floor(length / section))
	for i = 0, count - 1 do
		local side = if i % 2 == 0 then 1 else -1
		local cf = c * CFrame.new(0, -0.6, -(i + 0.5) * section)
		local part = B:Box(
			cf,
			Vector3.new(ctx.Width, 1.2, section - 0.3),
			Color3.fromRGB(120, 125, 135),
			Enum.Material.DiamondPlate,
			{
				Name = "RetractBridge",
				Tag = Tags.Timed,
				Attrs = {
					Kind = "Retract",
					Origin = cf,
					Offset = c.RightVector * side * (ctx.Width + 1),
					Period = 5,
					OnFraction = 0.6,
					Phase = i * 0.09,
					Warn = 0.8,
				},
			}
		)
		-- Housing the bridge slides into, with warning lamps.
		local housing = B:Box(
			c * CFrame.new(side * (ctx.Width + 1.5), -0.6, -(i + 0.5) * section),
			Vector3.new(ctx.Width, 2.4, section),
			Color3.fromRGB(70, 72, 80),
			Enum.Material.Metal
		)
		local lamp = B:Detail(
			housing.CFrame * CFrame.new(-side * (ctx.Width / 2), 1.4, 0),
			Vector3.new(0.6, 0.6, 0.6),
			Color3.fromRGB(255, 170, 40),
			Enum.Material.Neon,
			{
				Tag = Tags.Timed,
				Attrs = { Kind = "Lamp", Period = 5, OnFraction = 0.6, Phase = i * 0.09, Warn = 0.8 },
			}
		)
		lamp.Name = "WarnLamp"
		B:Icon(part, "⇄", Color3.fromRGB(255, 190, 90), Vector3.new(0, 2, 0))
		track(ctx, housing.Position)
	end
	recovery(ctx, c, count * section, 0)
	addPar(ctx, length / M.SprintSpeed + 1.5 + 12 / M.SprintSpeed)
	return platform(ctx, fwd(c, count * section), 12)
end

S.Spinner = function(ctx, c, seg)
	local mode = seg.Mode or "Platform"
	local B = ctx.B
	if mode == "Platform" then
		local gap = 32
		local center = c * CFrame.new(0, -0.6, -gap / 2)
		local hub = B:Column(
			(center * CFrame.new(0, -12, 0)).Position,
			11.4,
			3,
			Color3.fromRGB(80, 82, 90),
			Enum.Material.Metal
		)
		hub.Name = "SpinnerHub"
		local bar = B:Box(center, Vector3.new(4, 1.2, 30), ctx.Theme.Accent, Enum.Material.DiamondPlate, {
			Name = "SpinnerBeam",
			Tag = Tags.Mover,
			Attrs = { Kind = "Spin", Origin = center, Speed = 34 },
		})
		B:Icon(bar, "⟳", ctx.Theme.Signal, Vector3.new(0, 2, 0))
		track(ctx, center.Position + Vector3.new(16, 0, 16))
		track(ctx, center.Position - Vector3.new(16, 0, 16))
		recovery(ctx, c, gap, 0)
		addPar(ctx, 3.5)
		return platform(ctx, fwd(c, gap), 12)
	end
	-- Sweeper: a round floor with a rotating bar to jump over.
	local radius = 13
	local center = c * CFrame.new(0, 0, -radius - 1)
	B:Cylinder(
		center * CFrame.new(0, -1, 0) * CFrame.Angles(0, 0, math.rad(90)),
		2,
		radius * 2,
		ctx.Theme.Surface,
		ctx.Theme.SurfaceMaterial,
		{ Name = "SweeperFloor" }
	)
	local sweeper = B:Box(
		center * CFrame.new(0, 1.3, 0),
		Vector3.new(1.2, 1.4, radius * 2 - 1),
		Color3.fromRGB(240, 80, 60),
		Enum.Material.Neon,
		{
			Name = "Sweeper",
			CanCollide = false,
			Tag = Tags.Mover,
			Attrs = { Kind = "Spin", Origin = center * CFrame.new(0, 1.3, 0), Speed = 75, Sweeper = true },
		}
	)
	B:Icon(sweeper, "⚠", Color3.fromRGB(255, 120, 90), Vector3.new(0, 2, 0))
	B:Column((center * CFrame.new(0, 0, 0)).Position, 2.2, 1.6, Color3.fromRGB(70, 70, 76), Enum.Material.Metal)
	track(ctx, center.Position + Vector3.new(radius, 0, radius))
	track(ctx, center.Position - Vector3.new(radius, 0, radius))
	addPar(ctx, radius * 2 / M.SprintSpeed + 0.8)
	return platform(ctx, fwd(c, radius * 2 + 2), 12)
end

S.Doors = function(ctx, c, seg)
	local count = math.clamp(seg[2] or 2, 1, 4)
	local B, theme = ctx.B, ctx.Theme
	local spacing = 11
	local length = 8 + count * spacing
	local after = platform(ctx, c, length, nil, "Course")
	local center = fwd(c, length / 2)
	for _, side in { -1, 1 } do
		B:Box(
			center * CFrame.new(side * (ctx.Width / 2 + 0.6), 5, 0),
			Vector3.new(1.2, 10, length),
			theme.Wall,
			theme.WallMaterial
		)
	end
	B:Box(center * CFrame.new(0, 10.6, 0), Vector3.new(ctx.Width + 2.4, 1.2, length), theme.Wall, theme.WallMaterial)
	for i = 1, count do
		local z = 6 + (i - 1) * spacing
		local closed = c * CFrame.new(0, 4.6, -z)
		local phase = -(i - 1) * 0.16
		local door =
			B:Box(closed, Vector3.new(ctx.Width, 9.2, 1.2), Color3.fromRGB(150, 60, 50), Enum.Material.DiamondPlate, {
				Name = "TimedDoor",
				Tag = Tags.Timed,
				Attrs = {
					Kind = "Door",
					Origin = closed,
					Offset = Vector3.new(0, 9, 0),
					Period = 4.4,
					OnFraction = 0.5,
					Phase = phase,
					Warn = 0.7,
				},
			})
		B:Icon(door, "▮", Color3.fromRGB(255, 150, 120), Vector3.new(0, 5.4, 0))
		local lamp = B:Detail(
			c * CFrame.new(0, 10, -(z - 0.8)),
			Vector3.new(2, 0.5, 0.3),
			Color3.fromRGB(80, 255, 120),
			Enum.Material.Neon,
			{
				Tag = Tags.Timed,
				Attrs = { Kind = "Lamp", Period = 4.4, OnFraction = 0.5, Phase = phase, Warn = 0.7, Traffic = true },
			}
		)
		lamp.Name = "DoorLamp"
	end
	addPar(ctx, length / M.SprintSpeed + 1.6)
	return after
end

S.Switch = function(ctx, c, seg)
	local B = ctx.B
	local length = 26
	local id = ("%s_switch_%d"):format(ctx.Id, B:RandInt(1000, 9999))
	local after = platform(ctx, c, length, nil, "Course")
	local plateCF = c * CFrame.new(0, 0.15, -4)
	local plate = B:Box(plateCF, Vector3.new(5, 0.3, 5), Color3.fromRGB(80, 200, 255), Enum.Material.Neon, {
		Name = "PressurePlate",
		Tag = Tags.Switch,
		Attrs = { SwitchId = id, Duration = seg.Duration or 5.5 },
	})
	B:Icon(plate, "⊙", Color3.fromRGB(120, 220, 255), Vector3.new(0, 2, 0))
	B:Box(
		c * CFrame.new(0, 1, -12),
		Vector3.new(ctx.Width, 2.4, 1.4),
		ctx.Theme.Trim,
		ctx.Theme.WallMaterial,
		{ Name = "VaultWall" }
	)
	local gateCF = c * CFrame.new(0, 5, -(length - 1))
	local gate = B:Box(gateCF, Vector3.new(ctx.Width, 10, 1), Color3.fromRGB(80, 200, 255), Enum.Material.ForceField, {
		Name = "SwitchGate",
		Tag = Tags.SwitchGate,
		Attrs = { SwitchId = id, Origin = gateCF, Offset = Vector3.new(0, -10.5, 0) },
	})
	B:Text(gate, Enum.NormalId.Back, "STEP ON THE PLATE", { Color = Color3.new(1, 1, 1), PixelsPerStud = 8 })
	for _, side in { -1, 1 } do
		B:Box(
			c * CFrame.new(side * (ctx.Width / 2 + 0.5), 5, -(length - 1)),
			Vector3.new(1, 10, 1.4),
			ctx.Theme.Wall,
			ctx.Theme.WallMaterial
		)
	end
	addPar(ctx, length / M.SprintSpeed + 0.4)
	return after
end

S.Lasers = function(ctx, c, seg)
	local count = math.clamp(seg[2] or 3, 1, 5)
	local pattern = seg.Pattern or "Alternate"
	local B = ctx.B
	local spacing = 8
	local length = 8 + count * spacing
	local after = platform(ctx, c, length, nil, "Course")
	local red = Color3.fromRGB(255, 50, 70)
	for i = 1, count do
		local z = 5 + (i - 1) * spacing
		for _, side in { -1, 1 } do
			B:Box(
				c * CFrame.new(side * (ctx.Width / 2 + 0.4), 3.5, -z),
				Vector3.new(0.8, 7, 0.8),
				Color3.fromRGB(40, 40, 46),
				Enum.Material.Metal,
				{ Name = "LaserPost" }
			)
		end
		local function beam(y: number, attrs: { [string]: any }?)
			local cf = c * CFrame.new(0, y, -z)
			local options = {
				Name = "Laser",
				CanCollide = false,
				CanQuery = false,
				CastShadow = false,
				Tag = Tags.Hazard,
				Attrs = attrs,
			}
			local part = B:Box(cf, Vector3.new(ctx.Width, 0.3, 0.3), red, Enum.Material.Neon, options)
			part.CanTouch = true
			if attrs then
				B:Tag(part, Tags.Timed)
			end
			B:Icon(part, "⚠", Color3.fromRGB(255, 120, 120), Vector3.new(0, 1.2, 0), 26)
			return part
		end
		if pattern == "Sweep" then
			local cf = c * CFrame.new(0, 0.9, -z)
			beam(
				0.9,
				{ Kind = "LaserSweep", Origin = cf, Offset = Vector3.new(0, 4.6, 0), Period = 3.2, Phase = i * 0.21 }
			)
		elseif pattern == "Grid" then
			-- Fixed: low beams to jump, high beams to slide under.
			if i % 2 == 1 then
				beam(0.9, nil)
			else
				beam(3.4, nil)
				B:Box(c * CFrame.new(0, 7, -z), Vector3.new(ctx.Width, 6, 0.6), ctx.Theme.Wall, ctx.Theme.WallMaterial)
			end
		else -- Alternate
			beam(1.2, { Kind = "Laser", Period = 2.6, OnFraction = 0.5, Phase = (i % 2) * 0.5, Warn = 0.45 })
			beam(3.2, { Kind = "Laser", Period = 2.6, OnFraction = 0.5, Phase = (i % 2) * 0.5, Warn = 0.45 })
		end
	end
	addPar(ctx, length / M.SprintSpeed + count * 0.35)
	return after
end

S.Water = function(ctx, c, seg)
	ctx.Water = { StartCP = #ctx.Checkpoints, Rate = seg.Rate or 1.8 }
	return c
end

S.Conveyor = function(ctx, c, seg)
	local length = seg[2] or 30
	local dir = seg.Dir or 1
	local speed = 14
	local B = ctx.B
	local center = c * CFrame.new(0, -0.6, -length / 2)
	local belt =
		B:Box(center, Vector3.new(ctx.Width - 1, 1.2, length), Color3.fromRGB(45, 46, 50), Enum.Material.Rubber, {
			Name = "Conveyor",
			Tag = Tags.Conveyor,
			Attrs = { Speed = speed * dir },
		})
	belt.AssemblyLinearVelocity = c.LookVector * speed * dir
	B:Text(
		belt,
		Enum.NormalId.Top,
		if dir > 0 then "▲  ▲  ▲  ▲" else "▼  ▼  ▼  ▼",
		{ Color = Color3.fromRGB(240, 196, 40), PixelsPerStud = 4 }
	)
	for _, z in { 0, length } do
		B:Cylinder(
			c * CFrame.new(0, -0.6, -z),
			ctx.Width - 1,
			1.4,
			Color3.fromRGB(90, 90, 96),
			Enum.Material.Metal,
			{ Decor = true }
		)
	end
	for _, side in { -1, 1 } do
		B:Box(
			center * CFrame.new(side * (ctx.Width / 2), 0.2, 0),
			Vector3.new(1, 1.6, length),
			Color3.fromRGB(240, 180, 40),
			Enum.Material.Metal
		)
	end
	track(ctx, center.Position)
	addPar(ctx, length / math.max(M.SprintSpeed + speed * dir * 0.7, 10) + 12 / M.SprintSpeed)
	return platform(ctx, fwd(c, length), 12)
end

S.Wind = function(ctx, c, seg)
	local length = seg[2] or 30
	local B = ctx.B
	local side = if B:Rand(0, 1) > 0.5 then 1 else -1
	local width = 6
	local after = platform(ctx, c, length, width, "Course")
	local zone = B:Box(
		fwd(c, length / 2) * CFrame.new(0, 6, 0),
		Vector3.new(width + 14, 14, length),
		Color3.new(1, 1, 1),
		Enum.Material.SmoothPlastic,
		{
			Name = "WindZone",
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			Tag = Tags.WindZone,
			Attrs = {
				Force = c.RightVector * side * 70,
				Period = 4.2,
				OnFraction = 0.42,
				Phase = B:Rand(0, 1),
				Warn = 0.9,
			},
		}
	)
	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(-side * (width / 2 + 6), 0, 0)
	attachment.Parent = zone
	local streams = B:Emitter(attachment, "Mist", Color3.fromRGB(240, 248, 255))
	streams.Name = "GustStreams"
	B:Icon(zone, if side > 0 then "→" else "←", Color3.fromRGB(220, 235, 255), Vector3.new(0, 0, 0))
	addPar(ctx, length / M.WalkSpeed + 0.8)
	return after
end

S.Ice = function(ctx, c, seg)
	local length = seg[2] or 30
	local slope = seg.Slope or 0
	local B = ctx.B
	local a = c.Position
	local endC = c * CFrame.new(0, -slope, -length)
	local mid = (a + endC.Position) / 2
	local look = CFrame.lookAt(mid, endC.Position)
	B:Box(
		look * CFrame.new(0, -1, 0),
		Vector3.new(ctx.Width, 2, (endC.Position - a).Magnitude + 0.5),
		Color3.fromRGB(170, 215, 240),
		Enum.Material.Ice,
		{
			Name = "IceSlope",
			Tag = Tags.Ice,
		}
	)
	track(ctx, a)
	track(ctx, endC.Position)
	addPar(ctx, length / (M.SprintSpeed + 6) + 12 / M.SprintSpeed)
	return platform(ctx, endC, 12)
end

S.LowGrav = function(ctx, c, seg)
	local length = seg[2] or 50
	local B, theme = ctx.B, ctx.Theme
	local scale = 0.42
	-- Gaps sized for reduced gravity.
	local stats = table.clone(MovementConfig) :: any
	stats.Gravity *= scale
	local hop = Reach.JumpDistance(0, M.SprintSpeed, stats) * 0.62
	local zoneCenter = fwd(c, length / 2 + 4)
	local zone = B:Box(
		zoneCenter * CFrame.new(0, 10, 0),
		Vector3.new(ctx.Width + 12, 30, length + 10),
		Color3.new(1, 1, 1),
		Enum.Material.SmoothPlastic,
		{
			Name = "GravityZone",
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			Tag = Tags.GravityZone,
			Attrs = { Scale = scale },
		}
	)
	local attachment = Instance.new("Attachment")
	attachment.Parent = zone
	B:Emitter(attachment, "Motes", theme.Signal)
	-- Glass chamber walls.
	for _, side in { -1, 1 } do
		B:Box(
			zoneCenter * CFrame.new(side * (ctx.Width / 2 + 6), 10, 0),
			Vector3.new(1, 30, length + 10),
			theme.Signal,
			Enum.Material.Glass,
			{ Transparency = 0.7 }
		)
	end
	local cursor = c
	local travelled = 0
	local index = 0
	while travelled < length - 4 do
		index += 1
		local dy = if index % 2 == 0 then 3 else -2
		cursor = platform(ctx, cursor * CFrame.new(0, dy, -hop), 6, 8, "Floating")
		travelled += hop + 6
		token(ctx, (cursor * CFrame.new(0, 6, hop / 2)).Position, 1)
	end
	addPar(ctx, travelled / (M.SprintSpeed * 0.75))
	return platform(ctx, cursor, 12, nil, "Course")
end

S.Current = function(ctx, c, seg)
	local height = math.clamp(seg[2] or 18, 8, 40)
	local B = ctx.B
	local approach = platform(ctx, c, 8, nil, "Course")
	local column = fwd(c, 13) * CFrame.new(0, height / 2 + 3, 0)
	local zone = B:Box(column, Vector3.new(8, height + 10, 8), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, {
		Name = "AetherCurrent",
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Tag = Tags.GravityZone,
		Attrs = { Scale = 1, Lift = M.Gravity * 1.45, MaxRise = 34 },
	})
	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(0, -(height + 10) / 2, 0)
	attachment.Parent = zone
	B:Emitter(attachment, "Updraft", ctx.Theme.Signal)
	B:Cylinder(
		fwd(c, 13) * CFrame.new(0, -0.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		0.4,
		8,
		ctx.Theme.Signal,
		Enum.Material.Neon,
		{ Decor = true }
	)
	B:Icon(zone, "⇧", ctx.Theme.Signal, Vector3.new(0, -height / 2, 0))
	block(ctx, approach, 10, height, 14)
	local topC = approach * CFrame.new(0, height, -10)
	track(ctx, column.Position + Vector3.new(0, height / 2, 0))
	addPar(ctx, 8 / M.SprintSpeed + height / 30 + 1 + 14 / M.SprintSpeed)
	return platform(ctx, topC, 14, nil, "Course")
end

S.Holo = function(ctx, c, seg)
	local count = math.clamp(seg[2] or 3, 1, 6)
	local B = ctx.B
	local cursor = c
	for i = 1, count do
		local gap = math.max(Reach.JumpDistance(0) * 0.5, 5)
		local cf = cursor * CFrame.new(0, -0.5, -(gap + 3.5))
		local holo = B:Box(cf, Vector3.new(7, 1, 7), ctx.Theme.Signal, Enum.Material.ForceField, {
			Name = "HoloPlatform",
			Tag = Tags.Timed,
			Attrs = { Kind = "Blink", Period = 3.8, OnFraction = 0.62, Phase = -(i - 1) * 0.2, Warn = 0.8 },
		})
		B:Icon(holo, "◇", ctx.Theme.Signal, Vector3.new(0, 2, 0))
		local base = B:Detail(
			cf * CFrame.new(0, -0.7, 0),
			Vector3.new(7.2, 0.3, 7.2),
			Color3.fromRGB(40, 44, 60),
			Enum.Material.Metal,
			{ CanCollide = false }
		)
		base.Transparency = 0.6
		cursor = fwd(cursor, gap + 7)
		track(ctx, cf.Position)
		addPar(ctx, 1.1)
	end
	local gap = math.max(Reach.JumpDistance(0) * 0.5, 5)
	recovery(ctx, c, (cursor.Position - c.Position).Magnitude + gap, 0)
	addPar(ctx, 12 / M.SprintSpeed)
	return platform(ctx, fwd(cursor, gap), 12)
end

S.Turn = function(ctx, c, seg)
	local degrees = seg[2] or 90
	local size = ctx.Width + 4
	platform(ctx, c, size, size, "Course")
	local center = fwd(c, size / 2)
	local turned = center * CFrame.Angles(0, math.rad(-degrees), 0)
	addPar(ctx, 0.5)
	return fwd(turned, size / 2)
end

-- Checkpoints and finish -----------------------------------------------------------------------

local function finishWater(ctx: Ctx)
	local water = ctx.Water
	if not water then
		return
	end
	ctx.Water = nil
	local min, max = ctx.SectionMin, ctx.SectionMax
	local baseY = min.Y - 8
	local size = Vector3.new(max.X - min.X + 40, (max.Y - baseY) + 16, max.Z - min.Z + 20)
	local localCenter = Vector3.new((min.X + max.X) / 2, baseY - size.Y / 2, (min.Z + max.Z) / 2)
	local cf = ctx.Origin * CFrame.new(localCenter)
	local part = ctx.B:Box(cf, size, Color3.fromRGB(70, 160, 200), Enum.Material.Glass, {
		Name = "RisingWater",
		Transparency = 0.35,
		CanCollide = false,
		CanQuery = false,
		Tag = Tags.Water,
		Attrs = {
			CourseId = ctx.Id,
			StartCP = water.StartCP,
			Rate = water.Rate,
			BaseY = baseY,
			MaxY = max.Y + 1,
			Origin = cf,
		},
	})
	part.CanTouch = true
	ctx.B:Tag(part, Tags.Hazard, { Active = false })
end

local function gateArch(ctx: Ctx, c: CFrame, color: Color3, label: string, checkered: boolean?)
	local B = ctx.B
	local w = ctx.Width
	for _, side in { -1, 1 } do
		B:Box(
			c * CFrame.new(side * (w / 2 + 0.4), 4.5, 0),
			Vector3.new(0.8, 9, 0.8),
			ctx.Theme.Trim,
			Enum.Material.Metal
		)
	end
	local top = B:Box(c * CFrame.new(0, 9.3, 0), Vector3.new(w + 1.6, 1.2, 0.8), color, Enum.Material.Neon)
	if checkered then
		for i = 0, 7 do
			B:Detail(
				c * CFrame.new(-w / 2 + (i + 0.5) * (w / 8), 10.3, 0),
				Vector3.new(w / 8, 0.8, 0.85),
				if i % 2 == 0 then Color3.new(0.05, 0.05, 0.05) else Color3.new(1, 1, 1),
				Enum.Material.SmoothPlastic
			)
		end
	end
	local sign = B:Detail(
		c * CFrame.new(0, 11.4, 0),
		Vector3.new(w * 0.7, 1.4, 0.2),
		Color3.fromRGB(25, 28, 36),
		Enum.Material.SmoothPlastic
	)
	B:Text(sign, Enum.NormalId.Back, label, { Color = color })
	B:Text(sign, Enum.NormalId.Front, label, { Color = color })
	B:Light(top, color, 14, 0.7)
end

S.CP = function(ctx, c, seg)
	finishWater(ctx)
	local length = 12
	local after = platform(ctx, c, length, nil, "Checkpoint")
	local index = #ctx.Checkpoints + 1
	local center = fwd(c, length / 2)
	local volumeCF = center * CFrame.new(0, 5, 0)
	local volumeSize = Vector3.new(ctx.Width + 4, 12, length)
	ctx.B:Volume(volumeCF, volumeSize, Tags.CourseCheckpoint, { CourseId = ctx.Id, Index = index })
	local exchange = seg.Exchange == true
	gateArch(
		ctx,
		fwd(c, 2),
		if exchange then Color3.fromRGB(255, 120, 220) else ctx.Theme.Signal,
		if exchange then "EXCHANGE" else ("CHECKPOINT %d"):format(index)
	)
	local pad = ctx.B:Detail(
		center * CFrame.new(0, 0.05, 0),
		Vector3.new(ctx.Width - 2, 0.1, 6),
		ctx.Theme.Signal,
		Enum.Material.Neon
	)
	pad.Transparency = 0.4
	table.insert(ctx.Checkpoints, {
		Spawn = center * CFrame.new(0, 3.5, 0),
		Volume = { CFrame = volumeCF, Size = volumeSize },
		Exchange = exchange,
	})
	-- Each section between checkpoints tracks its own bounds (for rising water).
	ctx.SectionMin = ctx.Origin:PointToObjectSpace(center.Position)
	ctx.SectionMax = ctx.SectionMin
	addPar(ctx, length / M.SprintSpeed)
	return after
end

S.Finish = function(ctx, c, seg)
	finishWater(ctx)
	local length = 16
	local after = platform(ctx, c, length, ctx.Width + 6, "Finish")
	gateArch(ctx, fwd(c, 3), Color3.fromRGB(255, 255, 255), "FINISH", true)
	addPar(ctx, 3 / M.SprintSpeed)
	return after
end

-- Splits ------------------------------------------------------------------------------------------

local LANES = { A = -1, F = 0, E = 1 }

S.Split = function(ctx, c, seg)
	local B = ctx.B
	local lanes = {}
	for name in LANES do
		if seg[name] then
			table.insert(lanes, name)
		end
	end
	table.sort(lanes, function(x, y)
		return LANES[x] < LANES[y]
	end)
	-- Fork platform spanning every lane, with route signs.
	local span = LANE_SPACING * 2 + ctx.Width
	local fork = platform(ctx, c, 10, span, "Course")
	local parBefore = { A = ctx.Par.A, F = ctx.Par.F, E = ctx.Par.E }
	local ends: { [string]: CFrame } = {}
	local laneParA, laneParF, laneParE = 0, 0, 0
	for _, name in lanes do
		local sign = LANES[name]
		local laneStart = fwd(fork, 0) * CFrame.new(sign * LANE_SPACING, 0, 0)
		-- Route marker at the start of each lane.
		local post = B:Detail(
			laneStart * CFrame.new(ctx.Width / 2 - 0.6, 2.5, 1.5),
			Vector3.new(0.4, 5, 0.4),
			ctx.Theme.Trim,
			Enum.Material.Metal
		)
		local plate = B:Detail(
			post.CFrame * CFrame.new(-1.6, 2.6, 0),
			Vector3.new(3.2, 1.6, 0.15),
			Color3.fromRGB(25, 28, 36),
			Enum.Material.SmoothPlastic
		)
		local label = if name == "A" then "● STEADY" elseif name == "F" then "▲ FAST" else "★ EXPERT"
		B:Text(plate, Enum.NormalId.Back, label, {
			Color = if name == "E"
				then Color3.fromRGB(255, 210, 90)
				elseif name == "F" then Color3.fromRGB(120, 220, 255)
				else Color3.fromRGB(150, 255, 160),
		})
		-- Bridge from fork to lane start for side lanes.
		ctx.Lane = name
		ctx.LaneSign = sign
		local startPar = ctx.Par[name]
		local cursor = laneStart
		for index, sub in seg[name] do
			local builder = S[sub[1]]
			if builder then
				cursor = builder(ctx, cursor, sub)
			else
				warn("[CourseBuilder] Unknown segment " .. tostring(sub[1]) .. " in " .. ctx.Id)
			end
			if name == "E" and index == 1 then
				-- The expert shortcut: passing through here earns the distinction.
				local volumeCF = cursor * CFrame.new(0, 5, 3)
				local size = Vector3.new(ctx.Width + 4, 14, 8)
				B:Volume(volumeCF, size, Tags.CourseShortcut, { CourseId = ctx.Id })
				table.insert(ctx.Shortcuts, { CFrame = volumeCF, Size = size })
			end
		end
		ends[name] = cursor
		local spent = ctx.Par[name] - startPar
		if name == "A" then
			laneParA = spent
		elseif name == "F" then
			laneParF = spent
		else
			laneParE = spent
		end
	end
	ctx.Lane = nil
	ctx.LaneSign = 0

	-- Merge: bring every lane level and to the same forward distance.
	local maxForward, maxY = -math.huge, -math.huge
	local minLateral, maxLateral = math.huge, -math.huge
	for _, cursor in ends do
		local p = fork:PointToObjectSpace(cursor.Position)
		maxForward = math.max(maxForward, -p.Z)
		maxY = math.max(maxY, p.Y)
		minLateral = math.min(minLateral, p.X)
		maxLateral = math.max(maxLateral, p.X)
	end
	for name, cursor in ends do
		local p = fork:PointToObjectSpace(cursor.Position)
		local lift = maxY - p.Y
		local extraPar = 0
		ctx.Lane = name
		if lift > 0.5 then
			if lift <= 4 then
				cursor = S.Steps(ctx, cursor, { "Steps", 1, Rise = lift })
			elseif lift <= Reach.LedgeHeight() - 1.5 then
				cursor = S.Ledge(ctx, cursor, { "Ledge", lift })
			else
				cursor = S.Climb(ctx, cursor, { "Climb", lift, Type = "Ladder" })
			end
			extraPar += 1.5
		end
		ctx.Lane = nil
		p = fork:PointToObjectSpace(cursor.Position)
		local remaining = maxForward - -p.Z
		if remaining > 0.5 then
			cursor = platform(ctx, cursor, remaining)
			extraPar += remaining / M.SprintSpeed
		end
		if name == "A" then
			laneParA += extraPar
		elseif name == "F" then
			laneParF += extraPar
		else
			laneParE += extraPar
		end
	end
	-- Lanes that a split doesn't define fall back to the nearest one.
	if not seg.A then
		laneParA = if seg.F then laneParF else laneParE
	end
	if not seg.F then
		laneParF = if seg.A then laneParA else laneParE
	end
	if not seg.E then
		laneParE = laneParF
	end
	ctx.Par.A = parBefore.A + laneParA
	ctx.Par.F = parBefore.F + laneParF
	ctx.Par.E = parBefore.E + laneParE
	-- Lanes with no requirements of their own inherit the accessible route's.
	local mergeStart = fork * CFrame.new((minLateral + maxLateral) / 2, maxY, -maxForward)
	local mergeWidth = (maxLateral - minLateral) + ctx.Width
	local merged = platform(ctx, mergeStart, 12, mergeWidth, "Course")
	addPar(ctx, 12 / M.SprintSpeed)
	-- Recentre on the main line.
	local centre = fork:PointToObjectSpace(merged.Position)
	return merged * CFrame.new(-centre.X, 0, 0)
end

-- Build -------------------------------------------------------------------------------------------

local function newContext(
	B: Kit.Builder,
	theme: Theme,
	id: string,
	difficulty: number,
	width: number,
	origin: CFrame,
	folder: Folder
): Ctx
	return {
		B = B,
		Theme = theme,
		Id = id,
		Difficulty = difficulty,
		Width = width,
		Origin = origin,
		Folder = folder,
		Lane = nil,
		LaneSign = 0,
		Par = { A = 0, F = 0, E = 0 },
		Requires = { A = {}, F = {}, E = {} },
		TokenSpots = {},
		Checkpoints = {},
		Shortcuts = {},
		Water = nil,
		SectionMin = Vector3.zero,
		SectionMax = Vector3.zero,
		Techniques = 0,
		MinY = origin.Y,
		Safe = difficulty <= 4,
	}
end

function CourseBuilder.NewContext(
	B: Kit.Builder,
	theme: Theme,
	id: string,
	difficulty: number,
	origin: CFrame,
	folder: Folder
)
	return newContext(B, theme, id, difficulty, 10, origin, folder)
end

-- Run a list of segments from a cursor (used by the tower and endless modes too).
function CourseBuilder.Segments(ctx: Ctx, cursor: CFrame, segments: { any }): CFrame
	for _, seg in segments do
		local builder = S[seg[1]]
		if builder then
			cursor = builder(ctx, cursor, seg)
		else
			warn("[CourseBuilder] Unknown segment " .. tostring(seg[1]) .. " in " .. ctx.Id)
		end
	end
	return cursor
end

function CourseBuilder.Has(kind: string): boolean
	return S[kind] ~= nil
end

local function sortedKeys(set: { [string]: boolean }): { string }
	local list = {}
	for key in set do
		table.insert(list, key)
	end
	table.sort(list)
	return list
end

-- Choose tokens spread through the course, favouring harder spots. Only the
-- shared path and expert lanes hold tokens, so a single run can collect them all.
local function pickTokens(all: { { Position: Vector3, Priority: number, Lane: string? } }, wanted: number): { Vector3 }
	local spots = {}
	for _, spot in all do
		if spot.Lane == nil or spot.Lane == "E" then
			table.insert(spots, spot)
		end
	end
	local result = {}
	if #spots == 0 then
		return result
	end
	wanted = math.min(wanted, #spots)
	local chosen = {}
	local count = 0
	-- Always include one expert-lane spot if any exist.
	for index, spot in spots do
		if spot.Lane == "E" then
			chosen[index] = true
			count += 1
			break
		end
	end
	-- Evenly spaced picks, each nudged to the best spot nearby.
	local step = #spots / math.max(wanted, 1)
	local cursor = step / 2
	while count < wanted and cursor <= #spots + 0.5 do
		local index = math.clamp(math.floor(cursor + 0.5), 1, #spots)
		local best = index
		for j = math.max(1, index - 1), math.min(#spots, index + 1) do
			if not chosen[j] and (chosen[best] or spots[j].Priority > spots[best].Priority) then
				best = j
			end
		end
		if not chosen[best] then
			chosen[best] = true
			count += 1
		end
		cursor += step
	end
	-- Top up with the highest-priority leftovers.
	if count < wanted then
		local rest = {}
		for index in spots do
			if not chosen[index] then
				table.insert(rest, index)
			end
		end
		table.sort(rest, function(a, b)
			return spots[a].Priority > spots[b].Priority
		end)
		for _, index in rest do
			if count >= wanted then
				break
			end
			chosen[index] = true
			count += 1
		end
	end
	for index, spot in spots do
		if chosen[index] then
			table.insert(result, spot.Position)
		end
	end
	return result
end

-- Build a full course. `origin` is the top-surface point at the start, facing along the course.
function CourseBuilder.Build(B: Kit.Builder, course: any, theme: Theme, origin: CFrame, parent: Instance?): Meta
	local folder = B:Group(course.Id, parent)
	local meta: Meta
	B:Within(folder, function()
		local ctx = newContext(B, theme, course.Id, course.Difficulty, course.Width or 10, origin, folder)
		-- Start platform with gate and spawn pad.
		local cursor = platform(ctx, origin, 18, ctx.Width + 4, "Start")
		local spawn = origin * CFrame.new(0, 3.5, -10)
		gateArch(ctx, origin * CFrame.new(0, 0, -4), theme.Signal, string.upper(course.Name))
		local startPad =
			B:Box(origin * CFrame.new(0, 0.1, -10), Vector3.new(6, 0.2, 6), theme.Signal, Enum.Material.Neon, {
				Name = "StartPad",
				CanCollide = false,
				Tag = Tags.CourseStart,
				Attrs = { CourseId = course.Id, Spawn = spawn },
			})
		startPad.Transparency = 0.3
		addPar(ctx, -0.3) -- countdown starts you on the pad

		cursor = CourseBuilder.Segments(ctx, cursor, course.Segments)

		-- The finish volume is the last platform built by the Finish segment.
		local finishCF = cursor * CFrame.new(0, 5, 8)
		local finishSize = Vector3.new(ctx.Width + 8, 12, 14)
		B:Volume(finishCF, finishSize, Tags.CourseFinish, { CourseId = course.Id })

		-- Tokens.
		local tokenCount = math.clamp(4 + math.floor(#ctx.TokenSpots / 4), 5, 8)
		local tokens = pickTokens(ctx.TokenSpots, tokenCount)
		for index, position in tokens do
			local coin = B:Cylinder(
				CFrame.new(position) * CFrame.Angles(0, 0, 0),
				0.3,
				2.2,
				Color3.fromRGB(255, 205, 70),
				Enum.Material.Neon,
				{
					Name = "Token",
					CanCollide = false,
					CanQuery = false,
					Tag = Tags.CourseToken,
					Attrs = { CourseId = course.Id, Index = index },
				}
			)
			coin.CastShadow = false
		end

		-- Bounds in course space (for rooms and kill height).
		local min, max = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
		for _, part in folder:GetDescendants() do
			if part:IsA("BasePart") and part.Transparency < 1 then
				local p = origin:PointToObjectSpace(part.Position)
				local half = part.Size.Magnitude / 2
				min = min:Min(p - Vector3.new(half, half, half))
				max = max:Max(p + Vector3.new(half, half, half))
			end
		end

		local par = { A = math.max(ctx.Par.A, 5), F = math.max(ctx.Par.F, 5), E = math.max(ctx.Par.E, 5) }
		local medals = course.Medals or Medals.FromPar(par.A, par.F, par.E)
		local exchanges = {}
		for index, checkpoint in ctx.Checkpoints do
			if checkpoint.Exchange then
				table.insert(exchanges, index)
			end
		end
		local length = (origin:PointToObjectSpace(cursor.Position)).Magnitude
		meta = {
			Id = course.Id,
			Spawn = spawn,
			Checkpoints = ctx.Checkpoints,
			Finish = { CFrame = finishCF, Size = finishSize },
			Tokens = tokens,
			Shortcuts = ctx.Shortcuts,
			KillY = ctx.MinY - 22,
			Par = par,
			Medals = medals,
			Requires = sortedKeys(ctx.Requires.A),
			FastRequires = sortedKeys(ctx.Requires.F),
			ExpertRequires = sortedKeys(ctx.Requires.E),
			Length = length,
			Folder = folder,
			LocalMin = min,
			LocalMax = max,
			Origin = origin,
			FlowTarget = math.floor((ctx.Techniques * 16 + par.F * 12) * 1.15),
			Exchanges = exchanges,
		}
	end)
	return meta
end

return CourseBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">DistrictBuilder</string>
            <string name="Source"><![CDATA[-- Lays out a district: a social plaza at the centre, course start gates on
-- spokes around it, a challenge-room annex toward the Guildhall, and pockets
-- of free-roam rooftops between the spokes holding caches, letters, quest
-- spots and contract drop-offs.
--
-- Each district module supplies the look (themes, buildings, plaza dressing,
-- landmarks, secrets); this module supplies the structure, so every district
-- plays by the same rules and new districts slot in the same way.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Courses = require(ReplicatedStorage.Shared.Config.Courses)
local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Lore = require(ReplicatedStorage.Shared.Config.Lore)
local Reach = require(ReplicatedStorage.Shared.Logic.Reach)
local Tags = require(ReplicatedStorage.Shared.Tags)

local CourseBuilder = require(script.Parent.CourseBuilder)
local Kit = require(script.Parent.Kit)

local DistrictBuilder = {}

DistrictBuilder.PlazaRadius = 48
DistrictBuilder.StartRadius = 112
DistrictBuilder.CorridorHalfWidth = 46
DistrictBuilder.HubSector = math.rad(36)
DistrictBuilder.Prefix = {
	Hub = "hub",
	Tinroof = "tin",
	Ironworks = "iron",
	Verdant = "ver",
	Gilded = "gil",
	Frostreach = "fro",
	Citadel = "cit",
}

export type Spots = { Roof: Vector3, High: { Vector3 }, Nooks: { Vector3 } }
export type Building = { Center: Vector3, Top: number, Size: Vector3, Spots: Spots }

export type Context = {
	B: Kit.Builder,
	District: any,
	Origin: CFrame,
	Y: number,
	HubDir: Vector3,
	Spokes: { { Angle: number, Course: any, Length: number, Dir: Vector3 } },
	Buildings: { Building },
	CourseMetas: { any },
	High: { Vector3 },
	Roofs: { Vector3 },
	Nooks: { Vector3 },
	Spawn: CFrame,
	UsedHigh: number,
	UsedRoof: number,
	UsedNook: number,
	Annex: CFrame?,
	Taken: { Vector3 },
}

export type DistrictModule = {
	CourseTheme: CourseBuilder.Theme,
	RoomTheme: CourseBuilder.Theme,
	Plaza: (Kit.Builder, Context) -> (),
	Building: (Kit.Builder, Context, CFrame, Vector3) -> Spots,
	Connector: ((Kit.Builder, Context, Vector3, Vector3) -> ())?,
	Landmarks: (Kit.Builder, Context) -> (),
	QuestPoints: (Kit.Builder, Context) -> (),
	Skyline: (Kit.Builder, Context) -> (),
	Annex: ((Kit.Builder, Context, CFrame) -> ())?,
	HeightRange: { number }?,
}

-- Context helpers -------------------------------------------------------------------------

function DistrictBuilder.Dir(angle: number): Vector3
	return Vector3.new(math.cos(angle), 0, math.sin(angle))
end

-- Next unused high spot / roof spot / nook (wrapping if a district runs out).
function DistrictBuilder.TakeHigh(ctx: Context): Vector3
	ctx.UsedHigh += 1
	local list = if #ctx.High > 0 then ctx.High else ctx.Roofs
	return list[((ctx.UsedHigh - 1) % #list) + 1]
end

function DistrictBuilder.TakeRoof(ctx: Context): Vector3
	ctx.UsedRoof += 1
	return ctx.Roofs[((ctx.UsedRoof - 1) % #ctx.Roofs) + 1]
end

function DistrictBuilder.TakeNook(ctx: Context): Vector3
	ctx.UsedNook += 1
	local list = if #ctx.Nooks > 0 then ctx.Nooks else ctx.Roofs
	return list[((ctx.UsedNook - 1) % #list) + 1]
end

-- The most open spot on a ring around the plaza: as far as possible from every
-- course corridor, pocket building and previously placed landmark. Used to
-- place landmarks so they never collide with a route.
function DistrictBuilder.FindClear(ctx: Context, radius: number, footprint: number): Vector3
	local origin = ctx.District.Origin
	local hubAngle = math.atan2(ctx.HubDir.Z, ctx.HubDir.X)
	local bestPosition, bestClearance = origin + DistrictBuilder.Dir(hubAngle + math.pi) * radius, -math.huge
	for step = 0, 119 do
		local angle = step * math.pi / 60
		local d = (angle - hubAngle) % (math.pi * 2)
		if d > math.pi then
			d -= math.pi * 2
		end
		if math.abs(d) > DistrictBuilder.HubSector + math.rad(10) then
			local position = origin + DistrictBuilder.Dir(angle) * radius
			local clearance = math.huge
			for _, spoke in ctx.Spokes do
				local a = origin + spoke.Dir * DistrictBuilder.StartRadius
				local b = origin + spoke.Dir * (DistrictBuilder.StartRadius + spoke.Length)
				local ab = b - a
				local t = math.clamp((position - a):Dot(ab) / math.max(ab:Dot(ab), 1e-6), 0, 1)
				local closest = a + ab * t
				clearance = math.min(
					clearance,
					Vector3.new(position.X - closest.X, 0, position.Z - closest.Z).Magnitude
						- DistrictBuilder.CorridorHalfWidth
				)
			end
			for _, building in ctx.Buildings do
				local offset = Vector3.new(position.X - building.Center.X, 0, position.Z - building.Center.Z)
				clearance = math.min(clearance, offset.Magnitude - building.Size.X / 2 - 4)
			end
			for _, taken in ctx.Taken do
				clearance = math.min(
					clearance,
					(Vector3.new(position.X, 0, position.Z) - Vector3.new(taken.X, 0, taken.Z)).Magnitude - 60
				)
			end
			if clearance > bestClearance then
				bestPosition, bestClearance = position, clearance
			end
		end
	end
	if bestClearance < footprint then
		warn(
			("[World] %s landmark at radius %d has only %.0f studs clearance"):format(
				ctx.District.Id,
				radius,
				bestClearance
			)
		)
	end
	table.insert(ctx.Taken, bestPosition)
	-- Clear pocket buildings that would overlap the landmark.
	for index = #ctx.Buildings, 1, -1 do
		local building = ctx.Buildings[index]
		local offset = Vector3.new(bestPosition.X - building.Center.X, 0, bestPosition.Z - building.Center.Z)
		if offset.Magnitude < footprint + building.Size.X / 2 then
			warn("[World] landmark overlaps a pocket building in " .. ctx.District.Id)
		end
	end
	return bestPosition
end

-- Discoveries -----------------------------------------------------------------------------

function DistrictBuilder.Cache(ctx: Context, index: number, position: Vector3)
	local B = ctx.B
	local id = ("cache_%s_%d"):format(string.lower(ctx.District.Id), index)
	local crate = B:Box(
		CFrame.new(position + Vector3.new(0, 0.9, 0)) * CFrame.Angles(0, B:Rand(0, math.pi), 0),
		Vector3.new(2.2, 1.8, 1.6),
		Color3.fromRGB(196, 66, 58),
		Enum.Material.Fabric,
		{
			Name = "CourierCache",
			CanCollide = false,
			Tag = Tags.Discovery,
			Attrs = { Id = id, Kind = "Cache", District = ctx.District.Id, Title = "Courier Cache" },
		}
	)
	B:Detail(
		crate.CFrame * CFrame.new(0, 0.95, 0),
		Vector3.new(2.3, 0.15, 1.7),
		Color3.fromRGB(255, 196, 92),
		Enum.Material.Metal
	)
	local light = B:Detail(
		crate.CFrame * CFrame.new(0, 1.2, 0),
		Vector3.new(0.3, 0.3, 0.3),
		Color3.fromRGB(255, 220, 120),
		Enum.Material.Neon
	)
	B:Light(light, Color3.fromRGB(255, 200, 120), 7, 0.6)
	B:Icon(crate, "▣", Color3.fromRGB(255, 210, 120), Vector3.new(0, 2.5, 0))
end

function DistrictBuilder.Letter(ctx: Context, index: number, position: Vector3)
	local letters = Lore.Letters[ctx.District.Id]
	local entry = letters and letters[index]
	if not entry then
		return
	end
	local B = ctx.B
	local id = ("letter_%s_%d"):format(string.lower(ctx.District.Id), index)
	local paper = B:Box(
		CFrame.new(position + Vector3.new(0, 0.6, 0)) * CFrame.Angles(math.rad(-20), B:Rand(0, math.pi), 0),
		Vector3.new(1.2, 0.08, 0.9),
		Color3.fromRGB(245, 235, 210),
		Enum.Material.SmoothPlastic,
		{
			Name = "LostLetter",
			CanCollide = false,
			Tag = Tags.Discovery,
			Attrs = { Id = id, Kind = "Letter", District = ctx.District.Id, Title = entry.Title, Text = entry.Text },
		}
	)
	B:Detail(
		paper.CFrame * CFrame.new(0, 0.05, 0),
		Vector3.new(0.3, 0.02, 0.3),
		Color3.fromRGB(196, 66, 58),
		Enum.Material.SmoothPlastic
	)
	B:Icon(paper, "✉", Color3.fromRGB(255, 240, 210), Vector3.new(0, 2, 0))
end

function DistrictBuilder.Landmark(ctx: Context, key: string, title: string, cframe: CFrame, size: Vector3)
	ctx.B:Volume(cframe, size, Tags.Discovery, {
		Id = ("landmark_%s_%s"):format(string.lower(ctx.District.Id), key),
		Kind = "Landmark",
		District = ctx.District.Id,
		Title = title,
		Text = "Landmark discovered",
	})
end

function DistrictBuilder.Secret(ctx: Context, key: string, title: string, text: string, cframe: CFrame, size: Vector3)
	ctx.B:Volume(cframe, size, Tags.Discovery, {
		Id = "secret_" .. key,
		Kind = "Secret",
		District = ctx.District.Id,
		Title = title,
		Text = text,
	})
end

function DistrictBuilder.QuestPoint(ctx: Context, id: string, position: Vector3)
	ctx.B:Point(Tags.QuestPoint, id, position)
end

function DistrictBuilder.NPCSpot(ctx: Context, id: string, cframe: CFrame)
	local part = ctx.B:Point(Tags.NPCSpot, id, cframe.Position)
	part.CFrame = cframe
end

-- Plaza fixtures (shared by every district) ----------------------------------------------------

local function board(ctx: Context, kind: string, title: string, cframe: CFrame, color: Color3)
	local B = ctx.B
	for _, x in { -2.6, 2.6 } do
		B:Box(cframe * CFrame.new(x, 2.5, 0), Vector3.new(0.4, 5, 0.4), Color3.fromRGB(60, 50, 40), Enum.Material.Wood)
	end
	local panel = B:Box(
		cframe * CFrame.new(0, 4, 0),
		Vector3.new(5.6, 3, 0.3),
		Color3.fromRGB(35, 38, 48),
		Enum.Material.SmoothPlastic,
		{
			Name = kind .. "Board",
			Tag = Tags.Board,
			Attrs = { Kind = kind, District = ctx.District.Id },
		}
	)
	B:Text(panel, Enum.NormalId.Front, title, { Color = color, Padding = 6 })
	B:Text(panel, Enum.NormalId.Back, title, { Color = color, Padding = 6 })
	B:Light(panel, color, 10, 0.6, "Surface", Enum.NormalId.Front)
	local prompt =
		B:Prompt(panel, "Open", title, { Name = "BoardPrompt", Attrs = { Board = kind, District = ctx.District.Id } })
	prompt.MaxActivationDistance = 10
end

function DistrictBuilder.TravelGate(ctx: Context, cframe: CFrame)
	local B = ctx.B
	local palette = ctx.District.Palette
	local accent = palette.Signal or Color3.fromRGB(80, 200, 255)
	for _, x in { -5, 5 } do
		B:Box(cframe * CFrame.new(x, 6, 0), Vector3.new(1.6, 12, 1.6), Color3.fromRGB(60, 62, 70), Enum.Material.Metal)
	end
	B:Box(cframe * CFrame.new(0, 12.5, 0), Vector3.new(12, 1.4, 1.8), Color3.fromRGB(60, 62, 70), Enum.Material.Metal)
	local field = B:Box(cframe * CFrame.new(0, 6, 0), Vector3.new(8.4, 11, 0.4), accent, Enum.Material.ForceField, {
		Name = "TravelGate",
		CanCollide = false,
		Tag = Tags.TravelGate,
		Attrs = { District = ctx.District.Id },
	})
	field.Transparency = 0.3
	B:Light(field, accent, 18, 1)
	local sign = B:Detail(
		cframe * CFrame.new(0, 14.2, 0),
		Vector3.new(10, 2, 0.3),
		Color3.fromRGB(25, 28, 36),
		Enum.Material.SmoothPlastic
	)
	B:Text(sign, Enum.NormalId.Front, "LIFT GATE", { Color = accent })
	B:Text(sign, Enum.NormalId.Back, "LIFT GATE", { Color = accent })
	B:Prompt(field, "Travel", "Lift Gate", { Name = "TravelPrompt", Attrs = { Board = "Travel" } })
	B:Icon(field, "⇆", accent, Vector3.new(0, 7, 0))
end

local function startSign(ctx: Context, course: any, cframe: CFrame)
	local B = ctx.B
	local accent = ctx.District.Palette.Signal or Color3.new(1, 1, 1)
	B:Box(cframe * CFrame.new(0, 2, 0), Vector3.new(0.5, 4, 0.5), Color3.fromRGB(60, 60, 66), Enum.Material.Metal)
	local panel = B:Box(
		cframe * CFrame.new(0, 4.6, 0),
		Vector3.new(6, 3.2, 0.3),
		Color3.fromRGB(28, 30, 40),
		Enum.Material.SmoothPlastic,
		{ Name = "CourseSign" }
	)
	local difficulty = string.rep("■", course.Difficulty) .. string.rep("□", 10 - course.Difficulty)
	local kind = if course.Kind == "Room" then "CHALLENGE ROOM" elseif course.Kind == "Relay" then "RELAY" else "COURSE"
	local text = ('<font size="34"><b>%s</b></font>\n<font size="18">%s · %s</font>\n<font size="18">%s</font>'):format(
		string.upper(course.Name),
		kind,
		Courses.DifficultyNames[course.Difficulty],
		difficulty
	)
	B:Text(panel, Enum.NormalId.Front, text, { Color = accent, Rich = true, Padding = 8 })
	B:Text(panel, Enum.NormalId.Back, text, { Color = accent, Rich = true, Padding = 8 })
	B:Prompt(panel, "View Course", course.Name, {
		Name = "CoursePrompt",
		Distance = 14,
		Attrs = { CourseId = course.Id },
	})
end

-- Layout ----------------------------------------------------------------------------------------

local function angleDiff(a: number, b: number): number
	local d = (a - b) % (math.pi * 2)
	if d > math.pi then
		d -= math.pi * 2
	end
	return math.abs(d)
end

local function distanceToSegment(p: Vector3, a: Vector3, b: Vector3): number
	local ab = b - a
	local t = math.clamp((p - a):Dot(ab) / math.max(ab:Dot(ab), 1e-6), 0, 1)
	local closest = a + ab * t
	return Vector3.new(p.X - closest.X, 0, p.Z - closest.Z).Magnitude
end

-- Estimated forward length of a course recipe (for keeping pockets clear of it).
local function estimateLength(course: any): number
	local total = 40
	local function walk(segments: { any })
		for _, seg in segments do
			local kind = seg[1]
			if kind == "Split" then
				local longest = 0
				for _, lane in { seg.A, seg.F, seg.E } do
					if lane then
						local before = total
						walk(lane)
						longest = math.max(longest, total - before)
						total = before
					end
				end
				total += longest + 26
			elseif kind == "Run" then
				total += seg[2] or 16
			elseif kind == "Zip" then
				total += (seg[2] or 50) + 12
			elseif
				kind == "Balance"
				or kind == "Collapse"
				or kind == "Retract"
				or kind == "Conveyor"
				or kind == "Wind"
				or kind == "Ice"
				or kind == "LowGrav"
			then
				total += (seg[2] or 24) + 14
			elseif kind == "Grapple" then
				total += 32 + ((seg[2] or 1) - 1) * 30 + 14
			elseif kind == "TicTac" then
				total += 8 + (seg[2] or 2) * 16 + 14
			elseif kind == "Rope" then
				total += 19 + ((seg[2] or 2) - 1) * 15 + 14
			elseif kind == "Movers" then
				total += (seg[2] or 1) * 36
			else
				total += 30
			end
		end
	end
	walk(course.Segments)
	return total
end

function DistrictBuilder.Build(worldFolder: Instance, districtId: string, module: DistrictModule): (Context, { any })
	local district = Districts.ById[districtId]
	local B = Kit.new(worldFolder, districtId, district.Palette)
	local origin = CFrame.new(district.Origin)
	local hubOffset = Districts.ById.Hub.Origin - district.Origin
	local hubDir = Vector3.new(hubOffset.X, 0, hubOffset.Z).Unit
	local hubAngle = math.atan2(hubDir.Z, hubDir.X)

	local ctx: Context = {
		B = B,
		District = district,
		Origin = origin,
		Y = district.Origin.Y,
		HubDir = hubDir,
		Spokes = {},
		Buildings = {},
		CourseMetas = {},
		High = {},
		Roofs = {},
		Nooks = {},
		Spawn = CFrame.lookAt(
			district.Origin + hubDir * 26 + Vector3.new(0, 3, 0),
			district.Origin + Vector3.new(0, 3, 0)
		),
		UsedHigh = 0,
		UsedRoof = 0,
		UsedNook = 0,
		Annex = nil,
		Taken = {},
	}

	-- Plaza and its shared fixtures.
	module.Plaza(B, ctx)
	local gateCF = CFrame.lookAt(district.Origin + hubDir * (DistrictBuilder.PlazaRadius - 6), district.Origin)
	DistrictBuilder.TravelGate(ctx, gateCF)
	local side = hubDir:Cross(Vector3.yAxis)
	board(
		ctx,
		"Race",
		"RACE BOARD",
		CFrame.lookAt(district.Origin + hubDir * 30 + side * 16, district.Origin),
		Color3.fromRGB(255, 120, 220)
	)
	board(
		ctx,
		"Jobs",
		"JOB BOARD",
		CFrame.lookAt(district.Origin + hubDir * 30 - side * 16, district.Origin),
		Color3.fromRGB(255, 210, 90)
	)
	board(
		ctx,
		"Courses",
		"COURSES",
		CFrame.lookAt(district.Origin - hubDir * 18, district.Origin),
		Color3.fromRGB(120, 230, 255)
	)

	-- Course spokes, skipping the sector toward the hub (that's where the annex goes).
	local spokeCourses = {}
	local rooms = {}
	for _, course in Courses.ByDistrict[districtId] or {} do
		if course.Kind == "Room" then
			table.insert(rooms, course)
		else
			table.insert(spokeCourses, course)
		end
	end
	local usable = math.pi * 2 - DistrictBuilder.HubSector * 2
	local count = #spokeCourses
	for index, course in spokeCourses do
		local angle = hubAngle + DistrictBuilder.HubSector + usable * ((index - 0.5) / count)
		local dir = DistrictBuilder.Dir(angle)
		table.insert(ctx.Spokes, { Angle = angle, Course = course, Length = estimateLength(course), Dir = dir })
	end

	local metas = {}
	for _, spoke in ctx.Spokes do
		local course = spoke.Course
		local dir = spoke.Dir
		local startY = ctx.Y + (course.Y or 0)
		local start = Vector3.new(district.Origin.X, startY, district.Origin.Z) + dir * DistrictBuilder.StartRadius
		local startCF = CFrame.lookAt(start, start + dir)
		-- Approach walkway from the plaza.
		local plazaEdge = district.Origin + dir * (DistrictBuilder.PlazaRadius - 2)
		local walkStart = Vector3.new(plazaEdge.X, ctx.Y, plazaEdge.Z)
		local walkEnd = start + dir * 0.5
		local mid = (walkStart + walkEnd) / 2
		local walkLength = (Vector3.new(walkEnd.X, 0, walkEnd.Z) - Vector3.new(walkStart.X, 0, walkStart.Z)).Magnitude
		if math.abs(startY - ctx.Y) < 1 then
			B:Box(
				CFrame.lookAt(mid, mid + dir) * CFrame.new(0, -1, 0),
				Vector3.new(8, 2, walkLength),
				module.CourseTheme.Trim,
				module.CourseTheme.SurfaceMaterial,
				{ Name = "Approach" }
			)
		else
			local slopeCF = CFrame.lookAt(mid, walkEnd + (walkEnd - walkStart).Unit)
			B:Box(
				slopeCF * CFrame.new(0, -1, 0),
				Vector3.new(8, 2, (walkEnd - walkStart).Magnitude),
				module.CourseTheme.Trim,
				module.CourseTheme.SurfaceMaterial,
				{ Name = "Approach" }
			)
		end
		startSign(ctx, course, startCF * CFrame.new(5.5, 0, -1) * CFrame.Angles(0, math.rad(180), 0))
		local meta = CourseBuilder.Build(B, course, module.CourseTheme, startCF)
		meta.District = districtId
		table.insert(metas, meta)
		spoke.Length = math.max(spoke.Length, meta.Length + 20)
	end

	-- Challenge rooms in the annex toward the hub.
	if #rooms > 0 then
		local annexStart = district.Origin + hubDir * (DistrictBuilder.PlazaRadius - 2)
		local annexCenter = district.Origin + hubDir * 138
		ctx.Annex = CFrame.lookAt(annexCenter, annexCenter + hubDir)
		local mid = (annexStart + annexCenter) / 2
		-- A covered walkway leading out to the annex hall (the travel gate sits beside it).
		local walkway = CFrame.lookAt(mid, mid + hubDir) * CFrame.new(-14, -1, 0)
		B:Box(
			walkway,
			Vector3.new(10, 2, (annexCenter - annexStart).Magnitude),
			module.CourseTheme.Trim,
			module.CourseTheme.SurfaceMaterial,
			{ Name = "AnnexWalk" }
		)
		local hallCF = CFrame.lookAt(annexCenter - hubDir * 6, annexCenter) * CFrame.new(0, -1, 0)
		B:Box(
			hallCF,
			Vector3.new(190, 2, 22),
			module.CourseTheme.Trim,
			module.CourseTheme.SurfaceMaterial,
			{ Name = "AnnexHall" }
		)
		if module.Annex then
			module.Annex(B, ctx, CFrame.lookAt(annexCenter, annexCenter + hubDir))
		end
		local hallSign = B:Detail(
			CFrame.lookAt(
				annexCenter - hubDir * 16 + Vector3.new(0, 12, 0),
				annexCenter - hubDir * 40 + Vector3.new(0, 12, 0)
			),
			Vector3.new(30, 4, 0.4),
			Color3.fromRGB(25, 28, 36),
			Enum.Material.SmoothPlastic
		)
		B:Text(hallSign, Enum.NormalId.Front, "CHALLENGE ROOMS", { Color = district.Palette.Signal })
		for index, course in rooms do
			local lateral = (index - (#rooms + 1) / 2) * 62
			local roomOrigin = CFrame.lookAt(annexCenter, annexCenter + hubDir) * CFrame.new(-14 + lateral, 0, -4)
			local walkway2 = roomOrigin * CFrame.new(0, -1, 6)
			B:Box(walkway2, Vector3.new(8, 2, 14), module.CourseTheme.Trim, module.CourseTheme.SurfaceMaterial)
			startSign(ctx, course, roomOrigin * CFrame.new(5.5, 0, 4) * CFrame.Angles(0, math.rad(180), 0))
			local meta = CourseBuilder.Build(B, course, module.RoomTheme, roomOrigin)
			meta.District = districtId
			table.insert(metas, meta)
			-- Enclose the room.
			local min, max = meta.LocalMin, meta.LocalMax
			local margin = 6
			local sizeX = (max.X - min.X) + margin * 2
			local sizeZ = (max.Z - min.Z) + margin * 2
			local floorY = min.Y - 2
			local height = (max.Y - floorY) + 8
			local center = roomOrigin * CFrame.new((min.X + max.X) / 2, floorY + height / 2, (min.Z + max.Z) / 2)
			local wallColor = module.RoomTheme.Wall
			local wallMat = module.RoomTheme.WallMaterial
			for _, sx in { -1, 1 } do
				B:Box(
					center * CFrame.new(sx * sizeX / 2, 0, 0),
					Vector3.new(2, height, sizeZ),
					wallColor,
					wallMat,
					{ Name = "RoomWall" }
				)
			end
			-- Far wall, and the near wall with a doorway level with the start platform.
			B:Box(
				center * CFrame.new(0, 0, (min.Z - max.Z) / 2 - margin),
				Vector3.new(sizeX, height, 2),
				wallColor,
				wallMat,
				{ Name = "RoomWall" }
			)
			local nearZ = max.Z + margin
			local left, right = min.X - margin, max.X + margin
			local top = floorY + height
			local function nearPiece(x0: number, x1: number, y0: number, y1: number)
				if x1 - x0 > 0.2 and y1 - y0 > 0.2 then
					B:Box(
						roomOrigin * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, nearZ),
						Vector3.new(x1 - x0, y1 - y0, 2),
						wallColor,
						wallMat,
						{ Name = "RoomWall" }
					)
				end
			end
			nearPiece(left, -5, floorY, top)
			nearPiece(5, right, floorY, top)
			nearPiece(-5, 5, 11, top)
			nearPiece(-5, 5, floorY, -2)
			B:Box(
				center * CFrame.new(0, height / 2 + 1, 0),
				Vector3.new(sizeX + 2, 2, sizeZ + 4),
				wallColor,
				wallMat,
				{ Name = "RoomRoof" }
			)
			-- Light strips along the ceiling.
			for k = -1, 1 do
				local strip = B:Detail(
					center * CFrame.new(k * sizeX / 4, height / 2 - 0.3, 0),
					Vector3.new(1, 0.3, sizeZ - 6),
					Color3.fromRGB(255, 245, 225),
					Enum.Material.Neon
				)
				B:Light(strip, Color3.fromRGB(255, 240, 220), 40, 1.2, "Spot", Enum.NormalId.Bottom)
			end
		end
	end

	-- Exploration pockets between the spokes.
	local angles = {}
	for _, spoke in ctx.Spokes do
		table.insert(angles, spoke)
	end
	table.sort(angles, function(a, b)
		return (a.Angle - hubAngle) % (math.pi * 2) < (b.Angle - hubAngle) % (math.pi * 2)
	end)
	local function clearOfCourses(position: Vector3, radius: number): boolean
		local flat = Vector3.new(position.X - district.Origin.X, 0, position.Z - district.Origin.Z)
		if flat.Magnitude < DistrictBuilder.StartRadius + 50 then
			return false
		end
		local angle = math.atan2(flat.Z, flat.X)
		if angleDiff(angle, hubAngle) < DistrictBuilder.HubSector + math.rad(8) and flat.Magnitude < 380 then
			return false
		end
		for _, spoke in ctx.Spokes do
			local a = district.Origin + spoke.Dir * DistrictBuilder.StartRadius
			local b = district.Origin + spoke.Dir * (DistrictBuilder.StartRadius + spoke.Length)
			if distanceToSegment(position, a, b) < DistrictBuilder.CorridorHalfWidth + radius then
				return false
			end
		end
		for _, building in ctx.Buildings do
			local offset = Vector3.new(position.X - building.Center.X, 0, position.Z - building.Center.Z)
			if offset.Magnitude < radius + building.Size.X / 2 + 7 then
				return false
			end
		end
		return true
	end

	for _, radius in { 200, 255, 310, 365, 420, 480 } do
		local circumference = math.pi * 2 * radius
		local steps = math.floor(circumference / 48)
		for step = 0, steps - 1 do
			local angle = hubAngle + (step / steps) * math.pi * 2 + B:Rand(-0.02, 0.02)
			local r = radius + B:Rand(-10, 10)
			local position = district.Origin + DistrictBuilder.Dir(angle) * r
			local width = B:Rand(20, 32)
			if clearOfCourses(position, width * 0.75) then
				local range = module.HeightRange or { -8, 14 }
				local top = ctx.Y + math.floor(B:Rand(range[1], range[2]) / 2) * 2
				local size = Vector3.new(width, 0, B:Rand(20, 32))
				local cf = CFrame.lookAt(
					Vector3.new(position.X, top, position.Z),
					Vector3.new(district.Origin.X, top, district.Origin.Z)
				)
				local spots = module.Building(B, ctx, cf, size)
				table.insert(
					ctx.Buildings,
					{ Center = Vector3.new(position.X, top, position.Z), Top = top, Size = size, Spots = spots }
				)
				table.insert(ctx.Roofs, spots.Roof)
				for _, p in spots.High do
					table.insert(ctx.High, p)
				end
				for _, p in spots.Nooks do
					table.insert(ctx.Nooks, p)
				end
			end
		end
	end

	-- Connect neighbouring rooftops: jumpable gaps are left as they are, wider ones get
	-- a plank or a zipline so every pocket is traversable.
	for i, a in ctx.Buildings do
		local best, bestDistance = nil, math.huge
		for j, b in ctx.Buildings do
			if j ~= i then
				local d = Vector3.new(a.Center.X - b.Center.X, 0, a.Center.Z - b.Center.Z).Magnitude
				if d < bestDistance then
					best, bestDistance = b, d
				end
			end
		end
		if best and bestDistance < 75 then
			local edgeGap = bestDistance - (a.Size.X + best.Size.X) / 2
			local dy = best.Top - a.Top
			if edgeGap > Reach.JumpDistance(dy) * 0.6 then
				local from = Vector3.new(a.Center.X, a.Top, a.Center.Z)
				local to = Vector3.new(best.Center.X, best.Top, best.Center.Z)
				local dir = Vector3.new(to.X - from.X, 0, to.Z - from.Z).Unit
				local p0 = from + dir * (a.Size.X / 2 - 1)
				local p1 = to - dir * (best.Size.X / 2 - 1)
				if module.Connector then
					module.Connector(B, ctx, p0, p1)
				else
					local beam = B:Beam(
						p0 - Vector3.new(0, 0.5, 0),
						p1 - Vector3.new(0, 0.5, 0),
						1.3,
						1,
						module.CourseTheme.Beam,
						module.CourseTheme.BeamMaterial,
						{ Name = "Plank", Tag = Tags.Balance }
					)
					B:Icon(beam, "=", Color3.new(1, 1, 1), Vector3.new(0, 2, 0))
				end
			end
		end
	end

	-- A walkway from the plaza out to each pocket's nearest rooftop.
	local linked = {}
	for _, building in ctx.Buildings do
		local flat = Vector3.new(building.Center.X - district.Origin.X, 0, building.Center.Z - district.Origin.Z)
		local angle = math.atan2(flat.Z, flat.X)
		local bucket = math.floor(((angle - hubAngle) % (math.pi * 2)) / (math.pi * 2 / math.max(count, 1)))
		local current = linked[bucket]
		if not current or flat.Magnitude < current.Distance then
			linked[bucket] = { Building = building, Distance = flat.Magnitude }
		end
	end
	for _, entry in linked do
		local building = entry.Building
		local dir = Vector3.new(building.Center.X - district.Origin.X, 0, building.Center.Z - district.Origin.Z).Unit
		local a = Vector3.new(district.Origin.X, ctx.Y, district.Origin.Z) + dir * (DistrictBuilder.PlazaRadius - 2)
		local b = Vector3.new(building.Center.X, building.Top, building.Center.Z) - dir * (building.Size.X / 2 - 1)
		B:Beam(
			a - Vector3.new(0, 0.6, 0),
			b - Vector3.new(0, 0.6, 0),
			4,
			1.2,
			module.CourseTheme.Trim,
			module.CourseTheme.SurfaceMaterial,
			{ Name = "Skybridge" }
		)
		for _, s in { -1, 1 } do
			local side2 = dir:Cross(Vector3.yAxis) * s * 2.2
			B:Beam(
				a + side2 + Vector3.new(0, 1.6, 0),
				b + side2 + Vector3.new(0, 1.6, 0),
				0.2,
				0.2,
				module.CourseTheme.Trim,
				Enum.Material.Metal,
				{ Decor = true, CanCollide = true }
			)
		end
	end

	-- Discoveries spread through the pockets.
	for index = 1, 6 do
		DistrictBuilder.Cache(ctx, index, DistrictBuilder.TakeNook(ctx))
	end
	for index = 1, #(Lore.Letters[districtId] or {}) do
		DistrictBuilder.Letter(ctx, index, DistrictBuilder.TakeRoof(ctx) + Vector3.new(B:Rand(-3, 3), 0, B:Rand(-3, 3)))
	end
	-- Contract drop-off points on rooftops.
	for index = 1, 8 do
		local roof = DistrictBuilder.TakeRoof(ctx)
		B:Point(
			Tags.ContractPoint,
			("%s_contract_%d"):format(string.lower(districtId), index),
			roof + Vector3.new(0, 1, 0)
		)
	end

	module.Landmarks(B, ctx)
	module.QuestPoints(B, ctx)
	module.Skyline(B, ctx)
	DistrictBuilder.QuestPoint(
		ctx,
		DistrictBuilder.Prefix[districtId] .. "_plaza",
		district.Origin + Vector3.new(0, 2, 0)
	)
	return ctx, metas
end

return DistrictBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="69">
          <Properties>
            <string name="Name">Districts</string>
          </Properties>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">Citadel</string>
              <string name="Source"><![CDATA[-- Aether Citadel: floating marble architecture held aloft by the Aether Keel.
-- Every platform floats on a rock keel of its own; golden rings orbit
-- overhead, currents rise between the terraces, and gravity bends near the Keel.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Tags = require(ReplicatedStorage.Shared.Tags)

local DistrictBuilder = require(script.Parent.Parent.DistrictBuilder)
local Props = require(script.Parent.Parent.Props)

local P = Districts.ById.Citadel.Palette

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local Citadel = {}

Citadel.HeightRange = { -10, 22 }

local function keel(B, top: CFrame, width: number, length: number, depth: number)
	-- An inverted rock spire under each floating slab, with a glowing crystal tip.
	local d = math.min(depth, 6 + (width + length) * 0.35)
	for i = 1, 3 do
		local f = 1 - (i - 1) * 0.3
		B:Box(
			top * CFrame.new(0, -(i - 0.5) * d / 3, 0) * CFrame.Angles(0, i * 0.5, 0),
			Vector3.new(width * f * 0.9, d / 3, length * f * 0.9),
			B:Vary(P.Stone, 0.06),
			Enum.Material.Rock,
			{ Name = "Keel", Decor = i > 1 }
		)
	end
	if width * length > 150 then
		Props.Crystal(B, (top * CFrame.new(0, -d - 2, 0)).Position, 4, P.Aether)
	end
end

Citadel.CourseTheme = {
	Id = "Citadel",
	Surface = P.Marble,
	SurfaceMaterial = Enum.Material.Marble,
	Trim = P.Gold,
	Wall = P.MarbleDark,
	WallMaterial = Enum.Material.Marble,
	Accent = P.Accent,
	Signal = P.Signal,
	Beam = P.Gold,
	BeamMaterial = Enum.Material.Metal,
	Rope = P.Gold,
	Climb = "Ladder",
	BodyDepth = 26,
	Floating = true,
	Platform = function(B, top, width, length, role)
		B:Box(
			top * CFrame.new(0, -1, 0),
			Vector3.new(width, 2, length),
			B:Vary(P.Marble, 0.04),
			Enum.Material.Marble,
			{ Name = "Terrace" }
		)
		if role ~= "Recovery" and length >= 10 then
			for _, side in { -1, 1 } do
				B:Detail(
					top * CFrame.new(side * (width / 2 + 0.1), -0.6, 0),
					Vector3.new(0.2, 0.8, length),
					P.Gold,
					Enum.Material.Metal
				)
			end
		end
	end,
	Body = keel,
	AnchorMount = function(B, position)
		local ring = B:Detail(
			CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
			Vector3.new(0.3, 6, 6),
			P.Gold,
			Enum.Material.Metal,
			{ Shape = Enum.PartType.Cylinder }
		)
		ring.CanCollide = false
	end,
}

Citadel.RoomTheme = {
	Id = "CitadelRoom",
	Surface = P.Marble,
	SurfaceMaterial = Enum.Material.Marble,
	Trim = P.Gold,
	Wall = P.MarbleDark,
	WallMaterial = Enum.Material.Marble,
	Accent = P.Accent,
	Signal = P.Signal,
	Beam = P.Gold,
	BeamMaterial = Enum.Material.Metal,
	Rope = P.Gold,
	Climb = "Ladder",
	BodyDepth = 0,
}

local function ring(B, center: CFrame, radius: number, color: Color3, segments: number?)
	local n = segments or 16
	for i = 0, n - 1 do
		local angle = i / n * math.pi * 2
		local piece = B:Detail(
			center * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius),
			Vector3.new(2 * math.pi * radius / n + 0.3, 0.8, 1.2),
			color,
			Enum.Material.Metal
		)
		piece.CanCollide = false
	end
end

function Citadel.Plaza(B, ctx)
	local origin = ctx.Origin
	local R = DistrictBuilder.PlazaRadius
	B:Cylinder(
		origin * CFrame.new(0, -1, 0) * CFrame.Angles(0, 0, math.rad(90)),
		2,
		R * 2,
		P.Marble,
		Enum.Material.Marble,
		{ Name = "KeelTerrace" }
	)
	B:Cylinder(
		origin * CFrame.new(0, -0.95, 0) * CFrame.Angles(0, 0, math.rad(90)),
		2,
		R * 2 - 12,
		P.MarbleDark,
		Enum.Material.Marble,
		{ Decor = true }
	)
	Props.FloatingRock(B, origin * CFrame.new(0, -2, 0), R * 1.9, 60, P.Stone)
	-- Golden rings orbit slowly overhead.
	for index, radius in { 30, 38 } do
		local center = origin * CFrame.new(0, 24 + index * 6, 0) * CFrame.Angles(math.rad(12 * index), 0, 0)
		ring(B, center, radius, P.Gold, 20)
	end
	-- Statue plinths for the Warden and the Skywright memorial.
	local side = ctx.HubDir:Cross(Vector3.yAxis)
	local plinth = CFrame.lookAt(ctx.Origin.Position - ctx.HubDir * 22, ctx.Origin.Position)
	B:Box(
		plinth * CFrame.new(0, 1, 0),
		Vector3.new(8, 2, 8),
		P.MarbleDark,
		Enum.Material.Marble,
		{ Name = "WardenPlinth" }
	)
	DistrictBuilder.NPCSpot(ctx, "cit_warden", plinth * CFrame.new(0, 5, 0))
	DistrictBuilder.NPCSpot(
		ctx,
		"cit_ilse",
		CFrame.lookAt(
			ctx.Origin.Position + side * 24 + Vector3.new(0, 3, 0),
			ctx.Origin.Position + Vector3.new(0, 3, 0)
		)
	)
	DistrictBuilder.NPCSpot(
		ctx,
		"cit_echo",
		CFrame.lookAt(
			ctx.Origin.Position - side * 24 + Vector3.new(0, 3, 0),
			ctx.Origin.Position + Vector3.new(0, 3, 0)
		)
	)
	-- Ilse's camp: a tent and her map table.
	local camp = CFrame.lookAt(ctx.Origin.Position + side * 30, ctx.Origin.Position)
	B:Wedge(camp * CFrame.new(-2, 2, 4), Vector3.new(6, 4, 5), rgb(150, 110, 255), Enum.Material.Fabric)
	B:Wedge(
		camp * CFrame.new(2, 2, 4) * CFrame.Angles(0, math.rad(180), 0),
		Vector3.new(6, 4, 5),
		rgb(150, 110, 255),
		Enum.Material.Fabric
	)
	B:Box(camp * CFrame.new(0, 1.4, -2), Vector3.new(5, 0.3, 3), P.Gold, Enum.Material.Wood)
	for i = 0, 7 do
		Props.Column(
			B,
			origin * CFrame.Angles(0, i * math.pi / 4 + 0.39, 0) * CFrame.new(0, 0, -(R - 4)),
			14,
			P.Marble,
			i % 3 == 0
		)
	end
	local crystal = B:Ball(
		ctx.Origin.Position + Vector3.new(0, 4, 0),
		3,
		P.Aether2,
		Enum.Material.Neon,
		{ Name = "TerraceCrystal", CanCollide = false }
	)
	B:Light(crystal, P.Aether2, 30, 1.5)
	-- Skywright reliquary (district shop).
	local reliquary = CFrame.lookAt(ctx.Origin.Position - ctx.HubDir * 30 - side * 16, ctx.Origin.Position)
	B:Box(
		reliquary * CFrame.new(0, 1.5, 0),
		Vector3.new(8, 3, 3),
		P.MarbleDark,
		Enum.Material.Marble,
		{ Name = "Reliquary" }
	)
	local glow = B:Box(
		reliquary * CFrame.new(0, 4, 0),
		Vector3.new(2, 2, 2),
		P.Aether,
		Enum.Material.Neon,
		{ CanCollide = false }
	)
	B:Prompt(
		glow,
		"Browse",
		"Skywright Reliquary",
		{ Name = "ShopPrompt", Distance = 12, Attrs = { Board = "Shop", District = "Citadel" } }
	)
end

function Citadel.Building(B, ctx, top: CFrame, size: Vector3)
	local w, d = size.X, size.Z
	B:Box(
		top * CFrame.new(0, -1, 0),
		Vector3.new(w, 2, d),
		B:Vary(P.Marble, 0.05),
		Enum.Material.Marble,
		{ Name = "Island" }
	)
	Props.FloatingRock(B, top * CFrame.new(0, -2, 0), math.max(w, d) * 0.95, 30, P.Stone)
	local spots = { Roof = (top * CFrame.new(0, 0.2, 0)).Position, High = {}, Nooks = {} }
	if B:Rand(0, 1) < 0.5 then
		-- A colonnade with an arch: the arch top is a perch, its shadow a nook.
		Props.Arch(B, top * CFrame.new(0, 0, d / 4), math.min(w - 6, 12), 10, P.MarbleDark, Enum.Material.Marble)
		table.insert(spots.High, (top * CFrame.new(0, 11.7, d / 4)).Position)
		table.insert(spots.Nooks, (top * CFrame.new(-w / 2 + 2, 0.2, -d / 2 + 2)).Position)
		for i = -1, 1, 2 do
			Props.Column(B, top * CFrame.new(i * (w / 2 - 2), 0, -d / 4), 9, P.Marble, true)
		end
	else
		-- A reading pavilion of the Skywright Archive.
		local roofTop = (top * CFrame.new(0, 9, 0)).Position
		for i = 0, 3 do
			Props.Column(
				B,
				top * CFrame.new((if i % 2 == 0 then -1 else 1) * 4, 0, (if i < 2 then -1 else 1) * 4),
				8,
				P.Marble,
				false
			)
		end
		B:Box(top * CFrame.new(0, 9, 0), Vector3.new(12, 1, 12), P.Gold, Enum.Material.Metal, { Name = "PavilionRoof" })
		Props.Crystal(B, (top * CFrame.new(0, 0.2, 0)).Position, 3, P.Aether2)
		table.insert(spots.High, roofTop + Vector3.new(0, 0.7, 0))
		table.insert(spots.Nooks, (top * CFrame.new(w / 2 - 1.5, 0.2, d / 2 - 1.5)).Position)
	end
	return spots
end

function Citadel.Connector(B, ctx, a: Vector3, b: Vector3)
	-- Aether currents carry you up; golden chains bridge level gaps.
	if b.Y - a.Y > 4 then
		local column = a + (b - a) * 0.5
		local height = b.Y - a.Y + 16
		local zone = B:Box(
			CFrame.new(Vector3.new(column.X, a.Y + height / 2, column.Z)),
			Vector3.new(8, height, 8),
			rgb(255, 255, 255),
			Enum.Material.SmoothPlastic,
			{
				Name = "Current",
				Transparency = 1,
				CanCollide = false,
				CanQuery = false,
				Tag = Tags.GravityZone,
				Attrs = { Scale = 1, Lift = 260, MaxRise = 30 },
			}
		)
		local attachment = Instance.new("Attachment")
		attachment.Position = Vector3.new(0, -height / 2, 0)
		attachment.Parent = zone
		B:Emitter(attachment, "Updraft", P.Aether2)
		B:Icon(zone, "⇧", P.Signal, Vector3.new(0, -height / 2 + 2, 0))
	else
		local chain = B:Beam(
			a - Vector3.new(0, 0.5, 0),
			b - Vector3.new(0, 0.5, 0),
			1.2,
			1,
			P.Gold,
			Enum.Material.Metal,
			{ Name = "GoldChain", Tag = Tags.Balance }
		)
		B:Icon(chain, "=", rgb(255, 255, 255), Vector3.new(0, 2, 0))
	end
end

function Citadel.Landmarks(B, ctx)
	-- The Aether Keel: a colossal crystal hanging in rings, with a chamber beneath.
	local keelPos = DistrictBuilder.FindClear(ctx, 560, 40) + Vector3.new(0, 30, 0)
	local keelCF = CFrame.lookAt(keelPos, ctx.Origin.Position + Vector3.new(0, 30, 0))
	B:Box(
		keelCF * CFrame.new(0, -1, 0),
		Vector3.new(34, 2, 34),
		P.Marble,
		Enum.Material.Marble,
		{ Name = "KeelPlatform" }
	)
	Props.FloatingRock(B, keelCF * CFrame.new(0, -2, 0), 34, 40, P.Stone)
	local crystal = B:Box(
		keelCF * CFrame.new(0, 26, 0) * CFrame.Angles(0, math.rad(45), 0),
		Vector3.new(10, 44, 10),
		P.Aether,
		Enum.Material.Neon,
		{ Name = "AetherKeel", CanCollide = false }
	)
	B:Light(crystal, P.Aether, 80, 3)
	for index, radius in { 12, 16, 20 } do
		ring(
			B,
			keelCF * CFrame.new(0, 20 + index * 6, 0) * CFrame.Angles(math.rad(index * 20), math.rad(index * 30), 0),
			radius,
			P.Gold,
			18
		)
	end
	-- A stair of floating steps up to the relay ring.
	for i = 0, 7 do
		local step = keelCF * CFrame.Angles(0, i * 0.8, 0) * CFrame.new(0, 2 + i * 4.5, -13)
		B:Box(step, Vector3.new(6, 1, 4), P.MarbleDark, Enum.Material.Marble, { Name = "KeelStep" })
	end
	local relayDeck = keelCF * CFrame.new(0, 38, -13)
	B:Box(relayDeck, Vector3.new(10, 1, 6), P.Gold, Enum.Material.Metal, { Name = "RelayDeck" })
	DistrictBuilder.QuestPoint(ctx, "cit_keel_relay", (relayDeck * CFrame.new(0, 2, 0)).Position)
	DistrictBuilder.Landmark(ctx, "keel", "The Aether Keel", keelCF * CFrame.new(0, 4, 0), Vector3.new(34, 8, 34))
	-- The chamber beneath, reached by dropping through the gap at the platform's edge.
	local chamber = keelCF * CFrame.new(0, -28, 0)
	B:Box(
		chamber * CFrame.new(0, -1, 0),
		Vector3.new(16, 2, 16),
		P.MarbleDark,
		Enum.Material.Marble,
		{ Name = "KeelChamber" }
	)
	Props.Ladder(B, chamber * CFrame.new(0, 0, 8.6), 26, 2.6)
	local core =
		B:Ball(chamber.Position + Vector3.new(0, 4, 0), 3, P.Aether2, Enum.Material.Neon, { CanCollide = false })
	B:Light(core, P.Aether2, 20, 1.5)
	DistrictBuilder.Secret(
		ctx,
		"keel",
		"Under the Keel",
		"The Keel's control chamber. Every dial reads STABLE, and has for ten years.",
		chamber * CFrame.new(0, 3, 0),
		Vector3.new(16, 6, 16)
	)
	B:FarBox(keelCF * CFrame.new(0, 26, 0), Vector3.new(10, 44, 10), P.Aether, Enum.Material.Neon)

	-- The Skywright Archive: tiers of floating shelves around a reading dome.
	local archivePos = DistrictBuilder.FindClear(ctx, 520, 34)
	local archive = CFrame.lookAt(archivePos, ctx.Origin.Position)
	for tier = 0, 2 do
		local t = archive * CFrame.new(0, tier * 14, 0)
		local size = 30 - tier * 8
		B:Box(
			t * CFrame.new(0, -1, 0),
			Vector3.new(size, 2, size),
			P.Marble,
			Enum.Material.Marble,
			{ Name = "ArchiveTier" }
		)
		if tier == 0 then
			Props.FloatingRock(B, t * CFrame.new(0, -2, 0), size, 30, P.Stone)
		end
		for i = 0, 3 do
			Props.Column(
				B,
				t * CFrame.Angles(0, i * math.pi / 2 + math.pi / 4, 0) * CFrame.new(0, 0, -(size / 2 - 2)),
				12,
				P.MarbleDark,
				false
			)
		end
		Props.Ladder(
			B,
			t * CFrame.new(size / 2 - 3, 0, -(size / 2) - 0.1) * CFrame.Angles(0, math.rad(180), 0),
			14,
			2.4
		)
	end
	DistrictBuilder.Landmark(
		ctx,
		"archive",
		"Skywright Archive",
		archive * CFrame.new(0, 32, 0),
		Vector3.new(14, 6, 14)
	)
	B:FarBox(archive * CFrame.new(0, 14, 0), Vector3.new(30, 30, 30), P.Marble)
end

function Citadel.QuestPoints(B, ctx)
	for i = 1, 5 do
		local spot = DistrictBuilder.TakeHigh(ctx)
		local scroll = B:Detail(
			CFrame.new(spot + Vector3.new(0, 0.6, 0)),
			Vector3.new(1.4, 0.3, 0.3),
			rgb(245, 235, 210),
			Enum.Material.SmoothPlastic,
			{ Shape = Enum.PartType.Cylinder }
		)
		scroll.CanCollide = false
		DistrictBuilder.QuestPoint(ctx, "cit_map_" .. i, spot + Vector3.new(0, 1, 0))
	end
	for i = 1, 4 do
		local spot = DistrictBuilder.TakeNook(ctx)
		Props.Crystal(B, spot, 2.2, P.Aether)
		DistrictBuilder.QuestPoint(ctx, "cit_echo_" .. i, spot + Vector3.new(0, 1, 0))
	end
end

function Citadel.Skyline(B, ctx)
	-- Distant floating islands and drifting crystals.
	for i = 0, 15 do
		local angle = i * math.pi / 8 + 0.15
		local p = ctx.Origin.Position
			+ DistrictBuilder.Dir(angle) * (640 + B:Rand(-80, 80))
			+ Vector3.new(0, B:Rand(-60, 80), 0)
		local size = B:Rand(30, 70)
		B:FarBox(CFrame.new(p), Vector3.new(size, 4, size), P.Marble)
		B:FarBox(
			CFrame.new(p - Vector3.new(0, size * 0.3, 0)) * CFrame.Angles(0, 0.6, 0),
			Vector3.new(size * 0.6, size * 0.6, size * 0.6),
			P.Stone,
			Enum.Material.Rock
		)
	end
	for _ = 1, 20 do
		local p = ctx.Origin.Position
			+ DistrictBuilder.Dir(B:Rand(0, math.pi * 2)) * B:Rand(140, 560)
			+ Vector3.new(0, B:Rand(-60, 60), 0)
		Props.Crystal(B, p, B:Rand(2, 6), B:Pick({ P.Aether, P.Aether2, P.Glow }))
	end
	-- A sea of cloud far below.
	B:Detail(
		ctx.Origin * CFrame.new(0, -150, 0),
		Vector3.new(1600, 2, 1600),
		rgb(240, 225, 245),
		Enum.Material.Snow,
		{ CanCollide = false, Transparency = 0.2 }
	)
	B:Volume(
		ctx.Origin * CFrame.new(0, -ctx.District.KillDepth, 0),
		Vector3.new(1600, 10, 1600),
		Tags.KillZone,
		{ District = "Citadel" }
	)
end

return Citadel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Frostreach</string>
              <string name="Source"><![CDATA[-- Frostreach: a mountain settlement of timber lodges on rock pillars, linked by
-- rope bridges and exposed ridges. Snow, ice, gusting wind, and the Hollowpeak
-- signal mast at the top of the world.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Tags = require(ReplicatedStorage.Shared.Tags)

local DistrictBuilder = require(script.Parent.Parent.DistrictBuilder)
local Props = require(script.Parent.Parent.Props)

local P = Districts.ById.Frostreach.Palette

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local Frostreach = {}

Frostreach.HeightRange = { -4, 24 }

local function crag(B, top: CFrame, width: number, length: number, depth: number)
	-- A tapering rock pillar under every platform.
	local layers = 3
	for i = 1, layers do
		local f = 1 - (i - 1) * 0.18
		B:Box(
			top * CFrame.new(0, -(i - 0.5) * depth / layers, 0) * CFrame.Angles(0, (i - 1) * 0.3, 0),
			Vector3.new(width * f, depth / layers, length * f),
			B:Vary(P.Rock, 0.06),
			Enum.Material.Rock,
			{ Name = "Crag" }
		)
	end
end

Frostreach.CourseTheme = {
	Id = "Frostreach",
	Surface = P.Snow,
	SurfaceMaterial = Enum.Material.Snow,
	Trim = P.Wood,
	Wall = P.RockDark,
	WallMaterial = Enum.Material.Rock,
	Accent = P.Accent,
	Signal = P.Signal,
	Beam = P.Wood,
	BeamMaterial = Enum.Material.WoodPlanks,
	Rope = rgb(200, 180, 140),
	Climb = "Mesh",
	BodyDepth = 42,
	Platform = function(B, top, width, length, role)
		local material = if role == "Checkpoint"
				or role == "Start"
				or role == "Finish"
			then Enum.Material.WoodPlanks
			else Enum.Material.Snow
		B:Box(
			top * CFrame.new(0, -1, 0),
			Vector3.new(width, 2, length),
			if material == Enum.Material.WoodPlanks then P.Wood else P.Snow,
			material,
			{ Name = "Ledge" }
		)
		if role ~= "Recovery" and length >= 14 and B:Rand(0, 1) < 0.35 then
			Props.Pine(
				B,
				top
					* CFrame.new(
						(width / 2 - 1.5) * (if B:Rand(0, 1) < 0.5 then -1 else 1),
						0,
						B:Rand(-length / 3, length / 3)
					),
				B:Rand(5, 8),
				true
			)
		end
	end,
	Body = crag,
	WallStyle = function(B, cframe, size)
		return B:Box(cframe, size, P.Ice, Enum.Material.Ice, { Name = "IceWall", Transparency = 0.1 })
	end,
}

Frostreach.RoomTheme = {
	Id = "FrostRoom",
	Surface = P.Wood,
	SurfaceMaterial = Enum.Material.WoodPlanks,
	Trim = P.Wood,
	Wall = rgb(150, 120, 95),
	WallMaterial = Enum.Material.WoodPlanks,
	Accent = P.Accent,
	Signal = P.Signal,
	Beam = P.Wood,
	BeamMaterial = Enum.Material.WoodPlanks,
	Rope = rgb(200, 180, 140),
	Climb = "Ladder",
	BodyDepth = 0,
}

local function lodge(B, base: CFrame, width: number, depth: number, height: number): Vector3
	B:Box(
		base * CFrame.new(0, height / 2, 0),
		Vector3.new(width, height, depth),
		P.Wood,
		Enum.Material.WoodPlanks,
		{ Name = "Lodge" }
	)
	-- Steep roof from two wedges, capped with snow.
	for _, side in { -1, 1 } do
		B:Wedge(
			base * CFrame.new(side * width / 4, height + 2.5, 0) * CFrame.Angles(0, math.rad(90 * side), 0),
			Vector3.new(depth + 1, 5, width / 2 + 0.5),
			P.Fabric,
			Enum.Material.Slate
		)
		B:Wedge(
			base * CFrame.new(side * width / 4, height + 2.7, 0) * CFrame.Angles(0, math.rad(90 * side), 0),
			Vector3.new(depth + 1.2, 4.8, width / 2),
			P.Snow,
			Enum.Material.Snow,
			{ Decor = true }
		)
	end
	local window = B:Detail(
		base * CFrame.new(0, height / 2, -depth / 2 - 0.05),
		Vector3.new(3, 2.4, 0.1),
		P.Lamp,
		Enum.Material.Neon
	)
	B:Light(window, P.Lamp, 16, 0.8, "Surface", Enum.NormalId.Front)
	local chimney = Props.Chimney(B, base * CFrame.new(width / 3, height + 1, depth / 4), P.RockDark, 4)
	return chimney
end

function Frostreach.Plaza(B, ctx)
	local origin = ctx.Origin
	local R = DistrictBuilder.PlazaRadius
	B:Cylinder(
		origin * CFrame.new(0, -1, 0) * CFrame.Angles(0, 0, math.rad(90)),
		2,
		R * 2,
		rgb(150, 150, 160),
		Enum.Material.Slate,
		{ Name = "HearthSquare" }
	)
	crag(B, origin * CFrame.new(0, -2, 0), R * 2 - 6, R * 2 - 6, 70)
	-- The hearth: a big fire everyone gathers around.
	local hearth = B:Box(
		origin * CFrame.new(0, 0.6, 0),
		Vector3.new(6, 1.2, 6),
		P.RockDark,
		Enum.Material.Cobblestone,
		{ Name = "Hearth" }
	)
	local flame = Instance.new("Attachment")
	flame.Position = Vector3.new(0, 0.8, 0)
	flame.Parent = hearth
	B:Emitter(flame, "Fire", rgb(255, 170, 80))
	B:Light(hearth, rgb(255, 150, 70), 40, 2)
	for i = 0, 5 do
		Props.Bench(
			B,
			origin * CFrame.Angles(0, i * math.pi / 3, 0) * CFrame.new(0, 0, -9) * CFrame.Angles(0, math.rad(180), 0),
			P.Wood
		)
	end
	-- Lodges around the square (clear of the gate, boards and stall), prayer flags between them.
	local side = ctx.HubDir:Cross(Vector3.yAxis)
	local hubAngle = math.atan2(ctx.HubDir.Z, ctx.HubDir.X)
	local previous: Vector3? = nil
	for _, offset in { 1.2, 2.0, -2.0, -1.2 } do
		local p = ctx.Origin.Position + DistrictBuilder.Dir(hubAngle + offset) * (R - 10)
		local lodgeCF = CFrame.lookAt(p, ctx.Origin.Position)
		lodge(B, lodgeCF, 12, 9, 7)
		local flagPoint = p + Vector3.new(0, 10, 0)
		if previous then
			Props.StringLights(B, previous, flagPoint, P.Fabric)
		end
		previous = flagPoint
	end
	DistrictBuilder.NPCSpot(
		ctx,
		"fro_sigrun",
		CFrame.lookAt(
			ctx.Origin.Position + ctx.HubDir * 12 + Vector3.new(0, 3, 0),
			ctx.Origin.Position + Vector3.new(0, 3, 0)
		)
	)
	DistrictBuilder.NPCSpot(
		ctx,
		"fro_kesh",
		CFrame.lookAt(
			ctx.Origin.Position + side * 20 + Vector3.new(0, 3, 0),
			ctx.Origin.Position + Vector3.new(0, 3, 0)
		)
	)
	DistrictBuilder.QuestPoint(
		ctx,
		"fro_supplies",
		ctx.Origin.Position + side * 16 + ctx.HubDir * 4 + Vector3.new(0, 2, 0)
	)
	Props.Crate(B, CFrame.new(ctx.Origin.Position + side * 16 + ctx.HubDir * 7), 2.4, rgb(150, 110, 70))
	-- Outfitter's sled (district shop).
	local sled = CFrame.lookAt(ctx.Origin.Position - ctx.HubDir * 26 - side * 16, ctx.Origin.Position)
	B:Box(sled * CFrame.new(0, 1.2, 0), Vector3.new(8, 2.4, 4), P.Wood, Enum.Material.WoodPlanks, { Name = "Sled" })
	local tarp = B:Box(sled * CFrame.new(0, 3, 0), Vector3.new(7, 1.2, 3.6), P.Fabric, Enum.Material.Fabric)
	B:Prompt(
		tarp,
		"Browse",
		"Mountain Outfitter",
		{ Name = "ShopPrompt", Distance = 12, Attrs = { Board = "Shop", District = "Frostreach" } }
	)
end

function Frostreach.Building(B, ctx, top: CFrame, size: Vector3)
	local w, d = size.X, size.Z
	crag(B, top * CFrame.new(0, -2, 0), w, d, 70)
	B:Box(top * CFrame.new(0, -1, 0), Vector3.new(w, 2, d), P.Snow, Enum.Material.Snow, { Name = "SnowCap" })
	local spots = { Roof = (top * CFrame.new(-w / 4, 0.2, -d / 4)).Position, High = {}, Nooks = {} }
	if B:Rand(0, 1) < 0.5 then
		local chimney = lodge(B, top * CFrame.new(w / 5, 0, d / 5), math.min(w - 6, 12), math.min(d - 6, 9), 6)
		table.insert(spots.High, chimney)
		table.insert(spots.Nooks, (top * CFrame.new(w / 5 + math.min(w - 6, 12) / 2 + 1.2, 0.2, d / 5)).Position)
	else
		for _ = 1, 3 do
			Props.Pine(B, top * CFrame.new(B:Rand(-w / 3, w / 3), 0, B:Rand(-d / 3, d / 3)), B:Rand(6, 11), true)
		end
		local cairnTop = (top * CFrame.new(0, 0, 0)).Position
		for i = 0, 3 do
			Props.Rock(
				B,
				cairnTop + Vector3.new(0, 0.8 + i * 1.3, 0),
				Vector3.new(3 - i * 0.6, 1.4, 3 - i * 0.6),
				P.RockDark
			)
		end
		table.insert(spots.High, cairnTop + Vector3.new(0, 5.6, 0))
		table.insert(spots.Nooks, (top * CFrame.new(w / 2 - 1.5, 0.2, d / 2 - 1.5)).Position)
	end
	-- Icicles hang under the edges.
	for i = -1, 1 do
		local icicle = B:Detail(
			top * CFrame.new(i * w / 3, -3, -d / 2 + 0.4) * CFrame.Angles(math.rad(180), 0, 0),
			Vector3.new(0.6, 3, 0.6),
			P.Ice,
			Enum.Material.Ice
		)
		icicle.CanCollide = false
	end
	return spots
end

function Frostreach.Connector(B, ctx, a: Vector3, b: Vector3)
	-- Rope bridges: a plank walkway (balance) with rope rails that sway in the wind.
	local plank = B:Beam(
		a - Vector3.new(0, 0.5, 0),
		b - Vector3.new(0, 0.5, 0),
		1.6,
		1,
		P.Wood,
		Enum.Material.WoodPlanks,
		{ Name = "RopeBridge", Tag = Tags.Balance }
	)
	B:Icon(plank, "=", rgb(255, 255, 255), Vector3.new(0, 2, 0))
	local across = (b - a)
	local side = Vector3.new(-across.Z, 0, across.X).Unit * 1.4
	for _, s in { -1, 1 } do
		B:Rod(
			a + side * s + Vector3.new(0, 2.4, 0),
			b + side * s + Vector3.new(0, 2.4, 0),
			0.15,
			rgb(200, 180, 140),
			Enum.Material.Fabric,
			{ Decor = true, CanCollide = false }
		)
		for _, p in { a, b } do
			B:Box(
				CFrame.new(p + side * s + Vector3.new(0, 1.5, 0)),
				Vector3.new(0.4, 3, 0.4),
				P.Wood,
				Enum.Material.Wood
			)
		end
	end
end

function Frostreach.Landmarks(B, ctx)
	-- Hollowpeak Mast: a rock spire with a lattice mast and the great lamp.
	local peakPos = DistrictBuilder.FindClear(ctx, 560, 30)
	local peak = CFrame.lookAt(peakPos, ctx.Origin.Position)
	for i = 0, 4 do
		local f = 1 - i * 0.16
		B:Box(
			peak * CFrame.new(0, -40 + i * 16, 0) * CFrame.Angles(0, i * 0.4, 0),
			Vector3.new(44 * f, 16, 44 * f),
			P.RockDark,
			Enum.Material.Rock,
			{ Name = "Hollowpeak" }
		)
	end
	local summit = peak * CFrame.new(0, 40, 0)
	B:Box(summit * CFrame.new(0, -1, 0), Vector3.new(18, 2, 18), P.Snow, Enum.Material.Snow, { Name = "Summit" })
	-- The climb: ledges spiralling up the peak.
	for i = 0, 9 do
		local ledge = peak * CFrame.Angles(0, i * 1.1, 0) * CFrame.new(0, -30 + i * 7, -(22 - i * 1.4))
		B:Box(ledge, Vector3.new(9, 1, 4), P.Wood, Enum.Material.WoodPlanks, { Name = "PeakLedge" })
	end
	-- Lattice mast and lamp.
	for _, offset in { Vector3.new(-2, 0, -2), Vector3.new(2, 0, -2), Vector3.new(-2, 0, 2), Vector3.new(2, 0, 2) } do
		B:Box(
			summit * CFrame.new(offset) * CFrame.new(0, 14, 0),
			Vector3.new(0.6, 28, 0.6),
			rgb(150, 150, 160),
			Enum.Material.Metal
		)
	end
	Props.Ladder(B, summit * CFrame.new(0, 0, 2.4), 28, 2.4)
	B:Box(
		summit * CFrame.new(0, 28.5, 0),
		Vector3.new(7, 1, 7),
		P.Wood,
		Enum.Material.WoodPlanks,
		{ Name = "LampDeck" }
	)
	local lamp = B:Ball(
		summit.Position + Vector3.new(0, 31, 0),
		3.4,
		P.Lamp,
		Enum.Material.Neon,
		{ Name = "MastLamp", CanCollide = false }
	)
	B:Light(lamp, P.Lamp, 60, 2)
	DistrictBuilder.QuestPoint(ctx, "fro_beacon", (summit * CFrame.new(1.5, 30.5, 1.5)).Position)
	DistrictBuilder.NPCSpot(
		ctx,
		"fro_bram",
		CFrame.lookAt(summit.Position + Vector3.new(6, 3, 0), ctx.Origin.Position + Vector3.new(0, 43, 0))
	)
	DistrictBuilder.Landmark(ctx, "mast", "Hollowpeak Mast", summit * CFrame.new(0, 30, 0), Vector3.new(8, 6, 8))
	B:FarBox(peak * CFrame.new(0, 0, 0), Vector3.new(40, 80, 40), P.RockDark, Enum.Material.Rock)
	B:FarBox(summit * CFrame.new(0, 14, 0), Vector3.new(4, 28, 4), rgb(150, 150, 160))
	B:FarBox(CFrame.new(summit.Position + Vector3.new(0, 31, 0)), Vector3.new(3, 3, 3), P.Lamp, Enum.Material.Neon)

	-- The Frozen Falls: a cascade of ice down a cliff.
	local fallsPos = DistrictBuilder.FindClear(ctx, 520, 30)
	local falls = CFrame.lookAt(fallsPos, ctx.Origin.Position)
	B:Box(falls * CFrame.new(0, -20, 8), Vector3.new(44, 90, 16), P.RockDark, Enum.Material.Rock, { Name = "IceCliff" })
	B:Box(falls * CFrame.new(0, 25.5, 4), Vector3.new(44, 1, 24), P.Snow, Enum.Material.Snow)
	for i = 0, 5 do
		local column = B:Box(
			falls * CFrame.new(-10 + i * 4, -10, -0.5),
			Vector3.new(3.4, 70 - i * 6, 2),
			P.Ice,
			Enum.Material.Glacier,
			{ Name = "Icefall" }
		)
		column.Transparency = 0.15
	end
	B:Box(falls * CFrame.new(-16, 0, -1.4), Vector3.new(4, 50, 0.6), rgb(150, 155, 160), Enum.Material.DiamondPlate, {
		Name = "IceNet",
		Tag = Tags.Climbable,
		Attrs = { Kind = "Mesh" },
	})
	DistrictBuilder.Landmark(ctx, "falls", "The Frozen Falls", falls * CFrame.new(0, 29, 4), Vector3.new(44, 8, 24))
	B:FarBox(falls * CFrame.new(0, -20, 8), Vector3.new(44, 90, 16), P.Ice, Enum.Material.Glacier)
end

function Frostreach.QuestPoints(B, ctx)
	for _, id in { "fro_house_a", "fro_house_b", "fro_house_c" } do
		local roof = DistrictBuilder.TakeRoof(ctx)
		lodge(B, CFrame.new(roof + Vector3.new(4, -0.2, 4)), 8, 7, 5)
		DistrictBuilder.QuestPoint(ctx, id, roof + Vector3.new(0, 1.5, 0))
	end
	for i = 1, 5 do
		local spot = DistrictBuilder.TakeHigh(ctx)
		local post = B:Box(
			CFrame.new(spot + Vector3.new(0, 1.5, 0)),
			Vector3.new(0.4, 3, 0.4),
			P.Wood,
			Enum.Material.Wood,
			{ Name = "LanternPost" }
		)
		B:Detail(post.CFrame * CFrame.new(0, 1.8, 0), Vector3.new(0.9, 0.9, 0.9), rgb(80, 70, 60), Enum.Material.Glass)
		DistrictBuilder.QuestPoint(ctx, "fro_lantern_" .. i, spot + Vector3.new(0, 1, 0))
	end
end

function Frostreach.Skyline(B, ctx)
	for i = 0, 11 do
		local angle = i * math.pi / 6 + 0.1
		local p = ctx.Origin.Position + DistrictBuilder.Dir(angle) * (700 + B:Rand(-60, 60))
		local h = B:Rand(120, 260)
		B:FarBox(
			CFrame.new(p + Vector3.new(0, -140 + h / 2, 0)) * CFrame.Angles(0, B:Rand(0, 1), 0),
			Vector3.new(h * 0.6, h, h * 0.6),
			P.Rock,
			Enum.Material.Rock
		)
		B:FarBox(
			CFrame.new(p + Vector3.new(0, -140 + h, 0)) * CFrame.Angles(0, B:Rand(0, 1), 0),
			Vector3.new(h * 0.3, h * 0.15, h * 0.3),
			P.Snow,
			Enum.Material.Snow
		)
	end
	B:Detail(
		ctx.Origin * CFrame.new(0, -110, 0),
		Vector3.new(1400, 1, 1400),
		rgb(230, 238, 248),
		Enum.Material.Snow,
		{ CanCollide = false }
	)
	B:Volume(
		ctx.Origin * CFrame.new(0, -ctx.District.KillDepth, 0),
		Vector3.new(1600, 10, 1600),
		Tags.KillZone,
		{ District = "Frostreach" }
	)
end

return Frostreach
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">Gilded</string>
              <string name="Source"><![CDATA[-- Gilded Exchange: the neon financial heights. Glass towers with lit window
-- bands, rooftop helipads and antennas, holographic adverts, maintenance rigs,
-- security lasers, and the Exchange Spire crowned with its ticker ring.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Tags = require(ReplicatedStorage.Shared.Tags)

local DistrictBuilder = require(script.Parent.Parent.DistrictBuilder)
local Props = require(script.Parent.Parent.Props)

local P = Districts.ById.Gilded.Palette

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local NEONS = { P.Neon, P.Neon2, P.Gold, rgb(150, 255, 120) }
local ADS = {
	"BUY HIGH",
	"MERIDIAN EXCHANGE",
	"SKYWAY BONDS ▲",
	"TRADE NOW",
	"NIGHT MARKET",
	"GOLD +3.2%",
	"FUTURES",
	"LUMEN SYSTEMS",
}

local Gilded = {}

-- Towers here are taller and more varied than elsewhere.
Gilded.HeightRange = { -6, 28 }

local function tower(B, top: CFrame, width: number, length: number, depth: number)
	B:Box(
		top * CFrame.new(0, -depth / 2, 0),
		Vector3.new(width, depth, length),
		B:Vary(P.GlassDark, 0.05),
		Enum.Material.Glass,
		{ Name = "Tower", Reflectance = 0.15 }
	)
	if length >= 12 then
		local accent = B:Pick(NEONS)
		for _, side in { -1, 1 } do
			B:Detail(
				top * CFrame.new(side * (width / 2 + 0.05), -3, 0),
				Vector3.new(0.1, 0.4, length),
				accent,
				Enum.Material.Neon
			)
			B:Detail(
				top * CFrame.new(side * (width / 2 + 0.05), -10, 0),
				Vector3.new(0.1, 3, length * 0.85),
				if B:Rand(0, 1) < 0.6 then rgb(255, 230, 190) else rgb(40, 60, 90),
				Enum.Material.Neon
			)
		end
	end
end

Gilded.CourseTheme = {
	Id = "Gilded",
	Surface = P.Night,
	SurfaceMaterial = Enum.Material.Marble,
	Trim = P.Gold,
	Wall = P.Glass,
	WallMaterial = Enum.Material.Glass,
	Accent = P.Accent,
	Signal = P.Signal,
	Beam = P.Steel,
	BeamMaterial = Enum.Material.Metal,
	Rope = rgb(80, 80, 90),
	Climb = "Mesh",
	BodyDepth = 60,
	Platform = function(B, top, width, length, role)
		B:Box(
			top * CFrame.new(0, -1, 0),
			Vector3.new(width, 2, length),
			if role == "Checkpoint" then rgb(50, 52, 70) else B:Vary(P.Night, 0.05),
			Enum.Material.Marble,
			{ Name = "Roof" }
		)
		if role ~= "Recovery" and length >= 10 then
			B:Detail(
				top * CFrame.new(-width / 2 + 0.2, 0.03, 0),
				Vector3.new(0.3, 0.06, length),
				P.Gold,
				Enum.Material.Neon
			)
		end
	end,
	Body = tower,
	WallStyle = function(B, cframe, size)
		local wall = B:Box(cframe, size, P.Glass, Enum.Material.Glass, { Name = "GlassWall", Reflectance = 0.25 })
		return wall
	end,
	AnchorMount = function(B, position)
		-- Anchors hang from hovering maintenance drones.
		B:Detail(CFrame.new(position + Vector3.new(0, 3, 0)), Vector3.new(4, 1, 4), P.Steel, Enum.Material.Metal)
		local light = B:Detail(
			CFrame.new(position + Vector3.new(0, 2.4, 0)),
			Vector3.new(0.6, 0.3, 0.6),
			P.Neon2,
			Enum.Material.Neon
		)
		B:Light(light, P.Neon2, 10, 0.6)
	end,
}

Gilded.RoomTheme = {
	Id = "GildedRoom",
	Surface = P.Night,
	SurfaceMaterial = Enum.Material.Marble,
	Trim = P.Gold,
	Wall = rgb(30, 32, 46),
	WallMaterial = Enum.Material.Metal,
	Accent = P.Accent,
	Signal = P.Signal,
	Beam = P.Steel,
	BeamMaterial = Enum.Material.Metal,
	Rope = rgb(80, 80, 90),
	Climb = "Mesh",
	BodyDepth = 0,
}

function Gilded.Plaza(B, ctx)
	local origin = ctx.Origin
	local R = DistrictBuilder.PlazaRadius
	B:Box(
		origin * CFrame.new(0, -1, 0),
		Vector3.new(R * 2, 2, R * 2),
		rgb(40, 42, 58),
		Enum.Material.Marble,
		{ Name = "ExchangePlaza" }
	)
	tower(B, origin * CFrame.new(0, -2, 0), R * 2 - 4, R * 2 - 4, 120)
	for i = 0, 3 do
		B:Detail(
			origin * CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.new(0, 0.04, -R + 1),
			Vector3.new(R * 2 - 2, 0.08, 0.6),
			P.Gold,
			Enum.Material.Neon
		)
	end
	-- The holographic ticker: a ring of scrolling prices over the plaza.
	for i = 0, 7 do
		local angle = i * math.pi / 4
		local panel = B:Detail(
			origin * CFrame.Angles(0, angle, 0) * CFrame.new(0, 18, -16),
			Vector3.new(12.5, 3, 0.2),
			rgb(20, 24, 40),
			Enum.Material.Glass
		)
		B:Text(
			panel,
			Enum.NormalId.Back,
			ADS[i + 1] .. "  ▲" .. (i * 3 + 1) .. "." .. (i * 7 % 10),
			{ Color = NEONS[(i % #NEONS) + 1] }
		)
	end
	Props.Hologram(B, origin * CFrame.new(0, 0, 0), 6, P.Neon2)
	for i = 0, 5 do
		local p = origin * CFrame.Angles(0, i * math.pi / 3 + 0.5, 0)
		Props.Lamp(B, p * CFrame.new(0, 0, -(R - 5)), B:Pick(NEONS), 10)
		if i % 2 == 0 then
			Props.Bench(B, p * CFrame.new(0, 0, -24), rgb(60, 62, 80))
		end
	end
	local side = ctx.HubDir:Cross(Vector3.yAxis)
	DistrictBuilder.NPCSpot(
		ctx,
		"gil_vex",
		CFrame.lookAt(
			ctx.Origin.Position + side * 26 + Vector3.new(0, 3, 0),
			ctx.Origin.Position + Vector3.new(0, 3, 0)
		)
	)
	DistrictBuilder.NPCSpot(
		ctx,
		"gil_pria",
		CFrame.lookAt(
			ctx.Origin.Position - side * 24 - ctx.HubDir * 6 + Vector3.new(0, 3, 0),
			ctx.Origin.Position + Vector3.new(0, 3, 0)
		)
	)
	DistrictBuilder.NPCSpot(
		ctx,
		"gil_lumen",
		CFrame.lookAt(
			ctx.Origin.Position - ctx.HubDir * 26 + Vector3.new(0, 3, 0),
			ctx.Origin.Position + Vector3.new(0, 3, 0)
		)
	)
	-- Boutique kiosk (district shop).
	local kiosk = CFrame.lookAt(ctx.Origin.Position - ctx.HubDir * 30 + side * 18, ctx.Origin.Position)
	B:Box(
		kiosk * CFrame.new(0, 1.5, 0),
		Vector3.new(8, 3, 3),
		rgb(30, 32, 46),
		Enum.Material.Marble,
		{ Name = "Boutique" }
	)
	local sign = B:Box(kiosk * CFrame.new(0, 7, 0.5), Vector3.new(9, 1.5, 0.4), P.Neon, Enum.Material.Neon)
	B:Prompt(
		sign,
		"Browse",
		"Exchange Boutique",
		{ Name = "ShopPrompt", Distance = 12, Attrs = { Board = "Shop", District = "Gilded" } }
	)
end

function Gilded.Building(B, ctx, top: CFrame, size: Vector3)
	local w, d = size.X, size.Z
	local t = top
	tower(B, t, w, d, 140)
	B:Box(t * CFrame.new(0, -1, 0), Vector3.new(w, 2, d), P.Night, Enum.Material.Marble, { Name = "Rooftop" })
	local spots = { Roof = (t * CFrame.new(0, 0.2, 0)).Position, High = {}, Nooks = {} }
	local roll = B:Rand(0, 1)
	if roll < 0.35 then
		-- Helipad.
		B:Cylinder(
			t * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)),
			0.2,
			math.min(w, d) - 4,
			rgb(60, 62, 76),
			Enum.Material.Concrete,
			{ Decor = true }
		)
		local h = B:Detail(t * CFrame.new(0, 0.25, 0), Vector3.new(4, 0.1, 1), P.Gold, Enum.Material.Neon)
		h.CanCollide = false
		local antenna = Props.Antenna(B, t * CFrame.new(w / 2 - 2, 0, d / 2 - 2), B:Rand(12, 22))
		table.insert(spots.High, antenna)
		table.insert(spots.Nooks, (t * CFrame.new(-w / 2 + 1.5, 0.2, d / 2 - 1.5)).Position)
	elseif roll < 0.7 then
		local panel = Props.Billboard(B, t * CFrame.new(0, 0, d / 4), B:Pick(ADS), B:Pick(NEONS), math.min(w - 4, 16))
		table.insert(spots.High, panel.Position + Vector3.new(0, panel.Size.Y / 2 + 0.2, 0))
		table.insert(spots.Nooks, (t * CFrame.new(0, 0.2, d / 4 + 2)).Position)
	else
		Props.Hologram(B, t * CFrame.new(0, 0, 0), B:Rand(3, 6), B:Pick(NEONS))
		Props.ACUnit(B, t * CFrame.new(w / 3, 0, -d / 3))
		table.insert(spots.Nooks, (t * CFrame.new(w / 3 + 2.2, 0.2, -d / 3)).Position)
	end
	-- Window-washer rig hanging off one face: a ledge to catch.
	local rig = t * CFrame.new(0, -9, -d / 2 - 1.4)
	B:Box(rig, Vector3.new(10, 0.5, 2.6), P.Steel, Enum.Material.Metal, { Name = "WasherRig" })
	B:Detail(
		rig * CFrame.new(0, 1.2, -1.2),
		Vector3.new(10, 1.8, 0.2),
		P.Gold,
		Enum.Material.Metal,
		{ CanCollide = true }
	)
	table.insert(spots.Nooks, (rig * CFrame.new(3, 0.5, 0)).Position)
	return spots
end

function Gilded.Connector(B, ctx, a: Vector3, b: Vector3)
	-- Light-bridges (blinking) between towers, or cables to slide down.
	if math.abs(a.Y - b.Y) > 4 then
		local high, low = if a.Y > b.Y then a else b, if a.Y > b.Y then b else a
		local start = high + Vector3.new(0, 7.5, 0)
		local finish = low + Vector3.new(0, 5.5, 0)
		B:Box(CFrame.new(high + Vector3.new(0, 4, 0)), Vector3.new(0.6, 8, 0.6), P.Steel, Enum.Material.Metal)
		B:Box(CFrame.new(low + Vector3.new(0, 3, 0)), Vector3.new(0.6, 6, 0.6), P.Steel, Enum.Material.Metal)
		local cable = B:Rod(
			start,
			finish,
			0.22,
			rgb(40, 40, 50),
			Enum.Material.Metal,
			{ Name = "Cable", CanCollide = false, Tag = Tags.Zipline, Attrs = { A = start, B = finish } }
		)
		B:Icon(cable, "~", P.Signal, Vector3.new(0, 1.5, 0))
	else
		local bridge =
			B:Beam(a - Vector3.new(0, 0.5, 0), b - Vector3.new(0, 0.5, 0), 3, 1, P.Neon2, Enum.Material.ForceField, {
				Name = "LightBridge",
				Tag = Tags.Timed,
				Attrs = { Kind = "Blink", Period = 6, OnFraction = 0.75, Phase = B:Rand(0, 1), Warn = 1 },
			})
		B:Icon(bridge, "◇", P.Signal, Vector3.new(0, 2, 0))
	end
end

function Gilded.Landmarks(B, ctx)
	-- The Exchange Spire.
	local spirePos = DistrictBuilder.FindClear(ctx, 560, 30)
	local spire = CFrame.lookAt(spirePos, ctx.Origin.Position) * CFrame.new(0, 60, 0)
	tower(B, spire, 30, 30, 200)
	B:Box(spire * CFrame.new(0, -1, 0), Vector3.new(30, 2, 30), P.Night, Enum.Material.Marble, { Name = "SpireRoof" })
	for i = 1, 8 do
		local y = -i * 12
		local s = if i % 2 == 0 then 1 else -1
		B:Box(
			spire * CFrame.new(s * 9, y, -16.4),
			Vector3.new(10, 0.6, 2.8),
			P.Steel,
			Enum.Material.Metal,
			{ Name = "WasherRig" }
		)
	end
	Props.Ladder(B, spire * CFrame.new(0, -100, -15.1) * CFrame.Angles(0, math.rad(180), 0), 100, 3)
	local crown = spire * CFrame.new(0, 0, 0)
	for i = 0, 11 do
		local angle = i * math.pi / 6
		B:Detail(
			crown * CFrame.Angles(0, angle, 0) * CFrame.new(0, 14, -13),
			Vector3.new(7, 2.2, 0.2),
			NEONS[(i % #NEONS) + 1],
			Enum.Material.Neon
		)
	end
	local top = Props.Antenna(B, crown, 26)
	DistrictBuilder.QuestPoint(ctx, "gil_transmitter", (crown * CFrame.new(4, 1.5, 4)).Position)
	DistrictBuilder.QuestPoint(ctx, "gil_roof", (crown * CFrame.new(-4, 1.5, -4)).Position)
	DistrictBuilder.Landmark(ctx, "spire", "Exchange Spire", crown * CFrame.new(0, 4, 0), Vector3.new(30, 8, 30))
	B:FarBox(spire * CFrame.new(0, -100, 0), Vector3.new(30, 200, 30), P.GlassDark, Enum.Material.Glass)
	B:FarBox(CFrame.new(top), Vector3.new(1, 1, 1), rgb(255, 40, 40), Enum.Material.Neon)

	-- The Gold Vault: a squat golden strongroom tower.
	local vaultPos = DistrictBuilder.FindClear(ctx, 520, 30) + Vector3.new(0, 8, 0)
	local vault = CFrame.lookAt(vaultPos, ctx.Origin.Position + Vector3.new(0, 8, 0))
	B:Box(
		vault * CFrame.new(0, -60, 0),
		Vector3.new(36, 120, 36),
		P.Gold,
		Enum.Material.Metal,
		{ Name = "GoldVault", Reflectance = 0.2 }
	)
	B:Box(vault * CFrame.new(0, -1, 0), Vector3.new(36, 2, 36), P.Night, Enum.Material.Marble)
	local door = B:Cylinder(
		vault * CFrame.new(0, -10, -18.2) * CFrame.Angles(0, math.rad(90), 0),
		1,
		14,
		rgb(200, 170, 90),
		Enum.Material.Metal
	)
	door.Name = "VaultDoor"
	Props.Ladder(B, vault * CFrame.new(10, -40, -18.1) * CFrame.Angles(0, math.rad(180), 0), 40, 3)
	DistrictBuilder.Landmark(ctx, "vault", "The Gold Vault", vault * CFrame.new(0, 4, 0), Vector3.new(36, 8, 36))
	B:FarBox(vault * CFrame.new(0, -50, 0), Vector3.new(36, 100, 36), P.Gold)
end

function Gilded.QuestPoints(B, ctx)
	for i = 1, 4 do
		local spot = DistrictBuilder.TakeHigh(ctx)
		local terminal = B:Box(
			CFrame.new(spot + Vector3.new(0, 1.2, 0)),
			Vector3.new(1.4, 2.4, 0.8),
			rgb(30, 34, 50),
			Enum.Material.Metal,
			{ Name = "DataTerminal" }
		)
		B:Detail(terminal.CFrame * CFrame.new(0, 0.4, -0.41), Vector3.new(1.1, 1, 0.02), P.Neon2, Enum.Material.Neon)
		DistrictBuilder.QuestPoint(ctx, "gil_terminal_" .. i, spot + Vector3.new(0, 1, 0))
	end
	for i = 1, 4 do
		DistrictBuilder.QuestPoint(ctx, "gil_holo_" .. i, DistrictBuilder.TakeRoof(ctx) + Vector3.new(0, 1.5, 0))
	end
end

function Gilded.Skyline(B, ctx)
	for i = 0, 17 do
		local angle = i * math.pi / 9
		local p = ctx.Origin.Position + DistrictBuilder.Dir(angle) * (650 + B:Rand(-60, 60))
		local h = B:Rand(120, 300)
		B:FarBox(
			CFrame.new(p + Vector3.new(0, -120 + h / 2, 0)),
			Vector3.new(B:Rand(40, 70), h, B:Rand(40, 70)),
			P.GlassDark,
			Enum.Material.Glass
		)
		local band = B:Detail(
			CFrame.new(p + Vector3.new(0, -120 + h, 0)),
			Vector3.new(52, 1.5, 52),
			B:Pick(NEONS),
			Enum.Material.Neon
		)
		band.CanCollide = false
	end
	-- Traffic glow far below.
	for i = 1, 16 do
		local p = ctx.Origin.Position
			+ DistrictBuilder.Dir(B:Rand(0, math.pi * 2)) * B:Rand(160, 520)
			+ Vector3.new(0, -110, 0)
		local glow = B:Detail(
			CFrame.new(p),
			Vector3.new(30, 0.4, 3),
			B:Pick({ rgb(255, 80, 80), rgb(255, 230, 180) }),
			Enum.Material.Neon
		)
		glow.CanCollide = false
	end
	B:Volume(
		ctx.Origin * CFrame.new(0, -ctx.District.KillDepth, 0),
		Vector3.new(1600, 10, 1600),
		Tags.KillZone,
		{ District = "Gilded" }
	)
end

return Gilded
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">Hub</string>
              <string name="Source"><![CDATA[-- Guildhall Commons: the central hub. The Guild's signal tower rises from a
-- ring plaza with a lift gate to every district. Around it: the Training Yard
-- (one station per lesson), a free practice playground, the outfitter, the
-- race board, a crew lounge, the Spire and the Dreamline gate.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Courses = require(ReplicatedStorage.Shared.Config.Courses)
local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Lessons = require(ReplicatedStorage.Shared.Config.Lessons)
local Lore = require(ReplicatedStorage.Shared.Config.Lore)
local Tags = require(ReplicatedStorage.Shared.Tags)

local CourseBuilder = require(script.Parent.Parent.CourseBuilder)
local DistrictBuilder = require(script.Parent.Parent.DistrictBuilder)
local Kit = require(script.Parent.Parent.Kit)
local Props = require(script.Parent.Parent.Props)

local D = Districts.ById.Hub
local P = D.Palette

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local Hub = {}

local THEME: CourseBuilder.Theme = {
	Id = "Hub",
	Surface = P.Stone,
	SurfaceMaterial = Enum.Material.Limestone,
	Trim = P.Trim,
	Wall = rgb(190, 180, 165),
	WallMaterial = Enum.Material.Limestone,
	Accent = P.Accent,
	Signal = P.Signal,
	Beam = P.Wood,
	BeamMaterial = Enum.Material.WoodPlanks,
	Rope = rgb(210, 190, 140),
	Climb = "Ladder",
	BodyDepth = 30,
	Platform = function(B, top, width, length, role)
		local material = if role == "Checkpoint"
				or role == "Start"
				or role == "Finish"
			then Enum.Material.WoodPlanks
			else Enum.Material.Limestone
		B:Box(
			top * CFrame.new(0, -1, 0),
			Vector3.new(width, 2, length),
			if material == Enum.Material.WoodPlanks then P.Wood else B:Vary(P.Stone, 0.05),
			material,
			{ Name = "Platform" }
		)
		if role ~= "Floating" and role ~= "Recovery" then
			for _, side in { -1, 1 } do
				B:Detail(
					top * CFrame.new(side * (width / 2 - 0.2), 0.04, 0),
					Vector3.new(0.4, 0.08, length),
					P.Trim,
					Enum.Material.Wood
				)
			end
		end
	end,
	Body = function(B, top, width, length, depth)
		B:Box(
			top * CFrame.new(0, -depth / 2, 0),
			Vector3.new(width - 1, depth, length - 1),
			rgb(170, 160, 145),
			Enum.Material.Limestone,
			{ Name = "Pillar" }
		)
	end,
}

local function dir(angleDegrees: number): Vector3
	return DistrictBuilder.Dir(math.rad(angleDegrees))
end

-- Lesson stations: each is a small route built from the same segments as courses.
local STATIONS: { [string]: { any } } = {
	l_sprint = { { "Run", 12 }, { "Gap", 0.45 }, { "Gap", 0.5 }, { "Gap", 0.55 }, { "Run", 10 } },
	l_vault = { { "Run", 14 }, { "Vault", 2 }, { "Run", 8 } },
	l_slide = { { "Run", 16 }, { "Slide", 2 }, { "Run", 8 } },
	l_ledge = { { "Run", 8 }, { "Ledge", 8 }, { "Run", 4 }, { "Shimmy", 10 }, { "Run", 6 } },
	l_climb = { { "Run", 8 }, { "Climb", 12, Type = "Ladder" }, { "Run", 8 } },
	l_wallrun = { { "Run", 18 }, { "WallRun", 0.8, Side = "R" }, { "Run", 8 } },
	l_walljump = { { "Run", 8 }, { "Shaft", 14 }, { "Run", 8 } },
	l_balance = { { "Run", 8 }, { "Balance", 26 }, { "Run", 8 } },
	l_roll = { { "Run", 8 }, { "Climb", 14, Type = "Ladder" }, { "Drop", 14 }, { "Run", 10 } },
	l_zip = { { "Run", 8 }, { "Zip", 40, Drop = 8 }, { "Rope", 2 }, { "Run", 8 } },
	l_double = { { "Run", 14 }, { "DoubleGap", 0.6 }, { "Run", 8 }, { "WallRun", 0.8, Side = "R" }, { "Run", 10 } },
	l_dash = { { "Run", 14 }, { "DashGap", 0.6 }, { "Run", 8 }, { "DashGap", 0.7 }, { "Run", 10 } },
	l_grapple = { { "Run", 12 }, { "Grapple", 2 }, { "Run", 8 } },
	l_pull = { { "Run", 10 }, { "Pull", 16 }, { "Run", 4 }, { "WallRun", 0.8, Side = "L" }, { "Run", 8 } },
}

-- Stacked ledges for Ledge Leap (no segment does this, so it's built by hand).
local function stackedLedges(B: Kit.Builder, origin: CFrame)
	B:Box(origin * CFrame.new(0, -1, -8), Vector3.new(12, 2, 16), P.Stone, Enum.Material.Limestone)
	local wall = origin * CFrame.new(0, 0, -18)
	B:Box(
		wall * CFrame.new(0, 12, -2),
		Vector3.new(12, 24, 4),
		rgb(190, 180, 165),
		Enum.Material.Limestone,
		{ Name = "LeapWall" }
	)
	for i, height in { 7, 14, 21 } do
		local lip = B:Box(
			wall * CFrame.new(0, height - 0.3, 0.6),
			Vector3.new(10, 0.6, 1.2),
			P.Signal,
			Enum.Material.Neon,
			{ Name = "LeapLip" }
		)
		if i == 1 then
			B:Icon(lip, "^[]", P.Signal, Vector3.new(0, 2, 0))
		end
	end
	B:Box(wall * CFrame.new(0, 23, -10), Vector3.new(14, 2, 16), P.Stone, Enum.Material.Limestone, { Name = "LeapTop" })
	return wall * CFrame.new(0, 24, -18)
end

local function lessonStation(B: Kit.Builder, lesson: any, origin: CFrame, spawns: { [string]: CFrame })
	local folder = B:Group("Lesson_" .. lesson.Id)
	B:Within(folder, function()
		-- Start pad with an information sign.
		B:Box(
			origin * CFrame.new(0, -1, 6),
			Vector3.new(14, 2, 12),
			P.Wood,
			Enum.Material.WoodPlanks,
			{ Name = "LessonPad" }
		)
		local pad = B:Detail(
			origin * CFrame.new(0, 0.06, 6),
			Vector3.new(8, 0.12, 6),
			if lesson.Advanced then rgb(190, 110, 255) else P.Signal,
			Enum.Material.Neon
		)
		pad.Transparency = 0.4
		local sign =
			B:Box(origin * CFrame.new(-7, 4, 6), Vector3.new(0.4, 4, 8), rgb(30, 32, 42), Enum.Material.SmoothPlastic)
		B:Text(
			sign,
			Enum.NormalId.Left,
			(if lesson.Advanced then "ADVANCED\n" else "LESSON\n") .. string.upper(lesson.Name),
			{ Color = if lesson.Advanced then rgb(210, 160, 255) else P.Signal }
		)
		B:Text(
			sign,
			Enum.NormalId.Right,
			(if lesson.Advanced then "ADVANCED\n" else "LESSON\n") .. string.upper(lesson.Name),
			{ Color = if lesson.Advanced then rgb(210, 160, 255) else P.Signal }
		)
		local finish: CFrame
		if lesson.Layout == "Stacked" then
			finish = stackedLedges(B, origin)
		else
			local ctx = CourseBuilder.NewContext(B, THEME, lesson.Id, 1, origin, folder)
			ctx.NoRecovery = true
			finish = CourseBuilder.Segments(ctx, origin, STATIONS[lesson.Id] or { { "Run", 20 } })
		end
		-- The zone covers the whole station so lesson progress is tracked anywhere on it.
		local localEnd = origin:PointToObjectSpace(finish.Position)
		local length = math.abs(localEnd.Z) + 16
		local zone = B:Volume(
			origin * CFrame.new(localEnd.X / 2, 10, (localEnd.Z + 12) / 2),
			Vector3.new(math.abs(localEnd.X) + 48, 60, length + 8),
			Tags.LessonZone,
			{ LessonId = lesson.Id, Spawn = origin * CFrame.new(0, 3.5, 6), KillY = origin.Y - 16 }
		)
		zone.Name = "LessonZone"
		spawns["Lesson_" .. lesson.Id] = origin * CFrame.new(0, 3.5, 6)
	end)
end

local function travelGateFor(B: Kit.Builder, district: any, cframe: CFrame)
	local accent = district.Palette.Signal or P.Signal
	for _, x in { -5, 5 } do
		B:Box(cframe * CFrame.new(x, 7, 0), Vector3.new(1.8, 14, 1.8), rgb(60, 62, 70), Enum.Material.Metal)
	end
	B:Box(cframe * CFrame.new(0, 14.6, 0), Vector3.new(12.4, 1.4, 2), rgb(60, 62, 70), Enum.Material.Metal)
	local field = B:Box(cframe * CFrame.new(0, 7, 0), Vector3.new(8.4, 13, 0.4), accent, Enum.Material.ForceField, {
		Name = "TravelGate",
		CanCollide = false,
		Tag = Tags.TravelGate,
		Attrs = { District = district.Id },
	})
	B:Light(field, accent, 20, 1)
	local sign = B:Detail(
		cframe * CFrame.new(0, 16.6, 0),
		Vector3.new(12, 2.4, 0.3),
		rgb(25, 28, 36),
		Enum.Material.SmoothPlastic
	)
	local label = string.upper(district.Name) .. "\nLevel " .. district.Level .. "+"
	B:Text(sign, Enum.NormalId.Front, label, { Color = accent })
	B:Text(sign, Enum.NormalId.Back, label, { Color = accent })
	B:Prompt(
		field,
		"Travel",
		district.Name,
		{ Name = "TravelPrompt", Attrs = { Board = "Travel", Destination = district.Id } }
	)
	B:Icon(field, "⇆", accent, Vector3.new(0, 8, 0))
end

local function board(B: Kit.Builder, kind: string, title: string, cframe: CFrame, color: Color3)
	for _, x in { -2.8, 2.8 } do
		B:Box(cframe * CFrame.new(x, 2.5, 0), Vector3.new(0.4, 5, 0.4), rgb(60, 50, 40), Enum.Material.Wood)
	end
	local panel =
		B:Box(cframe * CFrame.new(0, 4.2, 0), Vector3.new(6, 3.4, 0.3), rgb(35, 38, 48), Enum.Material.SmoothPlastic, {
			Name = kind .. "Board",
			Tag = Tags.Board,
			Attrs = { Kind = kind, District = "Hub" },
		})
	B:Text(panel, Enum.NormalId.Front, title, { Color = color, Padding = 6 })
	B:Text(panel, Enum.NormalId.Back, title, { Color = color, Padding = 6 })
	B:Light(panel, color, 10, 0.6, "Surface", Enum.NormalId.Front)
	B:Prompt(panel, "Open", title, { Name = "BoardPrompt", Attrs = { Board = kind, District = "Hub" } })
end

local function npcSpot(B: Kit.Builder, id: string, cframe: CFrame)
	local part = B:Point(Tags.NPCSpot, id, cframe.Position)
	part.CFrame = cframe
end

function Hub.Build(world: Instance): (any, { [string]: any }, { [string]: CFrame })
	local B = Kit.new(world, "Hub", P)
	local O = D.Origin
	local origin = CFrame.new(O)
	local spawns: { [string]: CFrame } = {}
	local metas: { [string]: any } = {}
	local R = 64

	-- Ring plaza around the Guild tower ---------------------------------------------------
	B:Cylinder(
		origin * CFrame.new(0, -1, 0) * CFrame.Angles(0, 0, math.rad(90)),
		2,
		R * 2,
		P.Stone,
		Enum.Material.Limestone,
		{ Name = "GuildPlaza" }
	)
	B:Cylinder(
		origin * CFrame.new(0, -0.95, 0) * CFrame.Angles(0, 0, math.rad(90)),
		2,
		R * 2 - 16,
		rgb(200, 190, 175),
		Enum.Material.Limestone,
		{ Decor = true }
	)
	B:Cylinder(
		origin * CFrame.new(0, -40, 0) * CFrame.Angles(0, 0, math.rad(90)),
		76,
		R * 2 - 6,
		rgb(170, 160, 145),
		Enum.Material.Limestone,
		{ Name = "PlazaFoundation" }
	)
	for i = 0, 23 do
		local angle = i * math.pi / 12
		local p = origin * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.6, -R + 0.8)
		B:Detail(p, Vector3.new(16, 1.2, 1.2), P.Trim, Enum.Material.Wood)
	end

	-- The Guild signal tower: the last tower that never lost its signal.
	local towerHeight = 120
	B:Cylinder(
		origin * CFrame.new(0, towerHeight / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		towerHeight,
		26,
		rgb(200, 190, 175),
		Enum.Material.Limestone,
		{ Name = "GuildTower" }
	)
	for y = 12, towerHeight - 6, 18 do
		B:Detail(
			origin * CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Vector3.new(1.4, 27.4, 27.4),
			P.Trim,
			Enum.Material.Wood,
			{ Shape = Enum.PartType.Cylinder }
		)
		for k = 0, 5 do
			B:Detail(
				origin * CFrame.Angles(0, k * math.pi / 3, 0) * CFrame.new(0, y + 7, -13.05),
				Vector3.new(2.4, 4, 0.2),
				rgb(255, 214, 150),
				Enum.Material.Neon
			)
		end
	end
	-- Climbable route up the tower: a ladder spiral of platforms.
	for i = 0, 9 do
		local angle = i * 0.9
		local y = 10 + i * 11
		local ledge = origin * CFrame.Angles(0, angle, 0) * CFrame.new(0, y, -15)
		B:Box(
			ledge * CFrame.new(0, -0.5, 0),
			Vector3.new(8, 1, 6),
			P.Wood,
			Enum.Material.WoodPlanks,
			{ Name = "TowerLedge" }
		)
		Props.Ladder(B, origin * CFrame.Angles(0, angle, 0) * CFrame.new(0, y - 11, -13.3), 11, 2.4)
	end
	local crown = origin * CFrame.new(0, towerHeight, 0)
	B:Cylinder(
		crown * CFrame.new(0, 0.5, 0) * CFrame.Angles(0, 0, math.rad(90)),
		1,
		34,
		P.Trim,
		Enum.Material.Wood,
		{ Name = "TowerCrown" }
	)
	local beacon = B:Ball(
		crown.Position + Vector3.new(0, 10, 0),
		6,
		P.Signal,
		Enum.Material.Neon,
		{ Name = "GuildBeacon", CanCollide = false }
	)
	B:Light(beacon, P.Signal, 60, 2)
	for i = 0, 3 do
		B:Box(
			crown * CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.new(0, 4, -12),
			Vector3.new(1, 8, 1),
			P.Trim,
			Enum.Material.Wood
		)
	end
	B:Volume(crown * CFrame.new(0, 4, 0), Vector3.new(34, 8, 34), Tags.Discovery, {
		Id = "landmark_hub_tower",
		Kind = "Landmark",
		District = "Hub",
		Title = "Guild Signal Tower",
		Text = "Landmark discovered",
	})
	B:FarBox(origin * CFrame.new(0, towerHeight / 2, 0), Vector3.new(26, towerHeight, 26), rgb(200, 190, 175))
	B:FarBox(crown * CFrame.new(0, 10, 0), Vector3.new(6, 6, 6), P.Signal, Enum.Material.Neon)
	npcSpot(B, "hub_orla", CFrame.lookAt(O + Vector3.new(0, 3, 17), O + Vector3.new(0, 3, 40)))
	B:Detail(origin * CFrame.new(0, 5, 13.2), Vector3.new(6, 10, 0.4), rgb(80, 50, 30), Enum.Material.Wood)

	-- Lift gates to every district, each facing its destination.
	for _, district in Districts.Ordered() do
		local offset = district.Origin - O
		local direction = Vector3.new(offset.X, 0, offset.Z).Unit
		local position = O + direction * (R - 8)
		travelGateFor(B, district, CFrame.lookAt(position, position + direction))
	end
	spawns.Hub = CFrame.lookAt(O + Vector3.new(30, 3, 30), O + Vector3.new(0, 3, 0))

	-- Benches and lamps around the ring.
	for i = 0, 11 do
		local angle = i * math.pi / 6 + math.pi / 12
		local p = origin * CFrame.Angles(0, angle, 0)
		Props.Lamp(B, p * CFrame.new(0, 0, -(R - 4)), rgb(255, 214, 150), 10)
		if i % 2 == 0 then
			Props.Bench(B, p * CFrame.new(0, 0, -(R - 14)) * CFrame.Angles(0, math.rad(180), 0), P.Wood)
		end
	end

	-- Services on the plaza: outfitter, archive, race board, courses board.
	local function at(angle: number, radius: number, y: number?): Vector3
		return O + dir(angle) * radius + Vector3.new(0, y or 0, 0)
	end
	local bixPos = at(20, 40)
	local booth = CFrame.lookAt(bixPos, O)
	B:Box(
		booth * CFrame.new(0, 1.6, 0),
		Vector3.new(10, 3.2, 3),
		P.Wood,
		Enum.Material.WoodPlanks,
		{ Name = "OutfitterCounter" }
	)
	B:Box(booth * CFrame.new(0, 8, 1), Vector3.new(12, 0.4, 6), P.Fabric, Enum.Material.Fabric)
	for _, x in { -5.5, 5.5 } do
		B:Box(booth * CFrame.new(x, 4, 2.5), Vector3.new(0.4, 8, 0.4), P.Trim, Enum.Material.Wood)
	end
	local shopSign = B:Detail(
		booth * CFrame.new(0, 9, -1.6),
		Vector3.new(10, 1.6, 0.2),
		rgb(30, 32, 42),
		Enum.Material.SmoothPlastic
	)
	B:Text(shopSign, Enum.NormalId.Front, "BIX'S OUTFITTERS", { Color = P.Accent })
	B:Prompt(
		shopSign,
		"Browse",
		"Outfitters",
		{ Name = "ShopPrompt", Distance = 14, Attrs = { Board = "Shop", District = "Hub" } }
	)
	npcSpot(B, "hub_bix", booth * CFrame.new(0, 3, 3) * CFrame.Angles(0, math.rad(180), 0))

	local nellPos = at(85, 40)
	local archive = CFrame.lookAt(nellPos, O)
	B:Box(
		archive * CFrame.new(0, 5, 3),
		Vector3.new(12, 10, 6),
		rgb(110, 90, 130),
		Enum.Material.Brick,
		{ Name = "Archive" }
	)
	for i = -2, 2 do
		B:Detail(
			archive * CFrame.new(i * 2.2, 4, -0.05),
			Vector3.new(1.8, 7, 0.2),
			rgb(120, 80, 50),
			Enum.Material.WoodPlanks
		)
	end
	board(B, "Achievements", "ACHIEVEMENT JOURNAL", archive * CFrame.new(-8, 0, -2), rgb(210, 180, 255))
	npcSpot(B, "hub_nell", archive * CFrame.new(0, 3, -3) * CFrame.Angles(0, math.rad(180), 0))

	local dexPos = at(140, 40)
	board(B, "Race", "RACE BOARD", CFrame.lookAt(dexPos, O), rgb(255, 120, 220))
	board(B, "Leaderboard", "RECORDS", CFrame.lookAt(at(150, 44), O), rgb(120, 230, 255))
	npcSpot(B, "hub_dex", CFrame.lookAt(at(132, 36, 3), O + Vector3.new(0, 3, 0)))

	board(B, "Courses", "COURSES", CFrame.lookAt(at(200, 40), O), rgb(120, 230, 255))

	-- Crew lounge: an amphitheatre of steps for gathering before runs.
	local loungeCenter = at(320, 104)
	local lounge = CFrame.lookAt(loungeCenter, O)
	B:Box(
		lounge * CFrame.new(0, -1, 0),
		Vector3.new(44, 2, 40),
		P.Stone,
		Enum.Material.Limestone,
		{ Name = "LoungeFloor" }
	)
	B:Beam(
		at(320, R - 2) - Vector3.new(0, 0.6, 0),
		loungeCenter + dir(320) * -20 - Vector3.new(0, 0.6, 0),
		10,
		1.2,
		P.Stone,
		Enum.Material.Limestone,
		{ Name = "LoungeBridge" }
	)
	for step = 0, 3 do
		B:Box(
			lounge * CFrame.new(0, 0.8 + step * 1.6, 8 + step * 3),
			Vector3.new(40 - step * 4, 1.6, 3),
			rgb(190, 180, 165),
			Enum.Material.Limestone,
			{ Name = "LoungeStep" }
		)
	end
	Props.StringLights(
		B,
		(lounge * CFrame.new(-20, 10, -18)).Position,
		(lounge * CFrame.new(20, 10, -18)).Position,
		rgb(255, 210, 140)
	)
	Props.StringLights(
		B,
		(lounge * CFrame.new(-20, 10, -18)).Position,
		(lounge * CFrame.new(-20, 10, 18)).Position,
		rgb(255, 210, 140)
	)
	board(B, "Crew", "CREW BOARD", lounge * CFrame.new(-12, 0, -14), rgb(110, 230, 170))
	npcSpot(B, "hub_juno", lounge * CFrame.new(0, 3, -10) * CFrame.Angles(0, math.rad(180), 0))
	local fire =
		B:Detail(lounge * CFrame.new(0, 0.6, -4), Vector3.new(3, 1.2, 3), rgb(80, 60, 50), Enum.Material.Cobblestone)
	local flame = Instance.new("Attachment")
	flame.Parent = fire
	B:Emitter(flame, "Fire", rgb(255, 170, 80))
	B:Light(fire, rgb(255, 160, 80), 24, 1.2)

	-- Training Yard ----------------------------------------------------------------------------
	local yardDir = dir(30)
	local yardNear = 150
	local yardDepth = 350
	local yardCenter = O + yardDir * (yardNear + yardDepth / 2)
	local yardCF = CFrame.lookAt(yardCenter, yardCenter + yardDir)
	B:Beam(
		O + yardDir * (R - 2) - Vector3.new(0, 1, 0),
		O + yardDir * (yardNear + 1) - Vector3.new(0, 1, 0),
		14,
		2,
		P.Stone,
		Enum.Material.Limestone,
		{ Name = "YardBridge" }
	)
	B:Box(
		yardCF * CFrame.new(0, -1, 0),
		Vector3.new(180, 2, yardDepth),
		rgb(120, 140, 110),
		Enum.Material.Grass,
		{ Name = "YardGround" }
	)
	B:Box(
		yardCF * CFrame.new(0, -26, 0),
		Vector3.new(176, 48, yardDepth - 4),
		rgb(170, 160, 145),
		Enum.Material.Limestone,
		{ Name = "YardFoundation" }
	)
	local yardSign = B:Detail(
		CFrame.lookAt(O + yardDir * (yardNear + 2) + Vector3.new(0, 12, 0), O + Vector3.new(0, 12, 0)),
		Vector3.new(30, 4, 0.5),
		rgb(30, 32, 42),
		Enum.Material.SmoothPlastic
	)
	B:Text(yardSign, Enum.NormalId.Front, "TRAINING YARD", { Color = P.Signal })
	spawns.Training =
		CFrame.lookAt(O + yardDir * (yardNear + 8) + Vector3.new(0, 3, 0), yardCenter + Vector3.new(0, 3, 0))
	npcSpot(
		B,
		"hub_tam",
		CFrame.lookAt(
			O + yardDir * (yardNear + 12) + yardCF.RightVector * 10 + Vector3.new(0, 3, 0),
			O + Vector3.new(0, 3, 0)
		)
	)

	-- Three rows of five stations; each runs outward across the yard.
	local basic, advanced = {}, {}
	for _, lesson in Lessons.List do
		table.insert(if lesson.Advanced then advanced else basic, lesson)
	end
	local rows = { {}, {}, advanced }
	for index, lesson in basic do
		table.insert(rows[if index <= 5 then 1 else 2], lesson)
	end
	for rowIndex, row in rows do
		local rowZ = yardDepth / 2 - 14 - (rowIndex - 1) * 116
		for index, lesson in row do
			local lateral = (index - (#row + 1) / 2) * 32
			lessonStation(B, lesson, yardCF * CFrame.new(lateral, 4, rowZ), spawns)
		end
	end
	local advancedSign = B:Detail(
		yardCF * CFrame.new(0, 14, yardDepth / 2 - 14 - 2 * 116 + 16),
		Vector3.new(36, 3, 0.4),
		rgb(30, 32, 42),
		Enum.Material.SmoothPlastic
	)
	B:Text(
		advancedSign,
		Enum.NormalId.Back,
		"ADVANCED STATIONS: they open as you unlock new tools",
		{ Color = rgb(210, 160, 255) }
	)

	-- Practice playground: free-form obstacles to experiment on ------------------------------------
	local playDir = dir(120)
	local playCenter = O + playDir * 220
	local playCF = CFrame.lookAt(playCenter, playCenter + playDir)
	B:Beam(
		O + playDir * (R - 2) - Vector3.new(0, 1, 0),
		playCenter - playDir * 69 - Vector3.new(0, 1, 0),
		12,
		2,
		P.Stone,
		Enum.Material.Limestone,
		{ Name = "PlaygroundBridge" }
	)
	B:Box(
		playCF * CFrame.new(0, -1, 0),
		Vector3.new(170, 2, 140),
		rgb(180, 170, 155),
		Enum.Material.Limestone,
		{ Name = "PlaygroundFloor" }
	)
	B:Box(playCF * CFrame.new(0, -25, 0), Vector3.new(166, 46, 136), rgb(170, 160, 145), Enum.Material.Limestone)
	local playSign = B:Detail(
		CFrame.lookAt(playCenter - playDir * 68 + Vector3.new(0, 10, 0), O + Vector3.new(0, 10, 0)),
		Vector3.new(26, 3.4, 0.4),
		rgb(30, 32, 42),
		Enum.Material.SmoothPlastic
	)
	B:Text(playSign, Enum.NormalId.Front, "PRACTICE PLAYGROUND", { Color = P.Accent })
	local playFolder = B:Group("Playground")
	B:Within(playFolder, function()
		local ctx = CourseBuilder.NewContext(B, THEME, "playground", 1, playCF, playFolder)
		ctx.NoRecovery = true
		local lanes = {
			{ { "Run", 6 }, { "WallRun", 1, Side = "L" }, { "TicTac", 3 } },
			{ { "Run", 6 }, { "Shaft", 18 }, { "Balance", 20 } },
			{ { "Run", 6 }, { "Vault", 3 }, { "Slide", 2 } },
			{ { "Run", 6 }, { "Climb", 14, Type = "Mesh" }, { "Zip", 40, Drop = 14 } },
			{ { "Run", 6 }, { "Rope", 3 } },
			{ { "Run", 6 }, { "Grapple", 2 } },
			{ { "Run", 6 }, { "Bounce", 16 }, { "Pull", 16 } },
		}
		for index, lane in lanes do
			local lateral = (index - (#lanes + 1) / 2) * 22
			CourseBuilder.Segments(ctx, playCF * CFrame.new(lateral, 0, 60), lane)
		end
	end)

	-- Dreamline gate --------------------------------------------------------------------------------
	local gatePos = at(250, 112)
	local gate = CFrame.lookAt(gatePos, O)
	B:Beam(
		at(250, R - 2) - Vector3.new(0, 1, 0),
		gatePos - Vector3.new(0, 1, 0),
		10,
		2,
		P.Stone,
		Enum.Material.Limestone,
		{ Name = "DreamBridge" }
	)
	B:Box(
		gate * CFrame.new(0, -1, 0),
		Vector3.new(30, 2, 24),
		rgb(60, 50, 90),
		Enum.Material.Marble,
		{ Name = "DreamPad" }
	)
	Props.Arch(B, gate * CFrame.new(0, 0, 6), 12, 14, rgb(170, 150, 220), Enum.Material.Marble)
	local portal = B:Box(
		gate * CFrame.new(0, 7, 6),
		Vector3.new(11, 13, 0.6),
		rgb(255, 160, 240),
		Enum.Material.ForceField,
		{ Name = "DreamPortal", CanCollide = false }
	)
	B:Light(portal, rgb(255, 160, 240), 30, 1.5)
	B:Prompt(portal, "Enter", "The Dreamline", { Name = "DreamPrompt", Distance = 14, Attrs = { Board = "Endless" } })
	local dreamSign =
		B:Detail(gate * CFrame.new(0, 16.5, 6), Vector3.new(14, 2, 0.3), rgb(30, 24, 50), Enum.Material.SmoothPlastic)
	B:Text(dreamSign, Enum.NormalId.Front, "THE DREAMLINE", { Color = rgb(255, 180, 245) })
	B:Text(dreamSign, Enum.NormalId.Back, "THE DREAMLINE", { Color = rgb(255, 180, 245) })
	npcSpot(B, "hub_iris", gate * CFrame.new(-8, 3, -2))

	-- Spire approach (the tower itself is built by World/Spire) ----------------------------------------
	local spireBase = O + Districts.SpireOffset
	B:Beam(
		O + (spireBase - O).Unit * (R - 2) - Vector3.new(0, 1, 0),
		spireBase + (O - spireBase).Unit * 62 - Vector3.new(0, 1, 0),
		14,
		2,
		P.Stone,
		Enum.Material.Limestone,
		{ Name = "SpireBridge" }
	)
	npcSpot(
		B,
		"hub_aldous",
		CFrame.lookAt(spireBase + (O - spireBase).Unit * 66 + Vector3.new(8, 3, 0), O + Vector3.new(0, 3, 0))
	)
	B:Volume(
		CFrame.new(spireBase + (O - spireBase).Unit * 70 + Vector3.new(0, 6, 0)),
		Vector3.new(30, 12, 30),
		Tags.Discovery,
		{
			Id = "landmark_hub_spire",
			Kind = "Landmark",
			District = "Hub",
			Title = "The Spire",
			Text = "Landmark discovered",
		}
	)

	-- Hub courses on their own spokes ----------------------------------------------------------------------
	local hubCourses = Courses.ByDistrict.Hub or {}
	local courseAngles = { hub_graduation = 165, relay_guild = 205 }
	for _, course in hubCourses do
		local angle = courseAngles[course.Id] or 180
		local d = dir(angle)
		local start = O + d * 100
		local startCF = CFrame.lookAt(start, start + d)
		B:Beam(
			O + d * (R - 2) - Vector3.new(0, 1, 0),
			start - Vector3.new(0, 1, 0),
			8,
			2,
			THEME.Trim,
			Enum.Material.WoodPlanks,
			{ Name = "Approach" }
		)
		local sign = B:Box(
			startCF * CFrame.new(5.5, 4.6, -1),
			Vector3.new(6, 3.2, 0.3),
			rgb(28, 30, 40),
			Enum.Material.SmoothPlastic,
			{ Name = "CourseSign" }
		)
		B:Text(sign, Enum.NormalId.Back, string.upper(course.Name), { Color = P.Signal })
		B:Prompt(
			sign,
			"View Course",
			course.Name,
			{ Name = "CoursePrompt", Distance = 14, Attrs = { CourseId = course.Id } }
		)
		local meta = CourseBuilder.Build(B, course, THEME, startCF)
		meta.District = "Hub"
		metas[course.Id] = meta
	end

	-- Lost letters around the hub.
	local letterSpots = {
		crown.Position + Vector3.new(6, 1, 6),
		at(320, 104, 7.2),
		at(120, 250, 0.4),
	}
	for index, entry in Lore.Letters.Hub do
		local position = letterSpots[index]
		if position then
			local paper = B:Box(
				CFrame.new(position + Vector3.new(0, 0.6, 0)),
				Vector3.new(1.2, 0.08, 0.9),
				rgb(245, 235, 210),
				Enum.Material.SmoothPlastic,
				{
					Name = "LostLetter",
					CanCollide = false,
					Tag = Tags.Discovery,
					Attrs = {
						Id = "letter_hub_" .. index,
						Kind = "Letter",
						District = "Hub",
						Title = entry.Title,
						Text = entry.Text,
					},
				}
			)
			B:Icon(paper, "✉", rgb(255, 240, 210), Vector3.new(0, 2, 0))
		end
	end

	-- Clouds of distant city below and the kill floor.
	for i = 0, 15 do
		local angle = i * math.pi / 8
		local p = O + DistrictBuilder.Dir(angle) * B:Rand(380, 700) + Vector3.new(0, -150, 0)
		B:Detail(
			CFrame.new(p),
			Vector3.new(B:Rand(60, 120), B:Rand(80, 200), B:Rand(60, 120)),
			rgb(150, 150, 165),
			Enum.Material.Concrete,
			{ CanCollide = false }
		)
	end
	B:Volume(origin * CFrame.new(0, -D.KillDepth, 0), Vector3.new(1600, 10, 1600), Tags.KillZone, { District = "Hub" })

	local ctx = { B = B, Spawn = spawns.Hub }
	return ctx, metas, spawns
end

return Hub
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">Ironworks</string>
              <string name="Source"><![CDATA[-- Ironworks Quarter: the foundries that built the skyways. Steel gantries on
-- lattice legs, conveyors, steam vents, cranes swinging cargo, smokestacks and
-- the Titan Crane towering over everything.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Tags = require(ReplicatedStorage.Shared.Tags)

local DistrictBuilder = require(script.Parent.Parent.DistrictBuilder)
local Props = require(script.Parent.Parent.Props)

local P = Districts.ById.Ironworks.Palette

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local CONTAINERS = { rgb(170, 70, 50), rgb(60, 110, 150), rgb(200, 150, 40), rgb(70, 120, 80), rgb(120, 120, 130) }

local Ironworks = {}

local function legs(B, top: CFrame, width: number, length: number, depth: number)
	-- Lattice legs at the corners with a cross brace: gantries, not buildings.
	local hx, hz = width / 2 - 1, length / 2 - 1
	for _, corner in
		{ Vector3.new(-hx, 0, -hz), Vector3.new(hx, 0, -hz), Vector3.new(-hx, 0, hz), Vector3.new(hx, 0, hz) }
	do
		B:Box(
			top * CFrame.new(corner) * CFrame.new(0, -depth / 2, 0),
			Vector3.new(1.4, depth, 1.4),
			P.SteelDark,
			Enum.Material.Metal,
			{ Name = "Leg" }
		)
	end
	if length >= 12 then
		for _, side in { -1, 1 } do
			B:Detail(
				top * CFrame.new(side * hx, -depth * 0.3, 0) * CFrame.Angles(math.atan2(depth * 0.4, length - 2), 0, 0),
				Vector3.new(0.5, 0.5, math.sqrt((length - 2) ^ 2 + (depth * 0.4) ^ 2)),
				P.SteelDark,
				Enum.Material.Metal
			)
		end
	end
end

Ironworks.CourseTheme = {
	Id = "Ironworks",
	Surface = P.SteelDark,
	SurfaceMaterial = Enum.Material.DiamondPlate,
	Trim = P.Hazard,
	Wall = P.Rust,
	WallMaterial = Enum.Material.CorrodedMetal,
	Accent = P.Accent,
	Signal = P.Signal,
	Beam = P.Steel,
	BeamMaterial = Enum.Material.Metal,
	Rope = rgb(60, 60, 60),
	Climb = "Mesh",
	BodyDepth = 34,
	Platform = function(B, top, width, length, role)
		B:Box(
			top * CFrame.new(0, -0.75, 0),
			Vector3.new(width, 1.5, length),
			if role == "Checkpoint" then P.Concrete else B:Vary(P.SteelDark, 0.05),
			if role == "Checkpoint" then Enum.Material.Concrete else Enum.Material.DiamondPlate,
			{ Name = "Gantry" }
		)
		if role ~= "Floating" and role ~= "Recovery" and length >= 10 then
			-- Yellow-black edge stripes.
			B:Detail(
				top * CFrame.new(width / 2 - 0.3, 0.03, 0),
				Vector3.new(0.6, 0.06, length),
				P.Hazard,
				Enum.Material.SmoothPlastic
			)
		end
	end,
	Body = legs,
	WallStyle = function(B, cframe, size)
		local wall = B:Box(cframe, size, B:Pick(CONTAINERS), Enum.Material.CorrodedMetal, { Name = "ContainerWall" })
		return wall
	end,
}

Ironworks.RoomTheme = {
	Id = "IronworksRoom",
	Surface = P.SteelDark,
	SurfaceMaterial = Enum.Material.DiamondPlate,
	Trim = P.Hazard,
	Wall = P.Steel,
	WallMaterial = Enum.Material.Metal,
	Accent = P.Accent,
	Signal = P.Signal,
	Beam = P.Steel,
	BeamMaterial = Enum.Material.Metal,
	Rope = rgb(60, 60, 60),
	Climb = "Mesh",
	BodyDepth = 0,
}

function Ironworks.Plaza(B, ctx)
	local origin = ctx.Origin
	local R = DistrictBuilder.PlazaRadius
	B:Box(
		origin * CFrame.new(0, -1, 0),
		Vector3.new(R * 2, 2, R * 2),
		P.Concrete,
		Enum.Material.Concrete,
		{ Name = "FoundryYard" }
	)
	B:Box(origin * CFrame.new(0, -30, 0), Vector3.new(R * 2 - 4, 56, R * 2 - 4), P.Steel, Enum.Material.CorrodedMetal)
	for i = 0, 3 do
		Props.HazardStripes(B, origin * CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.new(0, 0.03, -R + 1.2), R * 2 - 4)
	end
	-- The furnace: a glowing kiln that lights the whole yard.
	local side = ctx.HubDir:Cross(Vector3.yAxis)
	local furnaceCF = CFrame.lookAt(ctx.Origin.Position - ctx.HubDir * 30, ctx.Origin.Position)
	B:Box(furnaceCF * CFrame.new(0, 7, 0), Vector3.new(16, 14, 10), P.Rust, Enum.Material.Brick, { Name = "Furnace" })
	local mouth = B:Detail(furnaceCF * CFrame.new(0, 4, -5.05), Vector3.new(6, 5, 0.2), P.Glow, Enum.Material.Neon)
	B:Light(mouth, P.Glow, 40, 2.5, "Surface", Enum.NormalId.Front)
	local fireAttachment = Instance.new("Attachment")
	fireAttachment.Parent = mouth
	B:Emitter(fireAttachment, "Sparks", P.Glow)
	Props.Smokestack(B, furnaceCF * CFrame.new(5, 14, 2), 22, P.Rust, true)
	-- Workbench, containers, crates: places to sit and wait for your crew.
	Props.Container(
		B,
		CFrame.lookAt(ctx.Origin.Position + side * 32, ctx.Origin.Position + side * 32 + ctx.HubDir),
		CONTAINERS[2]
	)
	for i = 0, 2 do
		Props.Crate(B, CFrame.new(ctx.Origin.Position - side * 30 + ctx.HubDir * (i * 3 - 3)), 2.6, rgb(150, 110, 70))
		Props.Barrel(B, CFrame.new(ctx.Origin.Position - side * 36 + ctx.HubDir * (i * 3 - 3)), CONTAINERS[i + 1])
	end
	for i = 0, 3 do
		local corner = origin * CFrame.Angles(0, i * math.pi / 2 + math.pi / 4, 0) * CFrame.new(0, 0, -R + 4)
		Props.Lamp(B, corner, rgb(255, 180, 110), 11)
	end
	-- An overhead gantry crane spanning the yard.
	for _, s in { -1, 1 } do
		B:Box(origin * CFrame.new(s * (R - 3), 11, 0), Vector3.new(2, 22, 2), P.Hazard, Enum.Material.Metal)
	end
	B:Box(
		origin * CFrame.new(0, 22.5, 0),
		Vector3.new(R * 2 - 4, 2, 3),
		P.Hazard,
		Enum.Material.Metal,
		{ Name = "GantryBeam" }
	)
	DistrictBuilder.NPCSpot(
		ctx,
		"iron_sadie",
		CFrame.lookAt(
			ctx.Origin.Position - ctx.HubDir * 20 + side * 8 + Vector3.new(0, 3, 0),
			ctx.Origin.Position + Vector3.new(0, 3, 0)
		)
	)
	DistrictBuilder.NPCSpot(
		ctx,
		"iron_brak",
		CFrame.lookAt(
			ctx.Origin.Position + side * 24 + Vector3.new(0, 3, 0),
			ctx.Origin.Position + Vector3.new(0, 3, 0)
		)
	)
	DistrictBuilder.NPCSpot(
		ctx,
		"iron_rook",
		CFrame.lookAt(
			ctx.Origin.Position - side * 26 + Vector3.new(0, 3, 0),
			ctx.Origin.Position + Vector3.new(0, 3, 0)
		)
	)
	-- Tool crib (district shop).
	local crib = CFrame.lookAt(ctx.Origin.Position - ctx.HubDir * 30 - side * 18, ctx.Origin.Position)
	B:Box(crib * CFrame.new(0, 1.5, 0), Vector3.new(8, 3, 3), P.Steel, Enum.Material.Metal, { Name = "ToolCrib" })
	local cage = B:Box(crib * CFrame.new(0, 6, 1.5), Vector3.new(9, 0.4, 5), P.Hazard, Enum.Material.Metal)
	B:Prompt(
		cage,
		"Browse",
		"Tool Crib",
		{ Name = "ShopPrompt", Distance = 12, Attrs = { Board = "Shop", District = "Ironworks" } }
	)
end

function Ironworks.Building(B, ctx, top: CFrame, size: Vector3)
	local w, d = size.X, size.Z
	local depth = 70
	B:Box(
		top * CFrame.new(0, -depth / 2 - 1, 0),
		Vector3.new(w, depth, d),
		B:Pick({ P.Steel, P.Rust, P.Concrete }),
		Enum.Material.CorrodedMetal,
		{ Name = "Factory" }
	)
	B:Box(
		top * CFrame.new(0, -1, 0),
		Vector3.new(w + 0.4, 2, d + 0.4),
		P.SteelDark,
		Enum.Material.DiamondPlate,
		{ Name = "FactoryRoof" }
	)
	-- Sawtooth skylights.
	for i = -1, 1 do
		B:Wedge(
			top * CFrame.new(0, 1.2, i * d / 3) * CFrame.Angles(0, math.rad(90), 0),
			Vector3.new(w * 0.7, 2.4, 3),
			rgb(150, 190, 210),
			Enum.Material.Glass,
			{ Decor = true }
		)
	end
	local spots = { Roof = (top * CFrame.new(-w / 4, 0.2, -d / 4)).Position, High = {}, Nooks = {} }
	local roll = B:Rand(0, 1)
	if roll < 0.45 then
		local high, nook =
			Props.Smokestack(B, top * CFrame.new(w / 4, 0, d / 4), B:Rand(16, 30), P.Rust, B:Rand(0, 1) < 0.5)
		table.insert(spots.High, high)
		table.insert(spots.Nooks, nook)
	elseif roll < 0.75 then
		local high = Props.Container(B, top * CFrame.new(0, 0, d / 6), B:Pick(CONTAINERS))
		table.insert(spots.High, high)
		table.insert(spots.Nooks, (top * CFrame.new(w / 2 - 1.5, 0.2, -d / 2 + 1.5)).Position)
	else
		-- Pipe run with a steam vent.
		local a = (top * CFrame.new(-w / 2 + 2, 2, 0)).Position
		local b = (top * CFrame.new(w / 2 - 2, 2, 0)).Position
		Props.Pipe(B, a, b, P.Pipe, 1.8)
		local vent = B:Detail(top * CFrame.new(0, 3, 0), Vector3.new(1.2, 1.2, 1.2), P.SteelDark, Enum.Material.Metal)
		local attachment = Instance.new("Attachment")
		attachment.Parent = vent
		B:Emitter(attachment, "Smoke", rgb(220, 220, 220)).Rate = 1
		table.insert(spots.Nooks, (top * CFrame.new(1.5, 0.2, 1.5)).Position)
	end
	Props.Crate(B, top * CFrame.new(-w / 2 + 2, 0, d / 2 - 2), 2.4, rgb(150, 110, 70))
	-- Catwalk along one side to hang from.
	local walk = top * CFrame.new(w / 2 + 1.2, -6, 0)
	B:Box(walk, Vector3.new(2.4, 0.4, d - 2), P.SteelDark, Enum.Material.DiamondPlate, { Name = "Catwalk" })
	B:Detail(
		walk * CFrame.new(1.1, 1, 0),
		Vector3.new(0.2, 1.8, d - 2),
		P.Hazard,
		Enum.Material.Metal,
		{ CanCollide = true }
	)
	table.insert(spots.Nooks, (walk * CFrame.new(0, 0.5, d / 3)).Position)
	return spots
end

function Ironworks.Connector(B, ctx, a: Vector3, b: Vector3)
	-- I-beams between gantries (balance), or a cable run downhill.
	if a.Y - b.Y > 5 then
		local start = a + Vector3.new(0, 7.5, 0)
		local finish = b + Vector3.new(0, 5.5, 0)
		B:Box(CFrame.new(a + Vector3.new(0, 4, 0)), Vector3.new(0.6, 8, 0.6), P.Hazard, Enum.Material.Metal)
		B:Box(CFrame.new(b + Vector3.new(0, 3, 0)), Vector3.new(0.6, 6, 0.6), P.Hazard, Enum.Material.Metal)
		local cable = B:Rod(
			start,
			finish,
			0.22,
			rgb(40, 40, 40),
			Enum.Material.Metal,
			{ Name = "CableRun", CanCollide = false, Tag = Tags.Zipline, Attrs = { A = start, B = finish } }
		)
		B:Icon(cable, "~", P.Signal, Vector3.new(0, 1.5, 0))
	else
		local beam = B:Beam(
			a - Vector3.new(0, 0.5, 0),
			b - Vector3.new(0, 0.5, 0),
			1.3,
			1,
			P.Steel,
			Enum.Material.Metal,
			{ Name = "IBeam", Tag = Tags.Balance }
		)
		B:Icon(beam, "=", rgb(255, 255, 255), Vector3.new(0, 2, 0))
	end
end

function Ironworks.Landmarks(B, ctx)
	-- The Titan Crane.
	local basePos = DistrictBuilder.FindClear(ctx, 560, 30)
	local base = CFrame.lookAt(basePos, ctx.Origin.Position)
	B:Box(
		base * CFrame.new(0, -1, 0),
		Vector3.new(26, 2, 26),
		P.Concrete,
		Enum.Material.Concrete,
		{ Name = "TitanBase" }
	)
	B:Box(base * CFrame.new(0, -40, 0), Vector3.new(24, 76, 24), P.Concrete, Enum.Material.Concrete)
	local cabTop, jibEnd = Props.Crane(B, base, 70, 60, P.Hazard)
	DistrictBuilder.QuestPoint(ctx, "iron_master", cabTop + Vector3.new(0, 0.5, 0))
	DistrictBuilder.QuestPoint(ctx, "iron_relay_1", jibEnd + Vector3.new(0, 0.5, 0))
	DistrictBuilder.Landmark(
		ctx,
		"titan",
		"The Titan Crane",
		CFrame.new(cabTop + Vector3.new(0, 2, 0)),
		Vector3.new(14, 6, 14)
	)
	B:FarBox(base * CFrame.new(0, 35, 0), Vector3.new(5, 70, 5), P.Hazard)
	B:FarBox(base * CFrame.new(0, 74.6, -26), Vector3.new(2.4, 1.2, 60), P.Hazard)
	-- Swinging cargo on the Titan's hook, for spectacle.
	B:Box(
		CFrame.new(jibEnd + Vector3.new(0, -16, 0)),
		Vector3.new(8, 8, 16),
		CONTAINERS[1],
		Enum.Material.CorrodedMetal,
		{
			Name = "TitanCargo",
			Tag = Tags.Mover,
			Attrs = {
				Kind = "Pendulum",
				Pivot = jibEnd + Vector3.new(0, -2, 0),
				Axis = base.RightVector,
				Amplitude = math.rad(8),
				Period = 7,
				Phase = 0,
				Origin = CFrame.new(jibEnd + Vector3.new(0, -16, 0)),
			},
		}
	)

	-- The Great Furnace: a stepped hall with three smokestacks.
	local hallPos = DistrictBuilder.FindClear(ctx, 520, 30) + Vector3.new(0, 6, 0)
	local hall = CFrame.lookAt(hallPos, ctx.Origin.Position + Vector3.new(0, 6, 0))
	B:Box(hall * CFrame.new(0, -40, 0), Vector3.new(40, 80, 30), P.Rust, Enum.Material.Brick, { Name = "GreatFurnace" })
	B:Box(hall * CFrame.new(0, -1, 0), Vector3.new(40.4, 2, 30.4), P.SteelDark, Enum.Material.DiamondPlate)
	local glow = B:Detail(hall * CFrame.new(0, -12, -15.1), Vector3.new(20, 10, 0.2), P.Glow, Enum.Material.Neon)
	B:Light(glow, P.Glow, 60, 3, "Surface", Enum.NormalId.Front)
	local tops = {}
	for i = -1, 1 do
		local top = Props.Smokestack(B, hall * CFrame.new(i * 12, 0, 6), 34 + i * 4, P.Rust, true)
		table.insert(tops, top)
	end
	DistrictBuilder.QuestPoint(ctx, "iron_relay_2", tops[1] + Vector3.new(0, 0.5, 0))
	DistrictBuilder.QuestPoint(ctx, "iron_relay_3", tops[3] + Vector3.new(0, 0.5, 0))
	DistrictBuilder.Landmark(ctx, "furnace", "The Great Furnace", hall * CFrame.new(0, 4, 0), Vector3.new(40, 8, 30))
	B:FarBox(hall * CFrame.new(0, -30, 0), Vector3.new(40, 60, 30), P.Rust)
end

function Ironworks.QuestPoints(B, ctx)
	DistrictBuilder.QuestPoint(ctx, "iron_relay_4", DistrictBuilder.TakeHigh(ctx) + Vector3.new(0, 1, 0))
	DistrictBuilder.QuestPoint(ctx, "iron_relay_5", DistrictBuilder.TakeHigh(ctx) + Vector3.new(0, 1, 0))
	for i = 1, 6 do
		local spot = if i % 2 == 0 then DistrictBuilder.TakeNook(ctx) else DistrictBuilder.TakeHigh(ctx)
		DistrictBuilder.QuestPoint(ctx, "iron_scrap_" .. i, spot + Vector3.new(0, 1, 0))
	end
end

function Ironworks.Skyline(B, ctx)
	for i = 0, 9 do
		local angle = i * math.pi / 5 + 0.2
		local p = ctx.Origin.Position + DistrictBuilder.Dir(angle) * (680 + B:Rand(-40, 40))
		local h = B:Rand(70, 140)
		B:FarBox(CFrame.new(p + Vector3.new(0, -60 + h / 2, 0)), Vector3.new(8, h, 8), P.Rust)
		B:FarBox(CFrame.new(p + Vector3.new(14, -80 + h / 4, 0)), Vector3.new(50, h / 2, 40), P.Steel)
		local top = B:Detail(
			CFrame.new(p + Vector3.new(0, -60 + h, 0)),
			Vector3.new(10, 1, 10),
			P.SteelDark,
			Enum.Material.Metal
		)
		local attachment = Instance.new("Attachment")
		attachment.Parent = top
		B:Emitter(attachment, "Smoke", rgb(110, 100, 95))
	end
	-- Molten glow from the foundry floor far below.
	for i = 1, 12 do
		local p = ctx.Origin.Position
			+ DistrictBuilder.Dir(B:Rand(0, math.pi * 2)) * B:Rand(160, 520)
			+ Vector3.new(0, -90, 0)
		local pool = B:Detail(CFrame.new(p), Vector3.new(B:Rand(20, 40), 1, B:Rand(20, 40)), P.Glow, Enum.Material.Neon)
		pool.CanCollide = false
		B:Light(pool, P.Glow, 60, 2)
	end
	B:Volume(
		ctx.Origin * CFrame.new(0, -ctx.District.KillDepth, 0),
		Vector3.new(1600, 10, 1600),
		Tags.KillZone,
		{ District = "Ironworks" }
	)
end

return Ironworks
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">Tinroof</string>
              <string name="Source"><![CDATA[-- Tinroof Terraces: the approachable residential rooftops. Brick terraces
-- separated by narrow alleys, water towers, washing lines, rooftop gardens
-- and the Old Bell, the tallest water tower in the Terraces.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Tags = require(ReplicatedStorage.Shared.Tags)

local DistrictBuilder = require(script.Parent.Parent.DistrictBuilder)
local Props = require(script.Parent.Parent.Props)

local P = Districts.ById.Tinroof.Palette

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local BRICKS = { P.Brick, P.BrickDark, rgb(160, 110, 80), rgb(190, 140, 100), P.Plaster }
local SHEETS = { rgb(240, 240, 235), rgb(120, 180, 230), rgb(240, 150, 150), rgb(250, 220, 120), rgb(160, 210, 160) }
local LIT = rgb(255, 214, 150)
local DARK = rgb(40, 50, 60)

local Tinroof = {}

local function body(B, top: CFrame, width: number, length: number, depth: number)
	local color = B:Pick(BRICKS)
	B:Box(
		top * CFrame.new(0, -depth / 2, 0),
		Vector3.new(width, depth, length),
		color,
		if color == P.Plaster then Enum.Material.Plaster else Enum.Material.Brick,
		{ Name = "Terrace" }
	)
	-- A band of windows below the roofline on long terraces.
	if length >= 12 then
		for _, side in { -1, 1 } do
			local lit = B:Rand(0, 1) < 0.4
			B:Detail(
				top * CFrame.new(side * (width / 2 + 0.05), -5, 0),
				Vector3.new(0.12, 2.6, length * 0.8),
				if lit then LIT else DARK,
				if lit then Enum.Material.Neon else Enum.Material.Glass
			)
		end
	end
	-- Cornice under the roofline.
	B:Detail(
		top * CFrame.new(0, -0.6, 0),
		Vector3.new(width + 0.6, 0.6, length + 0.6),
		P.Plaster,
		Enum.Material.Concrete
	)
end

Tinroof.CourseTheme = {
	Id = "Tinroof",
	Surface = P.Roof,
	SurfaceMaterial = Enum.Material.Slate,
	Trim = P.Wood,
	Wall = P.Brick,
	WallMaterial = Enum.Material.Brick,
	Accent = P.Accent,
	Signal = P.Signal,
	Beam = P.Wood,
	BeamMaterial = Enum.Material.WoodPlanks,
	Rope = rgb(210, 190, 140),
	Climb = "Ladder",
	BodyDepth = 46,
	Platform = function(B, top, width, length, role)
		local material = if role == "Checkpoint"
				or role == "Start"
				or role == "Finish"
			then Enum.Material.WoodPlanks
			else Enum.Material.Slate
		local color = if material == Enum.Material.WoodPlanks then P.Wood else B:Vary(P.Roof, 0.08)
		B:Box(top * CFrame.new(0, -1, 0), Vector3.new(width, 2, length), color, material, { Name = "Roof" })
	end,
	Body = body,
	Deco = function(B, top, width, length)
		if B:Rand(0, 1) < 0.5 then
			local side = if B:Rand(0, 1) < 0.5 then -1 else 1
			local vent = B:Detail(
				top * CFrame.new(side * (width / 2 - 0.6), 1, B:Rand(-length / 3, length / 3)),
				Vector3.new(0.8, 2, 0.8),
				P.Tin,
				Enum.Material.Metal
			)
			vent.CanCollide = false
		end
	end,
}

Tinroof.RoomTheme = {
	Id = "TinroofRoom",
	Surface = P.Wood,
	SurfaceMaterial = Enum.Material.WoodPlanks,
	Trim = P.BrickDark,
	Wall = P.Plaster,
	WallMaterial = Enum.Material.Plaster,
	Accent = P.Accent,
	Signal = P.Signal,
	Beam = P.Wood,
	BeamMaterial = Enum.Material.WoodPlanks,
	Rope = rgb(210, 190, 140),
	Climb = "Ladder",
	BodyDepth = 0,
}

function Tinroof.Plaza(B, ctx)
	local origin = ctx.Origin
	local R = DistrictBuilder.PlazaRadius
	-- A big flat roof deck with a brick rim.
	B:Box(
		origin * CFrame.new(0, -1, 0),
		Vector3.new(R * 2, 2, R * 2),
		P.Wood,
		Enum.Material.WoodPlanks,
		{ Name = "PlazaDeck" }
	)
	B:Box(
		origin * CFrame.new(0, -24, 0),
		Vector3.new(R * 2 - 2, 44, R * 2 - 2),
		P.Brick,
		Enum.Material.Brick,
		{ Name = "PlazaBuilding" }
	)
	for _, side in { -1, 1 } do
		for _, axis in { "X", "Z" } do
			local offset = if axis == "X"
				then Vector3.new(side * (R - 0.5), 0.6, 0)
				else Vector3.new(0, 0.6, side * (R - 0.5))
			local size = if axis == "X" then Vector3.new(1, 1.2, R * 2) else Vector3.new(R * 2, 1.2, 1)
			B:Detail(origin * CFrame.new(offset), size, P.BrickDark, Enum.Material.Brick)
		end
	end
	-- Rooftop garden (Gran Petra) on one side, pigeon loft (Milo) on the other.
	local side = ctx.HubDir:Cross(Vector3.yAxis)
	local gardenCenter = ctx.Origin.Position - side * 26 - ctx.HubDir * 8
	for i = -1, 1 do
		Props.Planter(
			B,
			CFrame.lookAt(
				gardenCenter + side * 0 + ctx.HubDir * (i * 5),
				gardenCenter + side * 4 + ctx.HubDir * (i * 5)
			),
			B:Pick({ rgb(240, 90, 90), rgb(250, 210, 90), rgb(240, 140, 200) })
		)
	end
	B:Box(
		CFrame.new(gardenCenter + side * 4 + Vector3.new(0, 1.5, 0)),
		Vector3.new(3, 3, 3),
		rgb(120, 140, 160),
		Enum.Material.Metal,
		{ Name = "RainBarrel" }
	)
	DistrictBuilder.NPCSpot(
		ctx,
		"tin_petra",
		CFrame.lookAt(gardenCenter - side * 3 + Vector3.new(0, 3, 0), ctx.Origin.Position + Vector3.new(0, 3, 0))
	)
	DistrictBuilder.QuestPoint(ctx, "tin_seedlings", gardenCenter + Vector3.new(0, 2, 0))

	local loft = CFrame.lookAt(ctx.Origin.Position + side * 28 - ctx.HubDir * 6, ctx.Origin.Position)
	B:Box(loft * CFrame.new(0, 3, 0), Vector3.new(8, 6, 6), P.Wood, Enum.Material.WoodPlanks, { Name = "PigeonLoft" })
	B:Wedge(loft * CFrame.new(0, 7, 0), Vector3.new(8.4, 2, 6.4), P.Roof, Enum.Material.Slate)
	for i = -2, 2 do
		B:Detail(
			loft * CFrame.new(i * 1.4, 4, -3.05),
			Vector3.new(0.9, 0.9, 0.1),
			rgb(30, 25, 20),
			Enum.Material.SmoothPlastic
		)
	end
	DistrictBuilder.NPCSpot(ctx, "tin_milo", loft * CFrame.new(0, 3, -6) * CFrame.Angles(0, math.rad(180), 0))

	-- Mrs. Okafor by the noticeboard near the gate.
	DistrictBuilder.NPCSpot(
		ctx,
		"tin_okafor",
		CFrame.lookAt(
			ctx.Origin.Position + ctx.HubDir * 18 - side * 8 + Vector3.new(0, 3, 0),
			ctx.Origin.Position + Vector3.new(0, 3, 0)
		)
	)

	-- Washing lines and string lights over the square.
	Props.Clothesline(
		B,
		ctx.Origin.Position + Vector3.new(-30, 0, -30),
		ctx.Origin.Position + Vector3.new(-10, 0, -36),
		SHEETS
	)
	Props.Clothesline(
		B,
		ctx.Origin.Position + Vector3.new(30, 0, 30),
		ctx.Origin.Position + Vector3.new(36, 0, 10),
		SHEETS
	)
	for i = 0, 3 do
		local a = origin * CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.new(0, 9, -R + 2)
		local b = origin * CFrame.Angles(0, (i + 1) * math.pi / 2, 0) * CFrame.new(0, 9, -R + 2)
		Props.StringLights(B, a.Position, b.Position, rgb(255, 210, 140))
		Props.Lamp(B, a * CFrame.new(0, -9, 0), rgb(255, 200, 130), 9)
	end
	-- Benches around a little fountain: somewhere to gather before a run.
	local fountain = origin * CFrame.new(0, 0, 0)
	B:Cylinder(
		fountain * CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, math.rad(90)),
		1.6,
		12,
		P.Plaster,
		Enum.Material.Concrete
	)
	B:Cylinder(
		fountain * CFrame.new(0, 1.65, 0) * CFrame.Angles(0, 0, math.rad(90)),
		0.2,
		10.5,
		rgb(90, 170, 210),
		Enum.Material.Glass,
		{ Decor = true }
	)
	B:Cylinder(
		fountain * CFrame.new(0, 3, 0) * CFrame.Angles(0, 0, math.rad(90)),
		3,
		1.4,
		P.Plaster,
		Enum.Material.Concrete
	)
	for i = 0, 5 do
		local angle = i * math.pi / 3
		Props.Bench(
			B,
			origin * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, 12) * CFrame.Angles(0, math.rad(180), 0),
			P.Wood
		)
	end
	-- Market stall (district shop).
	local stall = CFrame.lookAt(ctx.Origin.Position - ctx.HubDir * 30 + side * 16, ctx.Origin.Position)
	B:Box(
		stall * CFrame.new(0, 1.5, 0),
		Vector3.new(8, 3, 3),
		P.Wood,
		Enum.Material.WoodPlanks,
		{ Name = "StallCounter" }
	)
	for _, x in { -3.8, 3.8 } do
		B:Box(stall * CFrame.new(x, 3.5, 1.2), Vector3.new(0.3, 7, 0.3), P.Wood, Enum.Material.Wood)
	end
	local awning = B:Box(
		stall * CFrame.new(0, 7.2, 0) * CFrame.Angles(math.rad(-12), 0, 0),
		Vector3.new(9, 0.3, 5),
		P.Fabric,
		Enum.Material.Fabric,
		{ Name = "StallAwning" }
	)
	B:Prompt(
		awning,
		"Browse",
		"Terrace Stall",
		{ Name = "ShopPrompt", Distance = 12, Attrs = { Board = "Shop", District = "Tinroof" } }
	)
end

function Tinroof.Building(B, ctx, top: CFrame, size: Vector3)
	local w, d = size.X, size.Z
	local depth = 60
	body(B, top, w, d, depth)
	local color = B:Vary(P.Roof, 0.1)
	B:Box(top * CFrame.new(0, -1, 0), Vector3.new(w, 2, d), color, Enum.Material.Slate, { Name = "Rooftop" })
	-- Parapet with gaps so you can still run off the edges.
	for _, side in { -1, 1 } do
		B:Detail(
			top * CFrame.new(side * (w / 2 - 0.3), 0.5, -d / 4),
			Vector3.new(0.6, 1, d / 2 - 2),
			P.BrickDark,
			Enum.Material.Brick,
			{ CanCollide = true }
		)
	end
	local spots = { Roof = (top * CFrame.new(0, 0.2, 0)).Position, High = {}, Nooks = {} }
	local roll = B:Rand(0, 1)
	if roll < 0.45 then
		local high, nook = Props.WaterTower(
			B,
			top * CFrame.new(w / 4, 0, d / 4),
			B:Rand(0.8, 1.1),
			B:Pick({ rgb(130, 95, 70), rgb(110, 120, 130), rgb(150, 110, 80) })
		)
		table.insert(spots.High, high)
		table.insert(spots.Nooks, nook)
	elseif roll < 0.75 then
		Props.Clothesline(
			B,
			(top * CFrame.new(-w / 2 + 2, 0, -d / 2 + 3)).Position,
			(top * CFrame.new(w / 2 - 2, 0, -d / 2 + 5)).Position,
			SHEETS
		)
		Props.Planter(B, top * CFrame.new(-w / 4, 0, d / 4), B:Pick({ rgb(240, 90, 90), rgb(250, 210, 90) }))
		table.insert(spots.Nooks, (top * CFrame.new(w / 2 - 1.5, 0.2, d / 2 - 1.5)).Position)
	else
		Props.Skylight(B, top * CFrame.new(0, 0, 0))
		Props.ACUnit(B, top * CFrame.new(w / 3, 0, -d / 3))
		table.insert(spots.Nooks, (top * CFrame.new(w / 3 + 2.2, 0.2, -d / 3)).Position)
	end
	local chimneyTop = Props.Chimney(B, top * CFrame.new(-w / 2 + 2.5, 0, d / 2 - 2.5), B:Pick(BRICKS), B:Rand(4, 7))
	table.insert(spots.High, chimneyTop)
	-- Balcony on the face toward the plaza: a ledge you can hang from.
	local balcony = top * CFrame.new(0, -7, -d / 2 - 1.4)
	B:Box(balcony, Vector3.new(8, 0.6, 2.8), P.Wood, Enum.Material.WoodPlanks, { Name = "Balcony" })
	B:Detail(
		balcony * CFrame.new(0, 1.2, -1.3),
		Vector3.new(8, 1.8, 0.2),
		P.Tin,
		Enum.Material.Metal,
		{ CanCollide = true }
	)
	table.insert(spots.Nooks, (balcony * CFrame.new(2.5, 0.5, 0.3)).Position)
	return spots
end

-- Wider rooftop gaps get a washing line to ride (downhill) or a plank to walk.
function Tinroof.Connector(B, ctx, a: Vector3, b: Vector3)
	if a.Y - b.Y > 4 then
		local start = a + Vector3.new(0, 7.5, 0)
		local finish = b + Vector3.new(0, 5.5, 0)
		Props.Clothesline(B, a, a + (b - a).Unit * 0.5, SHEETS)
		B:Box(CFrame.new(b + Vector3.new(0, 3, 0)), Vector3.new(0.5, 6, 0.5), P.Wood, Enum.Material.Wood)
		local cable = B:Rod(start, finish, 0.18, rgb(230, 230, 230), Enum.Material.SmoothPlastic, {
			Name = "WashLine",
			CanCollide = false,
			Tag = Tags.Zipline,
			Attrs = { A = start, B = finish },
		})
		B:Icon(cable, "~", P.Signal, Vector3.new(0, 1.5, 0))
	else
		local plank = B:Beam(
			a - Vector3.new(0, 0.5, 0),
			b - Vector3.new(0, 0.5, 0),
			1.3,
			1,
			P.Wood,
			Enum.Material.WoodPlanks,
			{ Name = "Plank", Tag = Tags.Balance }
		)
		B:Icon(plank, "=", rgb(255, 255, 255), Vector3.new(0, 2, 0))
	end
end

function Tinroof.Landmarks(B, ctx)
	-- The Old Bell: a giant water tower on a tall terrace, with the relay on top.
	local basePos = DistrictBuilder.FindClear(ctx, 560, 26) + Vector3.new(0, 18, 0)
	local base = CFrame.lookAt(basePos, ctx.Origin.Position + Vector3.new(0, 18, 0))
	body(B, base, 30, 30, 80)
	B:Box(base * CFrame.new(0, -1, 0), Vector3.new(30, 2, 30), P.Roof, Enum.Material.Slate, { Name = "BellRoof" })
	Props.Ladder(B, base * CFrame.new(0, -40, -15.1) * CFrame.Angles(0, math.rad(180), 0), 40, 3)
	local legH, tankH = 22, 18
	for _, offset in { Vector3.new(-6, 0, -6), Vector3.new(6, 0, -6), Vector3.new(-6, 0, 6), Vector3.new(6, 0, 6) } do
		B:Box(
			base * CFrame.new(offset) * CFrame.new(0, legH / 2, 0),
			Vector3.new(1.2, legH, 1.2),
			rgb(70, 60, 50),
			Enum.Material.Wood
		)
	end
	B:Box(
		base * CFrame.new(0, legH, 0),
		Vector3.new(20, 1, 20),
		rgb(90, 75, 60),
		Enum.Material.WoodPlanks,
		{ Name = "BellDeck" }
	)
	B:Cylinder(
		base * CFrame.new(0, legH + tankH / 2 + 0.5, 0) * CFrame.Angles(0, 0, math.rad(90)),
		tankH,
		18,
		rgb(120, 90, 66),
		Enum.Material.WoodPlanks
	)
	B:Box(
		base * CFrame.new(0, legH + tankH + 1, 0),
		Vector3.new(19, 1, 19),
		rgb(80, 85, 90),
		Enum.Material.CorrodedMetal,
		{ Name = "BellTop" }
	)
	Props.Ladder(B, base * CFrame.new(0, 0, 9.4), legH + tankH + 1, 3)
	-- The bell itself, with its frame.
	local bellBase = base * CFrame.new(0, legH + tankH + 1.5, 0)
	Props.Arch(B, bellBase, 8, 7, rgb(90, 75, 60), Enum.Material.Wood)
	local bell = B:Box(
		bellBase * CFrame.new(0, 5, 0),
		Vector3.new(4, 4, 4),
		rgb(200, 160, 70),
		Enum.Material.Metal,
		{ Name = "OldBell" }
	)
	B:Light(bell, rgb(255, 210, 120), 30, 0.8)
	local relay = bellBase * CFrame.new(5, 0, 5)
	B:Box(
		relay * CFrame.new(0, 3, 0),
		Vector3.new(0.5, 6, 0.5),
		rgb(150, 150, 160),
		Enum.Material.Metal,
		{ Name = "RelayMast" }
	)
	DistrictBuilder.QuestPoint(ctx, "tin_relay", (relay * CFrame.new(0, 1.5, -2)).Position)
	DistrictBuilder.Landmark(ctx, "bell", "The Old Bell", bellBase * CFrame.new(0, 2, 0), Vector3.new(20, 6, 20))
	DistrictBuilder.Secret(
		ctx,
		"bell",
		"Ring the Bell",
		"You stood on the Old Bell itself. Somewhere below, a pigeon is very impressed.",
		bellBase * CFrame.new(0, 8.5, 0),
		Vector3.new(5, 4, 5)
	)
	B:FarBox(base * CFrame.new(0, legH / 2, 0), Vector3.new(18, legH + tankH, 18), rgb(120, 90, 66))

	-- Okafor House: the tallest terrace, balconies and awnings stepping up its face.
	local housePos = DistrictBuilder.FindClear(ctx, 520, 26) + Vector3.new(0, 26, 0)
	local house = CFrame.lookAt(housePos, ctx.Origin.Position + Vector3.new(0, 26, 0))
	body(B, house, 36, 26, 90)
	B:Box(house * CFrame.new(0, -1, 0), Vector3.new(36, 2, 26), P.Roof, Enum.Material.Slate, { Name = "OkaforRoof" })
	for i = 1, 6 do
		local y = -6 - i * 9
		local x = (if i % 2 == 0 then -1 else 1) * 9
		B:Box(
			house * CFrame.new(x, y, -14.5) * CFrame.Angles(math.rad(-15), 0, 0),
			Vector3.new(10, 0.4, 4),
			B:Pick(SHEETS),
			Enum.Material.Fabric,
			{ Name = "Awning" }
		)
		B:Box(
			house * CFrame.new(x, y - 3, -14),
			Vector3.new(9, 0.6, 3),
			P.Wood,
			Enum.Material.WoodPlanks,
			{ Name = "Balcony" }
		)
	end
	Props.Ladder(B, house * CFrame.new(0, -60, -13.1) * CFrame.Angles(0, math.rad(180), 0), 60, 3)
	Props.WaterTower(B, house * CFrame.new(-10, 0, 6), 1.1)
	DistrictBuilder.Landmark(ctx, "okafor", "Okafor House", house * CFrame.new(0, 4, 0), Vector3.new(36, 8, 26))
	B:FarBox(house * CFrame.new(0, -45, 0), Vector3.new(36, 90, 26), P.Brick)
end

function Tinroof.QuestPoints(B, ctx)
	-- Gran Petra's three gardens on three different roofs.
	for _, id in { "tin_garden_a", "tin_garden_b", "tin_garden_c" } do
		local roof = DistrictBuilder.TakeRoof(ctx)
		Props.Planter(B, CFrame.new(roof + Vector3.new(3, -0.2, 0)), rgb(250, 210, 90))
		DistrictBuilder.QuestPoint(ctx, id, roof + Vector3.new(0, 1.5, 0))
	end
	for i = 1, 5 do
		DistrictBuilder.QuestPoint(ctx, "tin_pigeon_" .. i, DistrictBuilder.TakeHigh(ctx) + Vector3.new(0, 1, 0))
	end
	DistrictBuilder.QuestPoint(ctx, "tin_party", DistrictBuilder.TakeRoof(ctx) + Vector3.new(0, 1.5, 0))
end

function Tinroof.Skyline(B, ctx)
	-- Far silhouettes of terraces ringing the district, and the lit streets below.
	for i = 0, 11 do
		local angle = i * math.pi / 6
		local r = 660 + B:Rand(-40, 40)
		local p = ctx.Origin.Position + DistrictBuilder.Dir(angle) * r
		local h = B:Rand(50, 110)
		B:FarBox(
			CFrame.new(p + Vector3.new(0, -60 + h / 2, 0)),
			Vector3.new(B:Rand(40, 70), h, B:Rand(40, 70)),
			B:Pick(BRICKS)
		)
		B:Detail(
			CFrame.new(p + Vector3.new(0, -70 + h / 2, 0)),
			Vector3.new(50, h, 50),
			B:Pick(BRICKS),
			Enum.Material.Brick,
			{ CanCollide = false }
		)
	end
	-- Street lamps far below, glimpsed through the alleys.
	for i = 1, 24 do
		local angle = B:Rand(0, math.pi * 2)
		local r = B:Rand(150, 520)
		local p = ctx.Origin.Position + DistrictBuilder.Dir(angle) * r + Vector3.new(0, -70, 0)
		local lamp = B:Detail(CFrame.new(p), Vector3.new(1, 1, 1), rgb(255, 190, 110), Enum.Material.Neon)
		lamp.CanCollide = false
		B:Light(lamp, rgb(255, 180, 100), 40, 1.5)
	end
	-- Kill zone well below the roofs: falling here returns you to safety.
	B:Volume(
		ctx.Origin * CFrame.new(0, -ctx.District.KillDepth, 0),
		Vector3.new(1600, 10, 1600),
		Tags.KillZone,
		{ District = "Tinroof" }
	)
end

return Tinroof
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">Verdant</string>
              <string name="Source"><![CDATA[-- Verdant Hollow: the old botanical tier, swallowed by its gardens. Mossy
-- stone ruins on root-wrapped pillars, giant climbable trees, vine swings,
-- crumbling terraces, the Great Falls and the Starfall Observatory.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Tags = require(ReplicatedStorage.Shared.Tags)

local DistrictBuilder = require(script.Parent.Parent.DistrictBuilder)
local Props = require(script.Parent.Parent.Props)

local P = Districts.ById.Verdant.Palette

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local FLOWERS = { P.Flower, rgb(255, 220, 120), rgb(180, 140, 255), rgb(255, 255, 255) }

local Verdant = {}

local function ruinBody(B, top: CFrame, width: number, length: number, depth: number)
	-- A stone pillar wrapped in roots, narrower than the platform it holds up.
	B:Box(
		top * CFrame.new(0, -depth / 2, 0),
		Vector3.new(width * 0.7, depth, length * 0.7),
		B:Vary(P.StoneDark, 0.08),
		Enum.Material.Slate,
		{ Name = "Pillar" }
	)
	if length >= 12 then
		for _, side in { -1, 1 } do
			B:Detail(
				top * CFrame.new(side * width * 0.36, -depth * 0.35, 0) * CFrame.Angles(0, 0, math.rad(side * 8)),
				Vector3.new(1.4, depth * 0.7, 1.4),
				P.Bark,
				Enum.Material.Wood
			)
		end
	end
	B:Detail(
		top * CFrame.new(0, -1.3, 0),
		Vector3.new(width + 0.4, 0.6, length + 0.4),
		P.Moss,
		Enum.Material.LeafyGrass
	)
end

Verdant.CourseTheme = {
	Id = "Verdant",
	Surface = P.Stone,
	SurfaceMaterial = Enum.Material.Slate,
	Trim = P.Bark,
	Wall = P.StoneDark,
	WallMaterial = Enum.Material.Cobblestone,
	Accent = P.Accent,
	Signal = P.Signal,
	Beam = P.Bark,
	BeamMaterial = Enum.Material.Wood,
	Rope = rgb(80, 130, 60),
	Climb = "Vines",
	BodyDepth = 40,
	Platform = function(B, top, width, length, role)
		B:Box(
			top * CFrame.new(0, -1, 0),
			Vector3.new(width, 2, length),
			B:Vary(P.Stone, 0.06),
			Enum.Material.Slate,
			{ Name = "Terrace" }
		)
		if role ~= "Recovery" and length >= 12 and B:Rand(0, 1) < 0.5 then
			B:Detail(
				top * CFrame.new(width / 2 - 1, 0.25, B:Rand(-length / 3, length / 3)),
				Vector3.new(2, 0.5, 3),
				P.Moss,
				Enum.Material.LeafyGrass
			)
		end
	end,
	Body = ruinBody,
	AnchorMount = function(B, position)
		B:Beam(
			position + Vector3.new(-8, 4, 0),
			position + Vector3.new(8, 3, 0),
			1.6,
			1.6,
			P.Bark,
			Enum.Material.Wood,
			{ Decor = true }
		)
		B:Detail(
			CFrame.new(position + Vector3.new(0, 7, 0)),
			Vector3.new(14, 6, 10),
			P.Leaf,
			Enum.Material.LeafyGrass,
			{ Shape = Enum.PartType.Ball, CanCollide = false }
		)
	end,
}

Verdant.RoomTheme = {
	Id = "VerdantRoom",
	Surface = P.Stone,
	SurfaceMaterial = Enum.Material.Slate,
	Trim = P.Bark,
	Wall = P.StoneDark,
	WallMaterial = Enum.Material.Cobblestone,
	Accent = P.Accent,
	Signal = P.Signal,
	Beam = P.Bark,
	BeamMaterial = Enum.Material.Wood,
	Rope = rgb(80, 130, 60),
	Climb = "Vines",
	BodyDepth = 0,
}

function Verdant.Plaza(B, ctx)
	local origin = ctx.Origin
	local R = DistrictBuilder.PlazaRadius
	B:Cylinder(
		origin * CFrame.new(0, -1, 0) * CFrame.Angles(0, 0, math.rad(90)),
		2,
		R * 2,
		P.Stone,
		Enum.Material.Cobblestone,
		{ Name = "Glade" }
	)
	B:Cylinder(
		origin * CFrame.new(0, -34, 0) * CFrame.Angles(0, 0, math.rad(90)),
		64,
		R * 2 - 8,
		P.StoneDark,
		Enum.Material.Slate
	)
	-- The Glade tree at the centre: its vines are climbable, and its canopy is a lookout.
	local deck, nook = Props.GiantTree(B, origin * CFrame.new(0, 0, 0), 46, P.Leaf)
	DistrictBuilder.QuestPoint(ctx, "ver_seeds", ctx.Origin.Position + ctx.HubDir * 16 + Vector3.new(0, 2, 0))
	table.insert(ctx.High, deck)
	table.insert(ctx.Nooks, nook)
	-- Flowerbeds and glowing mushrooms.
	for i = 0, 5 do
		local angle = i * math.pi / 3 + 0.3
		local p = origin * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -R + 10)
		B:Box(p * CFrame.new(0, 0.4, 0), Vector3.new(8, 0.8, 5), P.Bark, Enum.Material.Wood)
		Props.Flowers(B, (p * CFrame.new(0, 0.8, 0)).Position, 3, FLOWERS, 6)
		local shroom = B:Detail(
			p * CFrame.new(5, 1.2, 0),
			Vector3.new(1.6, 0.6, 1.6),
			P.Signal,
			Enum.Material.Neon,
			{ Shape = Enum.PartType.Ball }
		)
		B:Light(shroom, P.Signal, 12, 0.7)
	end
	-- A pond.
	B:Cylinder(
		origin * CFrame.new(-18, 0.05, 18) * CFrame.Angles(0, 0, math.rad(90)),
		0.2,
		14,
		P.Water,
		Enum.Material.Glass,
		{ Decor = true, Transparency = 0.2 }
	)
	for i = 0, 4 do
		Props.Bench(B, origin * CFrame.Angles(0, i * 1.25 + 0.6, 0) * CFrame.new(0, 0, -20), P.Bark)
	end
	local side = ctx.HubDir:Cross(Vector3.yAxis)
	DistrictBuilder.NPCSpot(
		ctx,
		"ver_wren",
		CFrame.lookAt(
			ctx.Origin.Position + ctx.HubDir * 20 + side * 10 + Vector3.new(0, 3, 0),
			ctx.Origin.Position + Vector3.new(0, 3, 0)
		)
	)
	DistrictBuilder.NPCSpot(
		ctx,
		"ver_fern",
		CFrame.lookAt(
			ctx.Origin.Position - side * 24 + Vector3.new(0, 3, 0),
			ctx.Origin.Position + Vector3.new(0, 3, 0)
		)
	)
	-- Old Moss sits up on the tree deck, of course.
	DistrictBuilder.NPCSpot(ctx, "ver_moss", CFrame.lookAt(deck + Vector3.new(4, 3, 0), deck + Vector3.new(10, 3, 0)))
	-- Seed swap stall (district shop).
	local stall = CFrame.lookAt(ctx.Origin.Position - ctx.HubDir * 28 + side * 18, ctx.Origin.Position)
	B:Box(stall * CFrame.new(0, 1.5, 0), Vector3.new(8, 3, 3), P.Bark, Enum.Material.Wood, { Name = "SeedStall" })
	local canopy = B:Box(stall * CFrame.new(0, 7, 0.5), Vector3.new(10, 0.5, 6), P.Leaf, Enum.Material.LeafyGrass)
	for _, x in { -4, 4 } do
		B:Box(stall * CFrame.new(x, 3.5, 2), Vector3.new(0.5, 7, 0.5), P.Bark, Enum.Material.Wood)
	end
	B:Prompt(
		canopy,
		"Browse",
		"Seed Swap",
		{ Name = "ShopPrompt", Distance = 12, Attrs = { Board = "Shop", District = "Verdant" } }
	)
end

function Verdant.Building(B, ctx, top: CFrame, size: Vector3)
	local w, d = size.X, size.Z
	local spots = { Roof = (top * CFrame.new(0, 0.2, 0)).Position, High = {}, Nooks = {} }
	if B:Rand(0, 1) < 0.4 then
		-- A giant tree whose canopy deck is the "roof".
		local height = B:Rand(22, 34)
		local base = top * CFrame.new(0, -height, 0)
		B:Box(base * CFrame.new(0, -30, 0), Vector3.new(w * 0.6, 60, d * 0.6), P.StoneDark, Enum.Material.Slate)
		B:Box(base * CFrame.new(0, -1, 0), Vector3.new(w, 2, d), P.Stone, Enum.Material.Slate, { Name = "RootTerrace" })
		local deck, nook = Props.GiantTree(B, base, height, B:Vary(P.Leaf, 0.12))
		spots.Roof = base.Position + Vector3.new(w / 3, 0.2, 0)
		table.insert(spots.High, deck)
		table.insert(spots.Nooks, nook)
	else
		-- A ruined terrace with broken columns.
		ruinBody(B, top, w, d, 60)
		B:Box(
			top * CFrame.new(0, -1, 0),
			Vector3.new(w, 2, d),
			B:Vary(P.Stone, 0.06),
			Enum.Material.Slate,
			{ Name = "Ruin" }
		)
		for i = 0, 3 do
			local corner = top
				* CFrame.new((if i % 2 == 0 then -1 else 1) * (w / 2 - 2), 0, (if i < 2 then -1 else 1) * (d / 2 - 2))
			local columnTop = Props.Column(B, corner, B:Rand(8, 14), P.Stone, B:Rand(0, 1) < 0.5)
			if i == 0 then
				table.insert(spots.High, columnTop)
			end
		end
		Props.Flowers(B, (top * CFrame.new(0, 0.2, 0)).Position, w / 3, FLOWERS, 5)
		-- A collapsed lintel leaves a sheltered nook.
		B:Box(
			top * CFrame.new(-w / 4, 2, d / 4) * CFrame.Angles(0, 0, math.rad(20)),
			Vector3.new(10, 1.6, 3),
			P.StoneDark,
			Enum.Material.Slate
		)
		table.insert(spots.Nooks, (top * CFrame.new(-w / 4 - 2, 0.2, d / 4)).Position)
	end
	return spots
end

function Verdant.Connector(B, ctx, a: Vector3, b: Vector3)
	-- Fallen trunks to balance across, or a vine to swing.
	local dist = (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
	if dist > 18 and dist < 34 and math.abs(a.Y - b.Y) < 4 then
		local mid = (a + b) / 2 + Vector3.new(0, 14, 0)
		B:Beam(a + Vector3.new(0, 15, 0), b + Vector3.new(0, 15, 0), 1.4, 1.4, P.Bark, Enum.Material.Wood)
		local pivot = mid
		local rope = B:Rod(pivot, pivot - Vector3.new(0, 11, 0), 0.4, rgb(80, 130, 60), Enum.Material.Fabric, {
			Name = "Vine",
			CanCollide = false,
			Tag = Tags.SwingRope,
			Attrs = { Pivot = pivot, Length = 11 },
		})
		B:Icon(rope, "Y", P.Signal, Vector3.new(0, -2, 0))
		for _, p in { a, b } do
			B:Box(CFrame.new(p + Vector3.new(0, 8, 0)), Vector3.new(1.2, 16, 1.2), P.Bark, Enum.Material.Wood)
		end
	else
		local trunk = B:Beam(
			a - Vector3.new(0, 0.6, 0),
			b - Vector3.new(0, 0.6, 0),
			1.4,
			1.2,
			P.Bark,
			Enum.Material.Wood,
			{ Name = "FallenTrunk", Tag = Tags.Balance }
		)
		B:Icon(trunk, "=", rgb(255, 255, 255), Vector3.new(0, 2, 0))
	end
end

function Verdant.Landmarks(B, ctx)
	-- Starfall Observatory: a cracked dome on a tall ruined drum.
	local obsPos = DistrictBuilder.FindClear(ctx, 560, 30) + Vector3.new(0, 10, 0)
	local obs = CFrame.lookAt(obsPos, ctx.Origin.Position + Vector3.new(0, 10, 0))
	B:Cylinder(
		obs * CFrame.new(0, -40, 0) * CFrame.Angles(0, 0, math.rad(90)),
		80,
		34,
		P.StoneDark,
		Enum.Material.Slate,
		{ Name = "ObservatoryDrum" }
	)
	B:Cylinder(
		obs * CFrame.new(0, -1, 0) * CFrame.Angles(0, 0, math.rad(90)),
		2,
		36,
		P.Stone,
		Enum.Material.Slate,
		{ Name = "ObservatoryFloor" }
	)
	B:Box(obs * CFrame.new(0, -40, -17.3), Vector3.new(4, 80, 0.6), rgb(60, 110, 55), Enum.Material.LeafyGrass, {
		Name = "ObservatoryVines",
		Tag = Tags.Climbable,
		Attrs = { Kind = "Vines" },
	})
	-- Half dome (a ring of tilted slabs).
	for i = 0, 7 do
		local angle = i * math.pi / 8
		local slab = obs * CFrame.Angles(0, angle, 0) * CFrame.new(0, 9, -15) * CFrame.Angles(math.rad(-35), 0, 0)
		B:Box(slab, Vector3.new(11, 18, 1.4), rgb(220, 220, 210), Enum.Material.Marble)
	end
	local scope = obs * CFrame.new(0, 4, 4) * CFrame.Angles(math.rad(-40), 0, 0)
	B:Cylinder(
		scope * CFrame.Angles(0, math.rad(90), 0),
		16,
		3.4,
		rgb(180, 150, 90),
		Enum.Material.Metal,
		{ Name = "Telescope" }
	)
	B:Box(obs * CFrame.new(0, 1.5, 4), Vector3.new(3, 3, 3), P.StoneDark, Enum.Material.Slate)
	DistrictBuilder.QuestPoint(ctx, "ver_telescope", (obs * CFrame.new(0, 2, 0)).Position)
	DistrictBuilder.Landmark(
		ctx,
		"observatory",
		"Starfall Observatory",
		obs * CFrame.new(0, 4, 0),
		Vector3.new(34, 8, 34)
	)
	B:FarBox(obs * CFrame.new(0, -30, 0), Vector3.new(34, 60, 34), P.StoneDark)

	-- The Great Falls: a cliff with a waterfall and a hidden cave behind it.
	local fallsPos = DistrictBuilder.FindClear(ctx, 520, 34)
	local falls = CFrame.lookAt(fallsPos, ctx.Origin.Position)
	B:Box(falls * CFrame.new(0, -10, 8), Vector3.new(50, 100, 16), P.StoneDark, Enum.Material.Rock, { Name = "Cliff" })
	B:Box(
		falls * CFrame.new(0, 40.5, 4),
		Vector3.new(50, 1, 24),
		P.Moss,
		Enum.Material.LeafyGrass,
		{ Name = "ClifftopGrass" }
	)
	-- A ledge path up the cliff face.
	for i = 0, 5 do
		local ledge = falls * CFrame.new((if i % 2 == 0 then -1 else 1) * 16, i * 7 - 4, -1.5)
		B:Box(ledge, Vector3.new(10, 1, 3), P.Stone, Enum.Material.Slate, { Name = "CliffLedge" })
	end
	-- The water itself (no collision), its spray, and the pool.
	local water = B:Box(
		falls * CFrame.new(0, 10, -1),
		Vector3.new(14, 60, 1.6),
		P.Water,
		Enum.Material.Glass,
		{ Name = "Waterfall", CanCollide = false, Transparency = 0.25 }
	)
	water.CanQuery = false
	local spray = Instance.new("Attachment")
	spray.Position = Vector3.new(0, 28, 0)
	spray.Parent = water
	B:Emitter(spray, "Falls", rgb(220, 240, 255))
	local mist = Instance.new("Attachment")
	mist.Position = Vector3.new(0, -30, -2)
	mist.Parent = water
	B:Emitter(mist, "Mist", rgb(230, 245, 255))
	B:Box(falls * CFrame.new(0, -21, -10), Vector3.new(34, 2, 20), P.Stone, Enum.Material.Slate, { Name = "FallsPool" })
	B:Box(
		falls * CFrame.new(0, -19.9, -10),
		Vector3.new(30, 0.2, 16),
		P.Water,
		Enum.Material.Glass,
		{ Decor = true, Transparency = 0.2 }
	)
	-- The cave behind the curtain.
	B:Box(falls * CFrame.new(0, -14, 1.5), Vector3.new(12, 1, 6), P.Stone, Enum.Material.Slate, { Name = "CaveFloor" })
	local glow = B:Detail(falls * CFrame.new(0, -12, 3.5), Vector3.new(1, 1, 1), P.Signal, Enum.Material.Neon)
	B:Light(glow, P.Signal, 12, 1)
	DistrictBuilder.Secret(
		ctx,
		"waterfall",
		"Behind the Curtain",
		"A dry cave behind the falls. Someone left a bedroll and a very old map.",
		falls * CFrame.new(0, -11, 2),
		Vector3.new(12, 6, 6)
	)
	DistrictBuilder.Cache(ctx, 7, (falls * CFrame.new(3, -13.5, 2)).Position)
	DistrictBuilder.Landmark(ctx, "falls", "The Great Falls", falls * CFrame.new(0, 44, 4), Vector3.new(50, 8, 24))
	B:FarBox(falls * CFrame.new(0, -10, 8), Vector3.new(50, 100, 16), P.StoneDark)
end

function Verdant.QuestPoints(B, ctx)
	for i = 1, 5 do
		local spot = DistrictBuilder.TakeHigh(ctx)
		local page = B:Detail(
			CFrame.new(spot + Vector3.new(0, 0.6, 0)),
			Vector3.new(1, 0.05, 1.3),
			rgb(240, 235, 215),
			Enum.Material.Neon
		)
		page.CanCollide = false
		DistrictBuilder.QuestPoint(ctx, "ver_page_" .. i, spot + Vector3.new(0, 1, 0))
	end
	for _, id in { "ver_ruin_a", "ver_ruin_b", "ver_ruin_c" } do
		DistrictBuilder.QuestPoint(ctx, id, DistrictBuilder.TakeRoof(ctx) + Vector3.new(0, 1.5, 0))
	end
end

function Verdant.Skyline(B, ctx)
	for i = 0, 13 do
		local angle = i * math.pi / 7
		local p = ctx.Origin.Position + DistrictBuilder.Dir(angle) * (640 + B:Rand(-50, 50))
		local h = B:Rand(60, 120)
		B:FarBox(CFrame.new(p + Vector3.new(0, -70 + h / 2, 0)), Vector3.new(12, h, 12), P.Bark)
		B:FarBox(CFrame.new(p + Vector3.new(0, -70 + h, 0)), Vector3.new(60, 30, 60), P.Leaf)
	end
	-- Mist rolling over the drowned lower gardens.
	for i = 1, 10 do
		local p = ctx.Origin.Position
			+ DistrictBuilder.Dir(B:Rand(0, math.pi * 2)) * B:Rand(150, 500)
			+ Vector3.new(0, -70, 0)
		local pad = B:Detail(CFrame.new(p), Vector3.new(4, 1, 4), P.Water, Enum.Material.Glass)
		pad.Transparency = 1
		local attachment = Instance.new("Attachment")
		attachment.Parent = pad
		B:Emitter(attachment, "Mist", rgb(220, 240, 230))
	end
	B:Detail(
		ctx.Origin * CFrame.new(0, -100, 0),
		Vector3.new(1400, 1, 1400),
		rgb(60, 110, 100),
		Enum.Material.Glass,
		{ Transparency = 0.3, CanCollide = false }
	)
	B:Volume(
		ctx.Origin * CFrame.new(0, -ctx.District.KillDepth, 0),
		Vector3.new(1600, 10, 1600),
		Tags.KillZone,
		{ District = "Verdant" }
	)
end

return Verdant
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">Dreamline</string>
            <string name="Source"><![CDATA[-- The Dreamline: a floating lobby far above the city where endless runs begin.
-- EndlessService builds each runner's lane of sections on demand, starting
-- from the lane pads laid out here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Tags = require(ReplicatedStorage.Shared.Tags)

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Dreamline = {}

Dreamline.LaneSpacing = 160
Dreamline.Lanes = 12

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Start CFrame of an endless lane (top-surface point facing along the lane).
function Dreamline.LaneStart(index: number): CFrame
	local origin = Districts.Dreamline
	local x = (index - (Dreamline.Lanes + 1) / 2) * Dreamline.LaneSpacing
	local p = origin + Vector3.new(x, 0, -60)
	return CFrame.lookAt(p, p + Vector3.new(0, 0, -1))
end

function Dreamline.BuildGate(world: Instance): CFrame
	local origin = Districts.Dreamline
	local B = Kit.new(world, "Dreamline", { Signal = rgb(255, 160, 240) })
	local base = CFrame.new(origin)
	-- Lobby: a wide translucent platform with lane pads along its far edge.
	B:Box(
		base * CFrame.new(0, -1, -20),
		Vector3.new(Dreamline.Lanes * Dreamline.LaneSpacing, 2, 80),
		rgb(60, 50, 90),
		Enum.Material.Glass,
		{ Name = "DreamLobby", Transparency = 0.2 }
	)
	for index = 1, Dreamline.Lanes do
		local start = Dreamline.LaneStart(index)
		local pad = B:Box(
			start * CFrame.new(0, 0.1, 8),
			Vector3.new(10, 0.2, 10),
			rgb(255, 160, 240),
			Enum.Material.Neon,
			{ Name = "LanePad", CanCollide = false }
		)
		pad.Transparency = 0.4
		Props.Arch(B, start * CFrame.new(0, 0, 2), 10, 12, rgb(170, 150, 220), Enum.Material.Marble)
	end
	for i = 1, 30 do
		local p = origin + Vector3.new(B:Rand(-900, 900), B:Rand(-200, 300), B:Rand(-1500, 200))
		Props.Crystal(B, p, B:Rand(4, 14), B:Pick({ rgb(255, 160, 240), rgb(140, 160, 255), rgb(150, 255, 230) }))
	end
	local sign =
		B:Detail(base * CFrame.new(0, 14, 18), Vector3.new(40, 5, 0.5), rgb(30, 24, 50), Enum.Material.SmoothPlastic)
	B:Text(sign, Enum.NormalId.Front, "THE DREAMLINE", { Color = rgb(255, 180, 245) })
	B:Text(sign, Enum.NormalId.Back, "THE DREAMLINE", { Color = rgb(255, 180, 245) })
	local exit = B:Box(
		base * CFrame.new(0, 6, 16),
		Vector3.new(10, 12, 1),
		rgb(255, 214, 150),
		Enum.Material.ForceField,
		{ Name = "DreamExit", CanCollide = false }
	)
	B:Prompt(exit, "Return", "Guildhall", { Name = "DreamExitPrompt", Distance = 14, Attrs = { Board = "ReturnHub" } })
	B:Volume(base * CFrame.new(0, -220, -400), Vector3.new(4000, 10, 4000), Tags.KillZone, { District = "Dreamline" })
	return CFrame.lookAt(origin + Vector3.new(0, 3.5, 6), origin + Vector3.new(0, 3.5, -60))
end

return Dreamline
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">Kit</string>
            <string name="Source"><![CDATA[-- Geometry kit: the primitives every district, course and room is built from.
--
-- A Builder owns a district folder with three children:
--   Core   gameplay geometry (always present for players in the district)
--   Decor  decoration the client may hide on low detail settings
--   Far    simplified silhouettes shown when you're in another district
-- Everything is anchored, smooth-surfaced and deterministic (seeded RNG), so
-- the world is identical on every server.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Rotation = require(ReplicatedStorage.Shared.Logic.Rotation)
local Tags = require(ReplicatedStorage.Shared.Tags)

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

export type PartOptions = {
	Name: string?,
	Decor: boolean?,
	Far: boolean?,
	Parent: Instance?,
	Shape: Enum.PartType?,
	Transparency: number?,
	Reflectance: number?,
	CanCollide: boolean?,
	CanQuery: boolean?,
	CanTouch: boolean?,
	CastShadow: boolean?,
	Tag: string?,
	Attrs: { [string]: any }?,
	Group: string?,
	Class: string?,
}

local Kit = {}
Kit.__index = Kit

Kit.Textures = { Sparkle = SPARKLE, Smoke = SMOKE, Fire = FIRE }

export type Builder = typeof(setmetatable(
	{} :: {
		Root: Folder,
		Core: Folder,
		Decor: Folder,
		Far: Folder,
		District: string,
		Palette: { [string]: Color3 },
		Rng: Rotation.Rng,
		Parts: number,
		Current: Instance?,
	},
	Kit
))

function Kit.new(parent: Instance, districtId: string, palette: { [string]: Color3 }, seed: number?): Builder
	local root = Instance.new("Folder")
	root.Name = districtId
	root:SetAttribute("District", districtId)
	local core = Instance.new("Folder")
	core.Name = "Core"
	core.Parent = root
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = root
	local far = Instance.new("Folder")
	far.Name = "Far"
	far.Parent = root
	root.Parent = parent
	return setmetatable({
		Root = root,
		Core = core,
		Decor = decor,
		Far = far,
		District = districtId,
		Palette = palette,
		Rng = Rotation.Rng(seed or Rotation.Hash(districtId)),
		Parts = 0,
		Current = nil,
	}, Kit)
end

-- Group subsequent Core parts under a named folder (e.g. one per course).
function Kit.Group(self: Builder, name: string, parent: Instance?): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent or self.Core
	return folder
end

function Kit.Within(self: Builder, container: Instance?, fn: () -> ())
	local previous = self.Current
	self.Current = container
	fn()
	self.Current = previous
end

-- Primitives --------------------------------------------------------------------------

function Kit.Part(
	self: Builder,
	cframe: CFrame,
	size: Vector3,
	color: Color3,
	material: Enum.Material?,
	options: PartOptions?
): BasePart
	local o = options or {}
	local part = Instance.new((o.Class or "Part") :: any) :: BasePart
	part.Name = o.Name or "Part"
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if o.Shape and part:IsA("Part") then
		part.Shape = o.Shape
	end
	if o.Transparency then
		part.Transparency = o.Transparency
	end
	if o.Reflectance then
		part.Reflectance = o.Reflectance
	end
	if o.CanCollide ~= nil then
		part.CanCollide = o.CanCollide
	end
	if o.CanQuery ~= nil then
		part.CanQuery = o.CanQuery
	end
	if o.CanTouch ~= nil then
		part.CanTouch = o.CanTouch
	end
	local small = size.X * size.Y * size.Z < 60
	if o.CastShadow ~= nil then
		part.CastShadow = o.CastShadow
	elseif o.Decor and small then
		part.CastShadow = false
	end
	if o.Decor then
		-- Decoration never blocks movement queries in surprising ways.
		if o.CanCollide == nil and small then
			part.CanCollide = false
		end
		part.CanTouch = false
	end
	if o.Group then
		part.CollisionGroup = o.Group
	end
	if o.Attrs then
		for key, value in o.Attrs do
			part:SetAttribute(key, value)
		end
	end
	if o.Tag then
		CollectionService:AddTag(part, o.Tag)
	end
	part.Parent = o.Parent or (if o.Far then self.Far elseif o.Decor then self.Decor else (self.Current or self.Core))
	self.Parts += 1
	return part
end

function Kit.Box(
	self: Builder,
	cframe: CFrame,
	size: Vector3,
	color: Color3,
	material: Enum.Material?,
	options: PartOptions?
): BasePart
	return self:Part(cframe, size, color, material, options)
end

function Kit.Detail(
	self: Builder,
	cframe: CFrame,
	size: Vector3,
	color: Color3,
	material: Enum.Material?,
	options: PartOptions?
): BasePart
	local o = table.clone(options or {})
	o.Decor = true
	return self:Part(cframe, size, color, material, o)
end

function Kit.Wedge(
	self: Builder,
	cframe: CFrame,
	size: Vector3,
	color: Color3,
	material: Enum.Material?,
	options: PartOptions?
): BasePart
	local o = table.clone(options or {})
	o.Class = "WedgePart"
	return self:Part(cframe, size, color, material, o)
end

function Kit.Ball(
	self: Builder,
	position: Vector3,
	diameter: number,
	color: Color3,
	material: Enum.Material?,
	options: PartOptions?
): BasePart
	local o = table.clone(options or {})
	o.Shape = Enum.PartType.Ball
	return self:Part(CFrame.new(position), Vector3.one * diameter, color, material, o)
end

-- Cylinder whose axis runs along the CFrame's X axis (Roblox convention).
function Kit.Cylinder(
	self: Builder,
	cframe: CFrame,
	length: number,
	diameter: number,
	color: Color3,
	material: Enum.Material?,
	options: PartOptions?
): BasePart
	local o = table.clone(options or {})
	o.Shape = Enum.PartType.Cylinder
	return self:Part(cframe, Vector3.new(length, diameter, diameter), color, material, o)
end

-- Upright cylinder (axis vertical) standing on `base`.
function Kit.Column(
	self: Builder,
	base: Vector3,
	height: number,
	diameter: number,
	color: Color3,
	material: Enum.Material?,
	options: PartOptions?
): BasePart
	local cframe = CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	return self:Cylinder(cframe, height, diameter, color, material, options)
end

-- Cylinder from point a to point b.
function Kit.Rod(
	self: Builder,
	a: Vector3,
	b: Vector3,
	diameter: number,
	color: Color3,
	material: Enum.Material?,
	options: PartOptions?
): BasePart
	local offset = b - a
	local length = math.max(offset.Magnitude, 0.05)
	local up = if length > 0.05 and math.abs(offset.Unit.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	local cframe = CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.rad(90), 0)
	return self:Cylinder(cframe, length, diameter, color, material, options)
end

-- Box spanning from a to b (thin beam).
function Kit.Beam(
	self: Builder,
	a: Vector3,
	b: Vector3,
	width: number,
	height: number,
	color: Color3,
	material: Enum.Material?,
	options: PartOptions?
): BasePart
	local offset = b - a
	local length = math.max(offset.Magnitude, 0.05)
	local up = if math.abs(offset.Unit.Y) > 0.95 then Vector3.xAxis else Vector3.yAxis
	local cframe = CFrame.lookAt((a + b) / 2, b, up)
	return self:Part(cframe, Vector3.new(width, height, length), color, material, options)
end

-- Silhouette for distant viewing.
function Kit.FarBox(self: Builder, cframe: CFrame, size: Vector3, color: Color3, material: Enum.Material?)
	return self:Part(
		cframe,
		size,
		color,
		material,
		{ Far = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false }
	)
end

-- Decoration helpers ---------------------------------------------------------------------

function Kit.Light(
	self: Builder,
	part: BasePart,
	color: Color3,
	range: number,
	brightness: number?,
	kind: string?,
	face: Enum.NormalId?
): Light
	local light: Light
	if kind == "Spot" then
		local spot = Instance.new("SpotLight")
		spot.Face = face or Enum.NormalId.Bottom
		spot.Angle = 70
		spot.Range = range
		light = spot
	elseif kind == "Surface" then
		local surface = Instance.new("SurfaceLight")
		surface.Face = face or Enum.NormalId.Front
		surface.Angle = 80
		surface.Range = range
		light = surface
	else
		local point = Instance.new("PointLight")
		point.Range = range
		light = point
	end
	light.Color = color
	light.Brightness = brightness or 1
	light.Shadows = false
	light.Parent = part
	return light
end

function Kit.Text(
	self: Builder,
	part: BasePart,
	face: Enum.NormalId,
	text: string,
	options: { [string]: any }?
): SurfaceGui
	local o = options or {}
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = o.PixelsPerStud or 24
	gui.LightInfluence = o.LightInfluence or 0.2
	gui.MaxDistance = o.MaxDistance or 260
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = if o.Background then 0 else 1
	label.BackgroundColor3 = o.Background or Color3.new(0, 0, 0)
	label.Text = text
	label.TextColor3 = o.Color or Color3.new(1, 1, 1)
	label.Font = o.Font or Enum.Font.GothamBold
	label.TextScaled = true
	label.TextWrapped = true
	label.RichText = o.Rich == true
	label.TextStrokeTransparency = o.Stroke or 1
	label.Parent = gui
	if o.Padding then
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, o.Padding)
		padding.PaddingRight = UDim.new(0, o.Padding)
		padding.PaddingTop = UDim.new(0, o.Padding)
		padding.PaddingBottom = UDim.new(0, o.Padding)
		padding.Parent = label
	end
	gui.Parent = part
	return gui
end

-- Accessibility icon: a shape glyph above an interactive surface, so nothing
-- relies on colour alone. Clients show them according to the player's setting.
function Kit.Icon(self: Builder, part: BasePart, glyph: string, color: Color3, offset: Vector3?, size: number?)
	local gui = Instance.new("BillboardGui")
	gui.Name = "SurfaceIcon"
	gui.Size = UDim2.fromOffset(size or 34, size or 34)
	gui.StudsOffsetWorldSpace = offset or Vector3.new(0, 2.5, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 70
	gui.AlwaysOnTop = false
	gui.Enabled = false
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
	label.BackgroundTransparency = 0.25
	label.TextColor3 = color
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = glyph
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = label
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = part
	CollectionService:AddTag(gui, Tags.SurfaceIcon)
	return gui
end

function Kit.Prompt(
	self: Builder,
	part: BasePart,
	action: string,
	object: string,
	options: { [string]: any }?
): ProximityPrompt
	local o = options or {}
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.MaxActivationDistance = o.Distance or 12
	prompt.HoldDuration = o.Hold or 0
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.Style = Enum.ProximityPromptStyle.Default
	if o.Name then
		prompt.Name = o.Name
	end
	if o.Attrs then
		for key, value in o.Attrs do
			prompt:SetAttribute(key, value)
		end
	end
	prompt.Parent = part
	return prompt
end

function Kit.Emitter(self: Builder, parent: Instance, preset: string, color: Color3?): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	local tint = color or Color3.new(1, 1, 1)
	emitter.Color = ColorSequence.new(tint)
	emitter.LightInfluence = 0.6
	if preset == "Steam" then
		emitter.Texture = SMOKE
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(1, 1.6)
		emitter.Speed = NumberRange.new(26, 34)
		emitter.SpreadAngle = Vector2.new(8, 8)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 7) })
		emitter.Transparency =
			NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
		emitter.Drag = 1.5
	elseif preset == "Smoke" then
		emitter.Texture = SMOKE
		emitter.Rate = 3
		emitter.Lifetime = NumberRange.new(5, 8)
		emitter.Speed = NumberRange.new(4, 7)
		emitter.SpreadAngle = Vector2.new(10, 10)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 14) })
		emitter.Transparency =
			NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
		emitter.Acceleration = Vector3.new(2, 1, 0)
	elseif preset == "Sparks" then
		emitter.Texture = SPARKLE
		emitter.LightEmission = 1
		emitter.Rate = 6
		emitter.Lifetime = NumberRange.new(0.4, 0.9)
		emitter.Speed = NumberRange.new(8, 14)
		emitter.SpreadAngle = Vector2.new(35, 35)
		emitter.Acceleration = Vector3.new(0, -60, 0)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
	elseif preset == "Mist" then
		emitter.Texture = SMOKE
		emitter.Rate = 4
		emitter.Lifetime = NumberRange.new(3, 5)
		emitter.Speed = NumberRange.new(2, 5)
		emitter.SpreadAngle = Vector2.new(60, 20)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 5), NumberSequenceKeypoint.new(1, 12) })
		emitter.Transparency =
			NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	elseif preset == "Falls" then
		emitter.Texture = SMOKE
		emitter.Rate = 30
		emitter.Lifetime = NumberRange.new(1.2, 1.8)
		emitter.Speed = NumberRange.new(2, 4)
		emitter.SpreadAngle = Vector2.new(15, 5)
		emitter.Acceleration = Vector3.new(0, -70, 0)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 6) })
		emitter.Transparency =
			NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.9) })
	elseif preset == "Updraft" then
		emitter.Texture = SPARKLE
		emitter.LightEmission = 1
		emitter.Rate = 14
		emitter.Lifetime = NumberRange.new(1.5, 2.5)
		emitter.Speed = NumberRange.new(14, 22)
		emitter.SpreadAngle = Vector2.new(10, 10)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	elseif preset == "Motes" then
		emitter.Texture = SPARKLE
		emitter.LightEmission = 1
		emitter.Rate = 3
		emitter.Lifetime = NumberRange.new(2, 4)
		emitter.Speed = NumberRange.new(0.5, 1.5)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	elseif preset == "Fire" then
		emitter.Texture = FIRE
		emitter.LightEmission = 0.8
		emitter.Rate = 12
		emitter.Lifetime = NumberRange.new(0.6, 1.1)
		emitter.Speed = NumberRange.new(2, 4)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0) })
	else -- Glow
		emitter.Texture = SPARKLE
		emitter.LightEmission = 1
		emitter.Rate = 2
		emitter.Lifetime = NumberRange.new(1, 2)
		emitter.Speed = NumberRange.new(0, 0.5)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	end
	emitter.Parent = parent
	return emitter
end

-- Gameplay markers -------------------------------------------------------------------------

function Kit.Tag(self: Builder, instance: Instance, tag: string, attrs: { [string]: any }?)
	CollectionService:AddTag(instance, tag)
	if attrs then
		for key, value in attrs do
			instance:SetAttribute(key, value)
		end
	end
end

-- Invisible trigger volume.
function Kit.Volume(self: Builder, cframe: CFrame, size: Vector3, tag: string, attrs: { [string]: any }?): BasePart
	return self:Part(cframe, size, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, {
		Name = tag,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Tag = tag,
		Attrs = attrs,
	})
end

-- Named point for quests, NPCs and contracts.
function Kit.Point(self: Builder, tag: string, id: string, position: Vector3, attrs: { [string]: any }?): BasePart
	local a = attrs and table.clone(attrs) or {}
	a.Id = id
	a.District = self.District
	return self:Part(CFrame.new(position), Vector3.new(2, 2, 2), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, {
		Name = id,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Tag = tag,
		Attrs = a,
	})
end

-- Random helpers (deterministic) ----------------------------------------------------------

function Kit.Rand(self: Builder, lo: number, hi: number): number
	return lo + (hi - lo) * self.Rng:Next()
end

function Kit.RandInt(self: Builder, lo: number, hi: number): number
	return self.Rng:Int(lo, hi)
end

function Kit.Pick<T>(self: Builder, list: { T }): T
	return list[self.Rng:Int(1, #list)]
end

function Kit.Vary(self: Builder, color: Color3, amount: number): Color3
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, s, math.clamp(v + (self.Rng:Next() - 0.5) * amount, 0, 1))
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[-- Reusable set dressing shared by the district builders: rooftop clutter,
-- industrial kit, foliage, city furniture and floating architecture.
--
-- Every prop takes a CFrame on the surface it stands on (Y up) and returns the
-- interesting positions it creates (tops to stand on, hidden nooks), so district
-- builders can hang caches, letters and quest objectives on them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Tags = require(ReplicatedStorage.Shared.Tags)

local Kit = require(script.Parent.Kit)

type Builder = Kit.Builder

local Props = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- A climbable ladder against a face. `face` sits on the surface, looking away from it.
function Props.Ladder(B: Builder, face: CFrame, height: number, width: number?)
	local w = width or 2.6
	local surface = B:Box(
		face * CFrame.new(0, height / 2, -0.3),
		Vector3.new(w, height, 0.5),
		rgb(80, 82, 90),
		Enum.Material.Metal,
		{
			Name = "Ladder",
			Transparency = 0.7,
			Tag = Tags.Climbable,
			Attrs = { Kind = "Ladder" },
		}
	)
	for _, x in { -w / 2 + 0.2, w / 2 - 0.2 } do
		B:Detail(
			face * CFrame.new(x, height / 2, -0.75),
			Vector3.new(0.3, height, 0.3),
			rgb(70, 72, 80),
			Enum.Material.Metal
		)
	end
	for y = 1, math.floor(height) - 1, 2 do
		B:Detail(face * CFrame.new(0, y, -0.75), Vector3.new(w - 0.4, 0.2, 0.2), rgb(95, 97, 105), Enum.Material.Metal)
	end
	B:Icon(surface, "#", rgb(150, 230, 140), Vector3.new(0, height / 2 + 1, 0))
	return surface
end

-- Rooftops -----------------------------------------------------------------------------

function Props.WaterTower(B: Builder, base: CFrame, scale: number?, color: Color3?): (Vector3, Vector3)
	local s = scale or 1
	local legH = 9 * s
	local tankH = 8 * s
	local radius = 4.5 * s
	for _, offset in { Vector3.new(-1, 0, -1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, 1) } do
		B:Box(
			base * CFrame.new(offset * radius * 0.7) * CFrame.new(0, legH / 2, 0),
			Vector3.new(0.6, legH, 0.6) * Vector3.new(s, 1, s),
			rgb(70, 60, 50),
			Enum.Material.Wood
		)
	end
	B:Box(
		base * CFrame.new(0, legH, 0),
		Vector3.new(radius * 2.1, 0.6, radius * 2.1),
		rgb(90, 75, 60),
		Enum.Material.WoodPlanks
	)
	local tank = B:Cylinder(
		base * CFrame.new(0, legH + tankH / 2 + 0.3, 0) * CFrame.Angles(0, 0, math.rad(90)),
		tankH,
		radius * 2,
		color or rgb(130, 95, 70),
		Enum.Material.WoodPlanks
	)
	tank.Name = "WaterTank"
	-- Conical roof built from a wedge ring approximation.
	local roofTop = legH + tankH + 0.3
	B:Box(
		base * CFrame.new(0, roofTop + 0.6, 0),
		Vector3.new(radius * 1.9, 1.2, radius * 1.9),
		rgb(80, 85, 90),
		Enum.Material.CorrodedMetal
	)
	B:Box(
		base * CFrame.new(0, roofTop + 1.6, 0),
		Vector3.new(radius * 1.2, 1, radius * 1.2),
		rgb(80, 85, 90),
		Enum.Material.CorrodedMetal
	)
	for i = 0, 2 do
		B:Detail(
			base * CFrame.new(0, legH + 1.8 + i * (tankH / 3), 0) * CFrame.Angles(0, 0, math.rad(90)),
			Vector3.new(0.25, radius * 2.06, radius * 2.06),
			rgb(50, 50, 55),
			Enum.Material.Metal,
			{ Shape = Enum.PartType.Cylinder }
		)
	end
	Props.Ladder(B, base * CFrame.new(0, 0, radius * 0.7 + 0.4), legH + tankH + 0.6, 2.2)
	local top = (base * CFrame.new(0, roofTop + 2.2, 0)).Position
	local nook = (base * CFrame.new(0, 0.2, 0)).Position
	return top, nook
end

function Props.Chimney(B: Builder, base: CFrame, color: Color3, height: number?): Vector3
	local h = height or 5
	B:Box(base * CFrame.new(0, h / 2, 0), Vector3.new(2.6, h, 2.6), color, Enum.Material.Brick)
	B:Box(base * CFrame.new(0, h + 0.3, 0), Vector3.new(3, 0.6, 3), rgb(90, 90, 95), Enum.Material.Concrete)
	B:Detail(
		base * CFrame.new(0, h + 0.62, 0),
		Vector3.new(1.8, 0.06, 1.8),
		rgb(20, 20, 20),
		Enum.Material.SmoothPlastic
	)
	return (base * CFrame.new(0, h + 0.6, 0)).Position
end

function Props.ACUnit(B: Builder, base: CFrame)
	B:Detail(
		base * CFrame.new(0, 1, 0),
		Vector3.new(3, 2, 2.4),
		rgb(180, 185, 190),
		Enum.Material.Metal,
		{ CanCollide = true }
	)
	B:Detail(
		base * CFrame.new(0, 2.05, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Vector3.new(0.1, 1.8, 1.8),
		rgb(60, 62, 70),
		Enum.Material.Metal,
		{ Shape = Enum.PartType.Cylinder }
	)
end

function Props.Skylight(B: Builder, base: CFrame)
	B:Box(base * CFrame.new(0, 0.6, 0), Vector3.new(5, 1.2, 4), rgb(110, 100, 90), Enum.Material.Wood)
	B:Detail(
		base * CFrame.new(0, 1.25, 0),
		Vector3.new(4.4, 0.1, 3.4),
		rgb(170, 210, 230),
		Enum.Material.Glass,
		{ Transparency = 0.4 }
	)
end

function Props.Planter(B: Builder, base: CFrame, flower: Color3)
	B:Box(base * CFrame.new(0, 0.6, 0), Vector3.new(4, 1.2, 1.6), rgb(120, 80, 55), Enum.Material.WoodPlanks)
	B:Detail(base * CFrame.new(0, 1.25, 0), Vector3.new(3.8, 0.1, 1.4), rgb(80, 55, 40), Enum.Material.Ground)
	for i = -1, 1 do
		B:Detail(
			base * CFrame.new(i * 1.2, 1.7, 0),
			Vector3.new(0.9, 0.9, 0.9),
			rgb(80, 150, 70),
			Enum.Material.LeafyGrass,
			{ Shape = Enum.PartType.Ball }
		)
		B:Detail(
			base * CFrame.new(i * 1.2 + 0.2, 2.1, 0.1),
			Vector3.new(0.35, 0.35, 0.35),
			flower,
			Enum.Material.SmoothPlastic,
			{ Shape = Enum.PartType.Ball }
		)
	end
end

-- Washing line between two posts, with sheets.
function Props.Clothesline(B: Builder, a: Vector3, b: Vector3, colors: { Color3 })
	local height = 5.5
	for _, p in { a, b } do
		B:Box(
			CFrame.new(p + Vector3.new(0, height / 2, 0)),
			Vector3.new(0.4, height, 0.4),
			rgb(90, 70, 50),
			Enum.Material.Wood
		)
	end
	local top = Vector3.new(0, height - 0.3, 0)
	B:Rod(a + top, b + top, 0.1, rgb(230, 230, 230), Enum.Material.SmoothPlastic, { Decor = true, CanCollide = false })
	local count = math.floor((b - a).Magnitude / 3)
	for i = 1, count - 1 do
		local p = a:Lerp(b, i / count) + top - Vector3.new(0, 1.1, 0)
		local cloth = B:Detail(
			CFrame.lookAt(p, p + (b - a)),
			Vector3.new(0.05, 2, 1.8),
			colors[(i % #colors) + 1],
			Enum.Material.Fabric
		)
		cloth.CanCollide = false
	end
end

function Props.StringLights(B: Builder, a: Vector3, b: Vector3, color: Color3)
	B:Rod(a, b, 0.08, rgb(30, 30, 30), Enum.Material.SmoothPlastic, { Decor = true, CanCollide = false })
	local count = math.max(2, math.floor((b - a).Magnitude / 4))
	for i = 1, count - 1 do
		local p = a:Lerp(b, i / count) - Vector3.new(0, math.sin(i / count * math.pi) * 0.8, 0)
		local bulb = B:Detail(
			CFrame.new(p),
			Vector3.new(0.4, 0.4, 0.4),
			color,
			Enum.Material.Neon,
			{ Shape = Enum.PartType.Ball }
		)
		if i % 3 == 0 then
			B:Light(bulb, color, 8, 0.5)
		end
	end
end

function Props.Bench(B: Builder, base: CFrame, color: Color3?)
	local c = color or rgb(120, 85, 55)
	B:Box(base * CFrame.new(0, 1.1, 0), Vector3.new(5, 0.3, 1.6), c, Enum.Material.WoodPlanks)
	B:Box(base * CFrame.new(0, 1.9, 0.7), Vector3.new(5, 1.4, 0.2), c, Enum.Material.WoodPlanks)
	for _, x in { -2, 2 } do
		B:Detail(base * CFrame.new(x, 0.5, 0), Vector3.new(0.3, 1, 1.4), rgb(50, 50, 55), Enum.Material.Metal)
	end
end

function Props.Lamp(B: Builder, base: CFrame, color: Color3, height: number?)
	local h = height or 9
	B:Box(base * CFrame.new(0, h / 2, 0), Vector3.new(0.5, h, 0.5), rgb(40, 42, 48), Enum.Material.Metal)
	local head = B:Detail(base * CFrame.new(0, h + 0.4, 0), Vector3.new(1.2, 0.8, 1.2), color, Enum.Material.Neon)
	B:Light(head, color, 22, 1.1)
	return head
end

-- Industry -------------------------------------------------------------------------------

function Props.Crate(B: Builder, base: CFrame, size: number, color: Color3)
	B:Box(base * CFrame.new(0, size / 2, 0), Vector3.new(size, size, size), color, Enum.Material.WoodPlanks)
	B:Detail(
		base * CFrame.new(0, size / 2, -size / 2 - 0.02),
		Vector3.new(size * 0.9, 0.2, 0.05),
		rgb(60, 45, 30),
		Enum.Material.Wood
	)
end

function Props.Container(B: Builder, base: CFrame, color: Color3): Vector3
	B:Box(base * CFrame.new(0, 4.25, 0), Vector3.new(8.5, 8.5, 20), color, Enum.Material.CorrodedMetal)
	for z = -9, 9, 2 do
		B:Detail(
			base * CFrame.new(4.3, 4.25, z),
			Vector3.new(0.12, 8, 0.4),
			color:Lerp(Color3.new(0, 0, 0), 0.25),
			Enum.Material.Metal
		)
	end
	return (base * CFrame.new(0, 8.6, 0)).Position
end

function Props.Barrel(B: Builder, base: CFrame, color: Color3)
	B:Cylinder(base * CFrame.new(0, 1.6, 0) * CFrame.Angles(0, 0, math.rad(90)), 3.2, 2.2, color, Enum.Material.Metal)
end

function Props.Pipe(B: Builder, a: Vector3, b: Vector3, color: Color3, diameter: number?)
	return B:Rod(a, b, diameter or 1.6, color, Enum.Material.Metal)
end

-- Smokestack with a climbing mesh up one side. Returns the top position.
function Props.Smokestack(B: Builder, base: CFrame, height: number, color: Color3, smoke: boolean?): (Vector3, Vector3)
	local stack = B:Cylinder(
		base * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		height,
		7,
		color,
		Enum.Material.Brick
	)
	stack.Name = "Smokestack"
	B:Box(base * CFrame.new(0, height + 0.5, 0), Vector3.new(8.2, 1, 8.2), rgb(60, 60, 64), Enum.Material.Metal)
	for y = 6, height - 4, 10 do
		B:Detail(
			base * CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Vector3.new(0.6, 7.2, 7.2),
			rgb(240, 180, 40),
			Enum.Material.Metal,
			{ Shape = Enum.PartType.Cylinder }
		)
	end
	Props.Ladder(B, base * CFrame.new(0, 0, 3.6), height + 1, 2.4)
	if smoke then
		local vent = B:Detail(
			base * CFrame.new(0, height + 1.2, 0),
			Vector3.new(4, 0.2, 4),
			rgb(20, 20, 20),
			Enum.Material.SmoothPlastic
		)
		local attachment = Instance.new("Attachment")
		attachment.Parent = vent
		B:Emitter(attachment, "Smoke", rgb(120, 115, 110))
	end
	return (base * CFrame.new(0, height + 1.2, 0)).Position, (base * CFrame.new(4.6, 0.3, 0)).Position
end

function Props.Crane(B: Builder, base: CFrame, height: number, jib: number, color: Color3): (Vector3, Vector3)
	-- Lattice tower.
	for _, offset in { Vector3.new(-2, 0, -2), Vector3.new(2, 0, -2), Vector3.new(-2, 0, 2), Vector3.new(2, 0, 2) } do
		B:Box(
			base * CFrame.new(offset) * CFrame.new(0, height / 2, 0),
			Vector3.new(0.8, height, 0.8),
			color,
			Enum.Material.Metal
		)
	end
	for y = 4, height - 2, 6 do
		for _, rotation in { 0, 90, 180, 270 } do
			B:Detail(
				base * CFrame.Angles(0, math.rad(rotation), 0) * CFrame.new(0, y, 2) * CFrame.Angles(0, 0, math.rad(45)),
				Vector3.new(5.5, 0.35, 0.35),
				color,
				Enum.Material.Metal,
				{ CanCollide = true }
			)
		end
	end
	Props.Ladder(B, base * CFrame.new(0, 0, 2.6), height, 2.2)
	-- Cab and jib.
	B:Box(base * CFrame.new(0, height + 2, 0), Vector3.new(6, 4, 6), color, Enum.Material.Metal)
	local cab = B:Detail(
		base * CFrame.new(0, height + 2.5, -3.05),
		Vector3.new(4, 2, 0.1),
		rgb(150, 200, 230),
		Enum.Material.Glass
	)
	cab.Transparency = 0.3
	B:Box(
		base * CFrame.new(0, height + 4.6, -jib / 2 + 4),
		Vector3.new(2.4, 1.2, jib),
		color,
		Enum.Material.Metal,
		{ Name = "CraneJib" }
	)
	B:Box(base * CFrame.new(0, height + 4.6, 9), Vector3.new(2.4, 1.2, 14), color, Enum.Material.Metal)
	B:Box(base * CFrame.new(0, height + 3, 14), Vector3.new(5, 4, 4), rgb(80, 80, 86), Enum.Material.Concrete)
	local hookPoint = base * CFrame.new(0, height + 4, -jib + 6)
	B:Rod(
		hookPoint.Position,
		(hookPoint * CFrame.new(0, -12, 0)).Position,
		0.2,
		rgb(40, 40, 40),
		Enum.Material.Metal,
		{ Decor = true, CanCollide = false }
	)
	B:Box(hookPoint * CFrame.new(0, -12.6, 0), Vector3.new(1.2, 1.2, 1.2), rgb(240, 180, 40), Enum.Material.Metal)
	return (base * CFrame.new(0, height + 5.4, 0)).Position, (base * CFrame.new(0, height + 5.4, -jib + 8)).Position
end

function Props.HazardStripes(B: Builder, cframe: CFrame, length: number)
	for i = 0, math.floor(length / 2) - 1 do
		B:Detail(
			cframe * CFrame.new(-length / 2 + i * 2 + 1, 0, 0),
			Vector3.new(1, 0.06, 0.6),
			if i % 2 == 0 then rgb(240, 190, 30) else rgb(25, 25, 25),
			Enum.Material.SmoothPlastic
		)
	end
end

-- Nature -----------------------------------------------------------------------------------

function Props.Tree(B: Builder, base: CFrame, height: number, leaf: Color3, bark: Color3?): Vector3
	local trunk = B:Cylinder(
		base * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		height,
		height * 0.12 + 0.6,
		bark or rgb(110, 80, 58),
		Enum.Material.Wood
	)
	trunk.Name = "Trunk"
	local crown = height * 0.42
	B:Detail(
		base * CFrame.new(0, height, 0),
		Vector3.new(crown, crown * 0.8, crown),
		leaf,
		Enum.Material.LeafyGrass,
		{ Shape = Enum.PartType.Ball, CanCollide = true }
	)
	B:Detail(
		base * CFrame.new(crown * 0.35, height - crown * 0.2, crown * 0.2),
		Vector3.new(crown * 0.7, crown * 0.6, crown * 0.7),
		leaf:Lerp(Color3.new(1, 1, 0.6), 0.1),
		Enum.Material.LeafyGrass,
		{ Shape = Enum.PartType.Ball }
	)
	return (base * CFrame.new(0, height + crown * 0.4, 0)).Position
end

-- A giant climbable tree with a platform in its canopy.
function Props.GiantTree(B: Builder, base: CFrame, height: number, leaf: Color3): (Vector3, Vector3)
	local width = 9
	B:Cylinder(
		base * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		height,
		width,
		rgb(100, 72, 52),
		Enum.Material.Wood
	)
	-- Vines on one side make the trunk climbable.
	local vines = B:Box(
		base * CFrame.new(0, height / 2, -width / 2 + 0.2),
		Vector3.new(4, height, 0.6),
		rgb(60, 110, 55),
		Enum.Material.LeafyGrass,
		{
			Name = "TrunkVines",
			Tag = Tags.Climbable,
			Attrs = { Kind = "Vines" },
		}
	)
	B:Icon(vines, "#", rgb(150, 230, 140), Vector3.new(0, height / 2 + 1, 0))
	for i = 1, 5 do
		local angle = i * 1.3
		local root = base * CFrame.Angles(0, angle, 0) * CFrame.new(0, 1.2, width * 0.55)
		B:Detail(
			root * CFrame.Angles(math.rad(35), 0, 0),
			Vector3.new(1.6, 1.6, 6),
			rgb(95, 68, 48),
			Enum.Material.Wood,
			{ CanCollide = true }
		)
	end
	local deck = base * CFrame.new(0, height, 0)
	B:Box(
		deck * CFrame.new(0, -0.5, 0),
		Vector3.new(16, 1, 16),
		rgb(120, 90, 60),
		Enum.Material.WoodPlanks,
		{ Name = "CanopyDeck" }
	)
	B:Detail(
		deck * CFrame.new(0, 9, 0),
		Vector3.new(34, 14, 34),
		leaf,
		Enum.Material.LeafyGrass,
		{ Shape = Enum.PartType.Ball, CanCollide = false }
	)
	B:Detail(
		deck * CFrame.new(12, 5, 6),
		Vector3.new(18, 10, 18),
		leaf:Lerp(Color3.new(1, 1, 0.5), 0.12),
		Enum.Material.LeafyGrass,
		{ Shape = Enum.PartType.Ball, CanCollide = false }
	)
	return deck.Position + Vector3.new(0, 0.2, 0), (base * CFrame.new(width * 0.9, 0.4, 0)).Position
end

function Props.Rock(B: Builder, position: Vector3, size: Vector3, color: Color3)
	B:Box(
		CFrame.new(position) * CFrame.Angles(B:Rand(-0.3, 0.3), B:Rand(0, math.pi), B:Rand(-0.3, 0.3)),
		size,
		color,
		Enum.Material.Rock
	)
end

function Props.Pine(B: Builder, base: CFrame, height: number, snow: boolean?)
	B:Cylinder(
		base * CFrame.new(0, height * 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		height * 0.4,
		1.2,
		rgb(90, 65, 45),
		Enum.Material.Wood,
		{ Decor = true }
	)
	for i = 0, 2 do
		local tier = height * (0.3 + i * 0.22)
		local size = height * (0.55 - i * 0.14)
		B:Detail(
			base * CFrame.new(0, tier, 0) * CFrame.Angles(0, math.rad(45 * i), 0),
			Vector3.new(size, height * 0.28, size),
			rgb(40, 85, 60),
			Enum.Material.LeafyGrass,
			{ CanCollide = false }
		)
		if snow then
			B:Detail(
				base * CFrame.new(0, tier + height * 0.14, 0) * CFrame.Angles(0, math.rad(45 * i), 0),
				Vector3.new(size * 0.8, 0.5, size * 0.8),
				rgb(240, 245, 250),
				Enum.Material.Snow,
				{ CanCollide = false }
			)
		end
	end
end

function Props.Flowers(B: Builder, center: Vector3, radius: number, colors: { Color3 }, count: number)
	for _ = 1, count do
		local p = center + Vector3.new(B:Rand(-radius, radius), 0.4, B:Rand(-radius, radius))
		B:Detail(
			CFrame.new(p),
			Vector3.new(0.6, 0.6, 0.6),
			B:Pick(colors),
			Enum.Material.SmoothPlastic,
			{ Shape = Enum.PartType.Ball, CanCollide = false }
		)
	end
end

function Props.Column(B: Builder, base: CFrame, height: number, color: Color3, broken: boolean?): Vector3
	local h = if broken then height * B:Rand(0.4, 0.8) else height
	B:Cylinder(base * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.rad(90)), h, 2.4, color, Enum.Material.Marble)
	B:Box(base * CFrame.new(0, 0.4, 0), Vector3.new(3.2, 0.8, 3.2), color, Enum.Material.Marble)
	if not broken then
		B:Box(base * CFrame.new(0, h + 0.4, 0), Vector3.new(3.4, 0.8, 3.4), color, Enum.Material.Marble)
	end
	return (base * CFrame.new(0, h + 0.8, 0)).Position
end

function Props.Arch(B: Builder, base: CFrame, width: number, height: number, color: Color3, material: Enum.Material?)
	local m = material or Enum.Material.Marble
	for _, x in { -width / 2, width / 2 } do
		B:Box(base * CFrame.new(x, height / 2, 0), Vector3.new(2, height, 2), color, m)
	end
	B:Box(base * CFrame.new(0, height + 0.75, 0), Vector3.new(width + 2, 1.5, 2.2), color, m)
end

-- Floating rock underside for sky islands.
function Props.FloatingRock(B: Builder, top: CFrame, width: number, depth: number, color: Color3)
	local layers = 4
	for i = 1, layers do
		local f = 1 - (i - 1) / layers
		B:Box(
			top * CFrame.new(0, -i * depth / layers + depth / layers / 2 - 0.5, 0) * CFrame.Angles(0, i * 0.4, 0),
			Vector3.new(width * f, depth / layers, width * f),
			color:Lerp(Color3.new(0, 0, 0), i * 0.06),
			Enum.Material.Rock,
			{ Decor = i > 1 }
		)
	end
end

function Props.Crystal(B: Builder, position: Vector3, height: number, color: Color3)
	local crystal = B:Detail(
		CFrame.new(position + Vector3.new(0, height / 2, 0))
			* CFrame.Angles(B:Rand(-0.2, 0.2), B:Rand(0, 1), B:Rand(-0.2, 0.2)),
		Vector3.new(height * 0.35, height, height * 0.35),
		color,
		Enum.Material.Neon
	)
	crystal.CanCollide = false
	if height > 4 then
		B:Light(crystal, color, height * 2, 0.7)
	end
end

-- City -------------------------------------------------------------------------------------

function Props.Billboard(B: Builder, base: CFrame, text: string, color: Color3, width: number?): BasePart
	local w = width or 14
	for _, x in { -w / 3, w / 3 } do
		B:Box(base * CFrame.new(x, 3, 0), Vector3.new(0.5, 6, 0.5), rgb(50, 52, 60), Enum.Material.Metal)
	end
	local panel = B:Box(
		base * CFrame.new(0, 8, 0),
		Vector3.new(w, w * 0.4, 0.6),
		rgb(20, 22, 30),
		Enum.Material.SmoothPlastic,
		{ Name = "Billboard" }
	)
	B:Text(panel, Enum.NormalId.Front, text, { Color = color, Padding = 6 })
	B:Text(panel, Enum.NormalId.Back, text, { Color = color, Padding = 6 })
	B:Light(panel, color, 20, 1, "Surface", Enum.NormalId.Front)
	return panel
end

function Props.Antenna(B: Builder, base: CFrame, height: number): Vector3
	B:Box(base * CFrame.new(0, height / 2, 0), Vector3.new(0.6, height, 0.6), rgb(150, 150, 160), Enum.Material.Metal)
	for y = 3, height - 2, 4 do
		B:Detail(
			base * CFrame.new(0, y, 0),
			Vector3.new(3 - y / height * 2, 0.15, 0.15),
			rgb(150, 150, 160),
			Enum.Material.Metal
		)
	end
	local light = B:Detail(
		base * CFrame.new(0, height + 0.3, 0),
		Vector3.new(0.6, 0.6, 0.6),
		rgb(255, 40, 40),
		Enum.Material.Neon,
		{ Shape = Enum.PartType.Ball }
	)
	B:Light(light, rgb(255, 40, 40), 10, 0.8)
	return (base * CFrame.new(0, height, 0)).Position
end

function Props.Hologram(B: Builder, base: CFrame, size: number, color: Color3)
	local holo = B:Detail(
		base * CFrame.new(0, size, 0) * CFrame.Angles(0, B:Rand(0, 1), math.rad(45)),
		Vector3.one * size,
		color,
		Enum.Material.ForceField
	)
	holo.CanCollide = false
	local core = B:Detail(
		base * CFrame.new(0, size, 0),
		Vector3.one * size * 0.3,
		color,
		Enum.Material.Neon,
		{ Shape = Enum.PartType.Ball }
	)
	B:Light(core, color, size * 4, 1)
	B:Detail(
		base * CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Vector3.new(0.6, size * 0.8, size * 0.8),
		rgb(40, 44, 60),
		Enum.Material.Metal,
		{ Shape = Enum.PartType.Cylinder, CanCollide = true }
	)
end

-- Windows on a building face: rows of lit or dark panes (decor).
function Props.Windows(
	B: Builder,
	face: CFrame,
	width: number,
	height: number,
	lit: Color3,
	dark: Color3,
	chance: number
)
	local cols = math.max(1, math.floor(width / 5))
	local rows = math.max(1, math.floor(height / 6))
	if rows * cols > 40 then
		rows = math.max(1, math.floor(40 / cols))
	end
	for r = 0, rows - 1 do
		for c = 0, cols - 1 do
			local x = -width / 2 + (c + 0.5) * (width / cols)
			local y = -(r + 0.5) * (height / rows) - 2
			local isLit = B:Rand(0, 1) < chance
			B:Detail(
				face * CFrame.new(x, y, -0.06),
				Vector3.new(2.2, 2.6, 0.1),
				if isLit then lit else dark,
				if isLit then Enum.Material.Neon else Enum.Material.Glass
			)
		end
	end
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">Sections</string>
            <string name="Source"><![CDATA[-- The section library: short, self-contained obstacle sequences used by the
-- Spire challenge tower and the endless Dreamline.
--
-- Every section is made of CourseBuilder segments, whose sizes come from the
-- movement envelope (Logic/Reach), and difficulty only scales parameters within
-- the ranges validated by tools/headless/test_world.luau. That keeps endlessly
-- assembled routes physically achievable.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Rotation = require(ReplicatedStorage.Shared.Logic.Rotation)

export type Section = {
	Id: string,
	Min: number, -- minimum difficulty (1..10)
	Requires: string?,
	Length: number, -- rough forward length, for fitting floors
	Rise: number, -- rough net height change
	Make: (Rotation.Rng, number) -> { any },
}

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * math.clamp(t, 0, 1)
end

local function side(rng: Rotation.Rng): string
	return if rng:Next() < 0.5 then "L" else "R"
end

local Sections = {}

Sections.Library = {
	{
		Id = "hops",
		Min = 1,
		Length = 40,
		Rise = 2,
		Make = function(rng, d)
			return {
				{ "Gap", lerp(0.45, 0.85, d / 10) },
				{ "Gap", lerp(0.45, 0.82, d / 10), Rise = rng:Int(-2, 3) },
			}
		end,
	},
	{
		Id = "vaults",
		Min = 1,
		Length = 52,
		Rise = 0,
		Make = function(_, d)
			return { { "Vault", if d > 5 then 3 else 2 }, { "Slide", 1 } }
		end,
	},
	{
		Id = "ledge",
		Min = 1,
		Length = 20,
		Rise = 8,
		Make = function(_, d)
			return { { "Ledge", lerp(6, 11, d / 10) } }
		end,
	},
	{
		Id = "climb",
		Min = 1,
		Length = 20,
		Rise = 12,
		Make = function(rng, d)
			return { { "Climb", lerp(8, 16, d / 10), Type = if rng:Next() < 0.5 then "Ladder" else "Mesh" } }
		end,
	},
	{
		Id = "balance",
		Min = 1,
		Length = 34,
		Rise = 0,
		Make = function(_, d)
			return { { "Balance", lerp(16, 30, d / 10) } }
		end,
	},
	{
		Id = "zip",
		Min = 1,
		Length = 50,
		Rise = -6,
		Make = function()
			return { { "Zip", 34, Drop = 6 } }
		end,
	},
	{
		Id = "drop",
		Min = 1,
		Length = 21,
		Rise = -10,
		Make = function(_, d)
			return { { "Drop", lerp(8, 14, d / 10) } }
		end,
	},
	{
		Id = "wallrun",
		Min = 2,
		Length = 40,
		Rise = -4,
		Make = function(rng, d)
			return { { "WallRun", lerp(0.6, 1.1, d / 10), Side = side(rng) } }
		end,
	},
	{
		Id = "rope",
		Min = 2,
		Length = 34,
		Rise = 0,
		Make = function(_, d)
			return { { "Rope", if d > 6 then 2 else 1 } }
		end,
	},
	{
		Id = "bounce",
		Min = 2,
		Length = 24,
		Rise = 12,
		Make = function(_, d)
			return { { "Bounce", lerp(10, 18, d / 10) } }
		end,
	},
	{
		Id = "shaft",
		Min = 3,
		Length = 26,
		Rise = 14,
		Make = function(_, d)
			return { { "Shaft", lerp(10, 18, d / 10) } }
		end,
	},
	{
		Id = "collapse",
		Min = 3,
		Length = 34,
		Rise = 0,
		Make = function(_, d)
			return { { "Collapse", lerp(16, 26, d / 10) } }
		end,
	},
	{
		Id = "doors",
		Min = 3,
		Length = 30,
		Rise = 0,
		Make = function()
			return { { "Doors", 2 } }
		end,
	},
	{
		Id = "movers",
		Min = 4,
		Length = 35,
		Rise = 0,
		Make = function(rng)
			return { { "Movers", 1, Mode = if rng:Next() < 0.5 then "Linear" else "Pendulum" } }
		end,
	},
	{
		Id = "lasers",
		Min = 4,
		Length = 32,
		Rise = 0,
		Make = function(rng)
			return { { "Lasers", 2, Pattern = rng:Pick({ "Sweep", "Alternate", "Grid" }) } }
		end,
	},
	{
		Id = "holo",
		Min = 5,
		Length = 40,
		Rise = 0,
		Make = function()
			return { { "Holo", 2 } }
		end,
	},
	{
		Id = "tictac",
		Min = 5,
		Length = 52,
		Rise = -2,
		Make = function(rng)
			return { { "TicTac", 2, Side = side(rng) } }
		end,
	},
	{
		Id = "spinner",
		Min = 6,
		Length = 40,
		Rise = 0,
		Make = function(rng)
			return { { "Spinner", Mode = if rng:Next() < 0.5 then "Sweeper" else "Platform" } }
		end,
	},
	{
		Id = "double",
		Min = 4,
		Requires = "DoubleJump",
		Length = 36,
		Rise = 2,
		Make = function(rng, d)
			return { { "DoubleGap", lerp(0.45, 0.85, d / 10), Rise = rng:Int(0, 3) } }
		end,
	},
	{
		Id = "dash",
		Min = 6,
		Requires = "Dash",
		Length = 38,
		Rise = 0,
		Make = function(_, d)
			return { { "DashGap", lerp(0.45, 0.85, d / 10) } }
		end,
	},
	{
		Id = "grapple",
		Min = 6,
		Requires = "Grapple",
		Length = 46,
		Rise = 0,
		Make = function()
			return { { "Grapple", 1 } }
		end,
	},
	{
		Id = "pull",
		Min = 7,
		Requires = "GrapplePull",
		Length = 24,
		Rise = 16,
		Make = function()
			return { { "Pull", 15 } }
		end,
	},
	{
		Id = "lowgrav",
		Min = 7,
		Length = 50,
		Rise = 0,
		Make = function()
			return { { "LowGrav", 34 } }
		end,
	},
} :: { Section }

-- Sections available at a difficulty with a set of abilities.
function Sections.Available(difficulty: number, abilities: { [string]: boolean }?): { Section }
	local result = {}
	for _, section in Sections.Library do
		if section.Min <= difficulty and (not section.Requires or not abilities or abilities[section.Requires]) then
			table.insert(result, section)
		end
	end
	return result
end

-- Pick sections that fit a length budget and keep height change in bounds.
function Sections.Fill(
	rng: Rotation.Rng,
	difficulty: number,
	abilities: { [string]: boolean }?,
	budget: number,
	maxRise: number
): ({ any }, { string })
	local pool = Sections.Available(difficulty, abilities)
	local segments, ids = {}, {}
	local used, rise = 0, 0
	local attempts = 0
	while used < budget * 0.6 and attempts < 30 do
		attempts += 1
		local section = rng:Pick(pool)
		if
			used + section.Length <= budget
			and math.abs(rise + section.Rise) <= maxRise
			and not table.find(ids, section.Id)
		then
			for _, seg in section.Make(rng, difficulty) do
				table.insert(segments, seg)
			end
			table.insert(ids, section.Id)
			used += section.Length
			rise += section.Rise
		end
	end
	return segments, ids
end

return Sections
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">Spire</string>
            <string name="Source"><![CDATA[-- The Spire: a 25-floor challenge tower rising beside the Guildhall. Each floor
-- is a short enclosed route assembled from the section library, getting harder
-- (and needing more of the movement kit) the higher you go. The roof is a secret.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local Rotation = require(ReplicatedStorage.Shared.Logic.Rotation)
local Tags = require(ReplicatedStorage.Shared.Tags)

local CourseBuilder = require(script.Parent.CourseBuilder)
local Kit = require(script.Parent.Kit)
local Sections = require(script.Parent.Sections)

local Spire = {}

Spire.Floors = 25
Spire.Roof = nil :: CFrame?

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Abilities each band of floors may use.
local function abilitiesFor(floor: number): { [string]: boolean }
	local set = {}
	if floor >= 6 then
		set.DoubleJump = true
	end
	if floor >= 11 then
		set.Dash = true
	end
	if floor >= 16 then
		set.Grapple = true
	end
	if floor >= 21 then
		set.GrapplePull = true
	end
	return set
end

local THEME: CourseBuilder.Theme = {
	Id = "Spire",
	Surface = rgb(70, 74, 90),
	SurfaceMaterial = Enum.Material.Slate,
	Trim = rgb(255, 196, 92),
	Wall = rgb(120, 126, 150),
	WallMaterial = Enum.Material.Concrete,
	Accent = rgb(255, 196, 92),
	Signal = rgb(80, 200, 255),
	Beam = rgb(150, 105, 70),
	BeamMaterial = Enum.Material.WoodPlanks,
	Rope = rgb(210, 190, 140),
	Climb = "Mesh",
	BodyDepth = 0,
}

-- Returns metas keyed "spire_<n>".
function Spire.Build(world: Instance): { [string]: any }
	local hub = Districts.ById.Hub
	local B = Kit.new(world, "Spire", hub.Palette, Rotation.Hash("Spire"))
	local base = hub.Origin + Districts.SpireOffset
	local toHub = (hub.Origin - base) * Vector3.new(1, 0, 1)
	local facing = CFrame.lookAt(base, base - toHub.Unit)
	local metas = {}

	-- Lobby at hub level.
	B:Box(
		facing * CFrame.new(0, -1, 0),
		Vector3.new(70, 2, 70),
		rgb(70, 74, 90),
		Enum.Material.Slate,
		{ Name = "SpireLobby" }
	)
	B:Box(facing * CFrame.new(0, -40, 0), Vector3.new(66, 76, 66), rgb(110, 116, 140), Enum.Material.Concrete)
	local lift = B:Box(
		facing * CFrame.new(0, 6, 20),
		Vector3.new(10, 12, 2),
		rgb(80, 200, 255),
		Enum.Material.ForceField,
		{ Name = "SpireLift", CanCollide = false }
	)
	B:Prompt(lift, "Ride", "Spire Lift", { Name = "SpirePrompt", Distance = 14, Attrs = { Board = "Tower" } })
	local liftSign = B:Detail(
		facing * CFrame.new(0, 14, 20),
		Vector3.new(14, 2.2, 0.3),
		rgb(25, 28, 36),
		Enum.Material.SmoothPlastic
	)
	B:Text(liftSign, Enum.NormalId.Back, "THE SPIRE · 25 FLOORS", { Color = rgb(80, 200, 255) })

	local floorY = base.Y + 30
	local length = 150
	for floor = 1, Spire.Floors do
		local rng = Rotation.Rng(Rotation.Hash("spire", floor))
		local difficulty = 1 + (floor - 1) * 9 / (Spire.Floors - 1)
		local segments = Sections.Fill(rng, difficulty, abilitiesFor(floor), length - 44, 16)
		table.insert(segments, { "Finish" })
		local direction = if floor % 2 == 1 then 1 else -1
		local start = facing * CFrame.new(0, floorY - base.Y, direction * (length / 2 - 4))
		start = CFrame.lookAt(start.Position, start.Position + facing.LookVector * -direction)
		local course = {
			Id = "spire_" .. floor,
			Name = "Spire Floor " .. floor,
			Kind = "Tower",
			Difficulty = math.clamp(math.floor(difficulty + 0.5), 1, 10),
			Segments = segments,
		}
		local meta = CourseBuilder.Build(B, course, THEME, start)
		meta.District = "Hub"
		meta.Kind = "Tower"
		meta.Difficulty = course.Difficulty
		meta.Floor = floor
		metas[course.Id] = meta

		-- Enclose the floor: glass walls on a steel frame.
		local min, max = meta.LocalMin, meta.LocalMax
		local floorBottom = math.min(min.Y, -4) - 2
		local top = math.max(max.Y, 20) + 6
		local height = top - floorBottom
		local center = start * CFrame.new((min.X + max.X) / 2, floorBottom + height / 2, (min.Z + max.Z) / 2)
		local sizeX = math.max(max.X - min.X, 40) + 12
		local sizeZ = (max.Z - min.Z) + 14
		B:Box(
			center * CFrame.new(0, -height / 2 - 1, 0),
			Vector3.new(sizeX, 2, sizeZ),
			rgb(60, 64, 80),
			Enum.Material.Slate,
			{ Name = "FloorSlab" }
		)
		for _, s in { -1, 1 } do
			B:Box(
				center * CFrame.new(s * sizeX / 2, 0, 0),
				Vector3.new(1, height, sizeZ),
				rgb(150, 200, 230),
				Enum.Material.Glass,
				{ Transparency = 0.55, Name = "SpireGlass" }
			)
			B:Box(
				center * CFrame.new(0, 0, s * sizeZ / 2),
				Vector3.new(sizeX, height, 1),
				rgb(150, 200, 230),
				Enum.Material.Glass,
				{ Transparency = 0.55, Name = "SpireGlass" }
			)
			for _, t in { -1, 1 } do
				B:Detail(
					center * CFrame.new(s * sizeX / 2, 0, t * sizeZ / 2),
					Vector3.new(2, height, 2),
					rgb(60, 64, 80),
					Enum.Material.Metal,
					{ CanCollide = true }
				)
			end
		end
		B:Box(
			center * CFrame.new(0, height / 2 + 1, 0),
			Vector3.new(sizeX + 2, 2, sizeZ + 2),
			rgb(60, 64, 80),
			Enum.Material.Slate,
			{ Name = "FloorCeiling" }
		)
		local band = B:Detail(
			center * CFrame.new(0, height / 2 - 0.6, sizeZ / 2 + 0.6),
			Vector3.new(sizeX, 1, 0.2),
			if floor % 5 == 0 then rgb(255, 196, 92) else rgb(80, 200, 255),
			Enum.Material.Neon
		)
		B:Light(band, rgb(200, 230, 255), 50, 1, "Spot", Enum.NormalId.Bottom)
		local label = B:Detail(
			start * CFrame.new(-7, 7, -6),
			Vector3.new(0.3, 3, 6),
			rgb(25, 28, 36),
			Enum.Material.SmoothPlastic
		)
		B:Text(label, Enum.NormalId.Right, "FLOOR " .. floor, { Color = rgb(80, 200, 255) })
		B:Text(label, Enum.NormalId.Left, "FLOOR " .. floor, { Color = rgb(80, 200, 255) })
		B:FarBox(center, Vector3.new(sizeX, height, sizeZ), rgb(150, 200, 230), Enum.Material.Glass)
		floorY = start.Y + top + 10
	end

	-- The roof: a ladder out of the last floor's ceiling, and the secret above it all.
	local roofCF = facing * CFrame.new(0, floorY - base.Y, 0)
	B:Box(
		roofCF * CFrame.new(0, -1, 0),
		Vector3.new(40, 2, 40),
		rgb(60, 64, 80),
		Enum.Material.Slate,
		{ Name = "SpireRoof" }
	)
	local beacon = B:Ball(
		roofCF.Position + Vector3.new(0, 12, 0),
		5,
		rgb(255, 196, 92),
		Enum.Material.Neon,
		{ Name = "SpireBeacon", CanCollide = false }
	)
	B:Light(beacon, rgb(255, 196, 92), 60, 2)
	B:FarBox(
		CFrame.new(roofCF.Position + Vector3.new(0, 12, 0)),
		Vector3.new(5, 5, 5),
		rgb(255, 196, 92),
		Enum.Material.Neon
	)
	B:Volume(roofCF * CFrame.new(0, 4, 0), Vector3.new(40, 8, 40), Tags.Discovery, {
		Id = "secret_spire",
		Kind = "Secret",
		District = "Hub",
		Title = "Roof of the Spire",
		Text = "The highest point in Meridian. The whole city is laid out below you.",
	})
	Spire.Roof = roofCF * CFrame.new(0, 3.5, 0)
	return metas
end

return Spire
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[-- Builds the whole of Meridian: the Guildhall hub, the six districts, the
-- Spire challenge tower and the Dreamline. Publishes every course's runtime
-- data (checkpoints, medals, requirements) for the client and services.
--
-- The world is generated on server start from seeded data, so it is identical
-- on every server. To preview it in Studio edit mode, run in the command bar:
--   require(game.ServerScriptService.Server.World.WorldBuilder).Build()

local Lighting = game:GetService("Lighting")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Courses = require(ReplicatedStorage.Shared.Config.Courses)
local Districts = require(ReplicatedStorage.Shared.Config.Districts)
local MovementConfig = require(ReplicatedStorage.Shared.Config.Movement)
local Tags = require(ReplicatedStorage.Shared.Tags)

local DistrictBuilder = require(script.Parent.DistrictBuilder)

local WorldBuilder = {}

-- course id -> CourseBuilder.Meta (with District)
WorldBuilder.Courses = {} :: { [string]: any }
WorldBuilder.Spawns = {} :: { [string]: CFrame }
WorldBuilder.Contexts = {} :: { [string]: any }
WorldBuilder.Folder = nil :: Folder?
WorldBuilder.Built = false

local DISTRICT_MODULES = {
	Tinroof = "Tinroof",
	Ironworks = "Ironworks",
	Verdant = "Verdant",
	Gilded = "Gilded",
	Frostreach = "Frostreach",
	Citadel = "Citadel",
}

function WorldBuilder.CollisionGroups()
	local G = Tags.Groups
	for _, name in { G.Players, G.PlayersLow, G.PlayersPhase, G.LowClearance, G.Ghosts, G.Cosmetic } do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	local function set(a: string, b: string, collide: boolean)
		PhysicsService:CollisionGroupSetCollidable(a, b, collide)
	end
	-- Runners pass through each other.
	set(G.Players, G.Players, false)
	set(G.Players, G.PlayersLow, false)
	set(G.Players, G.PlayersPhase, false)
	set(G.PlayersLow, G.PlayersLow, false)
	set(G.PlayersLow, G.PlayersPhase, false)
	set(G.PlayersPhase, G.PlayersPhase, false)
	-- Crouching and sliding runners fit under low clearance.
	set(G.PlayersLow, G.LowClearance, false)
	-- Scripted moves (vaults, mantles, pulls) pass through scenery.
	set(G.PlayersPhase, G.World, false)
	set(G.PlayersPhase, G.LowClearance, false)
	-- Ghosts and cosmetics never collide with anything.
	for _, group in { G.World, G.Players, G.PlayersLow, G.PlayersPhase, G.LowClearance, G.Ghosts, G.Cosmetic } do
		set(G.Ghosts, group, false)
		set(G.Cosmetic, group, false)
	end
end

-- Publish course data where clients can read it (attributes on Configurations).
local function publish(metas: { [string]: any })
	local folder = ReplicatedStorage:FindFirstChild("SkylineCourses")
	if folder then
		folder:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "SkylineCourses"
	for id, meta in metas do
		local course = Courses.ById[id]
		local config = Instance.new("Configuration")
		config.Name = id
		config:SetAttribute("Name", if course then course.Name else id)
		config:SetAttribute("District", meta.District or (course and course.District) or "Hub")
		config:SetAttribute("Kind", meta.Kind or (course and course.Kind) or "Course")
		config:SetAttribute("Difficulty", if course then course.Difficulty else (meta.Difficulty or 1))
		for index, seconds in meta.Medals do
			config:SetAttribute("Medal" .. index, seconds)
		end
		config:SetAttribute("Expected", math.floor(meta.Par.A * 1.5 + 0.5))
		config:SetAttribute("ParA", meta.Par.A)
		config:SetAttribute("ParF", meta.Par.F)
		config:SetAttribute("ParE", meta.Par.E)
		config:SetAttribute("Checkpoints", #meta.Checkpoints)
		config:SetAttribute("Tokens", #meta.Tokens)
		config:SetAttribute("Length", math.floor(meta.Length))
		config:SetAttribute("KillY", meta.KillY)
		config:SetAttribute("Spawn", meta.Spawn)
		config:SetAttribute("FlowTarget", meta.FlowTarget)
		config:SetAttribute("Requires", table.concat(meta.Requires, ","))
		config:SetAttribute("FastRequires", table.concat(meta.FastRequires, ","))
		config:SetAttribute("ExpertRequires", table.concat(meta.ExpertRequires, ","))
		config:SetAttribute("HasShortcut", #meta.Shortcuts > 0)
		config:SetAttribute("Exchanges", table.concat(meta.Exchanges, ","))
		config:SetAttribute("Legs", if course and course.Legs then course.Legs else 1)
		for index, checkpoint in meta.Checkpoints do
			config:SetAttribute("CP" .. index, checkpoint.Spawn)
		end
		config.Parent = folder
	end
	folder.Parent = ReplicatedStorage
end

function WorldBuilder.Build(): { [string]: any }
	if WorldBuilder.Built then
		return WorldBuilder.Courses
	end
	local started = os.clock()
	workspace.Gravity = MovementConfig.Gravity
	WorldBuilder.CollisionGroups()

	-- Remove any template baseplate.
	for _, name in { "Baseplate", "SpawnLocation" } do
		local existing = workspace:FindFirstChild(name)
		if existing then
			existing:Destroy()
		end
	end
	local old = workspace:FindFirstChild("SkylineWorld")
	if old then
		old:Destroy()
	end
	local world = Instance.new("Folder")
	world.Name = "SkylineWorld"
	WorldBuilder.Folder = world

	local Hub = require(script.Parent.Districts.Hub)
	local hubCtx, hubMetas, hubSpawns = Hub.Build(world)
	WorldBuilder.Contexts.Hub = hubCtx
	for id, meta in hubMetas do
		WorldBuilder.Courses[id] = meta
	end
	for name, cframe in hubSpawns do
		WorldBuilder.Spawns[name] = cframe
	end

	for _, district in Districts.Ordered() do
		local moduleName = DISTRICT_MODULES[district.Id]
		local moduleScript = moduleName and script.Parent.Districts:FindFirstChild(moduleName)
		if moduleScript then
			local module = require(moduleScript) :: any
			local ctx, metas = DistrictBuilder.Build(world, district.Id, module)
			WorldBuilder.Contexts[district.Id] = ctx
			WorldBuilder.Spawns[district.Id] = ctx.Spawn
			for _, meta in metas do
				WorldBuilder.Courses[meta.Id] = meta
			end
		end
	end

	local Spire = require(script.Parent.Spire)
	local spireMetas = Spire.Build(world)
	for id, meta in spireMetas do
		WorldBuilder.Courses[id] = meta
	end

	local Dreamline = require(script.Parent.Dreamline)
	WorldBuilder.Spawns.Dreamline = Dreamline.BuildGate(world)

	publish(WorldBuilder.Courses)
	world.Parent = workspace

	-- Baseline lighting; each client adjusts it per district.
	Lighting.Brightness = 2.4
	Lighting.ClockTime = 14
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	WorldBuilder.Built = true

	local parts = 0
	for _, descendant in world:GetDescendants() do
		if descendant:IsA("BasePart") then
			parts += 1
		end
	end
	print(("[World] Built Meridian: %d parts, %d courses in %.2fs"):format(
		parts,
		(function()
			local n = 0
			for _ in WorldBuilder.Courses do
				n += 1
			end
			return n
		end)(),
		os.clock() - started
	))
	return WorldBuilder.Courses
end

return WorldBuilder
]]></string>
