	},
	{
		Id = "SureFooted",
		Branch = "Agility",
		Name = "Sure-Footed",
		Description = "Balance beams sway 15% less per rank.",
		MaxRank = 2,
		Cost = 1,
		Requires = { "SoftTouch" },
		Tier = 3,
		Column = 2,
		Effects = { { "BalanceSway", "Mul", -0.15 } },
	},
	{
