	{ XP = 250, Credits = 120 },
	{ XP = 400, Credits = 200 },
	{ XP = 600, Credits = 300 },
}
Quests.DailyBonus = { XP = 500, Credits = 300 } -- all three done

-- Weekly expeditions: three per week, the same for everyone.
Quests.Weekly = {
	{ Id = "w_tour", Kind = "Districts", Count = 3, Text = "Complete courses in 3 different districts" },
	{ Id = "w_tokens", Kind = "Tokens", Count = 60, Text = "Collect 60 course tokens" },
	{ Id = "w_gold", Kind = "Medal", Medal = 3, Count = 6, Text = "Earn gold or better 6 times" },
	{ Id = "w_social", Kind = "Social", Count = 2, Text = "Finish 2 races or relays" },
	{ Id = "w_spire", Kind = "Tower", Count = 10, Text = "Clear 10 Spire floors" },
	{ Id = "w_dream", Kind = "Endless", Count = 60, Text = "Clear 60 Dreamline sections" },
	{ Id = "w_explore", Kind = "Discover", Count = 6, Text = "Make 6 discoveries" },
	{ Id = "w_flow", Kind = "Flow", Tier2 = 4, Count = 3, Text = "Reach Seamless flow 3 times" },
	{ Id = "w_contracts", Kind = "Contracts", Count = 8, Text = "Complete 8 contracts" },
	{ Id = "w_courses", Kind = "Courses", Count = 15, Text = "Complete 15 courses" },
}
Quests.WeeklyReward = { XP = 2500, Credits = 1200, Prestige = 1 }

-- Contracts: repeatable district jobs from the job boards.
Quests.Contracts = {
	{ Kind = "Delivery", Name = "Express Parcel", Text = "Carry a parcel to %s within %ds." },
	{ Kind = "Relays", Name = "Relay Check", Text = "Ping %d relay points within %ds." },
	{ Kind = "Course", Name = "Route Certification", Text = "Earn %s or better on %s." },
}
Quests.ContractRefresh = 15 * 60 -- seconds before declined offers roll over

return Quests
]]></string>
