local Courses = {}
Courses.List = C
Courses.ById = {} :: { [string]: Course }
Courses.ByDistrict = {} :: { [string]: { Course } }

for index, course in C do
	course.Kind = course.Kind or "Course"
	course.Order = index
	Courses.ById[course.Id] = course
	local list = Courses.ByDistrict[course.District]
	if not list then
		list = {}
		Courses.ByDistrict[course.District] = list
	end
	table.insert(list, course)
end

Courses.DifficultyNames = {
	"Gentle",
	"Easy",
	"Steady",
	"Moderate",
	"Tricky",
	"Demanding",
	"Hard",
	"Severe",
	"Expert",
	"Legendary",
}

Courses.MedalNames = { "Bronze", "Silver", "Gold", "Platinum" }
Courses.MedalColors = {
	Color3.fromRGB(205, 127, 70),
	Color3.fromRGB(200, 210, 220),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(150, 235, 255),
}
-- Shapes so medals read without colour: bronze ●, silver ◆, gold ★, platinum ✦
Courses.MedalGlyphs = { "B", "S", "G", "P" }

Courses.Distinctions = {
	{ Id = "NoFall", Name = "Clean Run", Text = "Finished without a single fall or retry." },
	{ Id = "Shortcut", Name = "Pathfinder", Text = "Took the expert shortcut." },
	{ Id = "AllTokens", Name = "Collector", Text = "Collected every token in one run." },
	{ Id = "Flow", Name = "In the Flow", Text = "Kept a high flow score for the whole run." },
}

function Courses.Of(districtId: string, kind: string?): { Course }
	local result = {}
	for _, course in Courses.ByDistrict[districtId] or {} do
		if not kind or course.Kind == kind then
			table.insert(result, course)
		end
	end
	return result
end

return Courses
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Districts</string>
            <string name="Source"><![CDATA[-- The Guildhall hub and the six districts of Meridian.
--
-- Origins are world positions of each district's social plaza. Districts sit on
-- a ring around the hub, climbing higher the further the story goes, so every
-- district can see the next one glowing on the horizon.

export type Lighting = {
	Clock: { number }, -- time-of-day range the cycle moves through (hours)
	CycleMinutes: number,
	Brightness: number,
	Ambient: Color3,
	OutdoorAmbient: Color3,
	ShiftTop: Color3,
	ShiftBottom: Color3,
	Exposure: number,
	Atmosphere: { Density: number, Offset: number, Color: Color3, Decay: Color3, Glare: number, Haze: number },
	Bloom: { Intensity: number, Size: number, Threshold: number },
	Grade: { Brightness: number, Contrast: number, Saturation: number, Tint: Color3 },
	SunRays: number,
	Clouds: { Cover: number, Density: number, Color: Color3 },
	Night: Color3?,
}

export type District = {
	Id: string,
	Name: string,
	Short: string,
	Tagline: string,
	Lore: string,
	Traits: { string },
	Origin: Vector3,
	KillDepth: number,
	Level: number,
	Chapter: number, -- main story chapter that opens the district
	Order: number,
	Palette: { [string]: Color3 },
	Lighting: Lighting,
	Weather: { Kind: string, Chance: number },
	Music: { Root: number, Tempo: number, Mood: string },
	Ambience: string,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

