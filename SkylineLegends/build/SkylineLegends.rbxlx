		Tier = 2,
		Name = "Air Step",
		Text = "Double jump then dash in one chain.",
		Kind = "Chain",
		Actions = { "DoubleJump", "Dash" },
	},
	{
		Id = "ae3",
		Category = "Aerial",
		Tier = 3,
		Name = "Kick Dash",
		Text = "Wall jump, dash, then wall run in one chain.",
		Kind = "Chain",
		Actions = { "WallJump", "Dash", "WallRun" },
	},
	{
		Id = "ae4",
		Category = "Aerial",
		Tier = 4,
		Name = "No Ground Needed",
		Text = "Double jump, dash and grapple in one chain.",
		Kind = "Chain",
		Actions = { "DoubleJump", "Dash", "Grapple" },
	},
	{
		Id = "ae5",
		Category = "Aerial",
		Tier = 5,
		Name = "Aviator",
		Text = "Earn gold or better on 4 courses that focus on aerial moves.",
		Kind = "Medal",
		Focus = "Aerial",
		Medal = 3,
		Count = 4,
	},
	-- Traverse
	{
		Id = "tv1",
		Category = "Traverse",
		Tier = 1,
		Name = "Tightrope",
		Text = "Cross 8 balance beams.",
		Kind = "Count",
		Action = "Balance",
		Count = 8,
	},
	{
		Id = "tv2",
		Category = "Traverse",
		Tier = 2,
		Name = "Line Rider",
		Text = "Zipline straight into a rope swing in one chain.",
		Kind = "Chain",
		Actions = { "Zipline", "RopeSwing" },
	},
	{
		Id = "tv3",
		Category = "Traverse",
		Tier = 3,
		Name = "Steady Hands",
		Text = "Catch a beam after slipping 3 times.",
		Kind = "Count",
		Action = "BalanceCatch",
		Count = 3,
	},
	{
		Id = "tv4",
		Category = "Traverse",
		Tier = 4,
		Name = "Vine Line",
		Text = "Three rope swings in one chain.",
		Kind = "Chain",
		Actions = { "RopeSwing", "RopeSwing", "RopeSwing" },
	},
	{
		Id = "tv5",
		Category = "Traverse",
		Tier = 5,
		Name = "High Wire",
		Text = "Earn gold or better on 4 courses that focus on balance or lines.",
		Kind = "Medal",
		Focus = "Balance",
		Medal = 3,
		Count = 4,
	},
}

Mastery.Challenges = challenges
Mastery.ChallengeById = {} :: { [string]: Challenge }
Mastery.ChallengeFor = {} :: { [string]: { [number]: Challenge } }
for _, challenge in challenges do
	Mastery.ChallengeById[challenge.Id] = challenge
	local byTier = Mastery.ChallengeFor[challenge.Category]
	if not byTier then
		byTier = {}
		Mastery.ChallengeFor[challenge.Category] = byTier
	end
	byTier[challenge.Tier] = challenge
end

-- Current tier (0..5) given points and completed challenges.
function Mastery.TierOf(categoryId: string, points: number, completed: { [string]: boolean }): number
	local tier = 0
	for index, needed in Mastery.TierPoints do
		local challenge = Mastery.ChallengeFor[categoryId] and Mastery.ChallengeFor[categoryId][index]
		if points >= needed and (not challenge or completed[challenge.Id]) then
			tier = index
		else
			break
		end
	end
	return tier
end

-- Rewards for reaching each tier (cosmetics are granted by id).
Mastery.TierRewards = {
	[1] = { Credits = 150, XP = 250 },
	[2] = { Credits = 300, XP = 400 },
	[3] = { Credits = 500, XP = 600, Prestige = 1 },
	[4] = { Credits = 800, XP = 900, Prestige = 2 },
	[5] = { Credits = 1500, XP = 1500, Prestige = 3, Title = true },
}

return Mastery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[-- Standard movement attributes.
--
-- These are the exact values used in ranked runs, races and leaderboards. Skill
-- tree perks (Config/SkillTree) and practice assists modify a copy of this table
-- through Logic/MoveStats; nothing else should read or change it directly.
--
-- Units: studs, seconds. Root height above the floor is 3 studs (R6).

local Movement = {
	-- World -------------------------------------------------------------------
	Gravity = 180, -- workspace.Gravity (set by the server on start)
	FallGravityMultiplier = 1.3, -- extra gravity while falling: crisp, readable arcs
	MaxFallSpeed = 170,
	RootHeight = 3,

	-- Ground ------------------------------------------------------------------
	WalkSpeed = 18, -- default running pace
	SprintSpeed = 28,
	CrouchSpeed = 8,
	GroundAccel = 7.5, -- exponential rate toward target speed while speeding up
	GroundDecel = 4.5, -- rate while carrying extra momentum (landings, slides)
	IdleDecel = 16, -- rate when there's no input
	MaxSpeed = 72, -- hard cap on any horizontal speed
	SkidAngle = 115, -- degrees; reversing harder than this at speed skids
	SkidMinSpeed = 24,
	SkidKeep = 0.5,

	-- Jumping -----------------------------------------------------------------
	JumpVelocity = 54,
	JumpCutMultiplier = 0.55, -- let go of jump early for a short hop
	JumpCutWindow = 0.2,
	JumpBuffer = 0.12, -- a press this early still jumps on landing
	CoyoteTime = 0.1, -- you can still jump this long after leaving a ledge
	AirAccel = 34,
	AirTurnRate = 2.4, -- radians/second of steering above running speed
	AirBrake = 26,
	AirDrag = 0.05,
	DoubleJumpVelocity = 47,
	DoubleJumpRedirect = 0.45, -- how much a double jump can bend your direction (0..1)

	-- Landing -----------------------------------------------------------------
	RollWindow = 0.3, -- press crouch up to this long before touchdown
	RollLateWindow = 0.08, -- ...or this long after
	RollMinImpact = 40,
	RollDuration = 0.42,
	RollBoost = 1.04,
	SoftLandImpact = 50,
	HardLandImpact = 82,
	HeavyLandImpact = 125,
	SoftLandKeep = 0.9,
	StumbleTime = 0.42,
	HeavyStumbleTime = 0.8,
	StumbleSpeed = 6,
	PrecisionMaxWidth = 3.2, -- landing on anything this narrow counts as precise
	PrecisionMinAir = 0.45,

	-- Slide -------------------------------------------------------------------
	SlideMinSpeed = 15,
	SlideBoost = 7,
	SlideBoostCooldown = 1.2,
	SlideFriction = 11,
	SlideSlopeAccel = 0.75,
	SlideSteer = 1.6,
	SlideEndSpeed = 9,
	SlideJumpBoost = 1.06,
	SlideGrace = 0.18, -- airtime allowed before a slide becomes a fall

	-- Vault and mantle --------------------------------------------------------
	VaultMinHeight = 1.2,
	VaultMaxHeight = 4.6,
	VaultMaxDepth = 5.5,
	VaultReach = 3.2,
	VaultDuration = 0.3,
	VaultExitMin = 22,
	VaultExitBoost = 1.05,
	MantleDuration = 0.36,
	LowMantleDuration = 0.24,

	-- Ledges ------------------------------------------------------------------
	LedgeReach = 2.4,
	LedgeMinAbove = -0.8, -- ledge top relative to the root
	LedgeMaxAbove = 2.8,
	LedgeMaxRiseSpeed = 24,
	LedgeHangDrop = 2.6, -- root sits this far below the ledge top while hanging
	LedgeWallGap = 1.15,
	ShimmySpeed = 6.5,
	LedgeRegrabDelay = 0.35,
	LedgeLeapHeight = 7.5,
	LedgeJumpOut = 26,
	LedgeJumpUp = 44,

	-- Climbing ----------------------------------------------------------------
	ClimbUpSpeed = 9,
	ClimbSideSpeed = 7,
	ClimbDownSpeed = 13,
	ClimbHop = 6.5,
	ClimbReach = 2.3,

	-- Wall running ------------------------------------------------------------
	WallRunMinSpeed = 17,
	WallRunSpeed = 26,
	WallRunMaxTime = 1.45,
	WallRunStartLift = 11,
	WallRunGravity = 18, -- grows to WallRunGravityEnd over the run
	WallRunGravityEnd = 70,
	WallRunCheck = 2.6,
	WallRunMinHeight = 2.4,
	WallRunSameWallCooldown = 0.6,
	WallJumpOut = 27,
	WallJumpUp = 47,
	WallJumpKeep = 0.9,
	WallKickOut = 30,
	WallKickUp = 46,
	WallKickReach = 2.5,
	WallClimbSpeed = 30,
	WallClimbTime = 0.55,
	WallClimbGravity = 42,
	WallClimbMinSpeed = 8,
	WallCoyote = 0.14,

	-- Dash --------------------------------------------------------------------
	DashSpeed = 54,
	DashTime = 0.16,
	DashCooldown = 0.55,
	DashCharges = 1,
	DashLift = 6,

	-- Grapple -----------------------------------------------------------------
	GrappleRange = 90,
	GrappleCone = 42, -- degrees from the camera's view direction
	GrappleMinLength = 8,
	GrappleReel = 9,
	GrappleFastReel = 40,
	GrappleSwingAccel = 52,
	GrapplePull = 16,
	GrappleReleaseBoost = 1.08,
	GrappleReleasePop = 12,
	GrappleMaxSpeed = 95,
	GrappleCooldown = 0.35,
	PullSpeed = 78,
	PullPopUp = 42,
	PullPopForward = 24,

	-- Rope swings -------------------------------------------------------------
	RopeGrabRange = 3.4,
	RopeReleaseBoost = 1.1,
	RopeReleasePop = 20,
	RopeRegrab = 0.5,
	RopePump = 46,

	-- Ziplines ----------------------------------------------------------------
	ZipGrabRange = 3.8,
	ZipHang = 3.1,
	ZipMinSpeed = 18,
	ZipMaxSpeed = 64,
	ZipSlopeAccel = 0.75,
	ZipFlatSpeed = 26,
	ZipJumpUp = 34,
	ZipRegrab = 0.5,

	-- Balance -----------------------------------------------------------------
	BalanceSpeed = 12,
	BalanceSway = 1.25, -- how strongly the beam pushes you off balance
	BalanceCorrect = 3.4, -- how strongly steering corrects it
	BalanceDamping = 2.6,
	BalanceWind = 0.035,

	-- Stamina -----------------------------------------------------------------
	StaminaMax = 100,
	StaminaRegenGround = 34,
	StaminaRegenAir = 10,
	StaminaRegenDelay = 0.65,
	StaminaExhaustedUntil = 25, -- sprint is locked until stamina refills this far
	Costs = {
		Sprint = 5, -- per second
		WallRun = 16, -- per second
		Climb = 9, -- per second while moving
		ClimbIdle = 4,
		Hang = 5,
		DoubleJump = 15,
		Dash = 20,
		WallJump = 8,
		WallKick = 10,
		WallClimb = 12,
		Grapple = 8,
		Pull = 10,
		LedgeLeap = 12,
		ClimbHop = 10,
	},
}

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">NPCs</string>
            <string name="Source"><![CDATA[-- The people of Meridian who need a runner.
--
-- Spot names are placement points created by each district builder. Service
-- opens a menu page from the dialogue (shop, races, crews...).

export type NPC = {
	Id: string,
	Name: string,
	Role: string,
	District: string,
	Spot: string,
	Personality: string,
	Look: { Skin: Color3, Shirt: Color3, Pants: Color3, Hair: Color3, Hat: string? },
	Greeting: { string },
	Idle: { string },
	Service: string?,
	Pose: string?,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local SKIN = {
	rgb(255, 220, 190),
	rgb(234, 184, 146),
	rgb(198, 134, 98),
	rgb(141, 85, 56),
	rgb(96, 60, 40),
}

local list: { NPC } = {
	-- Guildhall -------------------------------------------------------------------
	{
		Id = "orla",
		Name = "Guildmaster Orla Vance",
		Role = "Head of the Runners' Guild",
		District = "Hub",
		Spot = "hub_orla",
		Personality = "Stern, warm underneath, ran the city's last delivery before the Severance.",
		Look = {
			Skin = SKIN[3],
			Shirt = rgb(196, 66, 58),
			Pants = rgb(40, 40, 46),
			Hair = rgb(200, 200, 205),
			Hat = "Bun",
		},
		Greeting = {
			"Runner. Good. The city doesn't wait, and neither do I.",
			"Every line you restore is one more family that can be reached.",
		},
		Idle = {
			"The board has work. Check your journal.",
			"I ran these roofs when the lifts still worked. They were never this interesting.",
		},
		Pose = "Arms",
	},
	{
		Id = "tam",
		Name = "Coach Tam Reyes",
		Role = "Training Coach",
		District = "Hub",
		Spot = "hub_tam",
		Personality = "Boundless energy, celebrates every small win, counts everything.",
		Look = {
			Skin = SKIN[2],
			Shirt = rgb(255, 196, 92),
			Pants = rgb(70, 110, 140),
			Hair = rgb(40, 30, 25),
			Hat = "Cap",
		},
		Greeting = { "Hey hey! Ready to move?", "Feet first, eyes up, momentum always!" },
		Idle = {
			"The Training Yard is always open. Run the lessons again any time.",
			"Unlocked something new? The advanced stations by the fountain will teach it.",
			"Mastery's not about doing a move a thousand times. It's about doing it when it counts.",
		},
		Service = "Mastery",
		Pose = "Bounce",
	},
	{
		Id = "bix",
		Name = "Quartermaster Bix",
		Role = "Guild Outfitter",
		District = "Hub",
		Spot = "hub_bix",
		Personality = "Gruff, practical, secretly a fashion obsessive.",
		Look = {
			Skin = SKIN[4],
			Shirt = rgb(150, 105, 70),
			Pants = rgb(60, 50, 40),
			Hair = rgb(30, 25, 20),
			Hat = "Beanie",
		},
		Greeting = {
			"Credits on the counter, runner.",
			"Nothing here makes you faster. Everything here makes you look faster.",
		},
		Idle = { "Prestige tokens buy the good stuff. You earn those, you don't find them." },
		Service = "Shop",
	},
	{
		Id = "dex",
		Name = "Marshal Dex",
		Role = "Race Marshal",
		District = "Hub",
		Spot = "hub_dex",
		Personality = "Competitive, loves numbers, quotes split times like poetry.",
		Look = {
			Skin = SKIN[1],
			Shirt = rgb(40, 44, 52),
			Pants = rgb(240, 240, 240),
			Hair = rgb(230, 120, 60),
			Hat = "Visor",
		},
		Greeting = {
			"Racing today? Ranked boards use standard gear, so it's all you.",
			"Point-four-two seconds. That's what separates legends from regulars.",
		},
		Idle = { "Open a lobby at the race board, or join one. Ghost races are always open." },
		Service = "Races",
	},
	{
		Id = "nell",
		Name = "Archivist Nell",
		Role = "Keeper of the Journal",
		District = "Hub",
		Spot = "hub_nell",
		Personality = "Quiet, precise, collects every scrap of the city's history.",
		Look = {
			Skin = SKIN[2],
			Shirt = rgb(90, 80, 120),
			Pants = rgb(50, 45, 60),
			Hair = rgb(120, 70, 40),
			Hat = "Glasses",
		},
		Greeting = { "Ah. Bring me letters, if you find them.", "The journal remembers every route you've run." },
		Idle = { "Lost letters are scattered across every district. Each one is a voice from before the Severance." },
		Service = "Achievements",
	},
	{
		Id = "juno",
		Name = "Juno Park",
		Role = "Crew Coordinator",
		District = "Hub",
		Spot = "hub_juno",
		Personality = "Sociable, organised, knows everybody's name.",
