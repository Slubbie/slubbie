		Kind = "Feat",
		Action = "GrappleRelease",
		Value = 70,
	},
	{
		Id = "gr4",
		Category = "Grappling",
		Tier = 4,
		Name = "Push and Pull",
		Text = "Grapple swing, pull anchor, then grapple swing in one chain.",
		Kind = "Chain",
		Actions = { "Grapple", "Pull", "Grapple" },
	},
	{
		Id = "gr5",
		Category = "Grappling",
		Tier = 5,
		Name = "Spider",
		Text = "Earn gold or better on 4 courses that focus on grappling.",
		Kind = "Medal",
		Focus = "Grapple",
		Medal = 3,
		Count = 4,
	},
	-- Chains
	{
		Id = "fc1",
		Category = "FlowChains",
		Tier = 1,
		Name = "Linked Up",
		Text = "Perform a chain of 6 moves.",
		Kind = "ChainLength",
		Count = 6,
	},
	{
		Id = "fc2",
		Category = "FlowChains",
		Tier = 2,
		Name = "Mixed Bag",
		Text = "Use 5 different techniques in one chain.",
		Kind = "ChainVariety",
		Count = 5,
	},
	{
		Id = "fc3",
		Category = "FlowChains",
		Tier = 3,
		Name = "Momentum",
		Text = "Perform a chain of 18 moves.",
		Kind = "ChainLength",
		Count = 18,
	},
	{
		Id = "fc4",
		Category = "FlowChains",
		Tier = 4,
		Name = "Repertoire",
		Text = "Use 8 different techniques in one chain.",
		Kind = "ChainVariety",
		Count = 8,
	},
	{
		Id = "fc5",
		Category = "FlowChains",
		Tier = 5,
