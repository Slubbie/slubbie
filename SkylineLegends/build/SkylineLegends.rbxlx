			Accent = rgb(255, 210, 110),
			Signal = rgb(180, 140, 255),
			Glow = rgb(200, 170, 255),
		},
		Lighting = {
			Clock = { 17.6, 18.6 },
			CycleMinutes = 30,
			Brightness = 2.3,
			Ambient = rgb(120, 100, 140),
			OutdoorAmbient = rgb(160, 130, 180),
			ShiftTop = rgb(255, 200, 220),
			ShiftBottom = rgb(120, 100, 190),
			Exposure = 0.2,
			Atmosphere = {
				Density = 0.32,
				Offset = 0.05,
				Color = rgb(230, 190, 220),
				Decay = rgb(140, 100, 190),
				Glare = 0.8,
				Haze = 1.4,
			},
			Bloom = { Intensity = 0.75, Size = 30, Threshold = 1.4 },
			Grade = { Brightness = 0.02, Contrast = 0.1, Saturation = 0.2, Tint = rgb(255, 244, 255) },
			SunRays = 0.18,
			Clouds = { Cover = 0.5, Density = 0.45, Color = rgb(255, 220, 240) },
		},
		Weather = { Kind = "Motes", Chance = 1 },
		Music = { Root = 11, Tempo = 100, Mood = "Epic" },
		Ambience = "Aether",
	},
}

local Districts = {}
Districts.List = list
Districts.ById = {} :: { [string]: District }
for _, district in list do
	Districts.ById[district.Id] = district
end

-- Districts in travel/story order, excluding the hub.
function Districts.Ordered(): { District }
	local result = {}
	for _, district in list do
		if district.Id ~= "Hub" then
			table.insert(result, district)
		end
	end
	table.sort(result, function(a, b)
		return a.Order < b.Order
	end)
	return result
end

-- Which district a world position belongs to (nearest plaza within range).
function Districts.At(position: Vector3): District?
	local best, bestDistance = nil, 900
	for _, district in list do
		local offset = position - district.Origin
		local flat = Vector3.new(offset.X, 0, offset.Z).Magnitude
		if flat < bestDistance and offset.Y > -district.KillDepth - 60 and offset.Y < 900 then
			best, bestDistance = district, flat
		end
	end
	return best
end

-- Special mode areas far from the districts.
Districts.Dreamline = Vector3.new(0, 1700, 3800) -- endless mode lanes
Districts.SpireOffset = Vector3.new(0, 0, -250) -- challenge tower, relative to the hub

return Districts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Flow</string>
            <string name="Source"><![CDATA[-- The flow system: rewards varied, well-executed, connected movement.
--
-- Each technique adds points. Repeating the same move in a short window is
-- worth less (variety), linking a move quickly after the last one is worth
-- more (clean transition), and controlled landings keep the chain alive while
-- stumbles and falls break it. Flow drains when you stop moving with purpose.
--
-- In free exploration the meter is a quiet visual; in course runs the points
-- earned become the run's flow score (for the "In the Flow" distinction,
-- score challenges and cosmetic milestones).

local Flow = {
	Points = {
		Jump = 2,
		Vault = 14,
		Slide = 6,
		SlideJump = 10,
		Mantle = 8,
		LedgeGrab = 6,
		LedgeLeap = 14,
		ClimbHop = 6,
		WallRun = 16,
		WallJump = 18,
		WallKick = 12,
		WallClimb = 12,
		DoubleJump = 9,
		Dash = 10,
		Grapple = 16,
		GrappleRelease = 8,
		Pull = 14,
		RopeSwing = 14,
		Zipline = 10,
		Balance = 8,
		BalanceCatch = 6,
		Roll = 18,
		PrecisionLand = 16,
		Bounce = 8,
		Launch = 8,
		Land = 3,
	},
	-- Moves that sustain flow while you're doing them (points per second).
	Sustain = { WallRun = 10, Climb = 3, Balance = 5, Zipline = 6, Swing = 7, Slide = 4 },
	-- The same move this many times among your last N moves loses value.
	VarietyWindow = 5,
	VarietyFalloff = { 1, 0.6, 0.35, 0.2, 0.1 },
	-- A move this soon after the previous one counts as a clean transition.
	TransitionWindow = 0.7,
	TransitionBonus = 0.35,
	-- Speed that counts as "moving with purpose".
	MomentumSpeed = 20,
	IdleGrace = 1.4, -- seconds before the meter starts draining
	DrainPerSecond = 90,
	MeterMax = 1000,
	-- Meter thresholds for each tier, with names and score multipliers.
	Tiers = {
		{ Name = "Rhythm", Threshold = 80, Multiplier = 1.1 },
		{ Name = "Flow", Threshold = 250, Multiplier = 1.25 },
		{ Name = "Surge", Threshold = 480, Multiplier = 1.5 },
		{ Name = "Seamless", Threshold = 720, Multiplier = 1.8 },
		{ Name = "Legendary", Threshold = 920, Multiplier = 2.2 },
	},
	-- Course runs: the "In the Flow" distinction needs this fraction of the
	-- course's flow target (set per course from its length and techniques).
	DistinctionFraction = 1,
	-- Chain bookkeeping shared with the server: a chain breaks after this long
	-- without a move, or on any breaker action.
	ChainGap = 1.8,
	ChainBreakers = { Stumble = true, Fall = true, Respawn = true },
}

function Flow.TierFor(meter: number): number
	local tier = 0
	for index, info in Flow.Tiers do
		if meter >= info.Threshold then
			tier = index
		end
	end
	return tier
end

return Flow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Lessons</string>
            <string name="Source"><![CDATA[-- Interactive lessons in the Guildhall Training Yard.
--
-- Each lesson is a small station: step onto its pad and a card shows the
-- technique, its input for your device, and two steps: perform the move, then
-- combine it with something you already know. Advanced stations unlock with
-- their ability.

export type LessonStep = { Text: string, Action: string?, Chain: { string }?, Count: number? }
export type Lesson = {
	Id: string,
	Name: string,
	Ability: string?,
	Advanced: boolean?,
	Input: string, -- input action name shown with your device's glyph
	Steps: { LessonStep },
	Layout: string, -- station geometry built by the Hub builder
}

local Lessons: { Lesson } = {
	{
		Id = "l_sprint",
		Name = "Run and Jump",
		Input = "Jump",
		Layout = "Gaps",
		Steps = {
			{ Text = "Hold Sprint and jump across the gap.", Action = "Jump" },
			{
				Text = "Jump just before you land to jump again instantly. Clear all three gaps.",
				Action = "Jump",
				Count = 3,
			},
		},
	},
	{
		Id = "l_vault",
		Name = "Vault",
		Ability = "Vault",
		Input = "Jump",
		Layout = "Vaults",
		Steps = {
			{ Text = "Run at the low wall and press Jump to vault it.", Action = "Vault" },
			{ Text = "Vault both walls without slowing down.", Action = "Vault", Count = 2 },
		},
	},
	{
		Id = "l_slide",
		Name = "Slide",
		Ability = "Slide",
		Input = "Crouch",
		Layout = "Slides",
		Steps = {
			{ Text = "Sprint, then press Crouch to slide under the striped beam.", Action = "Slide" },
			{ Text = "Slide, then jump out of the slide to keep its speed.", Chain = { "Slide", "SlideJump" } },
		},
	},
	{
		Id = "l_ledge",
		Name = "Ledge Grab and Mantle",
		Ability = "LedgeGrab",
		Input = "Jump",
		Layout = "Ledges",
		Steps = {
			{ Text = "Jump at the high ledge to catch it.", Action = "LedgeGrab" },
			{ Text = "Push forward to mantle up. Shimmy sideways along the rail if you like.", Action = "Mantle" },
		},
	},
	{
		Id = "l_climb",
		Name = "Climb",
		Ability = "Climb",
		Input = "Jump",
		Layout = "Climb",
		Steps = {
			{ Text = "Walk into the ladder to start climbing. Climb to the top.", Action = "Climb" },
			{ Text = "Press Jump while climbing to hop up faster.", Action = "ClimbHop" },
		},
	},
	{
		Id = "l_wallrun",
		Name = "Wall Run",
		Ability = "WallRun",
		Input = "Jump",
		Layout = "WallRun",
		Steps = {
			{
				Text = "Sprint and jump toward the chevron wall at a shallow angle to run along it.",
				Action = "WallRun",
			},
			{ Text = "Press Jump during the run to leap off and reach the far platform.", Action = "WallJump" },
		},
	},
	{
		Id = "l_walljump",
		Name = "Wall Kick",
		Ability = "WallJump",
		Input = "Jump",
		Layout = "Shaft",
		Steps = {
			{ Text = "Jump into the shaft, then press Jump beside a wall to kick off it.", Action = "WallKick" },
			{ Text = "Kick between both walls to reach the top.", Action = "WallKick", Count = 3 },
		},
	},
	{
		Id = "l_balance",
		Name = "Balance",
		Ability = "Balance",
		Input = "Move",
		Layout = "Beam",
		Steps = {
			{ Text = "Walk onto the beam. Steer against the sway shown under you.", Action = "Balance" },
			{
				Text = "If you slip, you'll catch the beam. Climb back up and finish the crossing.",
				Action = "Balance",
				Count = 2,
			},
		},
	},
	{
		Id = "l_roll",
		Name = "Landing Roll",
		Ability = "Roll",
		Input = "Crouch",
		Layout = "Drop",
		Steps = {
			{ Text = "Drop from the tower and press Crouch just before you land to roll.", Action = "Roll" },
			{ Text = "Roll, then keep sprinting. A clean roll keeps all your speed.", Chain = { "Roll", "Jump" } },
		},
	},
	{
		Id = "l_zip",
		Name = "Ziplines and Ropes",
		Ability = "Zipline",
		Input = "Jump",
		Layout = "Lines",
		Steps = {
			{ Text = "Jump into the cable to ride the zipline.", Action = "Zipline" },
			{
				Text = "Jump off the line into the rope swing, then jump to release.",
				Chain = { "Zipline", "RopeSwing" },
			},
		},
	},
	-- Advanced stations
	{
		Id = "l_double",
		Name = "Double Jump",
		Ability = "DoubleJump",
		Advanced = true,
		Input = "Jump",
		Layout = "Gaps",
		Steps = {
			{ Text = "Jump, then jump again in mid-air to cross the wide gap.", Action = "DoubleJump" },
			{ Text = "Wall run, then double jump off the end of the wall.", Chain = { "WallRun", "DoubleJump" } },
		},
	},
	{
		Id = "l_dash",
		Name = "Directional Dash",
		Ability = "Dash",
		Advanced = true,
		Input = "Dash",
		Layout = "Gaps",
		Steps = {
			{ Text = "Jump, then Dash toward the far platform.", Action = "Dash" },
			{ Text = "Double jump, then dash: the longest jump you can make.", Chain = { "DoubleJump", "Dash" } },
		},
	},
	{
		Id = "l_grapple",
		Name = "Grapple Swing",
		Ability = "Grapple",
		Advanced = true,
		Input = "Grapple",
		Layout = "Anchors",
		Steps = {
			{ Text = "Look toward the ring anchor and press Grapple to swing.", Action = "Grapple" },
			{ Text = "Release at the bottom of the swing, then grapple the next ring.", Action = "Grapple", Count = 2 },
		},
	},
	{
		Id = "l_pull",
		Name = "Grapple Pull",
		Ability = "GrapplePull",
		Advanced = true,
		Input = "Grapple",
		Layout = "Pull",
		Steps = {
			{ Text = "Grapple the diamond anchor to be pulled straight up to it.", Action = "Pull" },
			{ Text = "Pull, then wall run off the far tower.", Chain = { "Pull", "WallRun" } },
		},
	},
	{
		Id = "l_leap",
		Name = "Ledge Leap",
		Ability = "LedgeLeap",
		Advanced = true,
		Input = "Jump",
		Layout = "Stacked",
		Steps = {
			{
				Text = "Hang from the ledge and press Jump with forward held to leap to the one above.",
				Action = "LedgeLeap",
			},
			{ Text = "Leap up two ledges in a row.", Chain = { "LedgeLeap", "LedgeLeap" } },
		},
	},
}

local Module = {}
Module.List = Lessons
Module.ById = {} :: { [string]: Lesson }
for _, lesson in Lessons do
	Module.ById[lesson.Id] = lesson
end

function Module.BasicCount(): number
	local count = 0
	for _, lesson in Lessons do
		if not lesson.Advanced then
			count += 1
		end
	end
	return count
end

return Module
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Lore</string>
            <string name="Source"><![CDATA[-- Lost letters: undelivered post from before the Severance, scattered across
-- every district. Each one is a small piece of the story of how Meridian
-- came apart and who kept it going.

local Lore = {}

Lore.Letters = {
	Hub = {
		{
			Title = "Guild Roster, Final Page",
			Text = "Runners on duty the night of the Severance: Vance, Okonjo, Marrow, Reyes. Marrow took the Citadel line. Marrow did not return.",
		},
		{
			Title = "A Recruit's Note",
			Text = "Coach says I land like a sack of bricks. Coach is right. Practising rolls until the yard lamps go out.",
		},
		{
			Title = "Requisition Slip",
			Text = "Twelve grip tapes, four ropes, one replacement window (sorry, Bix).",
		},
	},
	Tinroof = {
		{
			Title = "To Whoever Finds the Pigeons",
			Text = "They always come home eventually. So do runners. Leave the loft door open. - M.",
		},
		{
			Title = "Okafor Building Notice",
			Text = "NO RUNNING ON THE WASHING LINES. (This means you, Guild.)",
		},
		{
			Title = "Seed Catalogue Order",
			Text = "Tomatoes, beans, marigolds for the bees. Deliver to the roof. The lifts are out again, so the roof is the only way.",
		},
		{
			Title = "Meet Me at the Bell",
			Text = "Six o'clock, on top of the Old Bell. If the lifts are down I'll climb. I always climb for you.",
		},
		{
			Title = "Lift Maintenance Log",
			Text = "Tinroof lift 4: cable snapped at 21:42. Lifts 1 to 3 dead by 21:50. Skyway power gone. Something happened up top.",
		},
	},
	Ironworks = {
		{
			Title = "Shift Report",
			Text = "Crane 7 drifting on its own again. Timer circuits from before my grandfather. Don't fight them, Brak. Learn them.",
		},
		{
			Title = "Skyway Cable Spec",
			Text = "Load rating 400 tonnes. Rated against everything but being cut on purpose.",
		},
		{
			Title = "Apprentice's Doodle",
			Text = "A drawing of a girl in goggles jumping between cranes. 'SADIE THE GREAT' is written underneath in big letters.",
		},
		{
			Title = "Order from the Citadel",
			Text = "Urgent: twelve keel stabiliser rings, delivery by Guild runner. Do not delay. Signed, Skywright Council.",
		},
		{
			Title = "Scrap Price List",
			Text = "Gears: 2 credits. Pistons: 5. Anything from the Citadel line: name your price.",
		},
	},
	Verdant = {
		{
			Title = "Observatory Night Log",
			Text = "21:41: Keel light flickering. 21:44: Citadel lights steady, but every skyway beacon goes dark at once. It wasn't an accident. They were switched off.",
		},
		{
			Title = "Pressed Flower",
			Text = "A flattened blue flower in an envelope. 'From the highest garden in the world. Wish you were here.'",
		},
		{
			Title = "Ranger Handbook, p. 12",
			Text = "The terraces rest on roots and old mortar. Never stand still on cracked stone. Keep moving and it'll hold long enough.",
		},
		{
			Title = "Moss's Letter (Unsent)",
			Text = "I strung the vines so the children could still visit the observatory. Nobody comes. I'll string more anyway.",
		},
		{
			Title = "Dam Inspection",
			Text = "Atrium dam: hairline fractures, worsening. If it goes, the lower garden floods in minutes. Climb fast.",
		},
	},
	Gilded = {
		{
			Title = "Trading Halted",
			Text = "All markets suspended pending restoration of skyway access. Estimated: 48 hours. (This notice is ten years old.)",
		},
		{
			Title = "Courier Leaderboard Printout",
			Text = "Express Lane record: VEX. Second place: also VEX, on a bad day.",
		},
		{
			Title = "Maintenance Ticket #4,112",
			Text = "Hologram projector 9 displaying unauthorised content (cat videos). Priority: low. Assigned: LUMEN.",
		},
		{
			Title = "Encrypted Packet",
			Text = "Decoded: 'KEEL STABLE. REPEAT. KEEL STABLE. REQUEST RECONNECTION.' Logged and ignored for 3,640 days.",
		},
		{
			Title = "Security Memo",
			Text = "Laser grid patterns are fixed and predictable. Please stop telling the couriers that.",
		},
	},
	Frostreach = {
		{
			Title = "Bram's Log, Year 1",
			Text = "Lit the lamp tonight. Pointed it at the Citadel. No answer. Will try again tomorrow.",
		},
		{
			Title = "Bram's Log, Year 20",
			Text = "Lit the lamp tonight. Still no answer. Still trying.",
		},
		{
			Title = "Bridge Toll Receipt",
			Text = "One crossing, Hollowpeak to Citadel lift station. Paid in full. Return trip: pending.",
		},
		{
			Title = "Kesh's Route Notes",
			Text = "Ridge gusts come every eight seconds. The snow streams warn you a heartbeat before. Jump with the wind, never against it.",
		},
		{
			Title = "Sigrun's Prayer Card",
			Text = "May the mountain let you climb. May the ice let you stop. May the bridge hold one more time.",
		},
	},
	Citadel = {
		{
			Title = "Skywright Council Minutes",
			Text = "The Keel is failing. If it falls, it falls on Meridian. Motion: sever the skyways and seal the Citadel until it's stable. Carried, unanimously.",
		},
		{
			Title = "A Skywright's Goodbye",
			Text = "Tell my brother in Tinroof I'm sorry I missed six o'clock at the Bell.",
		},
		{
			Title = "Keel Stability Report",
			Text = "Day 412: stable. Day 413: stable. Day 3,650: stable. Nobody left to read this.",
		},
		{
			Title = "Ilse's Map Margin",
			Text = "Gravity bends toward the Keel. Jump away from it and you float. Jump toward it and you fly.",
		},
		{
			Title = "The Warden's Orders",
			Text = "GUARD THE KEEL. ADMIT ONLY THOSE WHO MOVE AS SKYWRIGHTS MOVE. AWAIT RECONNECTION.",
		},
	},
}

return Lore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Mastery</string>
            <string name="Source"><![CDATA[-- Movement mastery: eight technique categories, each with five tiers.
--
-- A tier needs BOTH enough mastery points (earned by using the techniques in
-- validated play) AND its proficiency challenge, which proves real control
-- rather than repetition. Points per action are capped per minute so they
-- can't be farmed by spamming one move.
--
-- Challenge kinds (checked by MasteryService on the server):
--   Count         perform Action N times (lifetime)
--   Chain         perform Actions in order inside one unbroken movement chain
--   ChainLength   a chain of at least Count moves
--   ChainVariety  a chain with at least Count different techniques
--   Feat          one action whose reported Value reaches Value (e.g. wall-run seconds)
--   Streak        Count of Action in a row without any Breaks action in between
--   Medal         Medal (1-4) or better on Count courses whose Focus includes Focus

export type Challenge = {
	Id: string,
	Category: string,
	Tier: number,
	Name: string,
	Text: string,
	Kind: string,
	Action: string?,
	Actions: { string }?,
	Breaks: { string }?,
	Count: number?,
	Value: number?,
	Focus: string?,
	Medal: number?,
}

local Mastery = {}

Mastery.TierNames = { "Novice", "Adept", "Expert", "Master", "Grandmaster" }
Mastery.TierPoints = { 150, 600, 1500, 3200, 6000 }

Mastery.Categories = {
	{
		Id = "WallRunning",
		Name = "Wall Running",
		Icon = "//",
		Color = Color3.fromRGB(110, 190, 255),
		Blurb = "Runs, kicks and climbs along vertical surfaces.",
		Actions = { WallRun = 6, WallJump = 5, WallKick = 4, WallClimb = 4 },
	},
	{
		Id = "PrecisionLanding",
		Name = "Precision Landing",
		Icon = "+",
		Color = Color3.fromRGB(255, 210, 100),
		Blurb = "Sticking narrow landings and rolling out of big drops.",
		Actions = { PrecisionLand = 8, Roll = 6 },
	},
	{
		Id = "Grappling",
		Name = "Grappling",
		Icon = "(o)",
		Color = Color3.fromRGB(80, 230, 220),
		Blurb = "Swings, pulls and well-timed releases.",
		Actions = { Grapple = 6, GrappleRelease = 3, Pull = 6 },
	},
	{
		Id = "FlowChains",
		Name = "Movement Chains",
		Icon = "~>",
		Color = Color3.fromRGB(240, 120, 220),
		Blurb = "Long, varied chains of techniques without stopping.",
		Actions = { ChainBonus = 1 },
	},
	{
		Id = "Groundwork",
		Name = "Groundwork",
		Icon = "^_",
		Color = Color3.fromRGB(140, 230, 120),
		Blurb = "Vaults, slides and keeping speed through clutter.",
		Actions = { Vault = 5, Slide = 3, SlideJump = 4 },
	},
	{
		Id = "Climbing",
		Name = "Climbing",
		Icon = "#",
		Color = Color3.fromRGB(230, 160, 100),
		Blurb = "Ledges, mantles, climbs and leaps.",
		Actions = { LedgeGrab = 4, Mantle = 3, Climb = 3, LedgeLeap = 6, ClimbHop = 3 },
	},
	{
		Id = "Aerial",
		Name = "Aerial",
		Icon = "^^",
		Color = Color3.fromRGB(170, 150, 255),
		Blurb = "Double jumps and dashes that land where you meant.",
		Actions = { DoubleJump = 4, Dash = 5 },
	},
	{
		Id = "Traverse",
		Name = "Traverse",
		Icon = "=~",
		Color = Color3.fromRGB(200, 220, 230),
		Blurb = "Beams, ziplines and rope swings.",
		Actions = { Balance = 4, BalanceCatch = 5, Zipline = 4, RopeSwing = 5 },
	},
}

Mastery.ById = {}
for _, category in Mastery.Categories do
	Mastery.ById[category.Id] = category
end

-- Most points a single action type can award per minute.
Mastery.PointsPerMinuteCap = 120

local challenges: { Challenge } = {
	-- Wall running
	{
		Id = "wr1",
		Category = "WallRunning",
		Tier = 1,
		Name = "Wall Walker",
		Text = "Wall run 10 times.",
		Kind = "Count",
		Action = "WallRun",
		Count = 10,
	},
	{
		Id = "wr2",
		Category = "WallRunning",
		Tier = 2,
		Name = "Tic-Tac",
		Text = "Wall run, wall jump, then wall run again in one chain.",
		Kind = "Chain",
		Actions = { "WallRun", "WallJump", "WallRun" },
	},
	{
		Id = "wr3",
		Category = "WallRunning",
		Tier = 3,
		Name = "Long Stride",
		Text = "Hold a single wall run for 1.3 seconds.",
		Kind = "Feat",
		Action = "WallRun",
		Value = 1.3,
	},
	{
		Id = "wr4",
		Category = "WallRunning",
		Tier = 4,
		Name = "Corridor King",
		Text = "Four wall runs in one chain.",
		Kind = "Chain",
		Actions = { "WallRun", "WallRun", "WallRun", "WallRun" },
	},
	{
		Id = "wr5",
		Category = "WallRunning",
		Tier = 5,
