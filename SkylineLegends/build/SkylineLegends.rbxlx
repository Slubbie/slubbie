	{
		Id = "okafor",
		Name = "Mrs. Okafor",
		Role = "Terrace Landlady",
		District = "Tinroof",
		Spot = "tin_okafor",
		Personality = "Formidable, generous, owns half of Tinroof and all of its washing lines.",
		Look = {
			Skin = SKIN[5],
			Shirt = rgb(90, 160, 210),
			Pants = rgb(232, 214, 186),
			Hair = rgb(20, 20, 20),
			Hat = "Wrap",
		},
		Greeting = {
			"Welcome to the Terraces. Wipe your feet before you run on my roofs.",
			"The Guild sent you? About time.",
		},
		Idle = { "Those lines are for laundry. Mostly." },
	},

	-- Ironworks -------------------------------------------------------------------------
	{
		Id = "sadie",
		Name = "Engineer Sadie Kowalski",
		Role = "Chief Engineer",
		District = "Ironworks",
		Spot = "iron_sadie",
		Personality = "Dry, brilliant, talks to machines more than people.",
		Look = {
			Skin = SKIN[1],
			Shirt = rgb(240, 180, 40),
			Pants = rgb(58, 60, 66),
			Hair = rgb(150, 70, 40),
			Hat = "Goggles",
