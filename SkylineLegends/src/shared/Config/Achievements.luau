-- The achievement journal. Each entry tracks one statistic (see Logic/Stats for
-- the full list, including derived ones like "Gold" = courses at gold or better)
-- and pays out when it reaches its target. Hidden entries show as "???" until
-- earned.

export type Achievement = {
	Id: string,
	Category: string,
	Name: string,
	Text: string,
	Stat: string,
	Target: number,
	Hidden: boolean?,
	Credits: number?,
	Prestige: number?,
	XP: number?,
	Item: string?,
}

