Achievements.List = list
Achievements.ById = {} :: { [string]: Achievement }
for _, achievement in list do
	Achievements.ById[achievement.Id] = achievement
end

-- "Every course" always means every course and room that exists.
do
	local Courses = require(script.Parent.Courses)
	local count = 0
	for _, course in Courses.List do
		if course.Kind == "Course" or course.Kind == "Room" then
			count += 1
		end
	end
	Achievements.ById.courses_all.Target = count

	local Lore = require(script.Parent.Lore)
	local letters = 0
	for _, districtLetters in Lore.Letters do
		letters += #districtLetters
	end
	Achievements.ById.letters_all.Target = letters
end

return Achievements
