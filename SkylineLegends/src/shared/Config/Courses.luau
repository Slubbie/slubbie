-- Every course, challenge room and relay route, as segment recipes.
--
-- World/CourseBuilder turns each recipe into geometry. Distances are not
-- hard-coded: a { "Gap", 0.6 } is 60% of the longest gap the standard movement
-- attributes can clear (Logic/Reach), so every route stays physically
-- achievable even if movement tuning changes. Medal times are derived from each
-- route's par time unless a course lists Medals = { bronze, silver, gold, platinum }.
--
-- Segment vocabulary (see World/Obstacles for exact geometry):
--   Run L            Gap F Rise=dy     Steps N Rise=dy   Drop H        Vault N
--   Slide N          Tunnel L          Ledge H           WallClimb H   Shimmy L
--   Climb H Type=    WallRun T Side=   TicTac N          Shaft H       Balance L
--   Zip L Drop=      Rope N            Grapple N         Pull H        DoubleGap F
--   DashGap F        Bounce H          Vent H            Movers N Mode= Collapse L
--   Retract L        Spinner Mode=     Doors N           Switch        Lasers N Pattern=
--   Water Rate=      Conveyor L Dir=   Wind L            Ice L Slope=  LowGrav L
--   Current H        Holo N            Turn Deg          CP            Split A= F= E=
--   Finish
--
-- Split lanes: A = accessible (learn it), F = fast (confident execution),
-- E = expert (precision, demanding transitions, usually an expert shortcut).

export type Course = {
	Id: string,
	District: string,
	Kind: string?, -- "Course" (default) | "Room" | "Relay"
	Name: string,
	Blurb: string,
	Difficulty: number,
	Focus: { string },
	Segments: { any },
	Medals: { number }?,
	Legs: number?,
	Y: number?,
	Spoke: number?,
	Width: number?,
	Order: number?,
}

