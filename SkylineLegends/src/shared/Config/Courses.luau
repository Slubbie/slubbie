local Courses = {}
Courses.List = C
Courses.ById = {} :: { [string]: Course }
Courses.ByDistrict = {} :: { [string]: { Course } }

for index, course in C do
	course.Kind = course.Kind or "Course"
	course.Order = index
	Courses.ById[course.Id] = course
	local list = Courses.ByDistrict[course.District]
	if not list then
		list = {}
		Courses.ByDistrict[course.District] = list
	end
	table.insert(list, course)
end

Courses.DifficultyNames = {
	"Gentle",
	"Easy",
	"Steady",
	"Moderate",
	"Tricky",
	"Demanding",
	"Hard",
	"Severe",
	"Expert",
	"Legendary",
}

Courses.MedalNames = { "Bronze", "Silver", "Gold", "Platinum" }
Courses.MedalColors = {
	Color3.fromRGB(205, 127, 70),
	Color3.fromRGB(200, 210, 220),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(150, 235, 255),
}
-- Shapes so medals read without colour: bronze ●, silver ◆, gold ★, platinum ✦
Courses.MedalGlyphs = { "B", "S", "G", "P" }

Courses.Distinctions = {
	{ Id = "NoFall", Name = "Clean Run", Text = "Finished without a single fall or retry." },
	{ Id = "Shortcut", Name = "Pathfinder", Text = "Took the expert shortcut." },
	{ Id = "AllTokens", Name = "Collector", Text = "Collected every token in one run." },
	{ Id = "Flow", Name = "In the Flow", Text = "Kept a high flow score for the whole run." },
}

function Courses.Of(districtId: string, kind: string?): { Course }
	local result = {}
	for _, course in Courses.ByDistrict[districtId] or {} do
		if not kind or course.Kind == kind then
			table.insert(result, course)
		end
	end
	return result
end

return Courses
