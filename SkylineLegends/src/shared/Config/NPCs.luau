-- The people of Meridian who need a runner.
--
-- Spot names are placement points created by each district builder. Service
-- opens a menu page from the dialogue (shop, races, crews...).

export type NPC = {
	Id: string,
	Name: string,
	Role: string,
	District: string,
	Spot: string,
	Personality: string,
	Look: { Skin: Color3, Shirt: Color3, Pants: Color3, Hair: Color3, Hat: string? },
	Greeting: { string },
	Idle: { string },
	Service: string?,
	Pose: string?,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

