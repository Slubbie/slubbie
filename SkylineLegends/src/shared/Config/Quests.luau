-- The quest catalogue: the main story, district side quests, expert trials,
-- plus templates for daily objectives, weekly expeditions and contracts.
--
-- Every quest tells the player where to begin (Start), what success requires
-- (each step's Text) and what they'll receive (Rewards), before they accept.
--
-- Step kinds (checked by Services/QuestService from validated events):
--   Talk      Npc                      speak to someone (Say = their lines)
--   Reach     Point                    get to a place
--   Collect   Points                   pick up every item (shown only while active)
--   Activate  Points                   switch on relays/terminals/lanterns
--   Deliver   From, To, Fragile?, Time? carry a package to each destination
--   Course    Course, Medal?, NoFalls?, Shortcut?, Flow?
--   Courses   Count, District?          finish N different courses
--   Technique Action, Count, District?
--   Chain     Actions, District?        perform the moves in order in one chain
--   Flow      Tier, District?           reach a flow tier (1-5)
--   Discover  Count, District?
--   Lessons   Count                     training yard lessons
--   Timed     From, To, Time            get from A to B within the limit
--   Race / Relay  Count                 finish multiplayer races / relays
--   Mastery   Tier, Count               reach a tier in Count categories
--   Crew                                join or found a crew
--   Tower     Floor                     clear a Spire floor

export type Step = { [string]: any }
export type Quest = {
	Id: string,
	Type: string, -- "Main" | "Side" | "Expert"
	Chapter: number?,
	Giver: string,
	District: string,
	Name: string,
	Summary: string,
	Start: string,
	Requires: { Level: number?, Quests: { string }? },
	Intro: { string },
	Outro: { string },
	Steps: { Step },
	Rewards: { XP: number?, Credits: number?, Prestige: number?, Items: { string }? },
	Order: number?,
}

