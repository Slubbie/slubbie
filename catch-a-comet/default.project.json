{
  "name": "catch-a-comet",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 45,
        "CameraMinZoomDistance": 6,
        "CharacterWalkSpeed": 20
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FallenPartsDestroyHeight": -500,
        "StreamingEnabled": true,
        "StreamingMinRadius": 160,
        "StreamingTargetRadius": 900
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
