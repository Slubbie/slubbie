-- Livestock.
--
-- Genetics (see Lib/Genetics):
--   Coat     two alleles from Coats; the most dominant (lowest Dom) shows.
--            Rare coats are recessive, so two carriers are needed to see them.
--   Pattern  two alleles from Patterns, same rule.
--   Size, Yield, Temper, Speed  quantitative 0-10, averaged from parents ± noise.
-- A rare coat can change the product (golden hens lay golden eggs).
--
-- Care: animals need food once per in-game day (hay/feed in the trough or an
-- auto-feeder), like being petted and brushed, and dislike bad weather outside.
-- Happiness (0-100) and friendship (0-1000) raise product quality and rate.

export type Allele = { Id: string, Name: string, Dom: number, Color: Color3, Rarity: string, Weight: number }

export type Species = {
	Id: string,
	Name: string,
	Icon: string,
	Rarity: string,
	Home: string, -- building category tag that houses it
	Price: number,
	Level: number, -- Ranching level to buy
	Product: string,
	Interval: number, -- in-game hours between products
	Feed: { string },
	Sounds: { string },
	Coats: { Allele },
	Patterns: { Allele },
	CoatProducts: { [string]: string }?,
	Outside: boolean, -- wanders outside in good weather
	Rideable: boolean?,
	Buyable: boolean,
	Model: {
		Body: Vector3,
		Head: number,
		Legs: number,
		LegLength: number,
		Neck: number?,
		Ears: string?,
		Tail: string?,
		Beak: boolean?,
		Wings: boolean?,
		Horns: boolean?,
		Fluffy: boolean?,
		Hover: number?,
		Shell: boolean?,
		Glow: boolean?,
	},
}

local hex = Color3.fromHex

local function allele(id, name, dom, color, rarity, weight): Allele
	return { Id = id, Name = name, Dom = dom, Color = hex(color), Rarity = rarity or "Common", Weight = weight or 10 }
end

