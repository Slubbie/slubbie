-- Cooked food (Kitchen). Energy restores stamina; buffs last in-game minutes. ------------------
local function food(id, name, icon, value, energy, buff, rarity, tags)
	return {
		Id = id,
		Name = name,
		Icon = icon,
		Value = value,
		Energy = energy,
		Buff = buff,
		Rarity = rarity or "Common",
		Use = "Eat",
		Tags = tags or { "Cooked" },
	}
end

