-- Crop mutations (traits).
--
-- While a crop grows, the server rolls each mutation it doesn't have yet:
--   chance per in-game hour = Base × weather mult × fertilizer mult × neighbour
--                             mult × region mult × latent gene mult × skills
-- Triggers:
--   Weather    { [weatherId] = mult } (on top of the weather's own Mutations table)
--   Neighbors  { [cropId] = mult } for each adjacent (8-way) crop of that type
--   Regions    { [regionOrTag] = mult } e.g. a Greenhouse or Skyreach soil
--   Night      mult while it's night
--   FullMoon   mult on full-moon nights
-- Special rules:
--   OnHarvest  roll only at harvest instead of while growing (e.g. Perfect uses score)
--   Group      mutations in the same group are exclusive (Giant vs Tiny)
--
-- Combos are legendary stacks: having every mutation in Requires adds the combo
-- (which then counts as its own collection entry with its own reveal).

export type Mutation = {
	Id: string,
	Name: string,
	Icon: string,
	Description: string,
	Value: number, -- sell value multiplier
	Rarity: string,
	Base: number, -- chance per in-game hour of growth
	Group: string?,
	Weather: { [string]: number }?,
	Neighbors: { [string]: number }?,
	Regions: { [string]: number }?,
	Night: number?,
	FullMoon: number?,
	OnHarvest: boolean?,
	Size: number?, -- size multiplier
	Yield: number?, -- extra items
	Visual: {
		Color: Color3?,
		Material: string?,
		Neon: boolean?,
		Light: Color3?,
		Particles: string?,
		Scale: number?,
		Hue: boolean?,
		Transparency: number?,
	},
}

export type Combo = {
	Id: string,
	Name: string,
	Icon: string,
	Description: string,
	Requires: { string },
	Value: number,
	Visual: { Particles: string?, Color: Color3?, Light: Color3?, Scale: number? },
}

