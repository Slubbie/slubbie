-- Villagers.
--
-- Schedules: lists of { hour, waypoint } (waypoints are named places in
-- Config/World.Waypoints). The active list is chosen by priority:
--   Festival (if a festival is on) > Rain (rain/storm/snow) > <Season> > Weekend > Default
-- NPCs walk between waypoints along the village road graph.
--
-- Friendship: 0-2500 points = 0-10 hearts. Talking once a day, gifts (twice a
-- week per NPC), quests and festivals raise it. Hearts unlock discounts, recipes
-- (Config/Recipes Unlock.Friend), shop items, quests (Config/Quests) and story
-- scenes (Events below). Birthdays multiply gift friendship ×5.
--
-- Gifts: item ids or "#Tag". Anything not listed is Neutral.

export type Npc = {
	Id: string,
	Name: string,
	Role: string,
	Icon: string,
	Birthday: { number }, -- { season index, day }
	Shop: string?,
	Unlock: { [string]: any }?,
	Look: {
		Skin: Color3,
		Shirt: Color3,
		Pants: Color3,
		Hair: Color3,
		HairStyle: string,
		Hat: string?,
		HatColor: Color3?,
		Accessory: string?,
		Height: number,
	},
	Gifts: { Love: { string }, Like: { string }, Dislike: { string }, Hate: { string } },
	Schedule: { [string]: { { any } } },
	Lines: { [string]: { string } },
	Events: { { Hearts: number, Title: string, Lines: { string }, Reward: { [string]: any } } },
	Perks: { { Hearts: number, Text: string, Effect: { [string]: any } } },
	Voice: number,
}

