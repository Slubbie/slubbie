-- Explorable regions.
--
--   Center/Radius    region bounds (used for "which region am I in", hazards, music)
--   Unlock           what opens it (checked by the server for every action inside it):
--                      Quest = id · Item = id (kept in inventory) · Skill = { name, level }
--                      Project = town project id · Estate = level · Night = true (only at night)
--   Weather          Replace = { natural → regional }, Force = weather id
--   Hazard           Kind, EnergyPerMinute drained unless protected by Buff (or a Warmth/Light source)
--   Waters           fishing zones { Tag, Center, Radius }
--   Nodes            { [nodeId] = count } trees/rocks spawned in the region
--   Forage / Bugs    ids that can spawn here (seasons/time still apply)
--   Dig              dig-spot loot { { Id, Weight } }
--   Music            mood name for the adaptive soundtrack
--   Ambience         ambience layer names (client AudioController)

export type Region = {
	Id: string,
	Name: string,
	Icon: string,
	Description: string,
	Center: Vector3,
	Radius: number,
	Height: number?, -- vertical extent (floating/underground regions)
	Biome: string,
	Unlock: { [string]: any }?,
	UnlockText: string?,
	Weather: { Replace: { [string]: string }?, Force: string? }?,
	Hazard: { Kind: string, EnergyPerMinute: number, Buff: string, Text: string }?,
	Waters: { { Tag: string, Center: Vector3, Radius: number } },
	Nodes: { [string]: number },
	Forage: { string },
	Bugs: { string },
	Dig: { { Id: string, Weight: number } },
	Music: string,
	Ambience: { string },
	MapColor: Color3,
	Secrets: { string }?,
	EnvTags: { string }?,
}

local V = Vector3.new
local hex = Color3.fromHex

local COMMON_DIG = {
	{ Id = "clay", Weight = 30 },
	{ Id = "worm", Weight = 22 },
	{ Id = "stone", Weight = 12 },
	{ Id = "geode", Weight = 8 },
	{ Id = "old_coin", Weight = 5 },
	{ Id = "clay_pot", Weight = 4 },
	{ Id = "mystery_seed", Weight = 3 },
}

local function dig(extra: { { Id: string, Weight: number } })
	local out = table.clone(COMMON_DIG)
	for _, entry in extra do
		table.insert(out, entry)
	end
	return out
end

