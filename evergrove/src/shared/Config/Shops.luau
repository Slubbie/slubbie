-- NPC shops.
--
-- Stock entries:
--   Id         item id ("seed_<crop>" for seeds, placeable ids for placeables)
--   Price      override (default: item base value × BuyMarkup, seeds use Crop.Seed)
--   Season     only sold in this season (or list); "Current" = crop seeds in season
--   Level      Farming level (seeds) / Estate level (placeables) required
--   Hearts     hearts with the owner required
--   Stock      daily limit per player (nil = unlimited)
--   Currency   "Coins" (default) or "Tokens" (festival tokens)
--
-- Shops also buy things (Buys = item tags/categories they pay a bonus for).
-- The general store buys anything at market price.

export type Entry = {
	Id: string,
	Price: number?,
	Season: any?,
	Level: number?,
	Hearts: number?,
	Stock: number?,
	Currency: string?,
}

export type Shop = {
	Id: string,
	Name: string,
	Owner: string,
	Icon: string,
	Stock: { Entry },
	AllSeeds: boolean?, -- sells every shop crop seed that is in season
	Buys: { [string]: number }?, -- tag/category → price multiplier when selling here
	Rotating: { Pool: { Entry }, Count: number }?,
	Days: { number }?, -- weekdays open (nil = every day)
	Hours: { number }?, -- { open, close }
	Services: { string }?,
}

