-- Weather types and how often they happen.
--
-- Gameplay fields
--   Growth       crop growth multiplier outdoors
--   Drain        soil moisture drain multiplier (0 = no drain)
--   Waters       rain fills outdoor soil moisture
--   Mutations    { [mutationId] = chance multiplier } for crops growing in it
--   Fish         { Rarity = mult, Tags = { tag = mult } } fishing table modifiers
--   Animals      happiness change per in-game hour for animals outside
--   Market       { [category/tag] = price multiplier }
--   Hazard       optional outdoor crop hazard { Kind, ChancePerHour, Protect = placeable tag }
--   Time         "Any" | "Night" | "Day" (night-only weather only rolls in night slots)
--   Rare         shown with a banner and recorded in the collection book
--
-- Visual fields drive the client (clouds, particles, lighting, audio).

export type WeatherType = {
	Id: string,
	Name: string,
	Icon: string,
	Description: string,
	Growth: number,
	Drain: number,
	Waters: boolean,
	Mutations: { [string]: number },
	Fish: { [string]: any },
	Animals: number,
	Market: { [string]: number },
	Hazard: { Kind: string, ChancePerHour: number, Protect: string }?,
	Time: string,
	Rare: boolean?,
	Visual: {
		Cover: number,
		Density: number,
		CloudColor: Color3,
		Fog: number,
		Haze: number,
		Rain: number,
		Snow: number,
		Hail: number,
		Wind: number,
		Brightness: number,
		Tint: Color3,
		Particles: string?,
		Lightning: boolean?,
		Sky: string?,
	},
	Audio: { Loop: string?, Volume: number },
	Caption: string?,
}

local function weather(def: any): WeatherType
	def.Mutations = def.Mutations or {}
	def.Fish = def.Fish or {}
	def.Market = def.Market or {}
	def.Animals = def.Animals or 0
	def.Growth = def.Growth or 1
	def.Drain = def.Drain or 1
	def.Waters = def.Waters == true
	def.Time = def.Time or "Any"
	local v = def.Visual
	v.Cover = v.Cover or 0.4
	v.Density = v.Density or 0.4
	v.CloudColor = v.CloudColor or Color3.new(1, 1, 1)
	v.Fog = v.Fog or 0
	v.Haze = v.Haze or 0.8
	v.Rain = v.Rain or 0
	v.Snow = v.Snow or 0
	v.Hail = v.Hail or 0
	v.Wind = v.Wind or 0.3
	v.Brightness = v.Brightness or 1
	v.Tint = v.Tint or Color3.new(1, 1, 1)
	def.Audio = def.Audio or { Volume = 0 }
	return def
end

